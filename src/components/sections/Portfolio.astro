---
/**
 * Portfolio Section - 作品集展示區（PC 傾斜列表 / Mobile Carousel）
 */

import SectionTitle from '../common/SectionTitle.astro';
import { Search, Layers, Map, BarChart3, Bot, Shield, MessageSquare, Mic, Building2, Code } from '@lucide/astro';

interface PortfolioStat {
    label: string;
    value: string;
}

interface PortfolioItem {
    id: string;
    iconKey: string;
    status: string;
    statusType: string;
    title: string;
    subtitle: string;
    desc: string;
    image: string;
    stats: PortfolioStat[];
    tech: string[];
    link: string;
}

interface Props {
    items?: PortfolioItem[];
}

// Icon 對應表
const iconComponents = {
    search: Search,
    layers: Layers,
    map: Map,
    chart: BarChart3,
    bot: Bot,
    shield: Shield,
    message: MessageSquare,
    mic: Mic,
    building: Building2,
    code: Code,
