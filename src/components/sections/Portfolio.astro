        },
        {
            id: 'rice-call',
            iconKey: 'mic',
            status: '開源貢獻',
            statusType: 'opensource',
            title: 'Rice Call 開源貢換',
            subtitle: 'RaidCall 致敬・10+ 貢獻者協作',
