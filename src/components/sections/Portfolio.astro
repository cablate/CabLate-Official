} = Astro.props;
---

<section class="section section-dark featured-section">
    <div class="container">
        <SectionTitle
            title="專案實績"
            subtitle="Projects"
            reveal={false}
        />

        <div class="portfolio-showcase">
            <!-- 左側：作品預覽區 -->
            <div class="portfolio-preview">
                {items.map((item, idx) => {
                    const IconComponent = iconComponents[item.iconKey as keyof typeof iconComponents];
                    return (
                        <div class={`portfolio-preview-item ${idx === 0 ? 'active' : ''}`} data-portfolio={item.id}>
                            <div class="preview-image">
                                <img src={item.image} alt={item.title} onerror="this.style.display='none'" />
                                <div class="preview-placeholder">
                                    {IconComponent && <IconComponent size={64} />}
                                </div>
                            </div>
                            <div class="preview-overlay">
                                <h3 class="preview-title">{item.title}</h3>
                                <p class="preview-subtitle">{item.subtitle}</p>
                                <p class="preview-desc">{item.desc}</p>
                                {item.link !== '#' && (
                                    <a href={item.link} class="preview-link" target="_blank" rel="noopener">
                                        <span>查看專案</span>
                                        <span class="link-arrow">→</span>
                                    </a>
                                )}
                            </div>
                        </div>
                    );
                })}
            </div>

            <!-- 右側：作品列表 -->
            <div class="portfolio-list-wrapper">
                <div class="portfolio-list">
                    {items.map((item, idx) => {
                        const IconComponent = iconComponents[item.iconKey as keyof typeof iconComponents];
                        return (
                            <button
                                class={`portfolio-list-item ${idx === 0 ? 'active' : ''}`}
                                data-portfolio-btn={item.id}
                            >
                                <span class="list-item-icon">
                                    {IconComponent && <IconComponent size={20} />}
                                </span>
                                <span class="list-item-content">
                                    <span class="list-item-title">{item.title}</span>
                                    <span class="list-item-subtitle">{item.subtitle}</span>
                                </span>
                                <span class={`list-item-status status-${item.statusType}`}>{item.status}</span>
                            </button>
                        );
                    })}
                </div>
                <!-- 手機版 Carousel 指示器 -->
                <div class="portfolio-carousel-indicators">
                    {items.map((item, idx) => (
                        <button
                            class={`carousel-dot ${idx === 0 ? 'active' : ''}`}
                            data-carousel-dot={idx}
                            aria-label={`Go to ${item.title}`}
                        />
                    ))}
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    // Portfolio 作品集切換
    const portfolioBtns = document.querySelectorAll('.portfolio-list-item');
    const portfolioItems = document.querySelectorAll('.portfolio-preview-item');

    function updatePortfolio(portfolioId: string) {
        portfolioBtns.forEach(btn => {
            btn.classList.toggle('active', (btn as HTMLElement).dataset.portfolioBtn === portfolioId);
        });
        portfolioItems.forEach(item => {
            item.classList.toggle('active', (item as HTMLElement).dataset.portfolio === portfolioId);
        });
    }

    portfolioBtns.forEach((btn, idx) => {
        btn.addEventListener('click', () => {
            const portfolioId = (btn as HTMLElement).dataset.portfolioBtn;
            if (portfolioId) {
                updatePortfolio(portfolioId);
                // 手機版：同步更新小點點和滾動位置
                if (isMobile()) {
                    updateCarouselState(idx);
                }
            }
        });
    });

    // 手機版：更新 Carousel 狀態（小點點 + 滾動置中）
    function updateCarouselState(idx: number) {
        const carouselDots = document.querySelectorAll('.carousel-dot');
        const portfolioList = document.querySelector('.portfolio-list') as HTMLElement | null;
        const portfolioListItems = document.querySelectorAll('.portfolio-list-item');

        // 更新小點點
        carouselDots.forEach((dot, i) => {
            dot.classList.toggle('active', i === idx);
        });

        // 滾動到置中位置
        if (portfolioList && portfolioListItems[idx]) {
            const item = portfolioListItems[idx] as HTMLElement;
            const itemWidth = item.offsetWidth;
            const listWidth = portfolioList.offsetWidth;
            const gap = 12;
            // 計算讓項目置中的 scrollLeft
            const scrollTarget = idx * (itemWidth + gap) - (listWidth - itemWidth) / 2;
            portfolioList.scrollTo({
                left: Math.max(0, scrollTarget),
                behavior: 'smooth'
            });
        }
    }

    // 檢測是否為手機版
    const isMobile = () => window.matchMedia('(max-width: 900px)').matches;

    // 拖曳滾動功能（含慣性動畫、區分點擊與拖曳、彈性回彈）- 僅 PC 版
    const portfolioList = document.querySelector('.portfolio-list') as HTMLElement | null;
    const carouselDots = document.querySelectorAll('.carousel-dot');
    const portfolioListItems = document.querySelectorAll('.portfolio-list-item');

    if (portfolioList) {
        let isMouseDown = false;
        let isDragging = false;
        let startY = 0;
        let scrollTop = 0;
        let velocity = 0;
        let lastY = 0;
        let lastTime = 0;
        let animationId: number | null = null;
        let overscrollAmount = 0;
        const DRAG_THRESHOLD = 5;
        const OVERSCROLL_RESISTANCE = 0.3;
        const BOUNCE_BACK_SPEED = 0.15;

        const getMaxScroll = () => portfolioList.scrollHeight - portfolioList.clientHeight;

        const updateOverscrollVisual = () => {
            portfolioList.style.transform = `rotate(-12deg) translateY(${-overscrollAmount}px)`;
        };

        const resetOverscrollVisual = () => {
            portfolioList.style.transform = 'rotate(-12deg)';
        };

        const startDrag = (e: MouseEvent | TouchEvent) => {
            if (isMobile()) return;
            if (animationId) {
                cancelAnimationFrame(animationId);
                animationId = null;
            }
            isMouseDown = true;
            isDragging = false;
            startY = (e as MouseEvent).pageY || (e as TouchEvent).touches?.[0]?.pageY;
            scrollTop = portfolioList.scrollTop;
            lastY = startY;
            lastTime = Date.now();
            velocity = 0;
            overscrollAmount = 0;
        };

        const drag = (e: MouseEvent | TouchEvent) => {
            if (isMobile()) return;
            if (!isMouseDown) return;
            const y = (e as MouseEvent).pageY || (e as TouchEvent).touches?.[0]?.pageY;
            const diff = Math.abs(startY - y);

            if (!isDragging && diff > DRAG_THRESHOLD) {
                isDragging = true;
                portfolioList.classList.add('dragging');
            }

            if (!isDragging) return;
            e.preventDefault();

            const now = Date.now();
            const dt = now - lastTime;

            if (dt > 0) {
                velocity = (lastY - y) / dt * 15;
            }

            lastY = y;
            lastTime = now;

            const rawScroll = scrollTop + (startY - y);
            const maxScroll = getMaxScroll();

            if (rawScroll < 0) {
                overscrollAmount = rawScroll * OVERSCROLL_RESISTANCE;
                portfolioList.scrollTop = 0;
                updateOverscrollVisual();
            } else if (rawScroll > maxScroll) {
                overscrollAmount = (rawScroll - maxScroll) * OVERSCROLL_RESISTANCE;
                portfolioList.scrollTop = maxScroll;
                updateOverscrollVisual();
            } else {
                overscrollAmount = 0;
                resetOverscrollVisual();
                portfolioList.scrollTop = rawScroll;
            }
        };

        const endDrag = () => {
            if (isMobile()) return;
            if (!isMouseDown) return;
            isMouseDown = false;

            if (isDragging) {
                isDragging = false;
                portfolioList.classList.remove('dragging');

                if (overscrollAmount !== 0) {
                    const bounceBack = () => {
                        overscrollAmount *= (1 - BOUNCE_BACK_SPEED);
                        if (Math.abs(overscrollAmount) < 0.5) {
                            overscrollAmount = 0;
                            resetOverscrollVisual();
                            animationId = null;
                            return;
                        }
                        updateOverscrollVisual();
                        animationId = requestAnimationFrame(bounceBack);
                    };
                    bounceBack();
                } else {
                    const momentum = () => {
                        if (Math.abs(velocity) < 0.5) {
                            animationId = null;
                            return;
                        }
                        const newScroll = portfolioList.scrollTop + velocity;
                        const maxScroll = getMaxScroll();

                        if (newScroll <= 0 || newScroll >= maxScroll) {
                            portfolioList.scrollTop = Math.max(0, Math.min(newScroll, maxScroll));
                            animationId = null;
                            return;
                        }

                        portfolioList.scrollTop = newScroll;
                        velocity *= 0.92;
                        animationId = requestAnimationFrame(momentum);
                    };
                    momentum();
                }
            }
        };

        // PC 版事件
        portfolioList.addEventListener('mousedown', startDrag);
        window.addEventListener('mousemove', drag);
        window.addEventListener('mouseup', endDrag);
        portfolioList.addEventListener('touchstart', startDrag, { passive: true });
        portfolioList.addEventListener('touchmove', drag, { passive: false });
        portfolioList.addEventListener('touchend', endDrag);

        // === 手機版 Carousel 邏輯 ===

        // 更新指示器
        const updateCarouselDots = () => {
            if (!isMobile()) return;
            const scrollLeft = portfolioList.scrollLeft;
            const itemWidth = (portfolioListItems[0] as HTMLElement)?.offsetWidth || 0;
            const gap = 16;
            const currentIndex = Math.round(scrollLeft / (itemWidth + gap));

            carouselDots.forEach((dot, idx) => {
                dot.classList.toggle('active', idx === currentIndex);
            });

            // 同步更新 preview
            if (portfolioListItems[currentIndex]) {
                const portfolioId = (portfolioListItems[currentIndex] as HTMLElement).dataset.portfolioBtn;
                if (portfolioId) {
                    updatePortfolio(portfolioId);
                    portfolioListItems.forEach(item => item.classList.remove('active'));
                    portfolioListItems[currentIndex].classList.add('active');
                }
            }
        };

        // 點擊指示器跳轉
        carouselDots.forEach((dot, idx) => {
            dot.addEventListener('click', () => {
                if (!isMobile()) return;

                // 更新 preview 內容
                if (portfolioListItems[idx]) {
                    const portfolioId = (portfolioListItems[idx] as HTMLElement).dataset.portfolioBtn;
                    if (portfolioId) {
                        updatePortfolio(portfolioId);
                    }
                }

                // 統一使用 updateCarouselState 處理小點點 + 置中滾動
                updateCarouselState(idx);
            });
        });

        // 監聽滾動更新指示器
        let scrollTimeout: ReturnType<typeof setTimeout>;
        portfolioList.addEventListener('scroll', () => {
            if (!isMobile()) return;
            clearTimeout(scrollTimeout);
            scrollTimeout = setTimeout(updateCarouselDots, 50);
        });
    }

    // === 手機版預覽區滑動支援 ===
    const portfolioPreview = document.querySelector('.portfolio-preview') as HTMLElement | null;
    if (portfolioPreview) {
        let touchStartX = 0;
        let touchEndX = 0;
        let currentIndex = 0;
        const SWIPE_THRESHOLD = 50;

        const getActiveIndex = () => {
            const activeItem = document.querySelector('.portfolio-preview-item.active');
            if (!activeItem) return 0;
            const allItems = document.querySelectorAll('.portfolio-preview-item');
            return Array.from(allItems).indexOf(activeItem);
        };

        const navigateToIndex = (idx: number) => {
            const totalItems = portfolioItems.length;
            if (idx < 0) idx = 0;
            if (idx >= totalItems) idx = totalItems - 1;

            const targetItem = portfolioListItems[idx] as HTMLElement;
            if (targetItem?.dataset.portfolioBtn) {
                updatePortfolio(targetItem.dataset.portfolioBtn);
                if (isMobile()) {
                    updateCarouselState(idx);
                }
            }
        };

        portfolioPreview.addEventListener('touchstart', (e: TouchEvent) => {
            if (!isMobile()) return;
            touchStartX = e.touches[0].clientX;
            currentIndex = getActiveIndex();
        }, { passive: true });

        portfolioPreview.addEventListener('touchend', (e: TouchEvent) => {
            if (!isMobile()) return;
            touchEndX = e.changedTouches[0].clientX;
            const swipeDistance = touchStartX - touchEndX;

            if (Math.abs(swipeDistance) > SWIPE_THRESHOLD) {
                if (swipeDistance > 0) {
                    // 向左滑 → 下一個
                    navigateToIndex(currentIndex + 1);
                } else {
                    // 向右滑 → 上一個
                    navigateToIndex(currentIndex - 1);
                }
            }
        }, { passive: true });
    }
</script>

<style>
    .featured-section {
        padding: 5rem 0;
        background: var(--bg-soft);
    }

    /* ===== Portfolio Showcase ===== */
    .portfolio-showcase {
        position: relative;
        height: 560px;
        overflow: hidden;
        border-radius: 16px;
        border: 1px solid var(--border);
    }

    /* Preview Area - 填滿整個區塊 */
    .portfolio-preview {
        position: absolute;
        inset: 0;
        overflow: hidden;
        background: var(--bg-muted);
    }

    .portfolio-preview-item {
        position: absolute;
        inset: 0;
        opacity: 0;
        visibility: hidden;
        transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .portfolio-preview-item.active {
        opacity: 1;
        visibility: visible;
    }

    .preview-image {
        position: absolute;
        inset: 0;
    }

    .preview-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.8;
    }

    .preview-placeholder {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--accent);
        opacity: 0.2;
    }

    .preview-overlay {
        position: absolute;
        inset: 0;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        background: linear-gradient(
            to top,
            var(--bg) 0%,
            rgba(255, 255, 255, 0.9) 50%,
            rgba(255, 255, 255, 0.6) 100%
        );
    }

    .preview-status {
