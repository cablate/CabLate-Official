            image: '/images/concept/portfolio-deep-research-organic-concept.webp',
            stats: [
                { label: '功能模組', value: '15+' },
                { label: '活躍貢獻者', value: '10+' }
            ],
            tech: ['TypeScript', 'WebRTC', 'React', 'Node.js'],
            link: '#'
        },
        {
            id: 'crm-system',
            iconKey: 'building',
            status: '接案實績',
            statusType: 'enterprise',
            title: '企業 ERP 系統',
            subtitle: '3+ 企業導入・效率提升 40%',
            desc: '為中小企業客戶打造的客戶關係管理與工作流程自動化系統。整合客戶資料管理、流程追蹤、報表分析等功能，協助企業從傳統作業模式轉型為數據驅動營運。',
            image: '/images/concept/portfolio-deep-research-organic-concept.webp',
            stats: [
                { label: '導入企業', value: '3+' },
                { label: '效率提升', value: '40%' }
            ],
            tech: ['Vue.js', 'Node.js', 'PostgreSQL', 'API'],
