---
import KitForm from '../common/KitForm.astro';
import { siteConfig } from '../../config/siteConfig';
---

<section class="newsletter-section" id="newsletter" aria-labelledby="newsletter-title">
  <div class="newsletter-text">
    <h2 id="newsletter-title">每封信，<br />拆一個 AI 卡點</h2>
    <p class="newsletter-copy">{siteConfig.newsletter.promise}{siteConfig.newsletter.cadence}</p>
  </div>

  <div class="newsletter-form">
    <KitForm />
    <p class="newsletter-note">送出後到信箱點確認連結。隨時可以退訂；資料怎麼用寫在<a href="/privacy/">隱私權政策</a></p>
  </div>
</section>

<style>
  .newsletter-section {
    min-width: 0;
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .newsletter-text h2 {
    margin: 0;
    font-family: var(--font-sans);
    color: var(--text-primary, #253047);
    font-size: clamp(1.3rem, 2.1vw, 1.65rem);
    line-height: 1.35;
    letter-spacing: -.02em;
    text-wrap: balance;
  }

  .newsletter-copy {
    margin: .65rem 0 0;
    color: var(--text-secondary, #697184);
    font-size: .95rem;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .newsletter-form {
    margin-top: 0;
  }

  .newsletter-note {
    margin: .65rem 0 0;
    color: var(--text-muted, #7c8494);
    font-size: .8rem;
    line-height: 1.6;
  }

  .newsletter-note a {
    color: var(--accent-text, #6248c8);
    text-decoration: underline;
    text-underline-offset: .2em;
  }

  @media (max-width: 900px) {
    .newsletter-section {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }

    .newsletter-text h2 {
      font-size: clamp(1.25rem, 5vw, 1.5rem);
    }
  }
</style>
