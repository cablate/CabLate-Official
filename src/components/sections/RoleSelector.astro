---
/**
 * RoleSelector Section - Bento Grid 身份展示
 */

import { siteConfig } from '../../config/siteConfig';

interface Role {
    name: string;
    subtitle: string;
    desc: string;
    achievements: string[];
    span?: string; // 'wide' | 'tall' | default
}

interface Props {
    roles?: Role[];
}

const {
    roles = [
        {
            name: '全端工程師',
            subtitle: 'FULL-STACK ENGINEER',
            desc: `${siteConfig.yearsExperience} 年全端實務經驗、具備優秀溝通能力、對系統品質有高度要求，熱衷於學習新技術並應用於專案中。`,
            achievements: [
                '第一年升任 SA/SD 系統架構師',
                '曾主導千萬預算跨部門專案開發',
                '主導多個系統從零到上線',
            ],
            span: 'tall'
        },
        {
            name: '社群創作者',
            subtitle: 'CONTENT CREATOR',
            desc: `不追「AI 炸裂」流量，專注把技術轉譯成人話。9 個月累積 ${siteConfig.threadsFollowers} 追蹤、${siteConfig.totalViews}瀏覽，沒下廣告，就是持續輸出有根據的觀點。`,
            achievements: [
                'MOPCON 貴賓、OpenVibeDevelopers、SDD.OS 社群講座',
                '資安講座主辦',
                `電子報 ${siteConfig.newsletterSubscribers} 訂閱`,
            ],
            span: 'tall'
        },
        {
            name: '接案開發者',
            subtitle: 'FREELANCER',
            desc: '客戶從小企業、本地新創、外商到政府案都有，幫你用最精簡的成本驗證市場假設。',
            achievements: [
                '從零到 demo 快速驗證',
                '客戶涵蓋新創、外商、政府單位',
                '累積兩年獨立/團隊接案經驗',
            ],
        },
        {
            name: '開源貢獻者',
            subtitle: 'OPEN SOURCE',
            desc: 'Google 生態系 MCP 領先官方近一年，也參與過救災平台、RC 語音復刻等數千 Star 專案，回饋社群。',
            achievements: [
                'Google 生態系 MCP',
                '多個數千 Star 開源專案貢獻',
            ],
        },
        {
            name: '技術顧問',
            subtitle: 'TECH CONSULTANT',
            desc: '少走一段彎路省下的時間，絕對比諮詢費值得。',
            achievements: [
                '一對一技術諮詢與陪跑服務',
            ],
            span: 'wide'
        },
    ]
} = Astro.props;
---

<section class="bento-section">
    <div class="container">
        <div class="bento-grid">
            {roles.map((role) => (
                <div class={`bento-card ${role.span ? `bento-${role.span}` : ''}`}>
                    <div class="bento-header">
                        <span class="bento-subtitle">{role.subtitle}</span>
                        <h3 class="bento-name">{role.name}</h3>
                    </div>
                    <p class="bento-desc">{role.desc}</p>
                    <ul class="bento-achievements">
                        {role.achievements.map(a => (
                            <li><span class="achievement-marker">◆</span>{a}</li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .bento-section {
        padding: 0 2rem 5rem;
        background: var(--bg);
    }

    .container {
        max-width: 800px;
        margin: 0 auto;
    }

    .bento-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.75rem;
    }

    .bento-card {
        padding: 1.5rem;
        background: var(--bg-soft);
        border-radius: 14px;
        display: flex;
        flex-direction: column;
        transition: all 0.2s ease;
    }

    .bento-card:hover {
        background: var(--bg-muted);
    }

    /* Span variants */
    .bento-wide {
        grid-column: span 2;
    }

    .bento-header {
        margin-bottom: 0.75rem;
    }

    .bento-subtitle {
        font-size: 0.65rem;
        font-weight: 600;
        color: var(--text-muted);
        letter-spacing: 0.15em;
        display: block;
        margin-bottom: 0.25rem;
    }

    .bento-name {
        font-family: 'Noto Serif TC', serif;
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--text-primary);
    }

    .bento-desc {
        font-size: 0.9rem;
        color: var(--text-secondary);
        line-height: 1.65;
        margin-bottom: auto;
        padding-bottom: 1rem;
    }

    .bento-achievements {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .bento-achievements li {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        font-size: 0.82rem;
        color: var(--text-primary);
        line-height: 1.5;
    }

    .achievement-marker {
        color: var(--accent, #6d28d9);
        font-size: 0.5rem;
        margin-top: 0.35rem;
        flex-shrink: 0;
    }

    @media (max-width: 600px) {
        .bento-section {
            padding: 0 1.5rem 4rem;
        }

        .bento-grid {
            grid-template-columns: 1fr;
            gap: 0.6rem;
        }

        .bento-wide {
            grid-column: span 1;
        }

        .bento-card {
            padding: 1.25rem;
        }

        .bento-name {
            font-size: 1.1rem;
        }
    }
</style>
