---
/**
 * Hero Section - 首頁主視覺區塊（極簡版）
 */

import { siteConfig } from '../../config/siteConfig';

interface Props {
    greeting?: string;
    subtitle?: string;
}

const {
    greeting = '嗨，我是 CabLate',
    subtitle = '工程師出身，靠架構思維跟 AI 協作，把技術翻譯成人話。',
} = Astro.props;
---

<section class="hero">
    <div class="hero-content">
        <h1 class="hero-title">{greeting}</h1>
        <p class="hero-subtitle">{subtitle}</p>
        <div class="hero-buttons">
            <a href={siteConfig.servicesUrl} class="hero-cta hero-cta-primary">看看我能幫什麼 &rarr;</a>
            <a href={siteConfig.threadsUrl} class="hero-cta hero-cta-secondary" target="_blank" rel="noopener">來 Threads 聊聊 &rarr;</a>
        </div>
    </div>
</section>

<style>
    .hero {
        min-height: 60vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 8rem 2rem 4rem;
        background: var(--bg);
    }

    .hero-content {
        max-width: 640px;
    }

    .hero-title {
        font-family: 'Noto Serif TC', serif;
        font-size: clamp(2.2rem, 6vw, 3.5rem);
        font-weight: 700;
        line-height: 1.3;
        color: var(--text-primary);
        margin-bottom: 1.25rem;
        letter-spacing: -0.02em;
    }

    .hero-subtitle {
        font-size: 1.1rem;
        color: var(--text-secondary);
        line-height: 1.7;
        margin-bottom: 2.5rem;
    }

    .hero-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .hero-cta {
        display: inline-block;
        padding: 0.75rem 2rem;
        font-size: 0.95rem;
        font-weight: 500;
        border-radius: 8px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .hero-cta-primary {
        color: white;
        background: var(--accent);
        border: 1px solid var(--accent);
    }

    .hero-cta-primary:hover {
        background: var(--accent-light);
        border-color: var(--accent-light);
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
    }

    .hero-cta-secondary {
        color: var(--text-primary);
        background: transparent;
        border: 1px solid var(--border);
    }

    .hero-cta-secondary:hover {
        border-color: var(--accent);
        color: var(--accent);
        background: var(--accent-subtle);
    }

    @media (max-width: 768px) {
        .hero {
            min-height: auto;
            padding: 7rem 1.5rem 3rem;
        }

        .hero-subtitle {
            font-size: 1rem;
        }
    }
</style>
