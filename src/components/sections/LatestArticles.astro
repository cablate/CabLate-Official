---
/**
 * Latest Articles Section - 首頁最新文章區塊
 */

import { getCollection } from 'astro:content';
import { formatDate } from '../../utils/format';

const allArticles = await getCollection('articles');
const published = allArticles.filter(entry => !entry.data.draft);

// 精選文章優先，再依發布日期排序
const featured = published
  .filter(entry => entry.data.featured)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const nonFeatured = published
  .filter(entry => !entry.data.featured)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

// 精選在前，剩餘用最新文章填滿 3 篇
const latestArticles = [...featured, ...nonFeatured].slice(0, 3);
const featuredSlugs = new Set(featured.map(a => a.slug));
---

{latestArticles.length > 0 && (
  <section class="latest-articles">
    <div class="latest-articles-inner">
      <div class="latest-articles-header">
        <h2 class="latest-articles-title">推薦閱讀</h2>
        <a href="/articles/" class="latest-articles-more">查看全部 →</a>
      </div>
      <div class="latest-articles-grid">
        {latestArticles.map((entry) => (
          <article class="la-card-wrapper">
            <a href={`/articles/${entry.slug}/`} class="la-card">
              <div class="la-card-top">
                <span class="la-category">{entry.data.category}</span>
                {featuredSlugs.has(entry.slug) && (
                  <span class="la-featured-badge">精選</span>
                )}
              </div>
              <h3 class="la-title">{entry.data.title}</h3>
              {entry.data.description && (
                <p class="la-desc">{entry.data.description}</p>
              )}
              <time class="la-date" datetime={entry.data.publishDate.toISOString()}>
                {formatDate(entry.data.publishDate)}
              </time>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .latest-articles {
    padding: 4rem 2rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .latest-articles-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2rem;
  }

  .latest-articles-title {
    font-family: 'Noto Serif TC', serif;
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text-primary, #1e293b);
  }

  .latest-articles-more {
    font-size: 0.9rem;
    color: var(--accent, #8b5cf6);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .latest-articles-more:hover {
    opacity: 0.8;
  }

  .latest-articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .la-card {
    display: flex;
    flex-direction: column;
    padding: 1.75rem 1.65rem;
    border: 0;
    border-radius: .2rem;
    background-color: transparent;
    background-image: var(--paper-reading-card-image);
    background-repeat: no-repeat;
    background-position: center;
    background-size: 123% 172.5%;
    text-decoration: none;
    transition: filter 0.2s, transform 0.2s;
    height: 100%;
  }

  @media (hover: hover) {
    .la-card:hover {
      filter: drop-shadow(0 .35rem .45rem rgb(69 58 43 / .11));
      transform: translateY(-2px);
    }
  }

  .la-card-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .la-category {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent, #8b5cf6);
    font-weight: 600;
  }

  .la-featured-badge {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--gold, #f59e0b);
    background: #fef3c7;
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius-full, 9999px);
    line-height: 1.5;
  }

  .la-title {
    font-family: 'Noto Serif TC', serif;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary, #1e293b);
    line-height: 1.4;
    margin-bottom: 0.5rem;
  }

  .la-desc {
    font-size: 0.85rem;
    color: var(--text-secondary, #475569);
    line-height: 1.6;
    margin-bottom: auto;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .la-date {
    font-size: 0.75rem;
    color: var(--text-muted, #94a3b8);
    margin-top: 1rem;
  }

  @media (max-width: 768px) {
    .latest-articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
