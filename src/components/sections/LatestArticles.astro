---
import { getCollection } from 'astro:content';
import { ArrowRight } from '@lucide/astro';
import { formatDate } from '../../utils/format';

const allArticles = await getCollection('articles');
const published = allArticles
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const curated = [
  {
    slug: 'claude-code-workflow',
    intent: '想看一條完整實作流程',
    mobileTitleLines: ['Claude Code 實戰：', '我怎麼用 AI 寫完', '一整個網站'],
  },
  {
    slug: 'blog-writing-openclaw',
    intent: '不確定自己是否真的需要 Agent',
    mobileTitleLines: ['你可能不需要龍蝦：', '自動化跟 Agent 是兩件事'],
  },
  {
    slug: 'reverse-engineer-claude-agent-sdk-hidden-token-cost',
    intent: '想看一次技術追根究柢',
    mobileTitleLines: ['逆向 Claude Agent SDK：', '找出每則訊息 2-3%', ' 額度消耗的根因與解法'],
  },
];

const selected = curated.flatMap((item) => {
  const entry = published.find((article) => article.slug === item.slug);
  return entry ? [{ entry, intent: item.intent, mobileTitleLines: item.mobileTitleLines }] : [];
});

const selectedSlugs = new Set(selected.map(({ entry }) => entry.slug));
for (const entry of published) {
  if (selected.length >= 3) break;
  if (!selectedSlugs.has(entry.slug)) {
    selected.push({ entry, intent: '更多實作觀察', mobileTitleLines: [entry.data.title] });
    selectedSlugs.add(entry.slug);
  }
}

const [primaryArticle, ...secondaryArticles] = selected;
---

{primaryArticle && (
  <section class="reading-section" aria-labelledby="reading-title">
    <header class="reading-header">
      <p>推薦閱讀</p>
      <h2 id="reading-title">先從你現在遇到的<br class="mobile-title-break" />問題讀起。</h2>
    </header>

    <a class="primary-reading" href={`/articles/${primaryArticle.entry.slug}/`}>
      <span>{primaryArticle.intent}</span>
      <h3>
        {primaryArticle.mobileTitleLines.map((line, index) => (
          <>{index > 0 && <br class="mobile-title-break" />}{line}</>
        ))}
      </h3>
      {primaryArticle.entry.data.description && <p>{primaryArticle.entry.data.description}</p>}
      <div>
        <time datetime={primaryArticle.entry.data.publishDate.toISOString()}>{formatDate(primaryArticle.entry.data.publishDate)}</time>
        <strong>開始閱讀 <ArrowRight size={15} aria-hidden="true" /></strong>
      </div>
    </a>

    <div class="secondary-reading-list">
      {secondaryArticles.map(({ entry, intent, mobileTitleLines }) => (
        <a href={`/articles/${entry.slug}/`}>
          <span>{intent}</span>
          <h3>
            {entry.slug === 'reverse-engineer-claude-agent-sdk-hidden-token-cost' ? (
              <>逆向 Claude Agent SDK：<br />找出每則訊息 2-3% <br />額度消耗的根因與解法</>
            ) : (
              mobileTitleLines.map((line, index) => (
                <>{index > 0 && <br class="mobile-title-break" />}{line}</>
              ))
            )}
          </h3>
          <ArrowRight size={16} aria-hidden="true" />
        </a>
      ))}
    </div>

    <a class="all-articles" href="/articles/">查看全部文章 <ArrowRight size={15} aria-hidden="true" /></a>
  </section>
)}

<style>
  .reading-section {
    min-width: 0;
  }

  .reading-header {
    max-width: 34rem;
    margin-bottom: 1.4rem;
  }

  .reading-header > p {
    margin: 0 0 .7rem;
    color: var(--accent, #8064ea);
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .08em;
  }

  .reading-header h2 {
    margin: 0;
    font-family: 'Noto Serif TC', serif;
    color: var(--text-primary, #253047);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.35;
    text-wrap: balance;
  }

  .primary-reading,
  .secondary-reading-list a,
  .all-articles {
    color: inherit;
    text-decoration: none;
  }

  .mobile-title-break {
    display: none;
  }

  .primary-reading {
    display: block;
    min-width: 0;
    padding: 1.5rem;
    border: 1px solid #e2d7a7;
    background: #fff9df;
  }

  .primary-reading > span,
  .secondary-reading-list span {
    color: var(--accent, #8064ea);
    font-size: .72rem;
    font-weight: 700;
  }

  .primary-reading h3 {
    margin: .65rem 0 .55rem;
    font-family: 'Noto Serif TC', serif;
    color: var(--text-primary, #253047);
    font-size: 1.3rem;
    line-height: 1.45;
    text-wrap: balance;
  }

  .primary-reading > p {
    margin: 0;
    color: var(--text-secondary, #697184);
    font-size: .88rem;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .primary-reading > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.1rem;
    color: var(--text-muted, #7c8494);
    font-size: .74rem;
  }

  .primary-reading strong,
  .all-articles {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    color: var(--accent, #8064ea);
  }

  .secondary-reading-list {
    margin-top: .9rem;
  }

  .secondary-reading-list a {
    display: grid;
    grid-template-columns: minmax(9rem, .65fr) minmax(0, 1.35fr) auto;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0;
    border-top: 1px solid #d7d1c6;
  }

  .secondary-reading-list h3 {
    margin: 0;
    font-family: 'Noto Serif TC', serif;
    color: var(--text-primary, #253047);
    font-size: .98rem;
    line-height: 1.5;
  }

  .secondary-reading-list svg {
    color: var(--accent, #8064ea);
  }

  .all-articles {
    width: fit-content;
    margin-top: 1.1rem;
    font-size: .82rem;
    font-weight: 700;
  }

  @media (hover: hover) {
    .primary-reading:hover,
    .secondary-reading-list a:hover,
    .all-articles:hover {
      color: var(--accent, #8064ea);
    }
  }

  @media (max-width: 600px) {
    .mobile-title-break {
      display: initial;
    }

    .primary-reading {
      padding: 1.25rem;
    }

    .primary-reading > div {
      align-items: flex-start;
      flex-direction: column;
      gap: .45rem;
    }

    .secondary-reading-list a {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: .4rem 1rem;
    }

    .secondary-reading-list span {
      grid-column: 1 / -1;
    }
  }
</style>
