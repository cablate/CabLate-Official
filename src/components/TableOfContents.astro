---
/**
 * TableOfContents - 文章目錄（sticky sidebar）
 * 只顯示 h2 / h3，h3 縮排於所屬 h2 底下
 * 使用 IntersectionObserver 做 scroll-spy
 */

interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;

const filtered = headings.filter(h => h.depth === 2 || h.depth === 3);

interface TocItem {
  depth: number;
  slug: string;
  text: string;
  children: { depth: number; slug: string; text: string }[];
}

const nested: TocItem[] = [];
for (const heading of filtered) {
  if (heading.depth === 2) {
    nested.push({ ...heading, children: [] });
  } else if (heading.depth === 3 && nested.length > 0) {
    nested[nested.length - 1].children.push(heading);
  } else {
    nested.push({ ...heading, children: [] });
  }
}
---

{filtered.length > 0 && (
  <nav class="toc" aria-label="目錄">
    <p class="toc-title">這篇的段落</p>
    <ul class="toc-list">
      {nested.map(item => (
        <li>
          <a href={`#${item.slug}`} class="toc-link" data-slug={item.slug}>
            {item.text}
          </a>
          {item.children.length > 0 && (
            <ul class="toc-sublist">
              {item.children.map(child => (
                <li>
                  <a href={`#${child.slug}`} class="toc-link toc-link-sub" data-slug={child.slug}>
                    {child.text}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
)}

<script is:inline>
  (function () {
    let cleanup;
    function initToc() {
      if (cleanup) cleanup();
      const tocLinks = document.querySelectorAll('.toc-link');
      if (!tocLinks.length) return;

      const slugs = Array.from(tocLinks).map(a => a.getAttribute('data-slug'));
      const headingEls = slugs.map(slug => document.getElementById(slug)).filter(Boolean);
      if (!headingEls.length) return;

      let currentSlug = '';
      function setActive(slug) {
        if (slug === currentSlug) return;
        currentSlug = slug;
        tocLinks.forEach(link => {
          link.classList.toggle('toc-active', link.getAttribute('data-slug') === slug);
        });
      }

      const observer = new IntersectionObserver(
        entries => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              setActive(entry.target.id);
              return;
            }
          }
        },
        { rootMargin: '-80px 0px -60% 0px', threshold: 0 }
      );

      headingEls.forEach(el => observer.observe(el));
      cleanup = () => observer.disconnect();
    }

    initToc();
    document.addEventListener('astro:page-load', initToc);
  })();
</script>

<style>
  .toc {
    max-height: calc(100vh - 3rem);
    overflow-y: auto;
    padding: 0.25rem 0 0.25rem 1rem;
    border-left: 1px solid var(--border);
    scrollbar-width: none;
  }

  .toc::-webkit-scrollbar {
    width: 0;
  }

  .toc-title {
    margin: 0 0 0.6rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .toc-list,
  .toc-sublist {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .toc-sublist {
    margin-top: 0.2rem;
  }

  .toc-link {
    display: block;
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.15rem 0;
    transition: color var(--transition-fast);
  }

  .toc-link:hover {
    color: var(--text-primary);
  }

  .toc-link-sub {
    padding-left: 0.75rem;
    font-size: 0.78rem;
  }

  .toc-link.toc-active {
    color: var(--accent-text);
    font-weight: 700;
  }
</style>
