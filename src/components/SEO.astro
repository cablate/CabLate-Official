---
/**
 * SEO Component - 通用 SEO 元件
 * 處理 Meta Tags、Open Graph、Twitter Cards、結構化數據
 *
 * 支援類型：
 * - website：預設，首頁/通用頁
 * - article：文章頁
 *
 * FAQ Schema：任何頁面只要傳入 faq prop 即可自動生成 FAQPage JSON-LD
 */

import { personEntity } from '../config/authority';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** 重複內容頁用：canonical、og:url 與 JSON-LD url 改指向此路徑 */
  canonicalPath?: string;
  publishDate?: Date;
  modifiedDate?: Date;
  tags?: string[];
  // FAQ
  faq?: FaqItem[];
}

const {
  title,
  description,
  image = '/images/og-default.png',
  imageAlt = title,
  imageWidth,
  imageHeight,
  type = 'website',
  noindex = false,
  canonicalPath,
  publishDate,
  modifiedDate,
  tags = [],
  faq,
} = Astro.props;

// 網站基礎資訊
const siteUrl = import.meta.env.SITE || 'https://cablate.com';
const fullUrl = new URL(canonicalPath ?? Astro.url.pathname, siteUrl);
const fullImageUrl = image.startsWith('http') ? image : new URL(image, siteUrl).href;

// JSON-LD headline 不含站名後綴（Google 要求 headline 與 h1 一致）
const jsonLdHeadline = title.replace(/\s*\|\s*CabLate$/, '');

// ─── 主要 JSON-LD ───

let jsonLd: Record<string, unknown>;

if (type === 'article') {
  // Article Schema.org
  jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: jsonLdHeadline,
    description,
    url: fullUrl.href,
    mainEntityOfPage: { '@type': 'WebPage', '@id': fullUrl.href },
    inLanguage: 'zh-TW',
    image: fullImageUrl,
    author: personEntity,
    publisher: {
      '@type': 'Organization',
      name: 'CabLate',
      url: siteUrl,
      logo: {
        '@type': 'ImageObject',
        url: new URL('/favicon.webp', siteUrl).href,
      },
    },
    ...(publishDate && { datePublished: publishDate.toISOString() }),
    ...(modifiedDate && { dateModified: modifiedDate.toISOString() }),
    ...(tags.length > 0 && { keywords: tags.join(', ') }),
  };
} else if (fullUrl.pathname === '/') {
  jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': new URL('/#website', siteUrl).href,
    name: 'CabLate',
    description,
    url: fullUrl.href,
    inLanguage: 'zh-TW',
    publisher: personEntity,
  };
} else {
  jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: jsonLdHeadline,
    description,
    url: fullUrl.href,
    image: fullImageUrl,
    inLanguage: 'zh-TW',
    isPartOf: { '@id': new URL('/#website', siteUrl).href },
  };
}

// ─── FAQ JSON-LD（獨立 script，任何 type 都可使用）───
// Filter out FAQ items containing [TEST] markers to prevent placeholder data in structured data

const productionFaq = faq
  ? faq.filter((item: FaqItem) =>
      !item.question.includes('[TEST]') && !item.answer.includes('[TEST]'))
  : [];
const hasFaq = productionFaq.length > 0;
const faqJsonLd = hasFaq
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: productionFaq.map((item: FaqItem) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    }
  : null;
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow" />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={fullUrl.href} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:image:alt" content={imageAlt} />
{imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
{imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
<meta property="og:site_name" content="CabLate" />
<meta property="og:locale" content="zh_TW" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Canonical Link -->
<link rel="canonical" href={fullUrl.href} />

<!-- JSON-LD 主結構化數據 -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

<!-- JSON-LD FAQ（獨立 script，不衝突） -->
{faqJsonLd && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />
)}

<!-- Additional Meta Tags -->
<meta name="author" content={personEntity.name} />
{publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
{modifiedDate && <meta property="article:modified_time" content={modifiedDate.toISOString()} />}
{tags.length > 0 && tags.map(tag => <meta property="article:tag" content={tag} />)}
