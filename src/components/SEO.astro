---
/**
 * SEO Component - 通用 SEO 元件
 * 處理 Meta Tags、Open Graph、Twitter Cards、結構化數據
 */

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishDate?: Date;
  modifiedDate?: Date;
  tags?: string[];
  author?: string;
}

const {
  title,
  description,
  image = '/images/og-default.png',
  type = 'website',
  noindex = false,
  publishDate,
  modifiedDate,
  tags = [],
  author = 'CabLate'
} = Astro.props;

// 網站基礎資訊
const siteUrl = import.meta.env.SITE || 'https://cablate.com';
const fullUrl = new URL(Astro.url.pathname, siteUrl);
const fullImageUrl = image.startsWith('http') ? image : new URL(image, siteUrl).href;

// JSON-LD headline 不含站名後綴（Google 要求 headline 與 h1 一致）
const jsonLdHeadline = title.replace(/\s*\|\s*CabLate$/, '');

// JSON-LD 結構化數據
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': type === 'article' ? 'Article' : 'WebSite',
  headline: jsonLdHeadline,
  description: description,
  url: fullUrl.href,
  image: fullImageUrl,
  author: {
    '@type': 'Person',
    name: author,
    url: siteUrl
  },
  publisher: {
    '@type': 'Organization',
    name: 'CabLate',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/favicon.webp', siteUrl).href
    }
  },
  ...(type === 'article' && {
    datePublished: publishDate?.toISOString(),
    dateModified: modifiedDate?.toISOString(),
    keywords: tags.join(', ')
  })
};
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={fullUrl.href} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:site_name" content="CabLate" />
<meta property="og:locale" content="zh_TW" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={fullUrl.href} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={fullImageUrl} />

<!-- Canonical Link -->
<link rel="canonical" href={fullUrl.href} />
<link rel="alternate" hreflang="zh-TW" href={fullUrl.href} />
<link rel="alternate" hreflang="x-default" href={fullUrl.href} />

<!-- JSON-LD 結構化數據 -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<!-- Additional Meta Tags -->
<meta name="author" content={author} />
{publishDate && <meta name="article:published_time" content={publishDate.toISOString()} />}
{modifiedDate && <meta name="article:modified_time" content={modifiedDate.toISOString()} />}
{tags.length > 0 && tags.map(tag => <meta property="article:tag" content={tag} />)}
