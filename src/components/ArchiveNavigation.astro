---
import { primaryNavigationGroups } from '../config/authority';
import { Menu, Moon, Sun, X } from '@lucide/astro';

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => currentPath === href;
---

<header class="site-header">
  <aside class="site-rail" aria-label="網站導覽">
    <a class="site-rail__brand" href="/" aria-label="CabLate 首頁" aria-current={currentPath === '/' ? 'page' : undefined}>
      <img src="/images/cablate-author-avatar.webp" alt="" width="256" height="256" aria-hidden="true" />
      <span>
        <strong>CabLate</strong>
      </span>
    </a>
    <nav class="site-rail__nav" aria-label="主要導覽">
      {primaryNavigationGroups.map((group, groupIndex) => (
        <div class="site-nav-group">
          <div class="site-nav-group__header">
            <p id={`rail-nav-group-${groupIndex}`}>{group.label}</p>
            {'overviewHref' in group && (
              <a class="site-nav-group__overview" href={group.overviewHref} aria-current={isCurrent(group.overviewHref) ? 'page' : undefined}>總覽</a>
            )}
          </div>
          <ul class="site-nav-list" aria-labelledby={`rail-nav-group-${groupIndex}`}>
            {group.items.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  <span>{item.label}</span>
                  <small>{item.railLabel}</small>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
    <button type="button" class="site-theme-toggle" data-theme-toggle aria-label="切換深色或淺色模式">
      <Sun class="site-theme-toggle__sun" size={15} aria-hidden="true" />
      <Moon class="site-theme-toggle__moon" size={15} aria-hidden="true" />
      <span data-theme-toggle-label>外觀模式</span>
    </button>
  </aside>

  <div class="site-mobile-header">
    <a class="site-mobile-brand" href="/" aria-label="CabLate 首頁">
      <img src="/images/cablate-author-avatar.webp" alt="" width="256" height="256" aria-hidden="true" />
      <span><strong>CabLate</strong></span>
    </a>
    <details class="site-mobile-menu">
      <summary aria-label="開啟網站選單" aria-controls="mobile-navigation">
        <Menu class="site-mobile-menu__open" size={22} aria-hidden="true" />
        <X class="site-mobile-menu__close" size={22} aria-hidden="true" />
        <span>選單</span>
      </summary>
      <nav id="mobile-navigation" aria-label="手機主要導覽">
        {primaryNavigationGroups.map((group, groupIndex) => (
          <div class="site-nav-group">
            <div class="site-nav-group__header">
              <p id={`mobile-nav-group-${groupIndex}`}>{group.label}</p>
              {'overviewHref' in group && (
                <a class="site-nav-group__overview" href={group.overviewHref} aria-current={isCurrent(group.overviewHref) ? 'page' : undefined}>總覽</a>
              )}
            </div>
            <ul class="site-nav-list" aria-labelledby={`mobile-nav-group-${groupIndex}`}>
              {group.items.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    <span>{item.label}</span><small>{item.railLabel}</small>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
        <button type="button" class="site-theme-toggle site-theme-toggle--mobile" data-theme-toggle aria-label="切換深色或淺色模式">
          <Sun class="site-theme-toggle__sun" size={16} aria-hidden="true" />
          <Moon class="site-theme-toggle__moon" size={16} aria-hidden="true" />
          <span data-theme-toggle-label>外觀模式</span>
        </button>
      </nav>
    </details>
  </div>
</header>

<script>
  const getEffectiveTheme = (): 'dark' | 'light' => {
    const override = document.documentElement.dataset.theme;
    if (override === 'dark' || override === 'light') return override;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  };

  const updateToggleButtons = () => {
    const theme = getEffectiveTheme();

    document.querySelectorAll<HTMLElement>('.site-theme-toggle').forEach((button) => {
      button.dataset.currentTheme = theme;

      const label = button.querySelector<HTMLElement>('[data-theme-toggle-label]');
      if (label) label.textContent = theme === 'dark' ? '切換淺色' : '切換深色';

      button.setAttribute(
        'aria-label',
        theme === 'dark' ? '目前為深色模式，點擊切換為淺色模式' : '目前為淺色模式，點擊切換為深色模式',
      );
    });
  };

  const initializeThemeToggles = () => {
    document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach((button) => {
      if (button.dataset.toggleReady === 'true') return;

      button.dataset.toggleReady = 'true';
      button.addEventListener('click', () => {
        const next = getEffectiveTheme() === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('cablate_theme', next);
        } catch (_) {}
        updateToggleButtons();
      });
    });

    updateToggleButtons();
  };

  window
    .matchMedia('(prefers-color-scheme: dark)')
    .addEventListener('change', () => updateToggleButtons());

  const initializeMobileMenu = () => {
    document.querySelectorAll<HTMLElement>('.site-mobile-menu').forEach((menu) => {
      if (menu.dataset.menuReady === 'true') return;

      const summary = menu.querySelector<HTMLElement>('summary');
      if (!summary) return;

      const syncLabel = () => {
        summary.setAttribute('aria-label', menu.hasAttribute('open') ? '關閉網站選單' : '開啟網站選單');
      };

      menu.dataset.menuReady = 'true';
      syncLabel();
      menu.addEventListener('toggle', syncLabel);
      menu.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !menu.hasAttribute('open')) return;
        menu.removeAttribute('open');
        summary.focus();
      });
    });
  };

  initializeMobileMenu();
  initializeThemeToggles();
  document.addEventListener('astro:page-load', initializeMobileMenu);
  document.addEventListener('astro:page-load', initializeThemeToggles);
</script>
