---
/**
 * NewsletterCTA - 文章內嵌重要更新通知 CTA 元件
 */

import KitForm from './common/KitForm.astro';
import { siteConfig } from '../config/siteConfig';
---

<aside class="newsletter-cta" aria-label="訂閱電子報">
  <div class="newsletter-cta-inner">
    <div class="newsletter-cta-text">
      <h2 class="newsletter-cta-heading">每封信，拆一個 AI 卡點。</h2>
      <p class="newsletter-cta-desc">{siteConfig.newsletter.promise}{siteConfig.newsletter.cadence}這個 Email 不會拿去做合作聯絡或 CabAI 註冊。</p>
    </div>
    <div class="newsletter-cta-form">
      <KitForm />
    </div>
  </div>
</aside>

<style>
  .newsletter-cta {
    max-width: 820px;
    margin: 3rem auto;
    padding: 2rem 2.5rem;
    background: var(--accent-subtle, #f5f3ff);
    border: 1px solid var(--accent-border, #e9e5f5);
    border-radius: var(--radius-md);
  }

  .newsletter-cta-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .newsletter-cta-text {
    flex: 1;
    min-width: 0;
  }

  .newsletter-cta-heading {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary, #1a1a2e);
    margin: 0 0 0.4rem;
    line-height: 1.4;
  }

  .newsletter-cta-desc {
    font-size: 0.9rem;
    color: var(--text-secondary, #64748b);
    margin: 0;
    line-height: 1.6;
  }

  .newsletter-cta-form {
    flex-shrink: 0;
    width: 100%;
    max-width: 360px;
  }

  @media (max-width: 768px) {
    .newsletter-cta {
      padding: 1.5rem;
      margin: 2rem 0;
    }

    .newsletter-cta-inner {
      flex-direction: column;
      gap: 1.25rem;
      align-items: flex-start;
    }

    .newsletter-cta-form {
      max-width: 100%;
      width: 100%;
    }
  }
</style>
