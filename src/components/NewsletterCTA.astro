---
/**
 * NewsletterCTA - 文章內嵌電子報訂閱 CTA 元件
 * 輕量版 CTA，嵌入文章內容下方，非全頁式訂閱區塊。
 */

import { siteConfig } from '../config/siteConfig';

const { formId, uid } = siteConfig.convertKit;
const successMessage = "資料已送出，請到信箱點擊確認連結，完成訂閱。";
---

<aside class="newsletter-cta" aria-label="訂閱電子報">
  <div class="newsletter-cta-inner">
    <div class="newsletter-cta-text">
      <h2 class="newsletter-cta-heading">訂閱 CabLate 電子報</h2>
      <p class="newsletter-cta-desc">收到 AI 協作、Agent 工作流程與產品實作的第一手觀察。每封信都會標明主題，不必每天追著社群更新。</p>
    </div>
    <div class="newsletter-cta-form">
      <script src="https://f.convertkit.com/ckjs/ck.5.js"></script>
      <form
        action={`https://app.kit.com/forms/${formId}/subscriptions`}
        class="seva-form formkit-form"
        method="post"
        data-sv-form={formId}
        data-uid={uid}
        data-format="inline"
        data-version="5"
        data-options={`{"settings":{"after_subscribe":{"action":"message","success_message":"${successMessage}","redirect_url":""},"analytics":{"google":null,"fathom":null,"facebook":null,"segment":null,"pinterest":null,"sparkloop":null,"googletagmanager":null},"modal":{"trigger":"timer","scroll_percentage":null,"timer":5,"devices":"all","show_once_every":15},"powered_by":{"show":false,"url":""},"recaptcha":{"enabled":false},"return_visitor":{"action":"show","custom_content":""},"slide_in":{"display_in":"bottom_right","trigger":"timer","scroll_percentage":null,"timer":5,"devices":"all","show_once_every":15},"sticky_bar":{"display_in":"top","trigger":"timer","scroll_percentage":null,"timer":5,"devices":"all","show_once_every":15}},"version":"5"}`}
      >
        <div data-element="fields" data-stacked="false" class="cta-fields">
          <div class="cta-field">
            <label class="visually-hidden" for={`article-newsletter-${formId}`}>Email</label>
            <input
              id={`article-newsletter-${formId}`}
              class="cta-input"
              name="email_address"
              aria-label="輸入你的 Email"
              placeholder="輸入你的 Email"
              required
              type="email"
              inputmode="email"
              autocomplete="email"
            />
          </div>
          <button data-element="submit" class="cta-submit" type="submit">
            <span>免費訂閱</span>
          </button>
        </div>
        <ul class="formkit-alert formkit-alert-error" data-element="errors" data-group="alert" aria-live="polite" aria-atomic="true"></ul>
      </form>
    </div>
  </div>
</aside>

<style>
  .newsletter-cta {
    max-width: 820px;
    margin: 3rem auto;
    padding: 2rem 2.5rem;
    background: var(--accent-subtle, #f5f3ff);
    border: 1px solid var(--accent-border, #e9e5f5);
    border-radius: var(--radius-md);
  }

  .newsletter-cta-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .newsletter-cta-text {
    flex: 1;
    min-width: 0;
  }

  .newsletter-cta-heading {
    font-family: 'Noto Serif TC', serif;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary, #1a1a2e);
    margin: 0 0 0.4rem;
    line-height: 1.4;
  }

  .newsletter-cta-desc {
    font-size: 0.9rem;
    color: var(--text-secondary, #64748b);
    margin: 0;
    line-height: 1.6;
  }

  .newsletter-cta-form {
    flex-shrink: 0;
    width: 100%;
    max-width: 360px;
  }

  /* ConvertKit form resets inside this component */
  .newsletter-cta-form :global(.formkit-form) {
    background: transparent !important;
    padding: 0 !important;
  }

  .cta-fields {
    display: flex;
    gap: 0.5rem;
    align-items: stretch;
  }

  .cta-field {
    flex: 1;
  }

  .cta-input {
    width: 100%;
    padding: 0.75rem 1rem;
    background: var(--bg, #fff);
    border: 1px solid var(--border, #e2e8f0);
    border-radius: var(--radius-sm);
    color: var(--text-primary, #1a1a2e);
    font-size: 0.9rem;
    font-family: inherit;
    box-sizing: border-box;
  }

  .cta-input:focus {
    outline: none;
    border-color: var(--accent, #6d28d9);
    box-shadow: 0 0 0 3px rgba(109, 40, 217, 0.08);
  }

  .cta-input::placeholder {
    color: var(--text-muted, #94a3b8);
  }

  .cta-submit {
    background: var(--accent, #6d28d9);
    border: none;
    border-radius: var(--radius-sm);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    font-family: inherit;
    padding: 0.75rem 1.25rem;
    cursor: pointer;
    transition: opacity 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .cta-submit:hover {
    opacity: 0.85;
  }

  .newsletter-cta-form :global(.formkit-alert-error) {
    background: rgba(242, 100, 59, 0.1);
    border: 1px solid #f2643b;
    color: #f2643b;
    border-radius: 6px;
    padding: 0.5rem 0.75rem;
    margin-top: 0.5rem;
    font-size: 0.85rem;
    list-style: none;
  }

  .newsletter-cta-form :global(.formkit-alert-success) {
    background: rgba(16, 191, 122, 0.1);
    border: 1px solid #10bf7a;
    color: #10bf7a;
    border-radius: 6px;
    padding: 0.5rem 0.75rem;
    margin-top: 0.5rem;
    font-size: 0.85rem;
    text-align: center;
  }

  .newsletter-cta-form :global(.formkit-powered-by-convertkit-container) {
    display: none !important;
  }

  @media (max-width: 768px) {
    .newsletter-cta {
      padding: 1.5rem;
      margin: 2rem 0;
    }

    .newsletter-cta-inner {
      flex-direction: column;
      gap: 1.25rem;
      align-items: flex-start;
    }

    .newsletter-cta-form {
      max-width: 100%;
      width: 100%;
    }

    .cta-fields {
      flex-direction: column;
    }

    .cta-submit {
      width: 100%;
    }
  }
</style>
