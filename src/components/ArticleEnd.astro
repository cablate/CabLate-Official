---
/**
 * ArticleEnd - 文章結尾唯一的行動區：電子報為主，作者與企業內訓各一行
 */

import KitForm from './common/KitForm.astro';
import { siteConfig } from '../config/siteConfig';

interface Props {
  category?: string;
  tags?: string[];
}

const { category = '', tags = [] } = Astro.props;
const topicBlob = `${category} ${tags.join(' ')}`.toLowerCase();
const isClaudeOrHarness =
  topicBlob.includes('claude') ||
  topicBlob.includes('harness') ||
  topicBlob.includes('sdk') ||
  topicBlob.includes('context');
const courseLabel = isClaudeOrHarness
  ? '看 Claude Code 深度工程手冊（免費試看）'
  : '看 AgentSkill 課程與 Claude Code 手冊';
---

<section class="article-end" aria-labelledby="article-end-title">
  <div class="article-end__box">
    <div class="article-end__newsletter">
      <h2 id="article-end-title">下一個 AI 卡點，寫好先寄給你</h2>
      <p>{siteConfig.newsletter.promise}{siteConfig.newsletter.cadence}</p>
      <KitForm />
      <p class="article-end__fine">隨時一鍵退訂・<a href="/privacy/">資料怎麼用</a></p>
    </div>

    <div class="article-end__routes" aria-label="這篇之後可以做的事">
      <a class="article-end__route-pill" href="/expertise/">免費 5 層健檢：拿手上的任務自己測 →</a>
      <a class="article-end__route-pill" href="/courses/">{courseLabel} →</a>
      <a class="article-end__route-pill" href="/services/consulting/">60 分鐘專案卡關諮詢 →</a>
    </div>

    <div class="article-end__author">
      <img src="/images/photos/cablate-portrait-real-v1.webp" alt="Cab（CabLate）作者照片" width="1400" height="1400" loading="lazy" decoding="async" />
      <p>寫這篇的是 Cab，在第一線教 AI 落地，從農會推廣人員教到外商工程團隊。<a href="/about/">我的經歷</a>・團隊想導入，看<a href="/services/enterprise/" data-analytics-placement="article_end">企業內訓</a>。</p>
    </div>
  </div>
</section>

<style>
  .article-end {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .article-end__box {
    display: grid;
    gap: 1.15rem;
    padding: 1.35rem 1.5rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--surface-subtle);
  }

  .article-end__newsletter {
    display: grid;
    gap: 0.65rem;
  }

  .article-end h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1.15rem, 2.2vw, 1.32rem);
    font-weight: 700;
    line-height: 1.4;
  }

  .article-end__newsletter > p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.94rem;
    line-height: 1.68;
  }

  .article-end .article-end__fine {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .article-end__routes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--border);
  }

  .article-end .article-end__route-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.42rem 0.85rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-strong);
    background: var(--surface-elevated);
    color: var(--text-primary);
    font-size: 0.84rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
  }

  .article-end .article-end__route-pill:hover {
    border-color: var(--accent);
    color: var(--accent-text);
    transform: translateY(-1px);
  }

  .article-end__author {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.85rem;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .article-end__author img {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: 35% center;
  }

  .article-end__author p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .article-end a {
    color: var(--accent-text);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  @media (max-width: 640px) {
    .article-end__box {
      padding: 1.15rem 1.1rem;
    }
  }
</style>
