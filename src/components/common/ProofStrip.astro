---
import { proofPoints } from '../../config/authority';

interface Props {
  tone?: 'paper' | 'plain';
  label?: string;
  class?: string;
}

const { tone = 'paper', label = '目前的數字', class: className } = Astro.props;
---

<section class:list={['proof-strip', `proof-strip--${tone}`, className]} aria-label={label}>
  <ul>
    {proofPoints.map((point) => (
      <li>
        <strong>{point.value}<span>{point.unit}</span></strong>
        <p>{point.label}</p>
        <small>截至 {point.asOf}</small>
      </li>
    ))}
  </ul>
</section>

<style>
  .proof-strip ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .proof-strip li {
    display: grid;
    align-content: start;
    gap: .35rem;
    padding: 1.25rem 1.4rem;
    border-left: 1px solid var(--border);
  }
  .proof-strip li:first-child { border-left: 0; }
  .proof-strip strong {
    color: var(--text-primary);
    font-family: var(--font-serif);
    font-size: clamp(1.7rem, 2.6vw, 2.3rem);
    font-weight: 700;
    letter-spacing: -.03em;
    line-height: 1.05;
  }
  .proof-strip strong span {
    margin-left: .2rem;
    color: var(--accent-text);
    font-family: var(--font-sans);
    font-size: .9rem;
    font-weight: 600;
    letter-spacing: 0;
  }
  .proof-strip p {
    margin: 0;
    color: var(--text-secondary);
    font-size: .88rem;
    line-height: 1.55;
  }
  .proof-strip small {
    color: var(--text-muted);
    font-size: .72rem;
  }
  .proof-strip--paper {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-soft);
    box-shadow: var(--shadow-sm);
  }
  .proof-strip--plain {
    border-block: 1px solid var(--border);
  }

  @media (max-width: 760px) {
    .proof-strip ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .proof-strip li { padding: 1rem; }
    .proof-strip li:nth-child(odd) { border-left: 0; }
    .proof-strip li:nth-child(n + 3) { border-top: 1px solid var(--border); }
  }
</style>
