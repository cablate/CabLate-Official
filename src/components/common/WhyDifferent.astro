---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const problems = [
  ['練的不是自己的工作', '上課用講師準備的範例，回到自己的表單、客戶和公司規定，就接不上了。'],
  ['程度差很多，卻上同一堂', '主管、工程師、行政坐在一起，有人覺得太快，有人覺得太慢。'],
  ['下課就沒人可以問', '卡住通常發生在回去第一次自己做的時候。'],
] as const;

const differences = [
  {
    title: '用你們自己的工作當練習題',
    body: '課前先收需求，示範和練習照你們的工作設計。工程團隊那場，課前收了 31 筆需求。',
    figure: '31',
    unit: '筆課前需求',
  },
  {
    title: '每個人都動手',
    body: '課堂用我自己開發的互動系統 Synora，每個人現場交作業，我現場講評。',
    figure: '1,050',
    unit: '次課堂提交（協會兩日班）',
  },
  {
    title: '下課前要做出東西',
    body: '目標是帶得走的成果。課後回收作品和心得，給你們下一步的建議。',
    figure: '23',
    unit: '個網站，兩天做出來',
  },
] as const;
---

<section class:list={['why-different', className]} aria-labelledby="why-different-title">
  <div class="why-different__problems">
    <p class="why-different__label">常見的情況</p>
    <h2 id="why-different-title">很多 AI 課上完，<br />隔週就沒人在用了</h2>
    <ol>
      {problems.map(([title, body]) => <li><strong>{title}</strong><span>{body}</span></li>)}
    </ol>
  </div>
  <div class="why-different__answer">
    <p class="why-different__label">我的課不一樣的地方</p>
    <ul>
      {differences.map((item) => (
        <li>
          <div class="why-different__figure"><strong>{item.figure}</strong><span>{item.unit}</span></div>
          <div><h3>{item.title}</h3><p>{item.body}</p></div>
        </li>
      ))}
    </ul>
    <p class="why-different__note">每一場都是我本人設計、本人上課，不轉包、不換人。</p>
  </div>
</section>

<style>
  .why-different {
    display: grid;
    grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr);
    gap: clamp(1.5rem, 3.5vw, 3rem);
    align-items: start;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }
  .why-different__label { margin: 0 0 .65rem; color: var(--accent-text); font-family: var(--font-mono); font-size: .76rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .why-different__problems { padding: clamp(1.75rem, 3vw, 2.35rem); border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface-subtle); }
  .why-different__problems h2 { margin: 0 0 1.4rem; color: var(--text-primary); font-family: var(--font-serif); font-size: clamp(1.5rem, 2.4vw, 1.95rem); letter-spacing: -.025em; line-height: 1.28; }
  .why-different__problems ol { display: grid; gap: 1.1rem; margin: 0; padding: 0; list-style: none; counter-reset: why; }
  .why-different__problems li { display: grid; gap: .3rem; padding-left: 2.25rem; position: relative; counter-increment: why; }
  .why-different__problems li::before { content: counter(why); position: absolute; left: 0; top: .12rem; display: grid; place-items: center; width: 1.55rem; height: 1.55rem; border: 1px solid var(--accent-border); border-radius: 50%; background: var(--surface-elevated); color: var(--accent-text); font-family: var(--font-mono); font-size: .74rem; font-weight: 700; }
  .why-different__problems strong { color: var(--text-primary); font-size: 1rem; }
  .why-different__problems span { color: var(--text-secondary); font-size: .92rem; line-height: 1.68; }
  .why-different__answer { padding: clamp(0.5rem, 1.5vw, 1rem) 0; }
  .why-different__answer ul { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
  .why-different__answer li { display: grid; grid-template-columns: 8.5rem minmax(0, 1fr); gap: 1.35rem; align-items: start; padding: 1.2rem 0; border-top: 1px solid var(--border); }
  .why-different__answer li:first-child { border-top: 0; padding-top: .2rem; }
  .why-different__figure { display: grid; gap: .2rem; }
  .why-different__figure strong { color: var(--accent-text); font-family: var(--font-serif); font-size: clamp(1.65rem, 2.3vw, 2.05rem); line-height: 1.05; letter-spacing: -.025em; }
  .why-different__figure span { color: var(--text-secondary); font-size: .8rem; line-height: 1.45; }
  .why-different__answer h3 { margin: 0 0 .35rem; color: var(--text-primary); font-size: 1.08rem; line-height: 1.45; }
  .why-different__answer p { margin: 0; color: var(--text-secondary); font-size: .94rem; line-height: 1.72; }
  .why-different__answer .why-different__note { margin-top: 1.15rem; padding-top: 1rem; border-top: 1px solid var(--border); color: var(--text-primary); font-size: .9rem; font-weight: 700; }

  @media (max-width: 1060px) {
    .why-different { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .why-different__answer li { grid-template-columns: 1fr; gap: .4rem; }
  }
</style>
