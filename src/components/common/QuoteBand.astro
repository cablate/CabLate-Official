---
import { threadsQuotes } from '../../config/authority';
import { siteConfig } from '../../config/siteConfig';

interface Props {
  title?: string;
  lead?: string;
  pick?: number[];
  tone?: 'dark' | 'light';
  class?: string;
}

const { title = '我在 Threads 上常講的話', lead = '幾句原文，沒有修過。', pick = [0, 2, 3], tone = 'dark', class: className } = Astro.props;
const quotes = pick.map((index) => threadsQuotes[index]).filter(Boolean);
const postUrl = (id: string) => `${siteConfig.threadsUrl}/post/${id}`;
---

<section class:list={['quote-band', `quote-band--${tone}`, className]} aria-labelledby="quote-band-title">
  <header class="quote-band__header">
    <h2 id="quote-band-title">{title}</h2>
    <p>{lead}</p>
  </header>
  <ul class="quote-band__list">
    {quotes.map((quote) => (
      <li>
        <blockquote>{quote.text}</blockquote>
        <a href={postUrl(quote.postId)} target="_blank" rel="noopener">@cab_late・{quote.date}</a>
      </li>
    ))}
  </ul>
</section>

<style>
  .quote-band {
    display: grid;
    gap: 1.35rem;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--text-primary);
  }
  .quote-band__header { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .5rem 1.5rem; }
  .quote-band__header h2 { margin: 0; color: var(--text-primary); font-family: var(--font-serif); font-size: clamp(1.45rem, 2.3vw, 1.9rem); letter-spacing: -.025em; }
  .quote-band__header p { margin: 0; color: var(--text-muted); font-size: .88rem; }
  .quote-band__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.15rem; margin: 0; padding: 0; list-style: none; }
  .quote-band__list li { display: grid; align-content: space-between; gap: 1.1rem; padding: 1.5rem; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface-elevated); box-shadow: var(--shadow-sm); }
  .quote-band blockquote { position: relative; margin: 0; padding-top: 1.2rem; color: var(--text-primary); font-family: var(--font-sans); font-size: .98rem; font-weight: 600; line-height: 1.7; text-wrap: pretty; }
  .quote-band blockquote::before { content: '“'; position: absolute; top: -.45rem; left: -.05rem; color: var(--accent); font-family: var(--font-serif); font-size: 2.2rem; line-height: 1; }
  .quote-band a { color: var(--text-muted); font-family: var(--font-mono); font-size: .76rem; text-decoration: none; transition: color var(--transition-fast); }
  .quote-band a:hover { color: var(--accent-text); }

  .quote-band--light { border: 0; background: transparent; color: var(--text-primary); }
  .quote-band--light .quote-band__header h2, .quote-band--light blockquote { color: var(--text-primary); }
  .quote-band--light .quote-band__header p, .quote-band--light a { color: var(--text-muted); }
  .quote-band--light .quote-band__list li { border-color: var(--border); background: var(--surface-elevated); }
  .quote-band--light blockquote::before { color: var(--accent); }

  @media (max-width: 960px) {
    .quote-band__list { grid-template-columns: 1fr; }
  }
</style>
