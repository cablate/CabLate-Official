---
/**
 * Kit Form Component - 全站唯一的電子報訂閱表單
 *
 * ck.5.js 只依賴 form 上的 data-sv-form 與 data-element 屬性，不注入樣式，
 * 所以版面全部用自有的 .kit-form 類別，不覆寫 Kit 的 formkit-* 類別。
 * 成功訊息由 ck.5.js 動態插入 .formkit-alert-success。
 */

import { siteConfig } from '../../config/siteConfig';

interface Props {
  submitLabel?: string;
}

const { submitLabel = '免費訂閱' } = Astro.props;
const { formId, uid } = siteConfig.convertKit;
const inputId = `kit-email-${formId}`;
const options = JSON.stringify({
  settings: {
    after_subscribe: { action: 'message', success_message: siteConfig.newsletter.successMessage, redirect_url: '' },
    analytics: { google: null, fathom: null, facebook: null, segment: null, pinterest: null, sparkloop: null, googletagmanager: null },
    modal: { trigger: 'timer', scroll_percentage: null, timer: 5, devices: 'all', show_once_every: 15 },
    powered_by: { show: false, url: '' },
    recaptcha: { enabled: false },
    return_visitor: { action: 'show', custom_content: '' },
    slide_in: { display_in: 'bottom_right', trigger: 'timer', scroll_percentage: null, timer: 5, devices: 'all', show_once_every: 15 },
    sticky_bar: { display_in: 'top', trigger: 'timer', scroll_percentage: null, timer: 5, devices: 'all', show_once_every: 15 },
  },
  version: '5',
});
---

<div class="kit-form">
  <script is:inline defer src="https://f.convertkit.com/ckjs/ck.5.js"></script>
  <form
    action={`https://app.kit.com/forms/${formId}/subscriptions`}
    class="seva-form formkit-form kit-form__form"
    method="post"
    data-sv-form={formId}
    data-uid={uid}
    data-format="inline"
    data-version="5"
    data-options={options}
  >
    <div data-element="fields" class="kit-form__fields">
      <label class="kit-form__label" for={inputId}>電子信箱</label>
      <input
        id={inputId}
        class="kit-form__input"
        name="email_address"
        placeholder="you@example.com"
        required
        type="email"
        inputmode="email"
        autocomplete="email"
        enterkeyhint="send"
      />
      <button data-element="submit" class="kit-form__submit btn btn-primary" type="submit">
        <span>{submitLabel}</span>
      </button>
    </div>
    <ul class="kit-form__errors" data-element="errors" data-group="alert" aria-live="polite" aria-atomic="true"></ul>
  </form>
</div>

<style>
  .kit-form {
    container-type: inline-size;
    width: 100%;
  }

  .kit-form__fields {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: .4rem .65rem;
  }

  .kit-form__label {
    color: var(--text-secondary);
    font-size: .78rem;
    font-weight: 700;
    text-align: left;
  }

  .kit-form__input {
    width: 100%;
    min-height: 3.1rem;
    padding: .8rem 1rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: #fff;
    box-shadow: inset 0 1px 2px rgb(0 0 0 / .04);
    color: var(--text-primary);
    font: inherit;
    font-size: 1rem;
  }

  .kit-form__input::placeholder {
    color: var(--text-muted);
    opacity: .8;
  }

  .kit-form__input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-color: var(--accent-text);
  }

  .kit-form__submit {
    position: relative;
    width: 100%;
    min-height: 3.1rem;
    white-space: nowrap;
  }

  .kit-form__submit span {
    position: relative;
    z-index: 1;
  }

  @container (min-width: 26rem) {
    .kit-form__fields {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .kit-form__label {
      grid-column: 1 / -1;
    }

    .kit-form__submit {
      width: auto;
    }
  }

  .kit-form__errors:empty {
    display: none;
  }

  .kit-form__errors,
  .kit-form :global(.formkit-alert-success) {
    margin: .75rem 0 0;
    padding: .6rem .8rem;
    border: 1px solid;
    border-radius: var(--radius-sm);
    font-size: .88rem;
    line-height: 1.6;
    list-style: none;
  }

  .kit-form__errors {
    border-color: var(--status-error-border);
    background: var(--status-error-bg);
    color: var(--status-error);
  }

  .kit-form :global(.formkit-alert-success) {
    border-color: var(--status-success-border);
    background: var(--status-success-bg);
    color: var(--status-success);
    text-align: center;
  }
</style>
