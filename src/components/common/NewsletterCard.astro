---
/**
 * NewsletterCard - /newsletter/ 與 /subscribe/ 共用的訂閱卡片
 */

import { Check } from '@lucide/astro';
import KitForm from './KitForm.astro';

const takeaways = [
  '我實際遇到的 AI 卡點，和我怎麼判斷',
  '哪裡容易出錯，什麼時候乾脆不要用 AI',
  '新課程、講座開放時，先寄給你',
];
---

<section class="newsletter-card paper-card paper-card--clip" aria-labelledby="newsletter-card-title">
  <div class="paper-card__inner newsletter-card__inner">
    <h1 id="newsletter-card-title">每封信，拆一個 AI 卡點</h1>
    <ul class="newsletter-card__takeaways" aria-label="你會收到">
      {takeaways.map((item) => <li><Check size={16} aria-hidden="true" />{item}</li>)}
    </ul>
    <KitForm />
    <p class="newsletter-card__reassurance">有值得寫的才寄・隨時一鍵退訂・<a href="/privacy/">資料怎麼用</a></p>
  </div>
</section>

<style>
  .newsletter-card {
    width: min(100%, 36rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-elevated);
    background-image: none;
    box-shadow: var(--shadow-md);
    filter: none;
  }

  .newsletter-card__inner {
    display: grid;
    gap: 1.4rem;
    padding: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 4vw, 2.75rem);
    text-align: center;
  }

  .newsletter-card h1 {
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 2.8vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -.025em;
    line-height: 1.25;
    text-wrap: balance;
  }

  .newsletter-card__takeaways {
    display: grid;
    gap: .5rem;
    width: fit-content;
    margin: 0 auto;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  .newsletter-card__takeaways li {
    display: flex;
    align-items: flex-start;
    gap: .5rem;
    color: var(--text-secondary);
    font-size: .95rem;
    line-height: 1.65;
  }

  .newsletter-card__takeaways :global(svg) {
    flex: none;
    margin-top: .3rem;
    color: var(--accent-text);
  }

  .newsletter-card__reassurance {
    margin: 0;
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: .82rem;
    font-weight: 500;
  }

  .newsletter-card__reassurance a {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: .2em;
  }
</style>
