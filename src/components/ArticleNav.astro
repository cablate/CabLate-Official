---
/**
 * ArticleNav - 上一篇 / 下一篇文章導航
 * 依 publishDate 降序排列，找出目前文章的前後篇
 */

import { getCollection } from 'astro:content';

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;

const allArticles = await getCollection('articles');
const sorted = allArticles
  .filter(a => !a.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const currentIndex = sorted.findIndex(a => a.slug === currentSlug);

// 排序是降序：index 較小 = 較新，index 較大 = 較舊
// 「上一篇」= 較舊的文章（index + 1），「下一篇」= 較新的文章（index - 1）
const prevArticle = currentIndex < sorted.length - 1 ? sorted[currentIndex + 1] : null;
const nextArticle = currentIndex > 0 ? sorted[currentIndex - 1] : null;
---

{(prevArticle || nextArticle) && (
  <nav class="article-nav" aria-label="文章導航">
    <div class="article-nav-inner">
      {prevArticle ? (
        <a href={`/articles/${prevArticle.slug}/`} class="article-nav-item article-nav-prev">
          <span class="article-nav-label">&larr; 上一篇</span>
          <span class="article-nav-title">{prevArticle.data.title}</span>
        </a>
      ) : (
        <div class="article-nav-item article-nav-placeholder"></div>
      )}
      {nextArticle ? (
        <a href={`/articles/${nextArticle.slug}/`} class="article-nav-item article-nav-next">
          <span class="article-nav-label">下一篇 &rarr;</span>
          <span class="article-nav-title">{nextArticle.data.title}</span>
        </a>
      ) : (
        <div class="article-nav-item article-nav-placeholder"></div>
      )}
    </div>
  </nav>
)}

<style>
  .article-nav {
    max-width: 820px;
    margin: 3rem auto 0;
    padding: 0 1rem;
  }

  .article-nav-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    border-top: 1px solid var(--border, #e2e8f0);
    padding-top: 2rem;
  }

  .article-nav-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.25rem 1.5rem;
    background: var(--bg-muted, #f1f5f9);
    border-radius: 10px;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease;
    border: 1px solid transparent;
  }

  .article-nav-item:hover {
    background: var(--accent-subtle, #f5f3ff);
    border-color: var(--accent-border, #ede9fe);
  }

  .article-nav-placeholder {
    background: transparent;
  }

  .article-nav-prev {
    align-items: flex-start;
  }

  .article-nav-next {
    align-items: flex-end;
    text-align: right;
  }

  .article-nav-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent, #8b5cf6);
  }

  .article-nav-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary, #1e293b);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .article-nav {
      padding: 0 0.75rem;
    }

    .article-nav-inner {
      grid-template-columns: 1fr;
      padding-top: 1.5rem;
    }

    .article-nav-next {
      align-items: flex-start;
      text-align: left;
    }

    .article-nav-item {
      padding: 1rem 1.25rem;
    }

    .article-nav-title {
      font-size: 0.9rem;
    }
  }
</style>
