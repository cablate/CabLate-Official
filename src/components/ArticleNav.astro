---
/**
 * ArticleNav - 上一篇 / 下一篇文章導航
 * 依 publishDate 降序排列，找出目前文章的前後篇
 */

import { getCollection } from 'astro:content';

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;

const allArticles = await getCollection('articles');
const sorted = allArticles
  .filter(a => !a.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const currentArticle = sorted.find(a => a.id === currentSlug);
const currentTags = new Set(currentArticle?.data.tags ?? []);
const currentCategory = currentArticle?.data.category ?? '';

const related = sorted
  .filter(a => a.id !== currentSlug)
  .map(a => {
    const sharedTags = (a.data.tags ?? []).filter(t => currentTags.has(t)).length;
    const sameCategory = a.data.category === currentCategory ? 1 : 0;
    return {
      entry: a,
      score: sharedTags * 10 + sameCategory * 3,
    };
  })
  .sort((a, b) => b.score - a.score || b.entry.data.publishDate.valueOf() - a.entry.data.publishDate.valueOf());

const prevArticle = related[0]?.entry ?? null;
const nextArticle = related[1]?.entry ?? null;
---

{(prevArticle || nextArticle) && (
  <nav class="article-nav" aria-label="延伸拆解文章">
    <div class="article-nav-inner">
      {prevArticle ? (
        <a href={`/articles/${prevArticle.id}/`} class="article-nav-item article-nav-prev">
          <span class="article-nav-label">延伸拆解 · {prevArticle.data.category}</span>
          <span class="article-nav-title">{prevArticle.data.title}</span>
        </a>
      ) : (
        <div class="article-nav-item article-nav-placeholder"></div>
      )}
      {nextArticle ? (
        <a href={`/articles/${nextArticle.id}/`} class="article-nav-item article-nav-next">
          <span class="article-nav-label">延伸拆解 · {nextArticle.data.category}</span>
          <span class="article-nav-title">{nextArticle.data.title}</span>
        </a>
      ) : (
        <div class="article-nav-item article-nav-placeholder"></div>
      )}
    </div>
  </nav>
)}

<style>
  .article-nav {
    margin-top: 1.25rem;
  }

  .article-nav-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
  }

  .article-nav-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.95rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-soft);
    text-decoration: none;
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .article-nav-item:hover {
    border-color: var(--accent-text);
    background: var(--surface-subtle);
  }

  .article-nav-placeholder {
    border-color: transparent;
    background: transparent;
  }

  .article-nav-prev {
    align-items: flex-start;
  }

  .article-nav-next {
    align-items: flex-end;
    text-align: right;
  }

  .article-nav-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .article-nav-title {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .article-nav-inner {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }

    .article-nav-placeholder {
      display: none;
    }

    .article-nav-next {
      align-items: flex-start;
      text-align: left;
    }

    .article-nav-item {
      padding: 0.85rem 1rem;
    }
  }
</style>
