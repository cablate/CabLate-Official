---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ArrowRight, Check, MoveRight } from '@lucide/astro';
import '../styles/service-pages.css';

const paths = [
  {
    kind: '先把卡點看清楚',
    title: 'AI 專案卡關諮詢',
    description: '適合已經投入時間，卻還是不知道哪裡出問題的人。用 90 分鐘把真正卡點、取捨與下一步找出來。',
    outcomes: ['一句核心判斷', '目前最主要的卡點', '優先三步與先不做什麼', '一頁行動卡與後續檢查點'],
    href: '/services/consulting/',
    action: '查看諮詢方式',
    primary: true,
  },
  {
    kind: '拿真實工作一起做',
    title: 'AI 實作陪跑',
    description: '適合想直接改善自己工作的人。五週一對一合作，依你的目標、工具、能力與每週進度客製進行。',
    outcomes: ['開始前排出這一期的重點', '每週一起判斷、實作與調整', '合作期間遇到問題可以直接問', '依實際需求留下能繼續使用的做法或資產'],
    href: '/services/coaching/',
    action: '查看陪跑方式',
    primary: false,
  },
];

const process = [
  ['先看情境', '先理解你想完成什麼、目前怎麼做，以及哪裡最常失敗。'],
  ['選對合作方式', '確認需要一次諮詢、五週客製陪跑、企業合作，或目前其實不需要合作。'],
  ['把條件說清楚', '適合時才確認這次要處理的重點、雙方責任、費用、時段與合作邊界。'],
  ['開始合作', '每一步都回到真實工作與目前進度，不用固定套餐硬套。'],
];

const organizationPaths = [
  {
    kind: '給團隊與組織',
    title: '企業診斷、工作坊與導入',
    description: '先看團隊的真實工作與重複問題，再判斷需要的是現況診斷、工作坊，還是小規模導入。',
    detail: '不會先拿固定課程時數套用；先知道哪些人、哪一段工作需要改。',
    href: '/services/enterprise/',
    action: '查看企業合作方式',
  },
  {
    kind: '給主辦方、平台與品牌',
    title: '講師、內容與產品合作',
    description: '演講、工作坊、內容共創與產品合作都可以提出。先提供受眾、形式、時程、預算與使用方式。',
    detail: '不同合作需要的準備、修改與使用權都不同，開始前會逐一說清楚。',
    href: '/services/partnerships/',
    action: '查看邀約合作方式',
  },
];
---

<BaseLayout title="專案諮詢、實作陪跑與企業合作" description="依你的情況選擇 90 分鐘 AI 專案卡關諮詢、五週一對一客製實作陪跑、企業合作，或講師與內容合作。" analytics="disabled">
  <article class="service-page paper-page">
    <header class="service-shell service-hero page-paper paper-card">
      <div class="service-hero__copy">
        <p class="section-label">合作方式</p>
        <h1 class="display-heading">你現在卡在哪裡，決定我們該怎麼合作。</h1>
        <p class="service-lead">想先找出問題，可以約一次專案諮詢；想拿自己的工作一起改，可以申請五週陪跑。團隊導入、演講、工作坊與內容合作，也都有各自的入口。</p>
        <div class="service-actions">
          <a class="btn btn-primary" href="/services/consulting/">先看卡關諮詢 <ArrowRight size={18} aria-hidden="true" /></a>
          <a class="service-text-link" href="/services/coaching/">想一起做？看實作陪跑 <MoveRight size={17} aria-hidden="true" /></a>
        </div>
        <p class="service-fine-print">不確定可以先從最接近的頁面開始。提交資料不代表合作成立；不適合時會直接說明。</p>
      </div>
      <figure class="service-hero__visual">
        <img src="/images/photos/cablate-speaking-ai-meetup-april.webp" alt="Cab 在 AI 聚會中說明實作方法" width="1920" height="1080" loading="eager" fetchpriority="high" />
        <figcaption>先看真實工作與限制，再決定該用什麼方法。</figcaption>
      </figure>
    </header>

    <section class="service-shell service-section page-paper paper-card" aria-labelledby="choose-title">
      <header class="service-section__intro">
        <h2 id="choose-title">想先找答案，和想一起做，適合的方式不一樣。</h2>
        <p>專案諮詢用 90 分鐘把問題與下一步找出來。實作陪跑則是五週客製合作，依你的真實工作每週調整，不照固定課綱走。</p>
      </header>

      <div class="service-paths">
        {paths.map((path) => (
          <article class:list={['service-path', path.primary && 'service-path--primary']}>
            <p>{path.kind}</p>
            <h3>{path.title}</h3>
            <p>{path.description}</p>
            <h4>你會帶走</h4>
            <ul>
              {path.outcomes.map((outcome) => <li><Check size={17} aria-hidden="true" />{outcome}</li>)}
            </ul>
            <a class:list={['btn', path.primary ? 'btn-primary' : 'btn-ghost']} href={path.href}>{path.action} <ArrowRight size={17} aria-hidden="true" /></a>
          </article>
        ))}
      </div>
    </section>

    <section class="service-shell service-section service-process page-paper paper-card" aria-labelledby="process-title">
      <header class="service-section__intro service-section__intro--compact">
        <h2 id="process-title">先看你的情況，再談方案。</h2>
      </header>
      <ol>
        {process.map(([title, body], index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div><h3>{title}</h3><p>{body}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <section class="service-shell service-section service-organization page-paper paper-card" aria-labelledby="organization-title">
      <header class="service-section__intro service-section__intro--stacked">
        <p class="section-label">團隊與邀約合作</p>
        <h2 id="organization-title">團隊導入與合作邀約，也可以直接從這裡開始。</h2>
        <p>企業先說明哪些人、哪一段工作遇到問題；主辦方、平台與品牌則提供受眾、形式、時程、預算與使用方式。資訊越清楚，越快知道下一步。</p>
      </header>
      <div class="service-organization__routes">
        {organizationPaths.map((path) => (
          <article>
            <p>{path.kind}</p>
            <h3>{path.title}</h3>
            <p>{path.description}</p>
            <strong>{path.detail}</strong>
            <a class="service-route-link" href={path.href}>{path.action} <ArrowRight size={17} aria-hidden="true" /></a>
          </article>
        ))}
      </div>
    </section>

    <section class="service-shell service-section service-principle page-paper paper-card" aria-labelledby="principle-title">
      <div>
        <h2 id="principle-title">客製合作，也要把責任與邊界說清楚。</h2>
      </div>
      <ul>
        <li><strong>開始前先對齊。</strong>確認這次的目標、優先順序、雙方責任，以及怎麼看進度。</li>
        <li><strong>重要判斷要留得下來。</strong>關鍵取捨、限制與下一步不只停在會議裡。</li>
        <li><strong>方法跟著問題走。</strong>不需要 Agent、自動化或新工具時，會直接說明。</li>
        <li><strong>新需求要重新排順序。</strong>客製不代表所有事情都能無限加入同一段合作。</li>
      </ul>
    </section>

  </article>
</BaseLayout>
