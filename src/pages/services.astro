---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ArrowRight, Check, MoveRight } from '@lucide/astro';
import { siteConfig } from '../config/siteConfig';
import '../styles/service-pages.css';

const collaborationMailto = `mailto:${siteConfig.contactEmail}?subject=${encodeURIComponent('其他合作情境')}&body=${encodeURIComponent(`合作形式：
預期受眾：
希望完成的結果：
預計時程：
預算範圍：`)}`;

const paths = [
  {
    kind: '先做一次判斷',
    title: 'AI 專案卡關諮詢',
    description: '適合已經投入時間，卻還看不出真正瓶頸的人。先把根因、取捨與下一步判斷清楚。',
    outcomes: ['一句核心診斷', '現況與主要卡點地圖', '優先三步與不做清單', '一頁行動卡與回顧節點'],
    href: '/services/consulting/',
    action: '查看諮詢方式',
    primary: true,
  },
  {
    kind: '一起完成一個範圍',
    title: '有界實作陪跑',
    description: '適合問題已經清楚，但需要有人一起拆工作包、做取捨、驗收，直到留下可交接成果的人。',
    outcomes: ['一個明確的合作成果', '可逐一驗收的工作包', '過程中的決策與修正紀錄', '結案交接包與剩餘風險'],
    href: '/services/coaching/',
    action: '查看陪跑方式',
    primary: false,
  },
];

const process = [
  ['先看情境', '先理解你想完成什麼、目前怎麼做，以及哪裡最常失敗。'],
  ['判斷適配', '確認這次需要的是一次諮詢、有界陪跑，或其實不需要合作。'],
  ['確認範圍', '適合時才確認產物、責任、費用、時段與停止條件。'],
  ['留下成果', '用一開始定義的真實案例驗收，並記下限制與下一步。'],
];
---

<BaseLayout title="AI 專案諮詢與實作陪跑" description="先用一次 AI 專案卡關諮詢找出真正瓶頸；問題已經清楚時，再用有界實作陪跑完成一個可驗收、可交接的工作流成果。" analytics="disabled">
  <article class="service-page paper-page">
    <header class="service-shell service-hero page-paper paper-card">
      <div class="service-hero__copy">
        <p class="section-label">合作方式</p>
        <h1 class="display-heading">先把問題看清楚，再決定要不要一起做。</h1>
        <p class="service-lead">你不需要先知道該買哪種顧問服務。先看你的問題是「不知道該怎麼判斷」，還是「已經知道要做什麼，但需要一起完成」。</p>
        <div class="service-actions">
          <a class="btn btn-primary" href="/services/consulting/">先看卡關諮詢 <ArrowRight size={18} aria-hidden="true" /></a>
          <a class="service-text-link" href="/services/coaching/">問題已經清楚？看實作陪跑 <MoveRight size={17} aria-hidden="true" /></a>
        </div>
        <p class="service-fine-print">不確定也沒關係。提交情境不代表一定合作；不適合時會直接說明。</p>
      </div>
      <figure class="service-hero__visual">
        <img src="/images/photos/cablate-speaking-ai-meetup-april.webp" alt="Cab 在 AI 聚會中說明實作方法" width="1920" height="1080" loading="eager" fetchpriority="high" />
        <figcaption>從真實案例、限制與完成條件開始，不先假設答案一定是 Agent。</figcaption>
      </figure>
    </header>

    <section class="service-shell service-section page-paper paper-card" aria-labelledby="choose-title">
      <header class="service-section__intro">
        <p class="section-label">先選現在需要的結果</p>
        <h2 id="choose-title">一次判斷，和一段共同實作，是兩種不同的合作。</h2>
        <p>諮詢先把問題縮小；陪跑只處理已經能說清楚的成果。這樣你不會為一個還沒看懂的問題，直接買下長期合作。</p>
      </header>

      <div class="service-paths">
        {paths.map((path) => (
          <article class:list={['service-path', path.primary && 'service-path--primary']}>
            <p>{path.kind}</p>
            <h3>{path.title}</h3>
            <p>{path.description}</p>
            <h4>你會帶走</h4>
            <ul>
              {path.outcomes.map((outcome) => <li><Check size={17} aria-hidden="true" />{outcome}</li>)}
            </ul>
            <a class:list={['btn', path.primary ? 'btn-primary' : 'btn-ghost']} href={path.href}>{path.action} <ArrowRight size={17} aria-hidden="true" /></a>
          </article>
        ))}
      </div>
    </section>

    <section class="service-shell service-section service-process page-paper paper-card" aria-labelledby="process-title">
      <header class="service-section__intro service-section__intro--compact">
        <p class="section-label">怎麼開始</p>
        <h2 id="process-title">不從套餐開始，先從你的真實情境開始。</h2>
      </header>
      <ol>
        {process.map(([title, body], index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div><h3>{title}</h3><p>{body}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <section class="service-shell service-section service-principle page-paper paper-card" aria-labelledby="principle-title">
      <div>
        <p class="section-label">合作原則</p>
        <h2 id="principle-title">你買的不是「隨時找 Cab」，而是一個能被驗收的結果。</h2>
      </div>
      <ul>
        <li><strong>先說完成條件。</strong>開始前先確認什麼結果算完成，避免邊做邊無限加項。</li>
        <li><strong>保留判斷證據。</strong>重要取捨、限制與驗收結果都會留下，不只停在會議裡。</li>
        <li><strong>不硬套熱門名詞。</strong>問題不需要 Agent、自動化或新工具時，會直接說明。</li>
        <li><strong>新需求重新定義。</strong>超出原範圍的工作，不會默認塞進同一個方案。</li>
      </ul>
    </section>

    <aside class="service-shell service-secondary page-paper paper-card" aria-labelledby="other-title">
      <div>
        <p class="section-label">其他合作</p>
        <h2 id="other-title">企業內訓、團隊導入、講師與內容合作</h2>
        <p>請直接說明受眾、想完成的結果、預計時程與預算範圍。我會先回覆是否適合，以及下一步需要補哪些資訊。</p>
      </div>
      <a class="btn btn-ghost" href={collaborationMailto}>說明其他合作情境 <ArrowRight size={17} aria-hidden="true" /></a>
    </aside>
  </article>
</BaseLayout>
