---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProofStrip from '../components/common/ProofStrip.astro';
import { ArrowRight, Check, MoveRight } from '@lucide/astro';
import '../styles/service-pages.css';

const paths = [
  {
    kind: '卡住了，想先看清楚',
    title: '專案卡關諮詢',
    price: 'NT$5,000',
    format: '一次 60 分鐘，線上',
    description: '你已經做了一陣子，卻說不出到底卡在哪。我們一起把問題攤開，排出接下來先做什麼、什麼先不做。',
    outcomes: ['一句話講清楚這次的核心問題', '現在最該處理的那個卡點', '接下來三件事，和暫時不做的事', '一頁行動卡，回去照著做'],
    href: '/services/consulting/',
    action: '看諮詢怎麼進行',
    primary: true,
  },
  {
    kind: '手上有件事，想真的做出來',
    title: 'AI 應用陪跑',
    price: 'NT$39,800',
    format: '五週，每週一次一對一',
    description: '拿你正在做的工作、內容或產品來，我陪你一起拆、一起做、一起檢查。AI 用得上就用，用不上就不硬塞。',
    outcomes: ['第一次見面就找出最值得處理的卡點', '確認 AI 能幫哪一段', '直接用你的東西一起做、一起測', '五週後知道要繼續、縮小，還是換方法'],
    href: '/services/coaching/',
    action: '看五週陪跑怎麼進行',
    primary: false,
  },
  {
    kind: '一整個團隊要用 AI',
    title: '企業內訓與導入',
    price: '依範圍報價',
    format: '診斷、工作坊、小規模試點',
    description: '先看團隊實際怎麼工作、哪裡一直重做，再決定要上課、改流程，還是先挑一段工作試做。',
    outcomes: ['課前訪談，看清楚誰要學什麼', '用你們自己的工作當練習題', '工作坊現場就做出第一版', '課後留下改善建議'],
    href: '/services/enterprise/',
    action: '看企業合作方式',
    primary: false,
  },
];

const promises = [
  ['開始前講好', '這次要處理什麼、誰負責哪段、費用和時間、哪些不包含，都先寫下來。'],
  ['不適合就直說', '你的題目如果不需要 AI，或現在不值得做，我會直接講。填表不代表一定要成交。'],
  ['不為了用 AI 而用 AI', 'Agent、自動化、新工具不是答案的時候，我會說。'],
  ['臨時加需求可以，但要重排', '不會默默把所有事情都塞進同一期。'],
];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://cablate.com/' },
    { '@type': 'ListItem', position: 2, name: '合作方式', item: 'https://cablate.com/services/' },
  ],
};

const servicesItemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'CabLate 合作方式',
  itemListElement: paths.map((path, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: path.title,
    description: path.description,
    url: `https://cablate.com${path.href}`,
  })),
};
---

<BaseLayout title="AI 顧問諮詢、五週應用陪跑與企業內訓合作" description="60 分鐘專案卡關諮詢 NT$5,000、五週一對一 AI 應用陪跑 NT$39,800，以及企業 AI 內訓、工作坊與團隊導入。先看你卡在哪一段，再選最適合的合作方式。" image="/og/pages/services.png" imageAlt="CabLate 合作方式：諮詢、陪跑、企業內訓。" imageWidth={1200} imageHeight={630}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(servicesItemListJsonLd)} />
  <article class="service-page paper-page">
    <header class="service-shell service-hero page-paper paper-card">
      <div class="service-hero__copy">
        <p class="section-label">合作方式</p>
        <h1 class="display-heading"><span class="heading-phrase">AI 用到卡住了？</span><span class="heading-phrase">先看卡在哪。</span></h1>
        <p class="service-lead">只想弄清楚問題，約一次 60 分鐘諮詢。想把手上的事做出來，五週陪跑。整個團隊要導入，走企業合作。</p>
        <div class="service-actions">
          <a class="btn btn-primary" href="#choose-title" data-analytics-placement="services_hero_primary">比較三種方式 <ArrowRight size={18} aria-hidden="true" /></a>
          <a class="service-text-link" href="/services/partnerships/" data-analytics-placement="services_hero_secondary">要邀請演講或合作？ <MoveRight size={17} aria-hidden="true" /></a>
        </div>
        <p class="service-fine-print">不確定選哪個也沒關係，挑最接近的填就好，我會親自看過再回你。</p>
      </div>
      <figure class="service-hero__visual">
        <img src="/images/photos/cablate-speaking-ai-meetup-april.webp" alt="Cab 在 AI 聚會上分享實作方法" width="2000" height="1333" loading="eager" fetchpriority="high" />
        <figcaption>從你正在做的事開始，AI 只用在真的幫得上忙的地方。</figcaption>
      </figure>
    </header>

    <ProofStrip label="一些數字" class="service-shell service-proof" />

    <section class="service-shell service-section page-paper paper-card" aria-labelledby="choose-title">
      <header class="service-section__intro service-section__intro--stacked">
        <h2 id="choose-title">三種合作方式，價格都寫在這</h2>
        <p>做過諮詢、14 天內決定加入陪跑的話，諮詢費可以全額折抵。</p>
      </header>

      <div class="service-paths service-paths--three">
        {paths.map((path) => (
          <article class:list={['service-path', path.primary && 'service-path--primary']}>
            <p>{path.kind}</p>
            <h3>{path.title}</h3>
            <div class="service-path__price">
              <strong>{path.price}</strong>
              <span>{path.format}</span>
            </div>
            <p>{path.description}</p>
            <h4>你會帶走</h4>
            <ul>
              {path.outcomes.map((outcome) => <li><Check size={17} aria-hidden="true" />{outcome}</li>)}
            </ul>
            <a class:list={['btn', path.primary ? 'btn-primary' : 'btn-ghost']} href={path.href} data-analytics-placement="services_path_card">{path.action} <ArrowRight size={17} aria-hidden="true" /></a>
          </article>
        ))}
      </div>
    </section>

    <section class="service-shell service-section service-principle page-paper paper-card" aria-labelledby="principle-title">
      <div>
        <h2 id="principle-title">不管選哪一種，這幾件事都一樣</h2>
      </div>
      <ul>
        {promises.map(([title, body]) => <li><strong>{title}。</strong>{body}</li>)}
      </ul>
    </section>

    <section class="service-shell service-final-cta page-paper paper-card" aria-labelledby="services-partner-title">
      <div>
        <p class="section-label">主辦方、平台、品牌</p>
        <h2 id="services-partner-title">想邀請演講或合作？</h2>
        <p>把受眾、形式、時間、預算和內容會怎麼使用告訴我，我通常很快就能回覆能不能接、怎麼做。</p>
      </div>
      <a class="btn btn-primary" href="/services/partnerships/" data-analytics-placement="services_organization_card">看講師與內容合作 <ArrowRight size={18} aria-hidden="true" /></a>
    </section>
  </article>
</BaseLayout>
