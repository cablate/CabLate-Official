---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/siteConfig';
import { CheckCircle } from '@lucide/astro';
import KitForm from '../components/common/KitForm.astro';
---

<BaseLayout title="Claude Code 實戰上手包｜開放通知" description="先了解成本、Context 與權限邊界，再開始第一個 Claude Code 工作流程。留下 Email，完成訂閱確認後接收上手包開放通知。">

<section class="lp-hero">
    <div class="lp-hero-inner">
        <h1 class="lp-title">Claude Code 實戰上手包</h1>
        <p class="lp-subtitle">先了解成本、Context 與權限邊界，再開始第一個 Claude Code 工作流程。</p>
    </div>
</section>

<section class="lp-section">
    <div class="lp-inner">
        <!-- 痛點 -->
        <div class="lp-pain">
            <h2 class="lp-section-title">裝好 Claude Code，然後呢？</h2>
            <p class="lp-pain-text">
                很多人裝好工具後就急著下指令，卻還沒弄清楚 AI 會讀到哪些資料、成本從哪裡產生，以及哪些操作需要先確認。
            </p>
        </div>

        <!-- 內容預覽 -->
        <div class="lp-preview">
            <h2 class="lp-section-title">上手包開放後，會先幫你處理四個問題</h2>
            <ul class="lp-checklist">
                <li>
                    <span class="lp-check"><CheckCircle size={20} /></span>
                    <span><strong>核心指南</strong>：了解基本運作方式、MCP／Skill／Agent 各自負責什麼、成本從哪裡來，以及第一個流程怎麼開始</span>
                </li>
                <li>
                    <span class="lp-check"><CheckCircle size={20} /></span>
                    <span><strong>CLAUDE.md 起始範例</strong>：提供可依專案調整的骨架，並說明哪些內容不適合直接照抄</span>
                </li>
                <li>
                    <span class="lp-check"><CheckCircle size={20} /></span>
                    <span><strong>常見錯誤與成本檢查表</strong>：開始工作前，先檢查容易忽略的設定與花費</span>
                </li>
                <li>
                    <span class="lp-check"><CheckCircle size={20} /></span>
                    <span><strong>安全與權限常見問答</strong>：知道哪些操作可以放心交給 AI，哪些情況應該先停下來確認</span>
                </li>
            </ul>
        </div>

        <div class="lp-fit-grid">
            <section>
                <h2 class="lp-section-title">適合你，如果你</h2>
                <ul><li>已經裝好 Claude Code，卻不知道第一個工作流程怎麼開始。</li><li>想先理解 Context、Skill 與成本，而不是背一堆指令。</li><li>需要一份遇到問題時可以回來檢查的入門指南。</li></ul>
            </section>
            <section>
                <h2 class="lp-section-title">不適合你，如果你</h2>
                <ul><li>期待拿到一包提示詞，就讓 AI 自動完成所有工作。</li><li>目前需要的是進階 Memory、Hooks、多 Agent 或 Harness 設計。</li><li>正在處理企業導入或特定產品問題，更需要個別情境診斷。</li></ul>
            </section>
        </div>

        <!-- 社會證明 -->
        <div class="lp-proof">
            <div class="lp-proof-items">
                <div class="lp-proof-item">
                    <span class="lp-proof-number">{siteConfig.lectureFeedbackScore}/5</span>
                    <span class="lp-proof-label">講座回饋（{siteConfig.lectureFeedbackCount} 筆，截至 2026-05）</span>
                </div>
                <div class="lp-proof-divider"></div>
                <div class="lp-proof-item">
                    <span class="lp-proof-label">VibeCoding 四週課與金流串接實作課皆已完成交付（截至 2026-06）</span>
                </div>
            </div>
        </div>

        <!-- 上手包開放通知 -->
        <div class="lp-form-area" id="download">
            <h2 class="lp-section-title">上手包開放通知</h2>
            <p class="lp-form-hint">留下 Email 並完成訂閱確認。上手包開放時，我會寄送通知，也會不定期分享相關入門內容。</p>
            <KitForm />
            <p class="lp-form-note">送出後，你會訂閱 CabLate 電子報並收到確認信；可隨時退訂。詳見<a href="/privacy/">隱私權政策</a>。</p>
        </div>

        <!-- 收尾 -->
        <div class="lp-closing">
            <p class="lp-closing-text">先用免費內容找到起點；需要完整方法、進階診斷或個別情境協助時，再考慮課程、手冊或合作服務。</p>
        </div>
    </div>
</section>

</BaseLayout>

<style>
    .lp-hero {
        padding: 1rem 0;
        text-align: center;
        background: transparent;
    }

    .lp-hero-inner {
        max-width: 640px;
        margin: 0 auto;
    }

    .lp-title {
        font-family: 'Noto Serif TC', serif;
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 0.75rem;
    }

    .lp-subtitle {
        font-size: 1.1rem;
        color: var(--text-secondary);
        line-height: 1.7;
    }

    .lp-section {
        padding: 0 0 1rem;
        background: transparent;
    }

    .lp-inner {
        max-width: 640px;
        margin: 0 auto;
    }

    .lp-section-title {
        font-family: 'Noto Serif TC', serif;
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 1rem;
    }

    /* 痛點 */
    .lp-pain {
        margin-bottom: 3rem;
        padding: 2rem;
        background: var(--bg-soft);
        border-radius: var(--radius-md);
        border: 1px solid var(--border);
    }

    .lp-pain-text {
        font-size: 1rem;
        color: var(--text-secondary);
        line-height: 1.7;
    }

    /* 內容預覽 */
    .lp-preview {
        margin-bottom: 3rem;
    }

    .lp-fit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 3rem; }
    .lp-fit-grid section { padding: 1.5rem; border: 1px solid var(--border); border-radius: var(--radius-md); }
    .lp-fit-grid ul { margin: 0; padding-left: 1.15rem; color: var(--text-secondary); font-size: .85rem; line-height: 1.75; }

    .lp-checklist {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .lp-checklist li {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        font-size: 0.95rem;
        color: var(--text-primary);
        line-height: 1.6;
        padding: 0.75rem 1rem;
        background: var(--bg-soft);
        border-radius: var(--radius-sm);
        border: 1px solid var(--border-light);
    }

    .lp-check {
        color: var(--accent);
        flex-shrink: 0;
        margin-top: 0.1rem;
    }

    /* 社會證明 */
    .lp-proof {
        margin-bottom: 3rem;
        padding: 1.5rem 2rem;
        background: var(--bg-soft);
        border-radius: var(--radius-md);
        border: 1px solid var(--border);
    }

    .lp-proof-items {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    .lp-proof-item {
        text-align: center;
    }

    .lp-proof-number {
        display: block;
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--accent);
        margin-bottom: 0.25rem;
    }

    .lp-proof-label {
        font-size: 0.85rem;
        color: var(--text-secondary);
    }

    .lp-proof-divider {
        width: 1px;
        height: 2rem;
        background: var(--border);
    }

    /* 表單區 */
    .lp-form-area {
        margin-bottom: 3rem;
        text-align: center;
    }

    .lp-form-hint {
        font-size: 0.95rem;
        color: var(--text-secondary);
        margin-bottom: 1.5rem;
    }

    .lp-form-note {
        margin-top: 1rem;
        font-size: 0.9rem;
        color: var(--text-muted);
    }

    .lp-form-note a { color: var(--accent); text-decoration: underline; text-underline-offset: .2em; }

    /* 收尾 */
    .lp-closing {
        text-align: center;
        padding: 2rem 0;
    }

    .lp-closing-text {
        font-size: 1.05rem;
        color: var(--text-secondary);
        font-style: italic;
    }

    @media (max-width: 600px) {
        .lp-hero {
            padding: 1rem 0;
        }

        .lp-section {
            padding: 0 0 1rem;
        }

        .lp-pain,
        .lp-proof {
            padding: 1.5rem;
        }

        .lp-proof-items {
            flex-direction: column;
            gap: 1rem;
        }
        .lp-fit-grid { grid-template-columns: 1fr; }

        .lp-proof-divider {
            width: 2rem;
            height: 1px;
        }
    }
</style>
