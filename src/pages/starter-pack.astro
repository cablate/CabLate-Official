---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/siteConfig';
import { CheckCircle } from '@lucide/astro';
---

<BaseLayout title="Claude Code 實戰上手包（免費）" description="一個工程師用了半年的省錢秘訣和避坑指南。核心指南、CLAUDE.md 模板、踩坑卡、安全 Q&A——輸入 Email 免費下載。">

<section class="lp-hero">
    <div class="lp-hero-inner">
        <h1 class="lp-title">Claude Code 實戰上手包</h1>
        <p class="lp-subtitle">一個工程師用了半年的省錢秘訣和避坑指南</p>
    </div>
</section>

<section class="lp-section">
    <div class="lp-inner">
        <!-- 痛點 -->
        <div class="lp-pain">
            <h2 class="lp-section-title">裝好 Claude Code，然後呢？</h2>
            <p class="lp-pain-text">
                大多數人還沒開口，錢就開始燒了——因為跳過了一個 10 分鐘的設定。
            </p>
        </div>

        <!-- 內容預覽 -->
        <div class="lp-preview">
            <h2 class="lp-section-title">你會拿到什麼</h2>
            <ul class="lp-checklist">
                <li>
                    <span class="lp-check"><CheckCircle size={20} /></span>
                    <span><strong>核心指南</strong>：運作機制 / MCP・Skill・Agent 秒懂 / 錢花在哪裡 / 不知道做什麼照這走</span>
                </li>
                <li>
                    <span class="lp-check"><CheckCircle size={20} /></span>
                    <span><strong>CLAUDE.md 模板</strong>：複製貼上就能用</span>
                </li>
                <li>
                    <span class="lp-check"><CheckCircle size={20} /></span>
                    <span><strong>踩坑卡 + 省錢 Checklist</strong></span>
                </li>
                <li>
                    <span class="lp-check"><CheckCircle size={20} /></span>
                    <span><strong>安全 Q&A</strong></span>
                </li>
            </ul>
        </div>

        <!-- 社會證明 -->
        <div class="lp-proof">
            <div class="lp-proof-items">
                <div class="lp-proof-item">
                    <span class="lp-proof-number">{siteConfig.lectureFeedbackScore}/5</span>
                    <span class="lp-proof-label">AgentSkill 講座（{siteConfig.lectureFeedbackCount} 筆回饋）</span>
                </div>
                <div class="lp-proof-divider"></div>
                <div class="lp-proof-item">
                    <span class="lp-proof-label">VibeCoding 線上課 ｜ 金流課程</span>
                </div>
            </div>
        </div>

        <!-- Kit 表單預留位 -->
        <div class="lp-form-area" id="download">
            <h2 class="lp-section-title">免費下載</h2>
            <p class="lp-form-hint">輸入 Email，立即寄送到你的信箱。</p>
            <div class="lp-form-placeholder">
                <!-- Kit embed form 預留位 -->
                <!-- 從 Kit 後台取得嵌入碼後，替換此區塊 -->
                <p class="lp-form-note">📮 表單載入中⋯⋯（Kit embed 預留位）</p>
            </div>
        </div>

        <!-- 收尾 -->
        <div class="lp-closing">
            <p class="lp-closing-text">你不寫程式也能用。三種人，三條路徑。</p>
        </div>
    </div>
</section>

</BaseLayout>

<style>
    .lp-hero {
        padding: 8rem 2rem 3rem;
        text-align: center;
        background: var(--bg);
    }

    .lp-hero-inner {
        max-width: 640px;
        margin: 0 auto;
    }

    .lp-title {
        font-family: 'Noto Serif TC', serif;
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 0.75rem;
    }

    .lp-subtitle {
        font-size: 1.1rem;
        color: var(--text-secondary);
        line-height: 1.7;
    }

    .lp-section {
        padding: 0 2rem 4rem;
        background: var(--bg);
    }

    .lp-inner {
        max-width: 640px;
        margin: 0 auto;
    }

    .lp-section-title {
        font-family: 'Noto Serif TC', serif;
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 1rem;
    }

    /* 痛點 */
    .lp-pain {
        margin-bottom: 3rem;
        padding: 2rem;
        background: var(--bg-soft);
        border-radius: 14px;
        border: 1px solid var(--border);
    }

    .lp-pain-text {
        font-size: 1rem;
        color: var(--text-secondary);
        line-height: 1.7;
    }

    /* 內容預覽 */
    .lp-preview {
        margin-bottom: 3rem;
    }

    .lp-checklist {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .lp-checklist li {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        font-size: 0.95rem;
        color: var(--text-primary);
        line-height: 1.6;
        padding: 0.75rem 1rem;
        background: var(--bg-soft);
        border-radius: 10px;
        border: 1px solid var(--border-light);
    }

    .lp-check {
        color: var(--accent);
        flex-shrink: 0;
        margin-top: 0.1rem;
    }

    /* 社會證明 */
    .lp-proof {
        margin-bottom: 3rem;
        padding: 1.5rem 2rem;
        background: var(--bg-soft);
        border-radius: 14px;
        border: 1px solid var(--border);
    }

    .lp-proof-items {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    .lp-proof-item {
        text-align: center;
    }

    .lp-proof-number {
        display: block;
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--accent);
        margin-bottom: 0.25rem;
    }

    .lp-proof-label {
        font-size: 0.85rem;
        color: var(--text-secondary);
    }

    .lp-proof-divider {
        width: 1px;
        height: 2rem;
        background: var(--border);
    }

    /* 表單區 */
    .lp-form-area {
        margin-bottom: 3rem;
        text-align: center;
    }

    .lp-form-hint {
        font-size: 0.95rem;
        color: var(--text-secondary);
        margin-bottom: 1.5rem;
    }

    .lp-form-placeholder {
        padding: 2rem;
        background: var(--bg-soft);
        border: 2px dashed var(--border);
        border-radius: 14px;
    }

    .lp-form-note {
        font-size: 0.9rem;
        color: var(--text-muted);
    }

    /* 收尾 */
    .lp-closing {
        text-align: center;
        padding: 2rem 0;
    }

    .lp-closing-text {
        font-size: 1.05rem;
        color: var(--text-secondary);
        font-style: italic;
    }

    @media (max-width: 600px) {
        .lp-hero {
            padding: 7rem 1.5rem 2rem;
        }

        .lp-section {
            padding: 0 1.5rem 3rem;
        }

        .lp-pain,
        .lp-proof {
            padding: 1.5rem;
        }

        .lp-proof-items {
            flex-direction: column;
            gap: 1rem;
        }

        .lp-proof-divider {
            width: 2rem;
            height: 1px;
        }
    }
</style>
