---
/**
 * Tag Archive Page - 標籤文章列表
 */

import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleArchiveCard from '../../../components/articles/ArticleArchiveCard.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  const published = articles.filter(entry => !entry.data.draft);

  // 取得所有不重複的標籤
  const tagSet = new Set<string>();
  published.forEach(entry => entry.data.tags.forEach(tag => tagSet.add(tag)));
  const tags = [...tagSet];

  return tags.map(tag => ({
    params: { tag },
    props: {
      tag,
      articles: published
        .filter(entry => entry.data.tags.includes(tag))
        .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()),
    },
  }));
}

const { tag, articles } = Astro.props;

// 結構化資料
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://cablate.com/' },
    { '@type': 'ListItem', position: 2, name: '文章', item: 'https://cablate.com/articles/' },
    { '@type': 'ListItem', position: 3, name: `標籤：${tag}`, item: `https://cablate.com/articles/tag/${tag}/` },
  ]
};
---

<BaseLayout
  title={`標籤：${tag} | 文章`}
  description={`CabLate 關於「${tag}」的文章，共 ${articles.length} 篇`}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <div class="archive-page paper-page">
    <section class="archive-shell page-paper paper-card paper-card--clip">
      <header class="archive-hero">
        <div class="archive-hero__topline">
          <p class="section-label">標籤索引</p>
          <span>TAG INDEX / {String(articles.length).padStart(2, '0')}</span>
        </div>
        <h1>#{tag}</h1>
        <p class="archive-hero__intro">這裡收集所有帶有「#{tag}」標籤的研究與實作筆記。先從摘要判斷哪篇最接近你現在的問題。</p>
      </header>

      <section class="archive-section" aria-labelledby="tag-articles-title">
        <header class="archive-section__header">
          <p class="section-label">{articles.length} 篇文章</p>
          <h2 id="tag-articles-title">從一篇具體紀錄開始，再沿著相關標籤繼續。</h2>
        </header>
        <div class="archive-list">
          {articles.map((entry: CollectionEntry<'articles'>, index: number) => (
            <ArticleArchiveCard entry={entry} index={index} activeTag={tag} />
          ))}
        </div>
        {articles.length === 0 && <p class="archive-empty">目前沒有「#{tag}」相關文章。</p>}
      </section>

      <nav class="archive-back-links" aria-label="文章索引導覽">
        <a class="text-link" href="/articles/">回到文章索引</a>
        <a class="text-link" href="/articles/tags/">瀏覽全部標籤</a>
      </nav>
    </div>
  </div>
</BaseLayout>
