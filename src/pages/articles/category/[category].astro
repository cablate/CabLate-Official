---
/**
 * Category Page - 分類文章列表
 * 為 Topic Cluster 建立分類入口頁
 */

import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleArchiveCard from '../../../components/articles/ArticleArchiveCard.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  const published = articles.filter(entry => !entry.data.draft);

  // 取得所有不重複的分類
  const categories = [...new Set(published.map(entry => entry.data.category))];

  return categories.map(category => ({
    params: { category },
    props: {
      category,
      articles: published
        .filter(entry => entry.data.category === category)
        .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()),
    },
  }));
}

const { category, articles } = Astro.props;

// BreadcrumbList 結構化資料
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://cablate.com/' },
    { '@type': 'ListItem', position: 2, name: '文章', item: 'https://cablate.com/articles/' },
    { '@type': 'ListItem', position: 3, name: category, item: `https://cablate.com/articles/category/${encodeURIComponent(category)}/` }
  ]
};
---

<BaseLayout
  title={`${category} | 文章分類`}
  description={`CabLate 的 ${category} 相關文章，共 ${articles.length} 篇`}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <div class="archive-page paper-page">
    <section class="archive-shell page-paper paper-card paper-card--clip">
      <header class="archive-hero">
        <div class="archive-hero__topline">
          <p class="section-label">主題索引</p>
          <span>CATEGORY INDEX / {String(articles.length).padStart(2, '0')}</span>
        </div>
        <h1>{category}</h1>
        <p class="archive-hero__intro">以下文章都屬於「{category}」。先看摘要，再挑一篇開始。</p>
      </header>

      <section class="archive-section" aria-labelledby="category-articles-title">
        <header class="archive-section__header">
          <p class="section-label">{articles.length} 篇文章</p>
          <h2 id="category-articles-title">從一個具體問題，開始沿著這個主題讀下去。</h2>
        </header>
        <div class="archive-list">
          {articles.map((entry: CollectionEntry<'articles'>, index: number) => (
            <ArticleArchiveCard entry={entry} index={index} />
          ))}
        </div>
        {articles.length === 0 && <p class="archive-empty">這個主題目前還沒有公開文章。</p>}
      </section>

      <nav class="archive-back-links" aria-label="文章索引導覽">
        <a class="text-link" href="/articles/">回到文章索引</a>
        <a class="text-link" href="/articles/tags/">瀏覽全部標籤</a>
      </nav>
    </div>
  </div>
</BaseLayout>
