---
/**
 * Tags Index Page - 標籤總覽
 */

import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

// 取得所有已發布文章，統計標籤
const allArticles = await getCollection('articles');
const published = allArticles.filter(entry => !entry.data.draft);

// 統計每個標籤的文章數量
const tagCountMap = new Map<string, number>();
published.forEach(entry => {
  entry.data.tags.forEach(tag => {
    tagCountMap.set(tag, (tagCountMap.get(tag) ?? 0) + 1);
  });
});

// 依數量降序排列
const tags = [...tagCountMap.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([tag, count]) => ({ tag, count }));

// 結構化資料
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://cablate.com/' },
    { '@type': 'ListItem', position: 2, name: '文章', item: 'https://cablate.com/articles/' },
    { '@type': 'ListItem', position: 3, name: '標籤', item: 'https://cablate.com/articles/tags/' },
  ]
};
---

<BaseLayout
  title="文章標籤"
  description={`瀏覽 CabLate 所有文章標籤，共 ${tags.length} 個標籤、${published.length} 篇文章`}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <div class="archive-page paper-page">
    <section class="archive-shell page-paper paper-card paper-card--clip">
      <header class="archive-hero">
        <div class="archive-hero__topline">
          <p class="section-label">標籤索引</p>
          <span>ALL TAGS / {String(tags.length).padStart(2, '0')}</span>
        </div>
        <h1>沿著標籤繼續讀。</h1>
        <p class="archive-hero__intro">標籤是延伸入口，不是另一個首頁。先從問題索引找到起點，再用這份目錄把相關研究串起來。</p>
      </header>

      <section class="archive-section" aria-labelledby="tags-title">
        <header class="archive-section__header">
          <p class="section-label">{tags.length} 個標籤・{published.length} 篇文章</p>
          <h2 id="tags-title">選一個主題，看看它曾經在哪些問題裡出現。</h2>
        </header>
        {tags.length > 0 ? (
          <div class="archive-tag-list">
            {tags.map(({ tag, count }) => (
              <a href={`/articles/tag/${tag}/`}>
                <span>{String(count).padStart(2, '0')}</span>
                <strong>#{tag}</strong>
                <span aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        ) : (
          <p class="archive-empty">目前沒有任何標籤。</p>
        )}
      </section>

      <nav class="archive-back-links" aria-label="文章索引導覽">
        <a class="text-link" href="/articles/">回到文章索引</a>
      </nav>
    </div>
  </div>
</BaseLayout>
