---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ArrowRight } from '@lucide/astro';
import { formatDate } from '../../utils/format';
import { personEntity } from '../../config/authority';

const allArticles = await getCollection('articles');
const publishedArticles = allArticles
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://cablate.com/' },
    { '@type': 'ListItem', position: 2, name: '文章', item: 'https://cablate.com/articles/' },
  ],
};

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '文章｜CabLate',
  description: 'CabLate 關於 Harness Engineering、Context Engineering、Skill 設計、Claude Code、Agent 工作流程、Vibe Coding 與 AI 教學設計的研究和實作文章。',
  url: 'https://cablate.com/articles/',
  numberOfItems: publishedArticles.length,
  hasPart: publishedArticles.slice(0, 10).map((entry) => ({
    '@type': 'Article',
    headline: entry.data.title,
    url: `https://cablate.com/articles/${entry.slug}/`,
    datePublished: entry.data.publishDate.toISOString(),
    author: personEntity,
  })),
};

const pageDescription = `CabLate 關於 Harness Engineering、Context Engineering、Skill 設計、Claude Code、Agent 工作流程、Vibe Coding 與 AI 教學設計的研究和實作文章，共 ${publishedArticles.length} 篇。`;
---

<BaseLayout title="文章｜CabLate" description={pageDescription}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(collectionJsonLd)} />

  <div class="articles-page paper-page">
    <section class="articles-section page-paper">
      <div class="articles-container">
        <header class="articles-hero">
          <p class="articles-hero__eyebrow">文章 · 共 {publishedArticles.length} 篇</p>
          <h1>AI 工具實作與逆向筆記</h1>
          <p>記錄我用 Claude Code、Agent SDK 做事時實際卡住的地方，以及後來的拆解與做法。</p>
        </header>

        <div class="article-feed">
          {publishedArticles.map((entry) => (
            <a href={`/articles/${entry.slug}/`} class="article-item">
              <time datetime={entry.data.publishDate.toISOString()}>{formatDate(entry.data.publishDate)}</time>
              <h2>{entry.data.title}</h2>
              <p>{entry.data.description}</p>
            </a>
          ))}
        </div>

        {publishedArticles.length === 0 && <p class="empty-state">這裡還沒有公開文章。</p>}

        <footer class="articles-footer">
          <div>
            <strong>新文章寫好時，先寄到你信箱</strong>
            <p>每封信拆一個實際遇到的 AI 卡點，有值得寫的才寄。</p>
          </div>
          <a class="articles-footer__btn" href="/newsletter/">免費訂閱電子報 <ArrowRight size={15} aria-hidden="true" /></a>
        </footer>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .articles-page > .articles-section {
    background-color: var(--bg-soft) !important;
    background-image: none !important;
    border: 1px solid var(--border-strong) !important;
    border-radius: var(--radius-md) !important;
    box-shadow: var(--shadow-sm) !important;
    padding: clamp(1.5rem, 3.5vw, 2.75rem) clamp(1.25rem, 4vw, 3rem) !important;
  }

  .articles-container {
    max-width: 44rem;
    margin-inline: auto;
  }

  .articles-hero {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .articles-hero__eyebrow {
    margin: 0 0 0.55rem;
    color: var(--accent-text);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .articles-hero h1 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1.55rem, 2.6vw, 2rem);
    font-weight: 700;
    line-height: 1.32;
    letter-spacing: -0.015em;
    color: var(--text-primary);
  }

  .articles-hero > p:last-child {
    max-width: 40rem;
    margin: 0.5rem 0 0;
    color: var(--text-secondary);
    font-size: 0.96rem;
    line-height: 1.68;
  }

  .article-feed {
    display: grid;
  }

  .article-item {
    display: grid;
    gap: 0.3rem;
    padding: 1.1rem 0.25rem;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
  }

  .article-item time {
    color: var(--text-muted);
    font-size: 0.82rem;
    letter-spacing: 0.02em;
  }

  .article-item h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1.08rem, 1.65vw, 1.2rem);
    font-weight: 700;
    line-height: 1.42;
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  .article-item p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.93rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    line-clamp: 1;
    overflow: hidden;
  }

  .article-item:hover h2 {
    color: var(--accent-text);
  }

  .empty-state {
    padding: 3rem 1.5rem;
    color: var(--text-muted);
    text-align: center;
  }

  .articles-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin-top: 1.75rem;
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: #f7f4ec;
  }

  .articles-footer strong {
    display: block;
    font-size: 1rem;
    color: var(--text-primary);
  }

  .articles-footer p {
    margin: 0.2rem 0 0;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .articles-footer__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1.1rem;
    border-radius: var(--radius-sm);
    background: var(--surface-ink);
    color: #fff;
    font-size: 0.88rem;
    font-weight: 700;
    white-space: nowrap;
    transition: background-color var(--transition-fast);
  }

  .articles-footer__btn:hover {
    background: var(--accent-text);
  }

  @media (max-width: 640px) {
    .articles-page > .articles-section {
      padding: 1.25rem 1.1rem !important;
    }

    .article-item {
      padding: 1rem 0;
    }

    .articles-footer {
      padding: 1.1rem;
    }

    .articles-footer__btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
