---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ArrowRight } from '@lucide/astro';
import { formatDate } from '../../utils/format';
import { personEntity } from '../../config/authority';

const allArticles = await getCollection('articles');
const publishedArticles = allArticles
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const featuredArticle = publishedArticles[0];
const restArticles = publishedArticles.filter((entry) => entry.slug !== featuredArticle?.slug);

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://cablate.com/' },
    { '@type': 'ListItem', position: 2, name: '文章', item: 'https://cablate.com/articles/' },
  ],
};

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '文章｜CabLate',
  description: 'CabLate 關於 Harness Engineering、Context Engineering、Skill 設計、Claude Code、Agent 工作流程、Vibe Coding 與 AI 教學設計的研究和實作文章。',
  url: 'https://cablate.com/articles/',
  numberOfItems: publishedArticles.length,
  hasPart: publishedArticles.slice(0, 10).map((entry) => ({
    '@type': 'Article',
    headline: entry.data.title,
    url: `https://cablate.com/articles/${entry.slug}/`,
    datePublished: entry.data.publishDate.toISOString(),
    author: personEntity,
  })),
};

const pageDescription = `CabLate 關於 Harness Engineering、Context Engineering、Skill 設計、Claude Code、Agent 工作流程、Vibe Coding 與 AI 教學設計的研究和實作文章，共 ${publishedArticles.length} 篇。`;
---

<BaseLayout title="文章｜CabLate" description={pageDescription}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(collectionJsonLd)} />

  <div class="articles-page paper-page">
    <section class="articles-section page-paper">
      <div class="articles-container">
        <header class="articles-hero">
          <p class="articles-hero__eyebrow">文章 · 共 {publishedArticles.length} 篇</p>
          <h1>AI 工具實作與逆向筆記</h1>
          <p>記錄我用 Claude Code、Agent SDK 做事時實際卡住的地方，以及後來的拆解與做法。</p>
        </header>

        {featuredArticle && (
          <a href={`/articles/${featuredArticle.slug}/`} class="featured-card">
            <div class="featured-card__meta">
              <span class="meta-category">{featuredArticle.data.category}</span>
              <time datetime={featuredArticle.data.publishDate.toISOString()}>{formatDate(featuredArticle.data.publishDate)}</time>
              {featuredArticle.data.readingTime && <span>{featuredArticle.data.readingTime} 分鐘閱讀</span>}
            </div>
            <h2>{featuredArticle.data.title}</h2>
            <p>{featuredArticle.data.description}</p>
            <span class="featured-card__cta">閱讀完整拆解 <ArrowRight size={16} aria-hidden="true" /></span>
          </a>
        )}

        <div class="article-feed">
          {restArticles.map((entry) => (
            <a href={`/articles/${entry.slug}/`} class="article-item">
              <div class="article-item__main">
                <div class="article-item__meta">
                  <span class="meta-category">{entry.data.category}</span>
                  <time datetime={entry.data.publishDate.toISOString()}>{formatDate(entry.data.publishDate)}</time>
                  {entry.data.readingTime && <span>{entry.data.readingTime} 分鐘閱讀</span>}
                </div>
                <h2>{entry.data.title}</h2>
                <p>{entry.data.description}</p>
              </div>
              <span class="article-item__arrow" aria-hidden="true">
                <ArrowRight size={18} />
              </span>
            </a>
          ))}
        </div>

        {publishedArticles.length === 0 && <p class="empty-state">這裡還沒有公開文章。</p>}

        <footer class="articles-footer">
          <div>
            <strong>新文章寫好時，先寄到你信箱</strong>
            <p>每封信拆一個實際遇到的 AI 卡點，有值得寫的才寄。</p>
          </div>
          <a class="articles-footer__btn" href="/newsletter/">免費訂閱電子報 <ArrowRight size={15} aria-hidden="true" /></a>
        </footer>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .articles-page > .articles-section {
    background-color: transparent !important;
    background-image: none !important;
    border: 0 !important;
    box-shadow: none !important;
    padding: 0 !important;
  }

  .articles-container {
    max-width: 46rem;
    margin-inline: auto;
  }

  .articles-hero {
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--border);
  }

  .articles-hero__eyebrow {
    margin: 0 0 0.55rem;
    color: var(--accent-text);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .articles-hero h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    font-weight: 700;
    line-height: 1.28;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .articles-hero > p:last-child {
    max-width: 40rem;
    margin: 0.65rem 0 0;
    color: var(--text-secondary);
    font-size: 0.98rem;
    line-height: 1.72;
  }

  .featured-card {
    display: block;
    margin-top: 2rem;
    padding: clamp(1.6rem, 3vw, 2.25rem);
    border: 1px solid var(--border-strong);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius-md);
    background: var(--surface-elevated);
    box-shadow: var(--shadow-md);
    text-decoration: none;
    transition: border-color var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .featured-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .article-item__meta,
  .featured-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.75rem;
    font-size: 0.84rem;
    color: var(--text-muted);
  }

  .meta-category {
    color: var(--accent-text);
    font-weight: 700;
  }

  .featured-card h2 {
    margin: 0.65rem 0 0.55rem;
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.1vw, 1.5rem);
    font-weight: 700;
    line-height: 1.38;
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  .featured-card:hover h2 {
    color: var(--accent-text);
  }

  .featured-card p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.96rem;
    line-height: 1.72;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  .featured-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.1rem;
    color: var(--accent-text);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .article-feed {
    margin-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .article-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.25rem;
    align-items: center;
    padding-block: 1.5rem;
    padding-inline: 0.25rem;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    transition: border-color var(--transition-fast);
  }

  .article-item__main {
    min-width: 0;
  }

  .article-item h2 {
    margin: 0.42rem 0 0.45rem;
    font-family: var(--font-sans);
    font-size: clamp(1.1rem, 1.7vw, 1.25rem);
    font-weight: 700;
    line-height: 1.42;
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  .article-item p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.94rem;
    line-height: 1.68;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  .article-item__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    color: var(--text-muted);
    transition: color var(--transition-fast), transform var(--transition-fast), background-color var(--transition-fast);
  }

  .article-item:hover h2 {
    color: var(--accent-text);
  }

  .article-item:hover .article-item__arrow {
    color: var(--accent-text);
    background: var(--accent-subtle);
    transform: translateX(3px);
  }

  .empty-state {
    padding: 3rem 1.5rem;
    color: var(--text-muted);
    text-align: center;
  }

  .articles-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin-top: 2.5rem;
    padding: 1.5rem 1.75rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--surface-elevated);
    box-shadow: var(--shadow-sm);
  }

  .articles-footer strong {
    display: block;
    font-size: 1.02rem;
    color: var(--text-primary);
  }

  .articles-footer p {
    margin: 0.25rem 0 0;
    font-size: 0.92rem;
    color: var(--text-secondary);
  }

  .articles-footer__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.65rem 1.2rem;
    border-radius: var(--radius-sm);
    background: var(--btn-primary-bg);
    color: #fff;
    font-size: 0.88rem;
    font-weight: 700;
    white-space: nowrap;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), background var(--transition-fast);
  }

  .articles-footer__btn:hover {
    background: var(--btn-primary-hover-bg);
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .articles-page > .articles-section {
      padding: 0 !important;
    }

    .featured-card {
      padding: 1.35rem 1.25rem;
    }

    .article-item {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
      padding-block: 1.25rem;
      padding-inline: 0;
    }

    .article-item__arrow {
      display: none;
    }

    .articles-footer {
      padding: 1.25rem;
    }

    .articles-footer__btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
