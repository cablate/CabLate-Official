---
/**
 * Newsletter Page - 站內導覽與頁尾的電子報入口
 * 與 /subscribe/ 共用 NewsletterCard；/subscribe/ 是站外分享用的無邊框版本。
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterCard from '../components/common/NewsletterCard.astro';
import { siteConfig } from '../config/siteConfig';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://cablate.com/' },
    { '@type': 'ListItem', position: 2, name: '電子報', item: 'https://cablate.com/newsletter/' },
  ],
};
---

<BaseLayout
  title="訂閱 Cab 的 AI 電子報｜每封拆解一個 AI 工作流與 Claude Code 卡點"
  description={`Cab 的電子報。${siteConfig.newsletter.promise}${siteConfig.newsletter.cadence}`}
  image="/og/pages/subscribe.png"
  imageAlt="訂閱 Cab 的電子報：每封拆一個 AI 卡點"
  imageWidth={1200}
  imageHeight={630}
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
  <div class="newsletter-page">
    <NewsletterCard />
  </div>
</BaseLayout>

<style>
  .newsletter-page {
    display: grid;
    place-items: center;
    min-height: calc(100vh - 14rem);
    padding: 2rem 1rem;
  }

  @media (max-width: 600px) {
    .newsletter-page {
      min-height: calc(100vh - 10rem);
      padding: 1.5rem .75rem 2.5rem;
    }
  }
</style>
