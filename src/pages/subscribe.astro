---
/**
 * Subscribe Landing Page - 站外分享用的無邊框訂閱頁
 * 站內導覽與頁尾走 /newsletter/；本頁 canonical 指回 /newsletter/。
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import NewsletterCard from '../components/common/NewsletterCard.astro';
import { ArrowLeft } from '@lucide/astro';
import { siteConfig } from '../config/siteConfig';

const pageTitle = '訂閱 Cab 的 AI 電子報｜每封拆解一個 AI 工作流與 Claude Code 卡點 | CabLate';
const pageDescription = `Cab 的電子報。${siteConfig.newsletter.promise}${siteConfig.newsletter.cadence}`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  shell="bare"
  noSEO={true}
>
  <SEO
    slot="head"
    title={pageTitle}
    description={pageDescription}
    image="/og/pages/subscribe.png"
    imageAlt="訂閱 Cab 的電子報：每封拆一個 AI 卡點"
    imageWidth={1200}
    imageHeight={630}
    canonicalPath="/newsletter/"
  />

  <div class="subscribe-wrapper">
    <nav class="subscribe-top-nav" aria-label="返回首頁">
      <a href="/" class="subscribe-back-btn">
        <ArrowLeft size={16} aria-hidden="true" />
        <span>CabLate</span>
      </a>
    </nav>
    <NewsletterCard />
  </div>
</BaseLayout>

<style>
  .subscribe-wrapper {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: 88vh;
    padding: 1.5rem 1rem 2rem;
  }

  .subscribe-top-nav {
    width: min(100%, 36rem);
    margin-bottom: 1.5rem;
  }

  .subscribe-back-btn {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .4rem .75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--bg-soft) 85%, transparent);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: .78rem;
    font-weight: 700;
    text-decoration: none;
    transition: color 180ms ease, background-color 180ms ease, border-color 180ms ease, transform 180ms ease;
  }

  .subscribe-back-btn:hover {
    border-color: var(--accent);
    background: var(--accent-subtle);
    color: var(--accent-text);
    transform: translateX(-2px);
  }

  @media (max-width: 600px) {
    .subscribe-wrapper {
      min-height: 82vh;
      padding: 1.5rem .75rem 2.5rem;
    }
  }
</style>
