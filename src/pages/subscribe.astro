---
/**
 * Subscribe Landing Page - 獨立 Email 訂閱專頁
 * 極簡聚焦：純粹的訂閱卡片
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import KitForm from '../components/common/KitForm.astro';
---

<BaseLayout
  title="訂閱 CabLate 的電子報"
  description="訂閱 CabLate 的電子報。"
  image="/og/pages/subscribe.png"
  imageAlt="訂閱 CabLate 的電子報"
  imageWidth={1200}
  imageHeight={630}
  noSEO={true}
>
  <SEO
    slot="head"
    title="訂閱 CabLate 的電子報"
    description="訂閱 CabLate 的電子報。"
    image="/og/pages/subscribe.png"
    imageAlt="訂閱 CabLate 的電子報"
    imageWidth={1200}
    imageHeight={630}
  />

  <main class="subscribe-page">
    <section class="subscribe-card paper-card" aria-labelledby="subscribe-title">
      <h1 id="subscribe-title">訂閱 CabLate 的電子報</h1>
      <div class="subscribe-form">
        <KitForm submitLabel="免費訂閱" successMessage="驗證信已送出！請到信箱點擊確認連結完成訂閱。" />
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .subscribe-page {
    min-height: calc(100vh - 16rem);
    display: grid;
    place-items: center;
    padding: clamp(2rem, 6vw, 4.5rem) 1rem;
    overflow-x: clip;
  }

  .subscribe-card {
    width: min(100%, 38rem);
    display: grid;
    gap: 1.75rem;
    padding: clamp(2.25rem, 5vw, 3.5rem) clamp(1.5rem, 4.5vw, 3rem);
    background: #fffdf8;
    background-image: var(--paper-white-image);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    box-shadow: 0 8px 30px rgb(58 48 38 / .08);
    text-align: center;
  }

  .subscribe-card h1 {
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-serif);
    font-size: clamp(1.85rem, 4vw, 2.65rem);
    font-weight: 700;
    letter-spacing: -.035em;
    line-height: 1.25;
    text-wrap: balance;
  }

  .subscribe-form {
    width: 100%;
    margin-top: .25rem;
  }

  @media (max-width: 600px) {
    .subscribe-page {
      min-height: calc(100vh - 12rem);
      padding-block: 2rem 3rem;
    }
    .subscribe-card {
      padding: 2rem 1.15rem;
      gap: 1.35rem;
    }
    .subscribe-card h1 {
      font-size: clamp(1.65rem, 6.8vw, 2.15rem);
    }
  }
</style>
