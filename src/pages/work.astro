---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ArrowRight, ArrowUpRight } from '@lucide/astro';
import { openSourceProofs, representativeWork } from '../config/authority';
---

<BaseLayout title="代表作品與公開實作 | CabLate" description="從工程手冊、實作型課程到 MCP 開源工具與資料產品，了解 CabLate 處理過哪些問題，以及成果如何被公開檢查。">
  <article class="work-page">
    <header class="work-hero"><p class="eyebrow">作品與公開證據</p><h1>作品不只展示結果，也留下我如何解決問題。</h1><p>這裡整理我能公開說明的代表作品與外部證據。只有成果、證據與公開授權都足夠完整的項目，才會稱為案例；其他項目則以專案記錄呈現。</p><a href="#selected-work">查看公開作品與證據 <ArrowRight size={18} aria-hidden="true" /></a></header>

    <section class="selected-work" id="selected-work" aria-labelledby="selected-title"><header><h2 id="selected-title">四類作品，對應四種解決問題的方式。</h2></header><div class="work-list">{representativeWork.map((work, index) => <a href={work.href} target={work.href.startsWith('http') ? '_blank' : undefined} rel={work.href.startsWith('http') ? 'noopener' : undefined}><span>0{index + 1}</span><div><small>{work.type}</small><h3>{work.title}</h3><p>{work.description}</p><strong>{work.proof}</strong></div><ArrowUpRight size={22} aria-hidden="true" /></a>)}</div></section>

    <section class="open-source" aria-labelledby="open-title"><header><h2 id="open-title">程式碼公開，技術能力才能被實際檢查。</h2><p>下方的 stars 與 forks 是 2026-07-02 的公開快照，數字之後仍會變動。它們至少能證明這些工具已經發布，也有人實際使用與延伸。</p></header><div>{openSourceProofs.map((project) => <a href={project.href} target="_blank" rel="noopener"><h3>{project.title}</h3><p>{project.description}</p><strong>{project.metric}</strong><small>截至 {project.asOf}</small></a>)}</div></section>

    <section class="project-notes" aria-labelledby="notes-title"><div><h2 id="notes-title">有些經驗可以證明能力，但不代表所有細節都適合公開。</h2></div><div><article><h3>企業 AI 導入與內訓</h3><p>已完成企業團隊的 AI 導入與內訓（2026-04-23 完成交付）。在尚未取得授權前，公司名稱、Logo、照片與參與人數都維持匿名。</p></article><article><h3>匿名電商平台 MCP 合作測試</h3><p>曾參與電商平台的 MCP 合作測試，將工具能力轉成營運分析情境。合作方身分與內部資料在未取得授權前不會公開。</p></article></div></section>
  </article>
</BaseLayout>

<style>
  .work-page { padding-top: 5.25rem; }.work-hero,.selected-work,.open-source,.project-notes { width:min(100% - 3rem,82rem);margin-inline:auto;padding-block:clamp(5rem,8vw,8rem); }.eyebrow{margin:0 0 1rem;color:var(--accent);font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.work-hero h1{max-width:14ch;margin:0;font-size:clamp(3rem,6vw,6rem);letter-spacing:-.065em;line-height:1.02}.work-hero>p:not(.eyebrow){max-width:50rem;margin:2rem 0;color:var(--text-secondary);font-size:1.08rem;line-height:1.85}.work-hero>a{display:inline-flex;align-items:center;gap:.6rem;min-height:3.2rem;padding:.8rem 1.2rem;background:var(--text-primary);color:var(--bg);font-weight:700}.selected-work,.open-source,.project-notes{border-top:1px solid var(--border)}.selected-work header,.open-source header{max-width:52rem;margin-bottom:3.5rem}.selected-work h2,.open-source h2,.project-notes h2{max-width:17ch;margin:0;font-size:clamp(2.3rem,4.5vw,4.2rem);letter-spacing:-.05em;line-height:1.06}.work-list{border-top:1px solid var(--border-strong)}.work-list>a{display:grid;grid-template-columns:4rem 1fr auto;gap:2rem;align-items:center;padding:2rem 0;border-bottom:1px solid var(--border)}.work-list>a>span{color:var(--accent);font-family:var(--font-mono);font-size:.72rem}.work-list small{color:var(--accent)}.work-list h3{margin:.4rem 0;font-size:1.7rem}.work-list p{max-width:54rem;margin:.5rem 0;color:var(--text-secondary);line-height:1.7}.work-list strong{color:var(--text-muted);font-size:.75rem}.work-list a:hover h3{color:var(--accent)}.open-source header>p:last-child{color:var(--text-secondary);line-height:1.8}.open-source>div{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.open-source>div>a{min-height:16rem;padding:1.5rem;border:1px solid var(--border)}.open-source h3{margin:0 0:.8rem}.open-source a p{color:var(--text-secondary);line-height:1.7}.open-source a strong,.open-source a small{display:block}.open-source a strong{margin-top:2rem;color:var(--accent)}.open-source a small{color:var(--text-muted)}.project-notes{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(3rem,8vw,8rem)}.project-notes>div:last-child{border-top:1px solid var(--border-strong)}.project-notes article{padding:1.3rem 0;border-bottom:1px solid var(--border)}.project-notes h3,.project-notes p{margin:0}.project-notes p{margin-top:.5rem;color:var(--text-secondary);line-height:1.75}@media(max-width:760px){.open-source>div,.project-notes{grid-template-columns:1fr}.work-list>a{grid-template-columns:2.5rem 1fr}.work-list>a>:global(svg){display:none}}@media(max-width:520px){.work-hero,.selected-work,.open-source,.project-notes{width:min(100% - 2rem,82rem)}.work-hero h1{font-size:2.75rem}}
  .work-page { padding-top: 0; }
</style>
