---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ArrowRight, ArrowUpRight } from '@lucide/astro';
import { representativeWork } from '../config/authority';

const workStories = [
  {
    ...representativeWork[0],
    problem: '半年多的 Claude Code 實作經驗散落在筆記、對話與不同專案裡，遇到問題時很難快速找到真正原因。',
    decision: '不按功能做百科，而是依 Skill、Memory、Context、Hook 與常見失效方式，整理成能查原因、修正與交接的工程手冊。',
  },
  {
    ...representativeWork[1],
    problem: 'Agent 能回答地點問題，卻缺少一套可安裝、可重複呼叫，也方便其他開發者延伸的 Google Maps 工具。',
    decision: '把地圖能力包成標準 MCP 工具，補齊安裝方式、工具介面與公開程式碼，再發布到 GitHub 與 npm。',
  },
  {
    ...representativeWork[2],
    problem: '許多 AI 寫程式示範停在畫面能動，真的接上金流後，訂單狀態、Webhook、簽章與錯誤處理才開始出現。',
    decision: '課程不只示範 API 呼叫，而是帶學員走完整條收款流程，讓每個環節都有可檢查的狀態與失敗處理。',
  },
  {
    ...representativeWork[3],
    problem: '社群上的投資訊號很多，但貼文、AI 判讀、即時通知與後續股價驗證彼此分散，無法形成可追蹤的紀錄。',
    decision: '把資料收集、AI 分析、推送與結果驗證接成一套可部署系統，並保留公開程式碼供外部檢查。',
  },
];

const limitedDisclosureWork = [
  {
    title: '企業 AI 導入與內訓',
    scope: '已完成需求盤點、內容與實作設計、執行及交付。',
    boundary: '企業名稱、Logo、照片、參與人數與內部成果尚未取得公開授權，因此目前只列為合作紀錄，不包裝成完整 Case Study。',
  },
  {
    title: '電商平台 MCP 合作測試',
    scope: '將 MCP 工具能力轉成實際營運分析情境，驗證工具如何進入既有工作流程。',
    boundary: '合作方身分、內部資料與測試結果需保密；缺少可公開脈絡前，只說明負責範圍，不宣稱商業成效。',
  },
];
---

<BaseLayout title="代表作品與關鍵判斷｜CabLate" description="從工程手冊、MCP 工具、金流教學到資料產品，了解 CabLate 面對問題與限制時如何做選擇，以及有哪些成果可以公開檢查。">
  <article class="work-page paper-page">
    <header class="work-hero page-paper paper-card">
      <p class="eyebrow section-label">作品與公開證據</p>
      <h1>作品不只看結果，也看限制下怎麼選。</h1>
      <p>作品可以看見結果，真正決定品質的，通常是過程裡那些不明顯的選擇。這裡只留下能說清楚問題、判斷與公開結果的項目。</p>
      <a href="#selected-work">查看四個代表項目 <ArrowRight size={18} aria-hidden="true" /></a>
    </header>

    <section class="selected-work page-paper paper-card paper-card--clip" id="selected-work" aria-labelledby="selected-title">
      <header>
        <p class="section-label">代表項目</p>
        <h2 id="selected-title">四個問題，四種不同的處理方式。</h2>
      </header>
      <div class="work-list">
        {workStories.map((work, index) => (
          <a href={work.href} target={work.href.startsWith('http') ? '_blank' : undefined} rel={work.href.startsWith('http') ? 'noopener' : undefined}>
            <span>0{index + 1}</span>
            <div class="work-story">
              <small>{work.type}</small>
              <h3>{work.title}</h3>
              <dl>
                <div><dt>原本的問題</dt><dd>{work.problem}</dd></div>
                <div><dt>關鍵判斷</dt><dd>{work.decision}</dd></div>
              </dl>
              <strong>{work.proof}</strong>
            </div>
            <ArrowUpRight size={22} aria-hidden="true" />
          </a>
        ))}
      </div>
    </section>

    <section class="project-notes page-paper paper-card paper-card--clip paper-card--clip-left" aria-labelledby="notes-title">
      <div>
        <p class="section-label">有限揭露的合作紀錄</p>
        <h2 id="notes-title">把做過的範圍與不能公開的部分放在一起說清楚。</h2>
      </div>
      <div>
        {limitedDisclosureWork.map(item => (
          <article>
            <h3>{item.title}</h3>
            <dl><div><dt>可公開範圍</dt><dd>{item.scope}</dd></div><div><dt>揭露限制</dt><dd>{item.boundary}</dd></div></dl>
          </article>
        ))}
        <a class="text-link" href="/services/">如果你有相似情境，查看合作方式 <ArrowRight size={16} aria-hidden="true" /></a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .work-page .eyebrow { text-transform: none; }
  .work-hero > p:not(.eyebrow) { max-width: 50rem; margin: 2rem 0; color: var(--text-secondary); font-size: 1.08rem; line-height: 1.85; }
  .work-hero > a { display: inline-flex; align-items: center; gap: .6rem; min-height: 3.2rem; padding: .8rem 1.2rem; background: var(--text-primary); color: var(--bg); font-weight: 700; }
  .selected-work > header { max-width: 52rem; margin-bottom: 3.5rem; }
  .selected-work h2, .project-notes h2 { max-width: 17ch; margin: 0; font-size: clamp(2.3rem, 4.5vw, 4.2rem); letter-spacing: -.05em; line-height: 1.06; }
  .work-list { border-top: 1px solid var(--border-strong); }
  .work-list > a { display: grid; grid-template-columns: 4rem 1fr auto; gap: 2rem; align-items: start; padding: 2.2rem 0; border-bottom: 1px solid var(--border); }
  .work-list > a > span { color: var(--accent); font-family: var(--font-mono); font-size: .72rem; }
  .work-list small { color: var(--accent); }
  .work-list h3 { margin: .4rem 0 1.3rem; font-size: 1.7rem; }
  .work-list strong { display: block; margin-top: 1.2rem; color: var(--text-muted); font-size: .75rem; }
  .work-list a:hover h3 { color: var(--accent); }
  .work-story dl { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin: 0; }
  .work-story dl div { padding-top: .9rem; border-top: 1px solid var(--border); }
  .work-story dt { margin-bottom: .45rem; color: var(--text-muted); font-size: .72rem; font-weight: 700; }
  .work-story dd { margin: 0; color: var(--text-secondary); line-height: 1.75; }
  .project-notes { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(3rem, 8vw, 8rem); }
  .project-notes > div:last-child { border-top: 1px solid var(--border-strong); }
  .project-notes article { padding: 1.3rem 0; border-bottom: 1px solid var(--border); }
  .project-notes h3 { margin: 0 0 1rem; }.project-notes dl { display: grid; gap: .8rem; margin: 0; }.project-notes dt { color: var(--text-muted); font-size: .72rem; font-weight: 700; }.project-notes dd { margin: .3rem 0 0; color: var(--text-secondary); line-height: 1.7; }
  .project-notes .text-link { margin-top: 1.5rem; }
  @media (max-width: 760px) {
    .project-notes, .work-story dl { grid-template-columns: 1fr; }
    .work-list > a { grid-template-columns: 2.5rem 1fr; }
    .work-list > a > :global(svg) { display: none; }
  }
</style>
