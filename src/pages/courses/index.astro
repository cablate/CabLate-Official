---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ArrowRight } from '@lucide/astro';
import { learningPath } from '../../config/authority';
import { siteConfig, withCabAiAttribution } from '../../config/siteConfig';
import { getServiceApplicationHref } from '../../config/serviceApplication';
import ProofStrip from '../../components/common/ProofStrip.astro';
import QuoteBand from '../../components/common/QuoteBand.astro';

const enterpriseHref = getServiceApplicationHref('enterprise', 'courses_team');

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://cablate.com/' },
    { '@type': 'ListItem', position: 2, name: '課程與手冊', item: 'https://cablate.com/courses/' },
  ],
};

const coursesItemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'CabLate 課程與手冊學習路徑',
  itemListElement: learningPath.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.title,
    description: item.outcome,
    url: item.href.startsWith('http') ? item.href.split('?')[0] : `https://cablate.com${item.href}`,
  })),
};
---

<BaseLayout title="課程與手冊" description="免費 AI 工作流健檢、講座、AgentSkill 課程（200+ 人購買，4.6 / 5）和 Claude Code 深度工程手冊（18 章 46 堂）。看你現在卡在哪，挑一個開始。" image="/og/pages/courses.png" imageAlt="CabLate 課程與手冊：卡在哪，就先補哪一塊。" imageWidth={1200} imageHeight={630}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(coursesItemListJsonLd)} />
  <article class="learn-page paper-page">
    <header class="learn-hero page-paper paper-card">
      <div class="learn-hero__topline">
        <p class="eyebrow section-label">課程與手冊</p>
      </div>
      <h1 class="display-heading"><span class="heading-phrase">不用照順序學，</span><span class="heading-phrase">卡在哪就先補哪。</span></h1>
      <p class="learn-hero__intro">有人還看不出問題在哪，有人已經天天用 Claude Code，卻一直犯同一種錯。下面四種沒有先後，挑最像你現在狀況的那個就好。</p>
      <a class="learn-hero__cta" href="#learning-map">看哪個適合我 <ArrowRight size={18} aria-hidden="true" /></a>
    </header>

    <ProofStrip label="教過的數字" class="learn-proof" />

    <section class="learn-map page-paper paper-card paper-card--clip paper-card--clip-left" id="learning-map" aria-labelledby="map-title">
      <header class="learn-map__header">
        <div>
          <p class="section-label">四種狀況</p>
          <h2 id="map-title">你現在比較像哪一種？</h2>
          <p class="learn-map__lead">還不確定卡在哪，先做免費健檢。已經知道問題，再往下挑。</p>
        </div>
      </header>

      <ul class="learn-map__list" role="list">
        {learningPath.map((item, index) => (
          <li class:list={[
            'learn-map__step',
            index === 0 && 'learn-map__step--start',
            item.href ? 'learn-map__step--available' : 'learn-map__step--pending',
          ]}>
            <div class="learn-map__marker" aria-hidden="true">
              <span>0{index + 1}</span>
            </div>
            <div class="learn-map__content">
              <div class="learn-map__meta">
                <small>{item.stage}</small>
                {!item.href && <span class="learn-map__pending">尚未開放</span>}
              </div>
              <h3>{item.situation}</h3>
              <div class="learn-map__solution">
                <span>適合你的是</span>
                <h4>{item.title}</h4>
                <p>{item.outcome}</p>
                <div class="learn-map__action">
                  {item.price && <strong>{item.price}</strong>}
                  {item.href ? (
                    <a class="learn-map__route-action" href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener' : undefined}>{item.cta} <ArrowRight size={15} aria-hidden="true" /></a>
                  ) : (
                    <span class="learn-map__status">有新場次時會在這裡更新</span>
                  )}
                </div>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <QuoteBand class="learn-quotes" title="課堂上我最常提醒的事" lead="Threads 原文，沒有修過。" pick={[3, 4, 2]} />

    <section class="cabai-onboarding page-paper paper-card paper-card--clip-left" id="cabai-platform" aria-labelledby="cabai-onboarding-title">
      <div>
        <p class="section-label">在哪裡上課</p>
        <h2 id="cabai-onboarding-title">試看、上課、之後的更新，都在 CabAI 帳號裡</h2>
      </div>
      <div class="cabai-onboarding__body">
        <p>用 Google 帳號登入 CabAI，就能看免費試看、買過的課程和手冊，之後的更新也會自動出現。在個人資料頁連結 Discord，還可以加入免費社群，跟其他人交流 AI 和開發的問題。</p>
        <div class="cabai-onboarding__readings" aria-label="延伸實作文章">
          <span>還沒決定要不要買課，也可以先讀這幾篇免費拆解</span>
          <ul>
            <li><a href="/articles/ai-tests-false-safety-six-phase-overhaul/">AI 寫了幾百個測試全綠，為什麼還是不能信？</a></li>
            <li><a href="/articles/reverse-engineer-claude-agent-sdk-hidden-token-cost/">Claude Agent SDK 逆向：省下 73% Token</a></li>
            <li><a href="/articles/claude-code-workflow/">Claude Code 完整工作流拆解</a></li>
          </ul>
        </div>
        <div class="cabai-onboarding__actions">
          <a class="learn-hero__cta" href={withCabAiAttribution(siteConfig.cabAi.accountUrl, 'courses_account')} target="_blank" rel="noopener">免費註冊 CabAI <ArrowRight size={17} aria-hidden="true" /></a>
        </div>
      </div>
    </section>
    <section class="learn-team page-paper paper-card" aria-labelledby="learn-team-title">
      <div>
        <p class="section-label">想讓團隊一起學</p>
        <h2 id="learn-team-title">同樣的內容，可以用你們自己的工作來上</h2>
        <p>講座、半日或全日工作坊、兩日班都教過。先聊需求，不收費。</p>
      </div>
      <a class="learn-hero__cta" href={enterpriseHref} data-analytics-placement="courses_team">告訴我團隊的狀況 <ArrowRight size={17} aria-hidden="true" /></a>
    </section>
  </article>
</BaseLayout>

<style>
  .learn-page { padding-top: 0; }
  .learn-hero, .learn-map, .cabai-onboarding, .learn-proof, .learn-quotes, .learn-team { width: min(100%, 68rem); margin-inline: auto; }
  .learn-proof, .learn-quotes, .learn-team { margin-block: 1rem; }
  .learn-team { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1.25rem 3rem; background: var(--surface-elevated) !important; border: 1px solid var(--border) !important; border-radius: var(--radius-md) !important; padding: clamp(1.75rem, 3.2vw, 2.5rem) !important; box-shadow: var(--shadow-sm) !important; }
  .learn-map h2, .cabai-onboarding h2, .learn-team h2 { max-width: 16em; margin: 0; font-family: var(--font-serif); font-size: clamp(1.55rem, 2.5vw, 2.1rem); letter-spacing: -.02em; line-height: 1.32; }
  .learn-team p:not(.section-label) { margin: .75rem 0 0; color: var(--text-secondary); font-size: .95rem; line-height: 1.75; }
  #learning-map { scroll-margin-top: 2rem; }
  .learn-hero { padding-block: 0; }
  .learn-hero__topline { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-inline-size: 0; padding-bottom: .9rem; border-bottom: 1px solid var(--border); }
  .learn-hero__topline .section-label { margin: 0; }
  .learn-hero__topline > span { min-inline-size: 0; color: var(--text-muted); font-family: var(--font-mono); font-size: .68rem; letter-spacing: .08em; text-align: end; text-wrap: pretty; }
  .learn-hero h1 { max-width: 15em; margin: 1.25rem 0 0; font-size: clamp(1.6rem, 2.6vw, 2.1rem); }
  .learn-hero__intro { max-width: 46rem; margin: 1rem 0 1.25rem; color: var(--text-secondary); font-size: 1.02rem; line-height: 1.75; }
  .learn-hero__cta { display: inline-flex; align-items: center; gap: .6rem; min-height: 3.2rem; padding: .8rem 1.35rem; border-radius: var(--radius-sm); background: var(--btn-primary-bg); color: #fff; font-weight: 700; box-shadow: var(--shadow-sm); transition: transform var(--transition-fast), box-shadow var(--transition-fast), background var(--transition-fast); }
  .learn-hero__cta:hover { background: var(--btn-primary-hover-bg); transform: translateY(-1px); box-shadow: var(--shadow-md); }
  .learn-hero__cta:active { transform: translateY(1px); }
  .learn-hero__cta:focus-visible, .learn-map a:focus-visible { outline: 2px solid var(--accent); outline-offset: .3rem; }

  .learn-map { padding-block: clamp(1.5rem, 3vw, 2.5rem); }
  .learn-map__header { position: relative; display: flex; align-items: flex-start; justify-content: space-between; gap: 2rem; margin-bottom: 1.75rem; }
  .learn-map__header h2 { max-width: 15em; margin: 0; font-family: var(--font-serif); font-size: clamp(1.55rem, 2.5vw, 2.1rem); letter-spacing: -.02em; line-height: 1.32; }
  .learn-map__lead { max-width: 40rem; margin: .9rem 0 0; color: var(--text-secondary); font-size: .95rem; line-height: 1.75; text-wrap: pretty; }
  .learn-map__header .paper-label { top: -.35rem; right: 1.5rem; left: auto; transform: rotate(2deg); }
  .learn-map__list { position: relative; margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--border); }
  .learn-map__list::before { position: absolute; top: 2.2rem; bottom: 2.2rem; left: 2rem; width: 1px; content: ''; background: linear-gradient(to bottom, var(--accent), var(--border-strong) 28%, var(--border-strong) 72%, var(--accent)); opacity: .55; }
  .learn-map__step { position: relative; display: grid; grid-template-columns: 4rem minmax(0, 1fr); gap: 1.5rem; padding: 1.6rem 0; border-bottom: 1px solid var(--border); }
  .learn-map__marker { position: relative; z-index: 1; display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border: 1px solid var(--border-strong); border-radius: 50%; background: var(--surface-elevated); color: var(--text-primary); font-family: var(--font-mono); font-size: .78rem; box-shadow: var(--shadow-sm); }
  .learn-map__step--available .learn-map__marker { border-color: color-mix(in oklab, var(--accent) 62%, var(--border-strong)); color: var(--accent); }
  .learn-map__step--pending .learn-map__marker { border-style: dashed; color: var(--text-muted); }
  .learn-map__step--start .learn-map__marker { border-color: var(--accent); background: var(--accent-subtle); color: var(--accent); }
  .learn-map__content { min-width: 0; }
  .learn-map__meta { display: flex; align-items: center; flex-wrap: wrap; gap: .75rem; }
  .learn-map__meta small { color: var(--text-muted); font-size: .8rem; }
  .learn-map__available, .learn-map__pending { display: inline-flex; align-items: center; gap: .25rem; min-block-size: 1.55rem; padding: .22rem .65rem; border: 1px solid transparent; border-radius: var(--radius-full); font-size: .72rem; font-weight: 700; line-height: 1.25; }
  .learn-map__available { border-color: rgb(112 91 177 / .22); background: rgb(112 91 177 / .09); color: var(--accent); }
  .learn-map__pending { border-color: var(--border); background: var(--surface-subtle); color: var(--text-muted); }
  .learn-map h3 { max-width: 23em; margin: .45rem 0 .85rem; font-size: clamp(1.12rem, 1.7vw, 1.3rem); line-height: 1.4; text-wrap: pretty; }
  .learn-map h4 { margin: .3rem 0 .6rem; font-size: 1.12rem; line-height: 1.4; text-wrap: balance; }
  .learn-map p { max-width: 50rem; margin: 0; color: var(--text-secondary); font-size: .95rem; line-height: 1.72; }
  .learn-map__solution { min-width: 0; padding: clamp(1.25rem, 2.5vw, 1.75rem); border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface-elevated); box-shadow: var(--shadow-sm); }
  .learn-map__solution > span { color: var(--accent-text); font-size: .78rem; font-weight: 700; }
  .learn-map__action { display: flex; align-items: center; flex-wrap: wrap; gap: .8rem 1.4rem; margin-top: 1rem; }
  .learn-map__action strong { color: var(--text-primary); font-size: .85rem; }
  .learn-map__route-action { display: inline-flex; align-items: center; justify-content: space-between; gap: .8rem; min-block-size: 3rem; max-inline-size: 100%; padding: .7rem 1.05rem; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); background: var(--bg-soft); color: var(--accent-text); font-size: .9rem; font-weight: 700; line-height: 1.35; white-space: nowrap; box-shadow: var(--shadow-sm); transition: border-color var(--transition-fast), background-color var(--transition-fast), color var(--transition-fast), transform var(--transition-fast); }
  .learn-map__route-action:hover { border-color: var(--accent); background-color: var(--accent-subtle); color: var(--accent-hover); }
  .learn-map__route-action:active { transform: translateY(1px); }
  .learn-map__route-action :global(svg) { flex: 0 0 auto; }
  .learn-map__status { display: block; padding-top: .8rem; border-top: 1px dashed var(--border-strong); color: var(--text-muted); font-size: .82rem; }

  .cabai-onboarding { display: grid; grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr); gap: clamp(1.5rem, 4vw, 3.5rem); background: var(--surface-elevated) !important; border: 1px solid var(--border) !important; border-radius: var(--radius-md) !important; padding: clamp(1.75rem, 3.2vw, 2.5rem) !important; box-shadow: var(--shadow-sm) !important; }
  .cabai-onboarding h2 { max-width: 15em; margin: 0; font-family: var(--font-serif); font-size: clamp(1.55rem, 2.5vw, 2.1rem); letter-spacing: -.02em; line-height: 1.32; }
  .cabai-onboarding__body { align-self: end; }
  .cabai-onboarding__body > p { max-width: 38rem; margin: 0; color: var(--text-secondary); font-size: .95rem; line-height: 1.78; }
  .cabai-onboarding__readings { margin-top: 1rem; padding-top: .9rem; border-top: 1px dashed var(--border); font-size: .88rem; }
  .cabai-onboarding__readings > span { display: block; color: var(--text-muted); margin-bottom: .45rem; }
  .cabai-onboarding__readings ul { margin: 0; padding-left: 1.1rem; display: grid; gap: .3rem; color: var(--text-secondary); }
  .cabai-onboarding__readings a { color: var(--accent-text); text-decoration: underline; text-underline-offset: .18em; }
  .cabai-onboarding__readings a:hover { color: var(--accent-hover); }
  .cabai-onboarding__actions { display: grid; justify-items: start; gap: .9rem; margin-top: 1.25rem; }

  @media (max-width: 760px) {
    .cabai-onboarding { grid-template-columns: 1fr; }
    .learn-map__header { gap: 1.25rem; }
    .learn-map__step { grid-template-columns: 3.5rem minmax(0, 1fr); gap: 1.25rem; }
    .learn-map__marker { width: 3.5rem; height: 3.5rem; }
    .learn-map__list::before { left: 1.75rem; }
  }

  @media (max-width: 520px) {
    .learn-hero, .learn-map, .cabai-onboarding, .learn-proof, .learn-quotes, .learn-team { width: min(100% - 2rem, 82rem); }
    .learn-team .learn-hero__cta { width: 100%; justify-content: center; }
    .learn-page .display-heading > .heading-phrase { white-space: normal; }
    #learning-map { scroll-margin-top: 5.5rem; }
    .learn-hero__topline { align-items: flex-start; gap: .75rem; }
    .learn-hero__topline > span { max-inline-size: 12ch; padding-top: .1rem; font-size: .6rem; line-height: 1.45; }
    .learn-hero h1 { margin-top: 1.1rem; font-size: clamp(1.4rem, 6vw, 1.7rem); }
    .learn-map__header { margin-bottom: 1.5rem; }
    .learn-map__header .paper-label { top: -.55rem; right: .2rem; }
    .learn-map__step { padding-block: 1.2rem; }
    .learn-map h3 { font-size: 1.12rem; }
    .learn-map p { font-size: .92rem; }
    .learn-map__meta { gap: .5rem; }
    .learn-map__available, .learn-map__pending { font-size: .66rem; }
    .learn-map__solution { padding: 1rem; }
    .learn-map__action { display: grid; gap: .7rem; }
    .learn-map__route-action { inline-size: 100%; }
    .cabai-onboarding__actions .learn-hero__cta { width: 100%; justify-content: center; }
  }

  @media (max-width: 340px) {
    .learn-map h4 { font-size: 1.02rem; }
    .learn-map__route-action { min-inline-size: 0; white-space: normal; }
  }

  @media (forced-colors: active) {
    .learn-map__solution, .learn-map__route-action { border-color: CanvasText; background-image: none; box-shadow: none; }
    .learn-map__route-action { color: LinkText; }
    .learn-map__status { border-color: GrayText; color: GrayText; }
  }

  @media (prefers-reduced-motion: reduce) {
    .learn-hero__cta, .learn-map a { transition: none; }
  }
</style>
