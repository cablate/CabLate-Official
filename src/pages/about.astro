---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ArrowRight, Github, AtSign } from '@lucide/astro';
import { authorityProfile, openSourceProofs } from '../config/authority';
import { siteConfig, withCabAiAttribution } from '../config/siteConfig';

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  dateModified: '2026-07-13',
  mainEntity: {
    '@type': 'Person',
    '@id': `${authorityProfile.authorUrl}#person`,
    name: authorityProfile.publicName,
    alternateName: authorityProfile.alternateName,
    url: authorityProfile.authorUrl,
    jobTitle: 'AI 應用講師／全端工程師',
    description: authorityProfile.shortBio,
    sameAs: authorityProfile.sameAs,
    knowsAbout: ['AI Agent', 'Claude Code', 'Vibe Coding', 'Context Engineering', 'Harness Engineering', 'Skill Design'],
  },
};

const timeline = [
  { time: '非本科轉職', title: '從前端一路補到系統整合', text: '我從前端進入工程，在實務專案裡補上後端、部署、系統整合與團隊協作。這段經歷讓我很早就知道，聽懂名詞和把事情完成是兩回事。' },
  { time: '工程實務期', title: '開始把驗收與復原一起算進交付', text: '進入政府與企業系統後，我開始承接系統分析與設計工作。功能能跑還不夠，資料、權限、驗收、復原與交接都要一起考慮。' },
  { time: '2024', datetime: '2024', title: '把工程經驗轉向 AI 應用', text: '我開始把工程背景轉向 AI 應用，也協助外部團隊理解 AI 可以怎麼進入實際工作。判斷與交付方法因此不再只留在工程專案裡。' },
  { time: '2025-06 至今', datetime: '2025-06', title: '全職投入 CabLate', text: '2025 年 6 月離開正職後，我全職投入 CabLate，陸續發展課程、講座、付費手冊、CabAI 平台與顧問服務。每一種形式都在處理同一件事：讓複雜方法能被理解、使用與接手。' },
];
---

<BaseLayout title="關於 CabLate｜從工程實作到 AI 工作流程的判斷" description={authorityProfile.shortBio}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

  <article class="about-page paper-page">
    <header class="about-hero page-paper paper-card">
      <div class="about-hero__topline">
        <p class="about-kicker">關於 CabLate</p>
        <span class="about-note">WORK NOTES / 01</span>
      </div>
      <div class="about-hero__grid">
        <div class="about-hero__headline">
          <h1 class="display-heading"><span class="heading-phrase">從工程實作</span><span class="heading-phrase">走到 AI 應用，</span><span class="heading-phrase">我一直在意成果</span><span class="heading-phrase">能不能被接手。</span></h1>
        </div>
        <div class="about-hero__aside">
          <p class="about-hero__lead">我是 CabLate，做過全端工程與系統設計，現在把這些經驗用在 AI 教學、產品和工作流程上。</p>
          <p>我在意的是：做出來之後，別人能不能直接用、知道怎麼檢查，出錯時也接得下去。</p>
          <dl class="about-hero__facts">
            <div><dt>我在處理</dt><dd>任務、可用資料、工具與驗收</dd></div>
            <div><dt>我留下</dt><dd>能重複、能交接的工作方法</dd></div>
          </dl>
          <p class="about-hero__referral">如果你或你的團隊已經在用 AI，工作卻一直重做、難以檢查，也不知道怎麼交給下一個人，我可以一起找出問題在哪裡。</p>
          <a class="text-link about-hero__action" href="/work/">先看代表作品 <ArrowRight size={16} aria-hidden="true" /></a>
        </div>
      </div>
    </header>

    <section class="about-story page-paper paper-card" aria-labelledby="story-title">
      <div class="about-story__intro section-heading">
        <p class="about-kicker">專業歷程</p>
        <h2 id="story-title">我在意交付，因為做出來不等於能使用。</h2>
        <span class="about-story__mark" aria-hidden="true">↳</span>
      </div>
      <div class="about-story__body">
        <p class="about-story__opening">早期我以為功能寫完就算完成。進入複雜系統後，我開始把資料、權限、驗收與復原一起算進交付。</p>
        <div class="about-story__copy">
          <p>資料可能出錯、權限可能漏掉、需求可能在交接時變形。即使功能可以執行，只要沒有人說得清楚如何驗收、出錯後怎麼復原，它就還不是一個可靠的成果。</p>
          <p>AI 讓產出變快，也讓這些缺口更快暴露。現在不論做教學、產品或合作，我都先問四件事：任務拆清楚了嗎？AI 讀到哪些資料？結果怎麼檢查？做對一次的方法能不能留下來？</p>
        </div>
      </div>
    </section>

    <section class="turning-points page-paper paper-card paper-card--clip" aria-labelledby="timeline-title">
      <header class="turning-points__header">
        <div class="section-heading">
          <p class="about-kicker">關鍵轉折</p>
          <h2 id="timeline-title">四個轉折，慢慢形成現在這套工作方式。</h2>
        </div>
        <p class="turning-points__note">從轉職、工程實務到全職投入 CabLate，這四段經歷改變了我判斷工作是否完成的方式。</p>
      </header>
      <ol class="timeline">
        {timeline.map((item, index) => (
          <li>
            <div class="timeline__rail" aria-hidden="true"><span class="timeline__node">0{index + 1}</span></div>
            <div class="timeline__meta"><time datetime={item.datetime}>{item.time}</time></div>
            <div class="timeline__content"><h3>{item.title}</h3><p>{item.text}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <section class="open-source page-paper paper-card" aria-labelledby="opensource-title">
      <header class="open-source__header">
        <div class="section-heading">
          <p class="about-kicker">公開作品</p>
          <h2 id="opensource-title">每件作品都附上公開程式碼、使用方式或可查證的數字。</h2>
        </div>
        <p>作品是判斷方式的證據。先看我怎麼拆問題，再決定要不要繼續往下讀。</p>
      </header>
      <div class="open-source__list">
        {openSourceProofs.map((project) => (
          <a href={project.href} target="_blank" rel="noopener">
            <div><h3>{project.title}</h3><p>{project.description}</p></div>
            <div class="open-source__proof"><strong>{project.metric}</strong><small>截至 {project.asOf}</small></div>
          </a>
        ))}
      </div>
      <div class="platform-proof" id="cabai-platform">
        <div>
          <p class="about-kicker">內容交付系統</p>
          <h3>CabAI 是我用來提供試看、販售課程和交付已購內容的平台。</h3>
          <p>訪客可以先免費試看，購買後再用同一個帳號讀課程、手冊和後續更新。</p>
        </div>
        <a href={withCabAiAttribution(siteConfig.cabAi.homeUrl, 'about_platform')} target="_blank" rel="noopener">查看 CabAI 學習平台 <ArrowRight size={16} aria-hidden="true" /></a>
      </div>
    </section>

    <section class="principles page-paper paper-card paper-card--clip paper-card--clip-left" aria-labelledby="principles-title">
      <div class="principles__grid">
        <div class="principles__intro section-heading">
          <p class="about-kicker">工作原則</p>
          <h2 id="principles-title">遇到不同工具與問題，我仍會守住四件事。</h2>
        <p class="principles__note">每次開始前，我都用下面四個問題確認方向。</p>
        </div>
        <div class="principles__list">
          <article><span>01</span><h3>沒有做過的，不假裝熟悉</h3><p>區分實際經驗、研究判斷與仍待驗證的想法，也說清楚方法適用到哪裡。</p></article>
          <article><span>02</span><h3>先做出能使用的版本</h3><p>讓真實使用者、限制與錯誤早點出現，再根據證據修正。</p></article>
          <article><span>03</span><h3>先看問題，再選工具</h3><p>簡單的方法能穩定解決，就不為了熱門名詞硬塞 Agent 或複雜架構。</p></article>
          <article><span>04</span><h3>做對一次，就把原因留下來</h3><p>把有效的判斷、順序與驗收方式整理成手冊、Skill 或工具。</p></article>
        </div>
      </div>
    </section>

    <section class="about-next page-paper paper-card paper-card--clip" id="next" aria-labelledby="next-title">
      <div>
        <p class="about-kicker">下一步</p>
        <h2 id="next-title">想看這些原則怎麼用在實作上，先看代表作品。</h2>
      </div>
      <div class="about-next__links">
        <a class="about-next__primary" href="/work/">查看代表作品 <ArrowRight size={18} aria-hidden="true" /></a>
        <div class="about-next__secondary"><a href="/expertise/">專業方法</a><a href="https://github.com/cablate" target="_blank" rel="noopener"><Github size={16} aria-hidden="true" /> GitHub</a><a href={siteConfig.threadsUrl} target="_blank" rel="noopener"><AtSign size={16} aria-hidden="true" /> Threads</a><a href={`mailto:${siteConfig.contactEmail}`}>Email</a></div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .about-page { padding-top: 0; }
  .about-page > .page-paper { overflow: visible; }
  .about-kicker { margin: 0 0 1rem; color: var(--accent); font-size: .72rem; font-weight: 700; letter-spacing: .1em; }
  .about-note { color: var(--text-muted); font-family: var(--font-mono); font-size: .62rem; letter-spacing: .08em; }
  .about-hero { padding-block: clamp(3.25rem, 7vw, 6.5rem) !important; }
  .about-hero__topline { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-bottom: 1.35rem; border-bottom: 1px solid var(--border); }
  .about-hero__topline p { margin: 0; }
  .about-hero__grid { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(16rem, .92fr); gap: clamp(2.5rem, 7vw, 7rem); align-items: end; padding-top: clamp(2.5rem, 5vw, 4.75rem); }
  .about-hero h1 { max-width: none !important; margin: 0; font-family: var(--font-serif); font-size: clamp(3rem, 5.8vw, 5.75rem) !important; letter-spacing: -.07em !important; line-height: 1.04 !important; }
  .about-hero__aside { max-width: 31rem; padding-bottom: .35rem; }
  .about-hero__aside p { margin: 0; color: var(--text-secondary); line-height: 1.85; }
  .about-hero__aside .about-hero__lead { margin-bottom: 1.2rem; color: var(--text-primary); font-size: 1.1rem; font-weight: 700; line-height: 1.65; }
  .about-hero__facts { display: grid; gap: .75rem; margin: 2rem 0 0; padding-top: 1rem; border-top: 1px solid var(--border); }
  .about-hero__facts div { display: grid; grid-template-columns: 5rem 1fr; gap: .8rem; }
  .about-hero__facts dt { color: var(--accent); font-size: .68rem; font-weight: 700; }
  .about-hero__facts dd { margin: 0; color: var(--text-secondary); font-size: .82rem; }
  .about-hero__referral { margin-top: 1.2rem !important; font-size: .82rem; line-height: 1.75 !important; }
  .about-hero__action { margin-top: 1rem; }
  .about-story { display: grid; grid-template-columns: minmax(12rem, .72fr) minmax(0, 1.28fr); gap: clamp(2.5rem, 8vw, 8rem); padding-block: clamp(3.5rem, 8vw, 7rem) !important; }
  .section-heading h2 { max-width: 16ch; margin: 0; font-size: clamp(2rem, 4vw, 3.55rem); letter-spacing: -.055em; line-height: 1.1; }
  .about-story__intro { position: relative; }
  .about-story__mark { position: absolute; right: 0; bottom: -.2rem; color: var(--accent); font-family: var(--font-serif); font-size: 3.2rem; line-height: 1; transform: rotate(-14deg); }
  .about-story__body { max-width: 45rem; }
  .about-story__opening { margin: 0 0 1.65rem; color: var(--text-primary) !important; font-size: clamp(1.35rem, 2.2vw, 1.9rem) !important; font-weight: 700; letter-spacing: -.025em; line-height: 1.55 !important; }
  .about-story__copy { display: grid; gap: 1.2rem; padding-top: 1.25rem; border-top: 1px solid var(--border); }
  .about-story__copy p { margin: 0; color: var(--text-secondary); line-height: 1.9; }
  .turning-points { padding-block: clamp(3.5rem, 7vw, 6.5rem) !important; }
  .turning-points__header { display: grid; grid-template-columns: minmax(0, 1fr) minmax(15rem, .65fr); gap: 2rem; align-items: end; padding-bottom: 2.5rem; border-bottom: 1px solid var(--border); }
  .turning-points__note { max-width: 24rem; margin: 0; color: var(--text-secondary); font-size: .86rem; line-height: 1.8; }
  .timeline { position: relative; margin: 0; padding: .4rem 0 0; list-style: none; }
  .timeline::before { content: ''; position: absolute; top: 1rem; bottom: 1.6rem; left: 1rem; width: 1px; background: color-mix(in srgb, var(--accent) 60%, var(--border)); }
  .timeline li { position: relative; display: grid; grid-template-columns: 2rem minmax(8rem, .42fr) minmax(0, 1.58fr); gap: 1.25rem; padding: 1.75rem 0; border-bottom: 1px solid var(--border); }
  .timeline li:last-child { border-bottom: 0; padding-bottom: .35rem; }
  .timeline__rail { position: relative; z-index: 1; }
  .timeline__node { display: grid; place-items: center; width: 2rem; height: 2rem; border: 1px solid var(--accent); border-radius: 50%; background: var(--bg-soft); color: var(--accent); font-family: var(--font-mono); font-size: .58rem; }
  .timeline__meta { padding-top: .25rem; }
  .timeline time { color: var(--accent); font-family: var(--font-mono); font-size: .68rem; line-height: 1.55; }
  .timeline__content { min-width: 0; }
  .timeline h3 { margin: 0 0 .55rem; font-size: 1.35rem; letter-spacing: -.025em; }
  .timeline li p { max-width: 47rem; margin: 0; color: var(--text-secondary); line-height: 1.8; }
  .open-source { padding-block: clamp(3.5rem, 7vw, 6.5rem) !important; }
  .open-source__header { display: grid; grid-template-columns: minmax(0, 1fr) minmax(15rem, .6fr); gap: 2rem; align-items: end; padding-bottom: 2.5rem; }
  .open-source__header > p { max-width: 23rem; margin: 0; color: var(--text-secondary); font-size: .86rem; line-height: 1.8; }
  .open-source__list { border-top: 1px solid var(--border-strong); }
  .open-source__list a { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem; align-items: center; padding: 1.4rem 0; border-bottom: 1px solid var(--border); }
  .open-source__list a:hover h3 { color: var(--accent); }
  .open-source__list h3, .open-source__list p { margin: 0; }
  .open-source__list h3 { font-size: 1.08rem; }
  .open-source__list p { margin-top: .35rem; color: var(--text-secondary); font-size: .82rem; }
  .open-source__proof { display: grid; justify-items: end; gap: .15rem; }
  .open-source__proof strong { color: var(--accent); font-size: .78rem; white-space: nowrap; }
  .open-source__proof small { color: var(--text-muted); font-size: .64rem; white-space: nowrap; }
  .platform-proof { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; margin-top: 2rem; padding-top: 2rem; border-top: 1px solid var(--border-strong); }
  .platform-proof .about-kicker { margin-bottom: .55rem; }
  .platform-proof h3 { max-width: 34rem; margin: 0; font-size: clamp(1.35rem, 2.4vw, 1.9rem); line-height: 1.45; }
  .platform-proof p:last-child { max-width: 42rem; margin: .75rem 0 0; color: var(--text-secondary); font-size: .84rem; line-height: 1.75; }
  .platform-proof > a { display: inline-flex; align-items: center; justify-self: start; gap: .45rem; color: var(--accent-text); font-size: .82rem; font-weight: 700; white-space: nowrap; }
  .principles { padding: clamp(3.5rem, 7vw, 6.5rem) !important; }
  .principles__grid { display: grid; grid-template-columns: minmax(12rem, .72fr) minmax(0, 1.28fr); gap: clamp(2.5rem, 7vw, 7rem); }
  .principles__note { max-width: 20rem; margin: 1.5rem 0 0; color: var(--text-secondary); font-size: .84rem; line-height: 1.8; }
  .principles__list { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--border); border-left: 1px solid var(--border); }
  .principles article { min-height: 14rem; padding: 1.35rem; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .principles article span { color: var(--accent); font-family: var(--font-mono); font-size: .66rem; }
  .principles article h3 { margin: 2.75rem 0 .65rem; font-size: 1.12rem; }
  .principles article p { margin: 0; color: var(--text-secondary); font-size: .82rem; line-height: 1.75; }
  .about-next { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(15rem, .9fr); gap: clamp(2.5rem, 7vw, 7rem); padding-block: clamp(3.5rem, 7vw, 6rem) !important; }
  .about-next h2 { max-width: 17ch; margin: 0; font-size: clamp(2rem, 4vw, 3.45rem); letter-spacing: -.055em; line-height: 1.1; }
  .about-next__links { align-self: end; border-top: 1px solid var(--border-strong); }
  .about-next__links a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 3.2rem; padding: .9rem 0; border-bottom: 1px solid var(--border); font-weight: 700; }
  .about-next__links a:hover { color: var(--accent); }
  .about-next__primary { color: var(--accent-text); }
  .about-next__secondary { display: flex; flex-wrap: wrap; gap: .5rem 1.2rem; padding-top: .75rem; }
  .about-next__secondary a { display: inline-flex; justify-content: flex-start; min-height: 2rem; padding: .25rem 0; border: 0; color: var(--text-secondary); font-size: .78rem; }
  @media (max-width: 800px) {
    .about-hero__grid, .about-story, .turning-points__header, .open-source__header, .platform-proof, .principles__grid, .about-next { grid-template-columns: 1fr; }
    .about-hero__grid { gap: 2.25rem; }
    .about-hero__aside { max-width: 38rem; }
    .about-story__mark { right: 1rem; }
    .turning-points__header, .open-source__header { gap: 1.25rem; }
    .principles__list { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .about-page > .page-paper { padding-inline: 1.25rem !important; }
    .about-hero { padding-block: 2.4rem 3rem !important; }
    .about-hero__topline { padding-bottom: 1rem; }
    .about-note { font-size: .55rem; }
    .about-hero__grid { padding-top: 2.15rem; }
    .about-hero h1 { font-size: clamp(2.55rem, 11vw, 3.45rem) !important; line-height: 1.08 !important; }
    .about-hero__aside .about-hero__lead { font-size: 1rem; }
    .about-hero__facts { margin-top: 1.35rem; }
    .about-story, .turning-points, .open-source, .principles, .about-next { padding-block: 2.8rem !important; }
    .about-story__opening { font-size: 1.25rem !important; }
    .about-story__mark { bottom: -.5rem; font-size: 2.6rem; }
    .turning-points__header, .open-source__header { padding-bottom: 1.7rem; }
    .timeline::before { top: 1rem; bottom: 1.2rem; left: .85rem; }
    .timeline li { grid-template-columns: 1.7rem minmax(0, 1fr); column-gap: .85rem; padding: 1.25rem 0; }
    .timeline__rail { grid-column: 1; grid-row: 1 / span 2; }
    .timeline__node { width: 1.7rem; height: 1.7rem; font-size: .52rem; }
    .timeline__meta { grid-column: 2; grid-row: 1; padding-top: .05rem; }
    .timeline__content { grid-column: 2; grid-row: 2; }
    .timeline h3 { margin-top: .35rem; font-size: 1.15rem; }
    .timeline li p { font-size: .84rem; line-height: 1.75; }
    .open-source__list a { grid-template-columns: 1fr; gap: .65rem; padding: 1.2rem 0; }
    .open-source__proof { justify-items: start; }
    .principles__list { grid-template-columns: 1fr; }
    .principles article { min-height: auto; padding: 1.25rem; }
    .principles article h3 { margin-top: 1.8rem; }
  }
</style>
