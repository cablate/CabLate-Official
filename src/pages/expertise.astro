---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ArrowRight } from '@lucide/astro';
import { signatureMethods } from '../config/authority';
const diagnosticScenarios = [
  {
    symptom: '它常忘記前文，或讀到不該使用的舊資料。',
    question: '先檢查 AI 在這個時間點，究竟能看見哪些資訊。',
    method: 'Context Engineering',
    check: '列出這次任務實際讀到的檔案、對話與資料版本，再和你以為它知道的內容逐項比對。',
    mistake: '把更多資料一次塞進 Context，卻沒有確認版本、優先順序與使用時機。',
    href: '/articles/claude-code-token-drain-system-reminder/',
  },
  {
    symptom: '它做了很多事，結果卻不能直接使用。',
    question: '再檢查任務、工具、權限、錯誤處理與完成標準有沒有接起來。',
    method: 'Harness Engineering',
    check: '挑一個真實案例，寫下輸入、允許使用的工具、完成條件，以及失敗後應停在哪裡。',
    mistake: '看到模型單次成功，就直接把它當成可重複運作的流程。',
    href: '/articles/claude-code-workflow/',
  },
  {
    symptom: '同一件事每次都要重教，品質還是忽好忽壞。',
    question: '最後看做對一次的方法，有沒有被整理成可重複執行的流程。',
    method: 'Skill 設計',
    check: '回看上次做對時真正影響結果的判斷、順序與限制，確認它們是否已被明確留下。',
    mistake: '只保存最後的 Prompt，沒有保存啟動條件、例外處理與驗收方式。',
    href: '/articles/agent-sdk-system-reminder-diff-fix/',
  },
];
---

<BaseLayout title="AI 工作流程與失效診斷｜CabLate" description="從 AI 忘記前文、成果不能用，到每次都要重新教，辨認問題出在 Context、工作環境，還是經驗沒有被留下來。">
  <article class="expertise-page paper-page">
    <header class="expertise-hero page-paper paper-card">
      <div class="expertise-hero__topline">
        <p class="expertise-kicker">專業方法</p>
        <span>DIAGNOSTIC NOTES / 02</span>
      </div>
      <h1><span>AI 一直鬼打牆時，</span><span>問題通常不只在 Prompt。</span></h1>
      <div class="expertise-hero__footer">
        <p>多加幾條規則，有時只會讓指令更長。真正要先看的是：AI 拿到什麼資料、能使用哪些工具、做到哪裡算完成，以及做對一次的方法有沒有留下來。</p>
        <a class="text-link" href="#diagnosis">先從你看到的問題開始 <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
    </header>

    <section class="diagnosis page-paper paper-card paper-card--clip paper-card--clip-left" id="diagnosis" aria-labelledby="diagnosis-title">
      <header class="diagnosis__header">
        <div>
          <p class="expertise-kicker">先辨認現象</p>
          <h2 id="diagnosis-title">先找到最像的現象，再做一個能排除原因的檢查。</h2>
        </div>
        <p>不用先記住方法名稱。從你已經看到的失效現象開始，先找到下一個能驗證的問題。</p>
      </header>
      <div class="diagnosis-list">
        {diagnosticScenarios.map((scenario, index) => (
          <article>
            <div class="diagnosis-index"><span>0{index + 1}</span><small>{scenario.method}</small></div>
            <div class="diagnosis-symptom">
              <h3>{scenario.symptom}</h3>
              <p>{scenario.question}</p>
            </div>
            <dl class="diagnosis-checks">
              <div><dt>先檢查</dt><dd>{scenario.check}</dd></div>
              <div><dt>常見誤判</dt><dd>{scenario.mistake}</dd></div>
            </dl>
            <a class="text-link" href={scenario.href}>看一個實際排查過程 <ArrowRight size={15} aria-hidden="true" /></a>
          </article>
        ))}
      </div>
    </section>

    <section class="method-map page-paper paper-card" aria-labelledby="method-map-title">
      <header class="method-map__header">
        <div>
          <p class="expertise-kicker">方法對照</p>
          <h2 id="method-map-title">先知道要檢查哪一層，再決定用什麼方法。</h2>
        </div>
        <p>方法不是答案本身，而是幫你把問題縮小、留下檢查順序的工具。</p>
      </header>
      <div class="method-map__table">
        {signatureMethods.map((method, index) => (
          <article>
            <span class="method-map__index">0{index + 1}</span>
            <div class="method-map__definition"><h3>{method.title}</h3><p>{method.definition}</p></div>
            <div class="method-map__fit"><small>適合先看</small><p>{method.problem.replace('適合：', '')}</p></div>
          </article>
        ))}
      </div>
      <div class="method-map__boundary">
        <div><strong>判斷邊界</strong><p>不是每個問題都需要 Agent。如果表單、試算表或一般自動化就能穩定完成工作，就先用簡單的方法。</p></div>
        <a class="text-link" href="/articles/">閱讀對應問題文章 <ArrowRight size={16} aria-hidden="true" /></a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .expertise-page > .page-paper { overflow: clip; }
  .expertise-kicker { margin: 0 0 1rem; color: var(--accent); font-size: .72rem; font-weight: 700; letter-spacing: .1em; }
  .expertise-hero { padding-block: clamp(3.25rem, 7vw, 6.5rem) !important; }
  .expertise-hero__topline { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-bottom: 1.35rem; border-bottom: 1px solid var(--border); }
  .expertise-hero__topline p { margin: 0; }
  .expertise-hero__topline > span { color: var(--text-muted); font-family: var(--font-mono); font-size: .62rem; letter-spacing: .08em; }
  .expertise-hero h1 { max-width: none !important; margin: clamp(2.75rem, 6vw, 5.75rem) 0 0; font-family: var(--font-serif); font-size: clamp(3rem, 6.2vw, 6.1rem) !important; letter-spacing: -.075em !important; line-height: 1.02 !important; }
  .expertise-hero h1 span { display: block; }
  .expertise-hero__footer { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem; align-items: end; margin-top: 2.75rem; padding-top: 1.25rem; border-top: 1px solid var(--border); }
  .expertise-hero__footer p { max-width: 52rem; margin: 0; color: var(--text-secondary); font-size: 1rem; line-height: 1.85; }
  .expertise-hero__footer a { display: inline-flex; align-items: center; gap: .6rem; color: var(--accent); font-weight: 700; white-space: nowrap; }
  .diagnosis { padding-block: clamp(3.5rem, 7vw, 6.5rem) !important; }
  .diagnosis__header, .method-map__header { display: grid; grid-template-columns: minmax(0, 1fr) minmax(15rem, .62fr); gap: 2rem; align-items: end; padding-bottom: 2.5rem; border-bottom: 1px solid var(--border); }
  .diagnosis__header h2, .method-map__header h2 { max-width: 17ch; margin: 0; font-size: clamp(2.2rem, 4.6vw, 4.2rem); letter-spacing: -.055em; line-height: 1.06; }
  .diagnosis__header > p, .method-map__header > p { max-width: 23rem; margin: 0; color: var(--text-secondary); font-size: .86rem; line-height: 1.8; }
  .diagnosis-list { border-top: 1px solid var(--border-strong); }
  .diagnosis-list article { display: grid; grid-template-columns: 7rem minmax(0, 1.08fr) minmax(15rem, .92fr); grid-template-areas: "index symptom checks" ". link link"; gap: 1.25rem 1.5rem; padding: 1.75rem 0; border-bottom: 1px solid var(--border); }
  .diagnosis-list article:last-child { border-bottom: 0; padding-bottom: .35rem; }
  .diagnosis-index { grid-area: index; display: grid; align-content: start; gap: .45rem; }
  .diagnosis-index span { color: var(--accent); font-family: var(--font-mono); font-size: .7rem; }
  .diagnosis-index small { color: var(--text-muted); font-size: .66rem; line-height: 1.45; }
  .diagnosis-symptom { grid-area: symptom; min-width: 0; }
  .diagnosis-symptom h3 { margin: 0; font-size: 1.35rem; letter-spacing: -.025em; line-height: 1.45; }
  .diagnosis-symptom p { margin: .55rem 0 0; color: var(--text-secondary); line-height: 1.75; }
  .diagnosis-checks { grid-area: checks; display: grid; gap: .9rem; margin: 0; }
  .diagnosis-checks div { padding-top: .75rem; border-top: 1px solid var(--border); }
  .diagnosis-checks dt { color: var(--text-muted); font-size: .68rem; font-weight: 700; }
  .diagnosis-checks dd { margin: .4rem 0 0; color: var(--text-secondary); font-size: .82rem; line-height: 1.7; }
  .diagnosis-list article > .text-link { grid-area: link; justify-self: end; font-size: .78rem; }
  .method-map { padding-block: clamp(3.5rem, 7vw, 6.5rem) !important; }
  .method-map__table { border-top: 1px solid var(--border-strong); }
  .method-map__table article { display: grid; grid-template-columns: 3rem minmax(0, 1.15fr) minmax(15rem, .85fr); gap: 1.5rem; padding: 1.45rem 0; border-bottom: 1px solid var(--border); }
  .method-map__index { color: var(--accent); font-family: var(--font-mono); font-size: .7rem; }
  .method-map__definition h3 { margin: 0; font-size: 1.2rem; }
  .method-map__definition p, .method-map__fit p { margin: .4rem 0 0; color: var(--text-secondary); font-size: .84rem; line-height: 1.75; }
  .method-map__fit { padding-left: 1rem; border-left: 1px solid var(--border); }
  .method-map__fit small { color: var(--accent); font-size: .68rem; font-weight: 700; }
  .method-map__boundary { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem; align-items: end; margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid var(--border-strong); }
  .method-map__boundary strong { font-size: .82rem; }
  .method-map__boundary p { max-width: 45rem; margin: .4rem 0 0; color: var(--text-secondary); font-size: .84rem; line-height: 1.75; }
  .method-map__boundary a { display: inline-flex; align-items: center; gap: .6rem; color: var(--accent); font-weight: 700; white-space: nowrap; }
  @media (max-width: 800px) {
    .expertise-hero__footer, .diagnosis__header, .method-map__header, .method-map__boundary { grid-template-columns: 1fr; }
    .expertise-hero__footer { gap: 1.25rem; }
    .expertise-hero__footer a, .method-map__boundary a { justify-self: start; }
    .diagnosis__header, .method-map__header { gap: 1.25rem; }
    .diagnosis-list article { grid-template-columns: 3rem minmax(0, 1fr); grid-template-areas: "index symptom" "checks checks" "link link"; column-gap: 1rem; }
    .diagnosis-checks { grid-template-columns: 1fr 1fr; gap: 1rem; }
    .diagnosis-list article > .text-link { justify-self: start; }
    .method-map__table article { grid-template-columns: 3rem minmax(0, 1fr); grid-template-areas: "index definition" ". fit"; gap: .55rem 1rem; }
    .method-map__index { grid-area: index; }
    .method-map__definition { grid-area: definition; }
    .method-map__fit { grid-area: fit; padding: .75rem 0 0; border-top: 1px solid var(--border); border-left: 0; }
  }
  @media (max-width: 560px) {
    .expertise-page > .page-paper { padding-inline: 1.25rem !important; }
    .expertise-hero { padding-block: 2.4rem 3rem !important; }
    .expertise-hero__topline { padding-bottom: 1rem; }
    .expertise-hero__topline > span { font-size: .55rem; }
    .expertise-hero h1 { margin-top: 2.15rem; font-size: clamp(2.55rem, 11vw, 3.45rem) !important; line-height: 1.08 !important; }
    .expertise-hero__footer { margin-top: 2rem; }
    .expertise-hero__footer p { font-size: .9rem; }
    .diagnosis, .method-map { padding-block: 2.8rem !important; }
    .diagnosis__header, .method-map__header { padding-bottom: 1.7rem; }
    .diagnosis__header h2, .method-map__header h2 { font-size: clamp(2rem, 9vw, 2.8rem); }
    .diagnosis-list article { gap: .75rem 1rem; padding: 1.35rem 0; }
    .diagnosis-list article:first-child { padding-top: 1.2rem; }
    .diagnosis-checks { grid-template-columns: 1fr; gap: .75rem; }
    .diagnosis-symptom h3 { font-size: 1.15rem; }
    .diagnosis-symptom p, .diagnosis-checks dd { font-size: .84rem; }
    .method-map__table article { padding: 1.25rem 0; }
  }
</style>
