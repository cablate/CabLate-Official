---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkflowDiagnostic from '../components/sections/WorkflowDiagnostic.astro';
import AuthorCard from '../components/common/AuthorCard.astro';
import { ArrowDown, ArrowRight } from '@lucide/astro';
import { getServiceApplicationHref } from '../config/serviceApplication';

const nextSteps = [
  { label: '自己修得動', title: '照健檢結果，先修那一層', body: '多數問題修一層就會好很多。修完再拿同一件事跑一次，比較前後差在哪。', href: '/courses/', cta: '看課程與手冊' },
  { label: '修了還是卡', title: '60 分鐘專案卡關諮詢', body: '帶著健檢結果來，我們直接從卡住的那層開始看，排出先做什麼、先不做什麼。', href: '/services/consulting/', cta: '看諮詢怎麼進行' },
  { label: '整個團隊都這樣', title: '企業內訓或工作坊', body: '同一種錯在團隊裡反覆出現，通常是流程和驗收沒講好。用你們自己的工作來練。', href: getServiceApplicationHref('enterprise', 'expertise_next'), cta: '告訴我團隊的狀況' },
];
---

<BaseLayout
  title="AI 工作流健檢"
  description="免費的 AI 工作流健檢。拿一件最近 AI 做壞的事，照五個問題檢查題目、資料、工具、進度和驗收，找出先修哪一層。"
  image="/og/pages/expertise.png"
  imageAlt="AI 工作流健檢：AI 一直鬼打牆，先找出最值得修的一層。"
  imageWidth={1200}
  imageHeight={630}
>
  <article class="expertise-page">
    <header class="diagnostic-hero" aria-labelledby="expertise-title">
      <div class="diagnostic-hero__index" aria-hidden="true">
        <span>免費健檢</span>
        <strong>05</strong>
        <span>個問題</span>
      </div>
      <div class="diagnostic-hero__content">
        <p class="section-label">AI 工作流健檢</p>
        <h1 id="expertise-title">AI 一直鬼打牆，<br />先別急著改 Prompt。</h1>
        <p>拿一件最近 AI 做壞、重做過，或你不敢直接交出去的事。照順序問五個問題：題目、資料、工具、進度、驗收，看先修哪一層最划算。</p>
        <a
          class="btn btn-primary diagnostic-start"
          href="#workflow-check"
          aria-label="開始檢查一件 AI 做壞的事"
          data-diagnostic-start
        >
          開始檢查 <ArrowDown size={18} aria-hidden="true" />
        </a>
        <small>這份健檢幫你找出先修哪一層，不會替你判斷個案。填的內容只留在你的瀏覽器。</small>
      </div>
    </header>

    <WorkflowDiagnostic />

    <section class="diagnostic-next" aria-labelledby="diagnostic-next-title">
      <header>
        <p class="section-label">檢查完之後</p>
        <h2 id="diagnostic-next-title">找到該修哪一層，接下來看你的狀況</h2>
      </header>
      <div class="diagnostic-next__grid">
        {nextSteps.map((step) => (
          <article class="page-paper paper-card">
            <small>{step.label}</small>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
            <a href={step.href} data-analytics-placement="expertise_next">{step.cta} <ArrowRight size={15} aria-hidden="true" /></a>
          </article>
        ))}
      </div>
    </section>

    <AuthorCard label="這份健檢的作者" />
  </article>
</BaseLayout>

<style>
  .expertise-page {
    width: min(100%, 68rem);
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    margin-inline: auto;
    padding-block: 0.5rem 2rem;
  }

  .diagnostic-hero {
    display: grid;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .diagnostic-hero__index {
    display: inline-flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.45rem;
    width: fit-content;
    padding: 0.35rem 0.9rem;
    margin-bottom: 1rem;
    border: 1px solid var(--accent-border);
    border-radius: var(--radius-full);
    background: var(--accent-subtle);
    color: var(--accent-text);
    font-family: var(--font-mono);
    text-align: center;
  }

  .diagnostic-hero__index span {
    font-size: 0.76rem;
    letter-spacing: 0.08em;
  }

  .diagnostic-hero__index strong {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1;
  }

  .diagnostic-hero__content {
    display: grid;
    align-content: center;
    justify-items: start;
    padding: 0;
  }

  .diagnostic-hero h1 {
    max-width: 16em;
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.5vw, 2.85rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.24;
  }

  .diagnostic-hero__content > p:not(.section-label) {
    max-width: 43rem;
    margin: 1rem 0 0;
    color: var(--text-secondary);
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .diagnostic-start {
    margin-top: 1.5rem;
    white-space: nowrap;
  }

  .diagnostic-hero small {
    max-width: 42rem;
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.7;
  }

  .diagnostic-next { display: grid; gap: 1.5rem; padding-block: clamp(1rem, 3vw, 1.75rem) 0.5rem; }
  .diagnostic-next .section-label { margin: 0 0 0.4rem; }
  .diagnostic-next h2 { max-width: 18em; margin: 0; font-family: var(--font-serif); font-size: clamp(1.5rem, 2.4vw, 2rem); letter-spacing: -0.02em; line-height: 1.32; }
  .diagnostic-next__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  .diagnostic-next article { display: grid; align-content: start; gap: 0.6rem; background: var(--surface-elevated) !important; border: 1px solid var(--border) !important; border-radius: var(--radius-md) !important; padding: 1.5rem !important; box-shadow: var(--shadow-sm) !important; }
  .diagnostic-next small { color: var(--accent-text); font-size: 0.78rem; font-weight: 700; }
  .diagnostic-next h3 { margin: 0; font-size: 1.12rem; line-height: 1.4; }
  .diagnostic-next p { margin: 0; color: var(--text-secondary); font-size: 0.94rem; line-height: 1.72; }
  .diagnostic-next a { display: inline-flex; align-items: center; gap: 0.35rem; margin-top: 0.5rem; color: var(--accent-text); font-size: 0.92rem; font-weight: 700; }
  .diagnostic-next a:hover { color: var(--accent-hover); }

  @media (max-width: 860px) {
    .diagnostic-next__grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 700px) {
    .diagnostic-next { padding-inline: 0; }
    .expertise-page { gap: 2rem; padding-block: 0; }
    .diagnostic-hero__content { padding: 0; }
    .diagnostic-hero h1 { font-size: clamp(1.75rem, 6.2vw, 2.2rem); }
    .diagnostic-start { width: 100%; white-space: normal; }
  }
</style>
