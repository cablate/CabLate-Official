---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkflowDiagnostic from '../components/sections/WorkflowDiagnostic.astro';
import { ArrowDown } from '@lucide/astro';
---

<BaseLayout
  title="AI 工作流健檢"
  description="拿一個真的失敗、重做或不敢交付的 AI 任務，依序檢查題目、資料、工具、狀態與驗收，找出最值得先修的一層。"
  image="/og/pages/expertise.png"
  imageAlt="AI 工作流健檢：AI 一直鬼打牆，先找出最值得修的一層。"
  imageWidth={1200}
  imageHeight={630}
>
  <article class="expertise-page" data-content-state="testing">
    <header class="diagnostic-hero" aria-labelledby="expertise-title">
      <div class="diagnostic-hero__index" aria-hidden="true">
        <span>AI WORKFLOW</span>
        <strong>05</strong>
        <span>LAYERS</span>
      </div>
      <div class="diagnostic-hero__content">
        <p class="section-label">AI 工作流健檢</p>
        <h1 id="expertise-title">AI 一直鬼打牆，<br />先別只改 Prompt。</h1>
        <p>拿一個最近真的失敗過、重做過，或不敢直接交付的任務。依序檢查題目、資料、工具、狀態與驗收，先找出最值得修的一層。</p>
        <a
          class="btn btn-primary diagnostic-start"
          href="#workflow-check"
          aria-label="開始檢查一個真實 AI 工作任務"
          data-diagnostic-start
        >
          開始檢查一個真實任務 <ArrowDown size={18} aria-hidden="true" />
        </a>
        <small>這份健檢提供排查方向，不會自動替你完成個案診斷，也不保證單次修改能解決所有問題。</small>
      </div>
    </header>

    <WorkflowDiagnostic />
  </article>
</BaseLayout>

<style>
  .expertise-page {
    width: min(100%, 76rem);
    display: grid;
    gap: 1rem;
    margin-inline: auto;
    padding-block: 1rem 2rem;
  }

  .diagnostic-hero {
    min-height: min(72vh, 46rem);
    display: grid;
    grid-template-columns: minmax(9rem, .28fr) minmax(0, 1fr);
    border: 1px solid var(--border-strong);
    background: var(--bg-soft);
  }

  .diagnostic-hero__index {
    display: grid;
    align-content: space-between;
    justify-items: center;
    padding: 2rem 1rem;
    border-right: 1px solid var(--border);
    color: var(--accent-text);
    font-family: var(--font-mono);
    text-align: center;
  }

  .diagnostic-hero__index span {
    font-size: .64rem;
    letter-spacing: .12em;
    writing-mode: vertical-rl;
  }

  .diagnostic-hero__index strong {
    font-family: var(--font-serif);
    font-size: clamp(4rem, 10vw, 8rem);
    font-weight: 400;
    line-height: 1;
  }

  .diagnostic-hero__content {
    display: grid;
    align-content: center;
    justify-items: start;
    padding: clamp(2rem, 7vw, 6rem);
  }

  .diagnostic-hero h1 {
    max-width: 14ch;
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 6vw, 5.2rem);
    font-weight: 700;
    letter-spacing: -.055em;
    line-height: 1.18;
  }

  .diagnostic-hero__content > p:not(.section-label) {
    max-width: 43rem;
    margin: 1.5rem 0 0;
    color: var(--text-secondary);
    font-size: clamp(1rem, 2vw, 1.12rem);
    line-height: 1.9;
  }

  .diagnostic-start {
    margin-top: 2rem;
    white-space: nowrap;
  }

  .diagnostic-hero small {
    max-width: 42rem;
    margin-top: 1.25rem;
    color: var(--text-muted);
    font-size: .75rem;
    line-height: 1.7;
  }

  @media (max-width: 700px) {
    .expertise-page { gap: .65rem; padding-block: 0; }
    .diagnostic-hero { min-height: auto; grid-template-columns: 3rem minmax(0, 1fr); }
    .diagnostic-hero__index { padding: 1.25rem .5rem; }
    .diagnostic-hero__index strong { font-size: 2rem; }
    .diagnostic-hero__content { padding: 2.25rem 1.25rem 2.5rem; }
    .diagnostic-hero h1 { font-size: clamp(2rem, 10vw, 3rem); }
    .diagnostic-start { width: 100%; white-space: normal; }
  }
</style>
