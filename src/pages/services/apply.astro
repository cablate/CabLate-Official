---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ArrowLeft, Check, Send, ShieldCheck } from '@lucide/astro';
import { siteConfig } from '../../config/siteConfig';
import { serviceApplicationOptions, serviceApplicationVersion } from '../../config/serviceApplication';
import '../../styles/service-application.css';

const serviceCopy = Object.fromEntries(serviceApplicationOptions.map((option) => [option.id, {
  label: option.label,
  summary: option.summary,
  offerNote: option.offerNote,
  situationLabel: option.situationLabel,
  situationHelp: option.situationHelp,
  situationPlaceholder: 'situationPlaceholder' in option ? option.situationPlaceholder : '',
  responseNote: option.responseNote,
  applicationCopy: 'applicationCopy' in option ? option.applicationCopy : null,
}]));
---

<BaseLayout
  title="提出服務申請"
  description="簡短告訴我你正在做什麼、目前卡在哪裡。我會依照你的需求，回覆 60 分鐘付費諮詢、陪跑免費聊聊或其他合作的下一步。"
  noindex={true}
>
  <article class="application-page paper-page">
    <nav class="application-shell application-back" aria-label="服務導覽">
      <a href="/services/"><ArrowLeft size={16} aria-hidden="true" />回到合作方式</a>
    </nav>

    <div class="application-shell application-stage">
      <header class="application-hero page-paper paper-card">
        <div class="application-selected-service" data-selected-service hidden>
          <label for="selected-service-control">
            <span>選擇你想申請的服務</span>
            <select id="selected-service-control" data-service-select>
              {serviceApplicationOptions.map((option) => (
                <option value={option.id}>{option.label}</option>
              ))}
            </select>
          </label>
          <div class="application-route-feedback" aria-live="polite" aria-atomic="true">
            <p data-route-summary></p>
            <p class="application-route-offer" data-route-offer hidden><strong>優惠說明</strong><span data-route-offer-text></span></p>
          </div>
        </div>

        <div>
          <p class="section-label" data-hero-label>先確認怎麼聊</p>
          <h1 class="display-heading" data-hero-title>先讓我看懂，你現在要處理什麼。</h1>
          <p data-hero-description>告訴我你正在做的事、目前卡住的地方，以及這次最需要什麼。我會依照你選的方式準備下一步。</p>
        </div>
        <aside aria-labelledby="application-next-title">
          <h2 id="application-next-title" data-next-title>我收到後會怎麼做</h2>
          <p><span data-next-first-step>Cab 會親自看問題與服務是否適合。</span><span data-application-response>適合的話，我會回覆下一步與可選時間。</span><span>不適合或還缺資料，我也會直接說。</span></p>
        </aside>
      </header>

      <section class="application-form-card page-paper paper-card" aria-labelledby="application-form-title">
      <header>
        <p class="section-label" data-form-label>簡短申請</p>
        <h2 id="application-form-title" data-form-title>留幾個關鍵資訊就好。</h2>
        <p data-form-description>只有姓名、Email 和兩個問題；其他資料有需要再補。</p>
        <ul class="application-trust-strip" aria-label="申請資料處理原則">
          <li><Check size={16} aria-hidden="true" />Cab 親自閱讀</li>
          <li><Check size={16} aria-hidden="true" />不適合也會直接說</li>
        </ul>
      </header>

      <form
        id="service-application-form"
        action="/api/service-application"
        method="post"
        novalidate={true}
        data-application-version={serviceApplicationVersion}
        data-contact-email={siteConfig.contactEmail}
        data-service-copy={JSON.stringify(serviceCopy)}
      >
        <input type="hidden" name="application_version" value={serviceApplicationVersion} />
        <input type="hidden" name="submission_id" value="" />
        <input type="hidden" name="source_path" value="/services/apply/" />
        <input type="hidden" name="source_key" value="direct" />
        <input type="hidden" name="utm_source" value="" />
        <input type="hidden" name="utm_medium" value="" />
        <input type="hidden" name="utm_campaign" value="" />
        <input type="hidden" name="utm_content" value="" />
        <div class="application-honeypot" aria-hidden="true">
          <label for="applicant-website">網站</label>
          <input id="applicant-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <fieldset class="application-choice" data-service-choice>
          <legend>這次比較接近哪一種需求？ <span class="application-required">必填</span></legend>
          <p id="service-choice-help">不知道也沒關係，選最接近的就好；我看完後仍會幫你判斷。</p>
          <div class="application-choice__grid">
            {serviceApplicationOptions.map((option) => (
              <label>
                <input id={`service-${option.id}`} type="radio" name="service" value={option.id} required aria-describedby="service-choice-help service-choice-error" />
                <span><strong>{option.shortLabel}</strong><small>{option.summary}</small></span>
              </label>
            ))}
          </div>
          <div class="application-route-feedback application-route-feedback--choice" data-service-choice-feedback hidden aria-live="polite" aria-atomic="true">
            <strong data-route-label></strong>
            <p data-route-summary></p>
            <p class="application-route-offer" data-route-offer hidden><strong>優惠說明</strong><span data-route-offer-text></span></p>
          </div>
          <p id="service-choice-error" class="application-error"><span aria-hidden="true">!</span>請先選一個最接近的方式。</p>
        </fieldset>

        <fieldset>
          <legend>先留一個能回覆你的方式</legend>
          <div class="application-field-grid">
            <div class="application-field">
              <label for="applicant-name">你的姓名 <span class="application-required">必填</span></label>
              <input id="applicant-name" name="name" type="text" autocomplete="name" maxlength="80" enterkeyhint="next" required aria-describedby="applicant-name-error" />
              <p id="applicant-name-error" class="application-error"><span aria-hidden="true">!</span>請填寫姓名。</p>
            </div>
            <div class="application-field">
              <label for="applicant-email">聯絡 Email <span class="application-required">必填</span></label>
              <input id="applicant-email" name="email" type="email" inputmode="email" autocomplete="email" maxlength="160" enterkeyhint="next" required aria-describedby="applicant-email-help applicant-email-error" />
              <p id="applicant-email-help" class="application-help">只用於回覆這次申請。</p>
              <p id="applicant-email-error" class="application-error"><span aria-hidden="true">!</span>請填寫可正常收信的 Email。</p>
            </div>
          </div>
        </fieldset>

        <div class="application-single-field">
          <div class="application-field">
            <label for="applicant-situation"><span data-situation-label>你想做的是什麼？做到哪裡卡住了？</span> <span class="application-required">必填</span></label>
            <textarea id="applicant-situation" name="situation" rows="5" minlength="20" maxlength="1600" required aria-describedby="situation-help situation-error" placeholder="簡單寫你正在做什麼、目前做到哪裡，以及接下來最難決定的事。"></textarea>
            <p id="situation-help" class="application-help" data-situation-help>簡單交代情境和卡點即可，不需要先整理成完整企劃書。</p>
            <p id="situation-error" class="application-error"><span aria-hidden="true">!</span>請再多說一點，至少 20 個字，讓我看得懂你正在做什麼、卡在哪裡。</p>
          </div>
        </div>

        {serviceApplicationOptions.map((option) => (
          <fieldset class="application-focus" data-focus-group={option.id} hidden>
            <legend>{option.focusQuestion} <span class="application-required">必填</span></legend>
            <div class="application-focus__grid">
              {option.focusOptions.map((focus) => (
                <label>
                  <input id={`focus-${option.id}-${focus.id}`} type="radio" name="focus" value={focus.id} disabled aria-describedby={`focus-${option.id}-error`} />
                  <span><strong>{focus.label}</strong><small>{focus.summary}</small></span>
                </label>
              ))}
            </div>
            <p id={`focus-${option.id}-error`} class="application-error"><span aria-hidden="true">!</span>請選擇一個最接近的狀況。</p>
          </fieldset>
        ))}

        <details class="application-optional">
          <summary>有時間限制或參考連結，再補充</summary>
          <div class="application-optional__body">
            <div class="application-field">
              <label for="applicant-organization">公司或團隊名稱 <span class="application-optional-marker">選填</span></label>
              <input id="applicant-organization" name="organization" type="text" autocomplete="organization" maxlength="120" />
            </div>
            <div class="application-field">
              <label for="preferred-timing">希望什麼時候開始或進行？ <span class="application-optional-marker">選填</span></label>
              <input id="preferred-timing" name="preferred_timing" type="text" maxlength="120" placeholder="例如：九月、活動前兩週、時間都可以討論" />
            </div>
            <div class="application-field">
              <label for="reference-links">有沒有我可以先看的公開連結？ <span class="application-optional-marker">選填</span></label>
              <textarea id="reference-links" name="reference_links" rows="3" maxlength="1000" aria-describedby="reference-links-help"></textarea>
              <p id="reference-links-help" class="application-help">一行一個。不要貼內網網址或任何敏感資料。</p>
            </div>
          </div>
        </details>

        <div class="application-verification" aria-labelledby="verification-title">
          <div><ShieldCheck size={20} aria-hidden="true" /><strong id="verification-title">安全檢查</strong></div>
          <div data-turnstile-container></div>
          <p data-turnstile-status role="status">正在準備安全檢查……</p>
        </div>

        <div id="application-error-summary" class="application-error-summary" role="alert" tabindex="-1" hidden>
          <strong>還有幾個地方需要確認。</strong>
          <p data-error-summary-message>請回到第一個標示錯誤的欄位修改。</p>
          <ul data-error-list></ul>
        </div>

        <noscript>
          <p class="application-noscript">這份表單需要 JavaScript 才能完成安全驗證。你也可以直接寄信到 <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>，簡單說明想處理的事與目前卡點。</p>
        </noscript>

        <div class="application-submit">
          <button class="btn btn-primary" type="submit"><span data-submit-label>送出申請</span> <Send size={18} aria-hidden="true" /></button>
          <p data-submit-note>送出不會自動扣款或保留時段。我確認適合後，才會回覆付款或訪談安排。</p>
        </div>
      </form>

      <section id="application-ready" class="application-ready" aria-labelledby="application-ready-title" aria-live="polite" hidden>
        <div tabindex="-1" data-ready-focus>
          <p class="section-label" data-ready-label>申請已送出</p>
          <h2 id="application-ready-title" data-ready-title>接下來我會先看你寫的內容。</h2>
          <p data-ready-message>我會用你留下的 Email 回覆是否適合，以及接下來怎麼進行。</p>
          <p class="application-ready__email">回覆會寄到：<strong data-ready-email></strong></p>
          <p class="application-ready__id">申請編號：<strong data-lead-id></strong></p>
        </div>
        <a class="btn btn-ghost" href="/services/">回到合作方式</a>
      </section>
      </section>
    </div>

    <aside class="application-shell application-boundary page-paper paper-card" aria-labelledby="application-boundary-title" data-application-boundary>
      <div>
        <p class="section-label">兩條路的差別</p>
        <h2 id="application-boundary-title">如果你還不知道該選哪一個，差別其實很簡單。</h2>
      </div>
      <ul>
        <li><Check size={17} aria-hidden="true" /><span><strong>你有一個具體問題，想用 60 分鐘直接拆開處理：</strong>選付費諮詢。</span></li>
        <li><Check size={17} aria-hidden="true" /><span><strong>你想找人陪著做五週：</strong>先送陪跑申請，我會挑適合的人免費聊 30 分鐘。</span></li>
        <li><Check size={17} aria-hidden="true" /><span>選錯沒關係，我看完會直接告訴你哪一個比較適合。</span></li>
      </ul>
    </aside>
  </article>
</BaseLayout>

<script>
  import { trackAnalyticsEvent, type ServiceId } from '../../lib/analytics-client';

  declare global {
    interface Window {
      turnstile?: {
        render: (container: HTMLElement, options: Record<string, unknown>) => string;
        reset: (widgetId?: string) => void;
      };
    }
  }

  const loadTurnstile = () => new Promise<void>((resolve, reject) => {
    if (window.turnstile) {
      resolve();
      return;
    }

    const existing = document.querySelector<HTMLScriptElement>('script[data-cablate-turnstile]');
    if (existing) {
      existing.addEventListener('load', () => resolve(), { once: true });
      existing.addEventListener('error', () => reject(new Error('turnstile-load-failed')), { once: true });
      return;
    }

    const script = document.createElement('script');
    script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
    script.async = true;
    script.defer = true;
    script.dataset.cablateTurnstile = 'true';
    script.addEventListener('load', () => resolve(), { once: true });
    script.addEventListener('error', () => reject(new Error('turnstile-load-failed')), { once: true });
    document.head.append(script);
  });

  const initializeServiceApplication = () => {
    const form = document.querySelector<HTMLFormElement>('#service-application-form');
    if (!form || form.dataset.ready === 'true') return;
    form.noValidate = true;

    const readyPanel = document.querySelector<HTMLElement>('#application-ready');
    const readyFocus = document.querySelector<HTMLElement>('[data-ready-focus]');
    const errorSummary = document.querySelector<HTMLElement>('#application-error-summary');
    const errorSummaryMessage = document.querySelector<HTMLElement>('[data-error-summary-message]');
    const errorList = document.querySelector<HTMLUListElement>('[data-error-list]');
    const leadIdOutput = document.querySelector<HTMLElement>('[data-lead-id]');
    const readyEmail = document.querySelector<HTMLElement>('[data-ready-email]');
    const readyMessage = document.querySelector<HTMLElement>('[data-ready-message]');
    const readyLabel = document.querySelector<HTMLElement>('[data-ready-label]');
    const readyTitle = document.querySelector<HTMLElement>('[data-ready-title]');
    const responseNote = document.querySelector<HTMLElement>('[data-application-response]');
    const situationLabel = document.querySelector<HTMLElement>('[data-situation-label]');
    const situationHelp = document.querySelector<HTMLElement>('[data-situation-help]');
    const situationInput = document.querySelector<HTMLTextAreaElement>('#applicant-situation');
    const heroLabel = document.querySelector<HTMLElement>('[data-hero-label]');
    const heroTitle = document.querySelector<HTMLElement>('[data-hero-title]');
    const heroDescription = document.querySelector<HTMLElement>('[data-hero-description]');
    const nextTitle = document.querySelector<HTMLElement>('[data-next-title]');
    const nextFirstStep = document.querySelector<HTMLElement>('[data-next-first-step]');
    const formLabel = document.querySelector<HTMLElement>('[data-form-label]');
    const formTitle = document.querySelector<HTMLElement>('[data-form-title]');
    const formDescription = document.querySelector<HTMLElement>('[data-form-description]');
    const submitNote = document.querySelector<HTMLElement>('[data-submit-note]');
    const selectedServicePanel = document.querySelector<HTMLElement>('[data-selected-service]');
    const serviceSelect = document.querySelector<HTMLSelectElement>('[data-service-select]');
    const serviceChoice = document.querySelector<HTMLElement>('[data-service-choice]');
    const serviceChoiceFeedback = document.querySelector<HTMLElement>('[data-service-choice-feedback]');
    const applicationBoundary = document.querySelector<HTMLElement>('[data-application-boundary]');
    const turnstileContainer = document.querySelector<HTMLElement>('[data-turnstile-container]');
    const turnstileStatus = document.querySelector<HTMLElement>('[data-turnstile-status]');
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]');
    type ApplicationCopy = {
      heroLabel: string;
      heroTitle: string;
      heroDescription: string;
      nextTitle: string;
      nextFirstStep: string;
      formLabel: string;
      formTitle: string;
      formDescription: string;
      submitLabel: string;
      submitNote: string;
    };
    const serviceCopy = JSON.parse(form.dataset.serviceCopy ?? '{}') as Record<string, {
      label: string;
      summary: string;
      offerNote: string;
      situationLabel: string;
      situationHelp: string;
      situationPlaceholder: string;
      responseNote: string;
      applicationCopy: ApplicationCopy | null;
    }>;
    const defaultApplicationCopy: ApplicationCopy = {
      heroLabel: heroLabel?.textContent?.trim() ?? '',
      heroTitle: heroTitle?.textContent?.trim() ?? '',
      heroDescription: heroDescription?.textContent?.trim() ?? '',
      nextTitle: nextTitle?.textContent?.trim() ?? '',
      nextFirstStep: nextFirstStep?.textContent?.trim() ?? '',
      formLabel: formLabel?.textContent?.trim() ?? '',
      formTitle: formTitle?.textContent?.trim() ?? '',
      formDescription: formDescription?.textContent?.trim() ?? '',
      submitLabel: submitLabel?.textContent?.trim() ?? '送出申請',
      submitNote: submitNote?.textContent?.trim() ?? '',
    };
    const params = new URLSearchParams(window.location.search);
    const safeAttribution = (value: string | null, fallback = '') => value && /^[A-Za-z0-9._~-]{1,100}$/.test(value) ? value : fallback;
    const analyticsServices = new Set<ServiceId>(['consulting', 'coaching', 'enterprise', 'partnerships']);
    const analyticsSources = new Set(['direct', 'coaching_page', 'consulting_page', 'enterprise_page', 'partnerships_page', 'services_page']);
    const analyticsService = (): ServiceId | 'unknown' => {
      const value = form.querySelector<HTMLInputElement>('input[name="service"]:checked')?.value;
      return value && analyticsServices.has(value as ServiceId) ? value as ServiceId : 'unknown';
    };
    const analyticsSource = () => {
      const value = params.get('source');
      return value && analyticsSources.has(value) ? value : 'direct';
    };
    let turnstileWidgetId = '';
    let turnstileToken = '';
    let turnstileReady = false;
    let turnstileTokenWaiters: Array<() => void> = [];
    let currentSubmitLabel = defaultApplicationCopy.submitLabel;
    let invalidSummaryTimer = 0;

    const applyApplicationCopy = (copy: ApplicationCopy) => {
      if (heroLabel) heroLabel.textContent = copy.heroLabel;
      if (heroTitle) heroTitle.textContent = copy.heroTitle;
      if (heroDescription) heroDescription.textContent = copy.heroDescription;
      if (nextTitle) nextTitle.textContent = copy.nextTitle;
      if (nextFirstStep) nextFirstStep.textContent = copy.nextFirstStep;
      if (formLabel) formLabel.textContent = copy.formLabel;
      if (formTitle) formTitle.textContent = copy.formTitle;
      if (formDescription) formDescription.textContent = copy.formDescription;
      if (submitNote) submitNote.textContent = copy.submitNote;
      currentSubmitLabel = copy.submitLabel;
      if (submitLabel) submitLabel.textContent = currentSubmitLabel;
    };

    const setHiddenValue = (name: string, value: string) => {
      const input = form.elements.namedItem(name);
      if (input instanceof HTMLInputElement) input.value = value;
    };

    setHiddenValue('submission_id', crypto.randomUUID());
    setHiddenValue('source_path', window.location.pathname);
    setHiddenValue('source_key', safeAttribution(params.get('source'), 'direct'));
    for (const key of ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content']) {
      setHiddenValue(key, safeAttribution(params.get(key)));
    }

    const updateService = (serviceId: string, collapseChoice = false) => {
      form.querySelectorAll<HTMLElement>('[data-focus-group]').forEach((group) => {
        const active = group.dataset.focusGroup === serviceId;
        group.hidden = !active;
        group.querySelectorAll<HTMLInputElement>('input[name="focus"]').forEach((input) => {
          input.disabled = !active;
          input.required = active;
          if (!active) {
            input.checked = false;
            input.removeAttribute('aria-invalid');
          }
        });
      });

      const copy = serviceCopy[serviceId];
      if (copy) {
        document.querySelectorAll<HTMLElement>('[data-route-label]').forEach((element) => {
          element.textContent = copy.label;
        });
        document.querySelectorAll<HTMLElement>('[data-route-summary]').forEach((element) => {
          element.textContent = copy.summary;
        });
        document.querySelectorAll<HTMLElement>('[data-route-offer]').forEach((element) => {
          element.hidden = !copy.offerNote;
        });
        document.querySelectorAll<HTMLElement>('[data-route-offer-text]').forEach((element) => {
          element.textContent = copy.offerNote;
        });
        if (situationLabel) situationLabel.textContent = copy.situationLabel;
        if (situationHelp) situationHelp.textContent = copy.situationHelp;
        if (situationInput) situationInput.placeholder = copy.situationPlaceholder || '簡單寫你正在做什麼、目前做到哪裡，以及接下來最難決定的事。';
        if (responseNote) responseNote.textContent = copy.responseNote;
        applyApplicationCopy(copy.applicationCopy ?? defaultApplicationCopy);
      }

      if (applicationBoundary) applicationBoundary.hidden = serviceId === 'coaching';

      if (serviceSelect && Array.from(serviceSelect.options).some((option) => option.value === serviceId)) {
        serviceSelect.value = serviceId;
      }

      if (collapseChoice && serviceChoice && selectedServicePanel) {
        serviceChoice.hidden = true;
        selectedServicePanel.hidden = false;
      } else if (serviceChoiceFeedback) {
        serviceChoiceFeedback.hidden = false;
      }
    };

    const selectedService = safeAttribution(params.get('service'));
    const selectedRadio = form.querySelector<HTMLInputElement>(`input[name="service"][value="${selectedService}"]`);
    if (selectedRadio) {
      selectedRadio.checked = true;
      updateService(selectedService, true);
    }

    form.querySelectorAll<HTMLInputElement>('input[name="service"]').forEach((radio) => {
      radio.addEventListener('change', () => {
        updateService(radio.value);
        if (analyticsServices.has(radio.value as ServiceId)) {
          trackAnalyticsEvent({ name: 'service_choice_change', properties: { service: radio.value as ServiceId } });
        }
      });
    });

    serviceSelect?.addEventListener('change', () => {
      const radio = form.querySelector<HTMLInputElement>(`input[name="service"][value="${serviceSelect.value}"]`);
      if (!radio) return;
      radio.checked = true;
      updateService(radio.value, true);
      if (analyticsServices.has(radio.value as ServiceId)) {
        trackAnalyticsEvent({ name: 'service_choice_change', properties: { service: radio.value as ServiceId } });
      }
    });

    form.addEventListener('focusin', () => {
      trackAnalyticsEvent({ name: 'form_start', properties: { service: analyticsService(), source: analyticsSource() } });
    }, { once: true });

    const controls = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input, textarea, select'));
    const fieldLabels: Record<string, string> = {
      service: '選擇合作方式',
      name: '填寫姓名',
      email: '確認聯絡 Email',
      situation: '補充你正在做的事與目前卡點',
      focus: '選擇一個最接近的選項',
      turnstile: '完成安全檢查',
    };
    const getFieldControl = (field: string) => {
      const named = form.elements.namedItem(field);
      if (named instanceof RadioNodeList) return Array.from(named).find((control) => control instanceof HTMLInputElement && !control.disabled) as HTMLInputElement | undefined;
      if (named instanceof HTMLInputElement || named instanceof HTMLTextAreaElement || named instanceof HTMLSelectElement) return named;
      return undefined;
    };
    const showErrorSummary = (message: string, fields: string[] = []) => {
      if (!errorSummary) return;
      errorSummary.hidden = false;
      if (errorSummaryMessage) errorSummaryMessage.textContent = message;
      if (errorList) {
        errorList.replaceChildren();
        [...new Set(fields)].forEach((field) => {
          const control = getFieldControl(field);
          const label = fieldLabels[field];
          if (!control || !label) return;
          const item = document.createElement('li');
          const button = document.createElement('button');
          button.type = 'button';
          button.textContent = label;
          button.addEventListener('click', () => control.focus());
          item.append(button);
          errorList.append(item);
        });
      }
      errorSummary.focus();
    };
    const syncAriaInvalid = (control: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement) => {
      if (!control.validity.valid) control.setAttribute('aria-invalid', 'true');
      else control.removeAttribute('aria-invalid');
    };

    form.addEventListener('blur', (event) => {
      const control = event.target;
      if (control instanceof HTMLInputElement || control instanceof HTMLTextAreaElement || control instanceof HTMLSelectElement) syncAriaInvalid(control);
    }, true);

    form.addEventListener('input', (event) => {
      const control = event.target;
      if ((control instanceof HTMLInputElement || control instanceof HTMLTextAreaElement || control instanceof HTMLSelectElement) && control.hasAttribute('aria-invalid')) syncAriaInvalid(control);
    });

    form.addEventListener('invalid', (event) => {
      const control = event.target;
      if (control instanceof HTMLInputElement || control instanceof HTMLTextAreaElement || control instanceof HTMLSelectElement) syncAriaInvalid(control);
      window.clearTimeout(invalidSummaryTimer);
      invalidSummaryTimer = window.setTimeout(() => {
        const invalidFields = controls
          .filter((candidate) => !candidate.disabled && !candidate.validity.valid && candidate.name)
          .map((candidate) => candidate.name);
        showErrorSummary('請從下面的項目回去修改。', invalidFields);
      }, 0);
    }, true);

    const resetTurnstile = () => {
      turnstileToken = '';
      if (turnstileWidgetId && window.turnstile) window.turnstile.reset(turnstileWidgetId);
    };

    const resolveTurnstileWaiters = () => {
      const waiters = turnstileTokenWaiters.splice(0);
      waiters.forEach((resolve) => resolve());
    };

    const waitForTurnstileToken = () => {
      if (turnstileToken) return Promise.resolve(true);
      return new Promise<boolean>((resolve) => {
        let timeoutId = 0;
        const finish = () => {
          window.clearTimeout(timeoutId);
          turnstileTokenWaiters = turnstileTokenWaiters.filter((waiter) => waiter !== finish);
          resolve(Boolean(turnstileToken));
        };
        timeoutId = window.setTimeout(finish, 8000);
        turnstileTokenWaiters.push(finish);
      });
    };

    const prepareTurnstile = async () => {
      if (!turnstileContainer || !turnstileStatus) return;
      try {
        const configResponse = await fetch('/api/service-application', { headers: { accept: 'application/json' } });
        const config = await configResponse.json() as { ok?: boolean; turnstileSiteKey?: string; action?: string; message?: string };
        if (!configResponse.ok || !config.turnstileSiteKey) throw new Error(config.message || 'turnstile-config-failed');
        await loadTurnstile();
        if (!window.turnstile) throw new Error('turnstile-unavailable');
        turnstileWidgetId = window.turnstile.render(turnstileContainer, {
          sitekey: config.turnstileSiteKey,
          action: config.action || 'service_application',
          appearance: 'interaction-only',
          theme: 'light',
          callback: (token: string) => {
            turnstileToken = token;
            turnstileReady = true;
            turnstileStatus.textContent = '可以送出了。';
            resolveTurnstileWaiters();
          },
          'expired-callback': () => {
            turnstileToken = '';
            turnstileStatus.textContent = '安全檢查已過期，請再試一次。';
          },
          'error-callback': () => {
            turnstileToken = '';
            turnstileStatus.textContent = '安全檢查暫時無法完成，請重新整理後再試。';
            resolveTurnstileWaiters();
          },
        });
        turnstileReady = true;
        turnstileStatus.textContent = '安全檢查會在送出時自動完成。';
      } catch {
        turnstileReady = false;
        turnstileStatus.innerHTML = `表單驗證暫時無法載入。請稍後再試，或直接寄信到 <a href="mailto:${form.dataset.contactEmail}">${form.dataset.contactEmail}</a>。`;
      }
    };

    void prepareTurnstile();

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      trackAnalyticsEvent({ name: 'form_submit_attempt', properties: { service: analyticsService() } });
      if (!form.checkValidity()) {
        const invalidFields: string[] = [];
        controls.forEach((control) => {
          if (control.disabled) return;
          syncAriaInvalid(control);
          if (!control.validity.valid && control.name) invalidFields.push(control.name);
        });
        showErrorSummary('請從下面的項目回去修改。', invalidFields);
        trackAnalyticsEvent({ name: 'form_submit_invalid', properties: { service: analyticsService(), reason: 'client_validation' } });
        return;
      }

      if (!turnstileReady) {
        showErrorSummary('安全檢查尚未載入，請稍等一下再送出。', ['turnstile']);
        trackAnalyticsEvent({ name: 'form_submit_invalid', properties: { service: analyticsService(), reason: 'turnstile_not_ready' } });
        return;
      }

      if (errorSummary) errorSummary.hidden = true;
      form.setAttribute('aria-busy', 'true');
      if (submitButton) submitButton.disabled = true;
      if (!turnstileToken) {
        if (submitLabel) submitLabel.textContent = '正在完成安全檢查……';
        const tokenReady = await waitForTurnstileToken();
        if (!tokenReady) {
          form.removeAttribute('aria-busy');
          if (submitButton) submitButton.disabled = false;
          if (submitLabel) submitLabel.textContent = currentSubmitLabel;
          showErrorSummary('安全檢查暫時沒有完成，請再送出一次。', ['turnstile']);
          trackAnalyticsEvent({ name: 'form_submit_invalid', properties: { service: analyticsService(), reason: 'turnstile_timeout' } });
          return;
        }
      }
      if (submitLabel) submitLabel.textContent = '正在送出……';

      const data = new FormData(form);
      const payload = Object.fromEntries(data.entries()) as Record<string, unknown>;
      payload.cf_turnstile_response = turnstileToken;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await response.json() as { ok?: boolean; leadId?: string; delivery?: 'dry_run' | 'email_sent'; message?: string; fields?: Record<string, string> };
        if (!response.ok || !result.ok || !result.leadId) {
          throw Object.assign(new Error(result.message || 'submit-failed'), { result });
        }

        if (leadIdOutput) leadIdOutput.textContent = result.leadId;
        if (readyEmail) readyEmail.textContent = String(data.get('email') || '');
        if (readyMessage) readyMessage.textContent = result.message || '我會先看你寫的內容。如果這次陪跑適合，我會寄信邀請你免費聊 30 分鐘。';
        if (result.delivery === 'dry_run') {
          if (readyLabel) readyLabel.textContent = '測試資料已接受';
          if (readyTitle) readyTitle.textContent = '這次沒有寄出 Email。';
        }
        trackAnalyticsEvent({
          name: 'generate_lead',
          properties: {
            service: analyticsService(),
            source: analyticsSource(),
            delivery: result.delivery === 'dry_run' ? 'dry_run' : 'email_sent',
          },
        });
        form.hidden = true;
        if (readyPanel) {
          readyPanel.hidden = false;
          readyPanel.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
          readyFocus?.focus({ preventScroll: true });
        }
      } catch (error) {
        resetTurnstile();
        const result = error && typeof error === 'object' && 'result' in error ? (error as { result?: { message?: string; fields?: Record<string, string> } }).result : undefined;
        const serverFields = Object.keys(result?.fields ?? {});
        serverFields.forEach((field) => {
          const control = getFieldControl(field);
          control?.setAttribute('aria-invalid', 'true');
        });
        if (serverFields.length > 0) {
          showErrorSummary(result?.message || '還有幾個地方需要確認。', serverFields);
        } else {
          showErrorSummary(result?.message || `資料還沒有送出。請稍後再試，或直接寄到 ${form.dataset.contactEmail}。`);
        }
        trackAnalyticsEvent({
          name: 'form_submit_error',
          properties: {
            service: analyticsService(),
            error_type: serverFields.length > 0 ? 'server_validation' : result ? 'server_response' : 'network_or_unknown',
          },
        });
      } finally {
        form.removeAttribute('aria-busy');
        if (submitButton) submitButton.disabled = false;
        if (submitLabel) submitLabel.textContent = currentSubmitLabel;
      }
    });

    form.dataset.ready = 'true';
  };

  initializeServiceApplication();
  document.addEventListener('astro:page-load', initializeServiceApplication);
</script>
