---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ArrowLeft, Check, Send, ShieldCheck } from '@lucide/astro';
import { siteConfig } from '../../config/siteConfig';
import { serviceApplicationOptions, serviceApplicationVersion } from '../../config/serviceApplication';
import '../../styles/service-application.css';

const serviceLabels = Object.fromEntries(serviceApplicationOptions.map((option) => [option.id, option.label]));
const serviceCopy = Object.fromEntries(serviceApplicationOptions.map((option) => [option.id, {
  situationLabel: option.situationLabel,
  situationHelp: option.situationHelp,
  responseNote: option.responseNote,
  applicationCopy: 'applicationCopy' in option ? option.applicationCopy : null,
}]));
---

<BaseLayout
  title="提出服務申請"
  description="簡短告訴我你想推進什麼、目前卡在哪裡。我會依照你的需求，回覆 60 分鐘付費諮詢、30 分鐘免費陪跑訪談或其他合作的下一步。"
  noindex={true}
  analytics="disabled"
>
  <article class="application-page paper-page">
    <nav class="application-shell application-back" aria-label="服務導覽">
      <a href="/services/"><ArrowLeft size={16} aria-hidden="true" />回到合作方式</a>
    </nav>

    <header class="application-shell application-hero page-paper paper-card">
      <div>
        <p class="section-label" data-hero-label>先確認怎麼聊</p>
        <h1 class="display-heading" data-hero-title>用幾個關鍵資訊，讓我先看懂你要處理的事。</h1>
        <p data-hero-description>不用寫企劃書，也不用先猜自己需要 Agent、自動化或工作流。告訴我你想推進什麼、卡在哪裡，我會依照你選的方式準備下一步。</p>
      </div>
      <aside aria-labelledby="application-next-title">
        <h2 id="application-next-title" data-next-title>送出後會發生什麼？</h2>
        <ol>
          <li><span>01</span><div data-next-first-step>我先看問題與服務是否適合。</div></li>
          <li><span>02</span><div data-application-response>適合的話，我會回覆下一步與可選時間。</div></li>
          <li><span>03</span>不適合或還缺資料，我也會直接說。</li>
        </ol>
      </aside>
    </header>

    <section class="application-shell application-form-card page-paper paper-card" aria-labelledby="application-form-title">
      <header>
        <p class="section-label" data-form-label>簡短申請</p>
        <h2 id="application-form-title" data-form-title>只問會影響分流與會前準備的資訊。</h2>
        <p data-form-description>只需要回答幾個關鍵問題；其他資料有的話再補充。不要貼密碼、Token、未遮蔽的客戶資料或公司機密原文。</p>
      </header>

      <form
        id="service-application-form"
        action="/api/service-application"
        method="post"
        data-application-version={serviceApplicationVersion}
        data-contact-email={siteConfig.contactEmail}
        data-service-labels={JSON.stringify(serviceLabels)}
        data-service-copy={JSON.stringify(serviceCopy)}
      >
        <input type="hidden" name="application_version" value={serviceApplicationVersion} />
        <input type="hidden" name="submission_id" value="" />
        <input type="hidden" name="source_path" value="/services/apply/" />
        <input type="hidden" name="source_key" value="direct" />
        <input type="hidden" name="utm_source" value="" />
        <input type="hidden" name="utm_medium" value="" />
        <input type="hidden" name="utm_campaign" value="" />
        <input type="hidden" name="utm_content" value="" />
        <div class="application-honeypot" aria-hidden="true">
          <label for="applicant-website">網站</label>
          <input id="applicant-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="application-selected-service" data-selected-service hidden>
          <div><span>這次要談</span><strong data-selected-service-label></strong></div>
          <button type="button" data-change-service>改選其他方式</button>
        </div>

        <fieldset class="application-choice" data-service-choice>
          <legend>這次比較接近哪一種需求？ <span>必填</span></legend>
          <p id="service-choice-help">不知道也沒關係，選最接近的就好；我看完後仍會幫你判斷。</p>
          <div class="application-choice__grid">
            {serviceApplicationOptions.map((option) => (
              <label>
                <input type="radio" name="service" value={option.id} required aria-describedby="service-choice-help service-choice-error" />
                <span><strong>{option.shortLabel}</strong><small>{option.summary}</small></span>
              </label>
            ))}
          </div>
          <p id="service-choice-error" class="application-error"><span aria-hidden="true">!</span>請先選一個最接近的方式。</p>
        </fieldset>

        <fieldset>
          <legend>怎麼聯絡你？</legend>
          <div class="application-field-grid">
            <div class="application-field">
              <label for="applicant-name">你的姓名 <span>必填</span></label>
              <input id="applicant-name" name="name" type="text" autocomplete="name" maxlength="80" enterkeyhint="next" required aria-describedby="applicant-name-error" />
              <p id="applicant-name-error" class="application-error"><span aria-hidden="true">!</span>請填寫姓名。</p>
            </div>
            <div class="application-field">
              <label for="applicant-email">聯絡 Email <span>必填</span></label>
              <input id="applicant-email" name="email" type="email" inputmode="email" autocomplete="email" maxlength="160" enterkeyhint="next" required aria-describedby="applicant-email-help applicant-email-error" />
              <p id="applicant-email-help" class="application-help">只用於回覆這次申請，不會自動加入電子報。</p>
              <p id="applicant-email-error" class="application-error"><span aria-hidden="true">!</span>請填寫可正常收信的 Email。</p>
            </div>
          </div>
        </fieldset>

        <div class="application-single-field">
          <div class="application-field">
            <label for="applicant-situation"><span data-situation-label>你現在最想推進哪件事？目前卡在哪裡？</span> <span>必填</span></label>
            <textarea id="applicant-situation" name="situation" rows="5" minlength="20" maxlength="1600" required aria-describedby="situation-help situation-sensitive-note situation-error" placeholder="例如：我想做……，目前做到……，接下來不知道怎麼繼續。"></textarea>
            <p id="situation-help" class="application-help" data-situation-help>簡單交代情境和卡點即可，不需要先整理成完整企劃書。</p>
            <p id="situation-sensitive-note" class="application-help application-sensitive-note">請不要貼密碼、Token、未遮蔽的客戶資料或公司機密原文。</p>
            <p id="situation-error" class="application-error"><span aria-hidden="true">!</span>請再多說一點，至少 20 個字，讓我看得懂你正在做什麼、卡在哪裡。</p>
          </div>
        </div>

        {serviceApplicationOptions.map((option) => (
          <fieldset class="application-focus" data-focus-group={option.id} hidden>
            <legend>{option.focusQuestion} <span>必填</span></legend>
            <div class="application-focus__grid">
              {option.focusOptions.map((focus) => (
                <label>
                  <input type="radio" name="focus" value={focus.id} disabled aria-describedby={`focus-${option.id}-error`} />
                  <span><strong>{focus.label}</strong><small>{focus.summary}</small></span>
                </label>
              ))}
            </div>
            <p id={`focus-${option.id}-error`} class="application-error"><span aria-hidden="true">!</span>請選擇一個最接近的狀況。</p>
          </fieldset>
        ))}

        <details class="application-optional">
          <summary>有其他資料的話，再補充</summary>
          <div class="application-optional__body">
            <div class="application-field">
              <label for="applicant-organization">公司或團隊名稱 <span>選填</span></label>
              <input id="applicant-organization" name="organization" type="text" autocomplete="organization" maxlength="120" />
            </div>
            <div class="application-field">
              <label for="preferred-timing">希望什麼時候開始或進行？ <span>選填</span></label>
              <input id="preferred-timing" name="preferred_timing" type="text" maxlength="120" placeholder="例如：九月、活動前兩週、時間都可以討論" />
            </div>
            <div class="application-field">
              <label for="reference-links">有沒有我可以先看的公開連結？ <span>選填</span></label>
              <textarea id="reference-links" name="reference_links" rows="3" maxlength="1000" aria-describedby="reference-links-help"></textarea>
              <p id="reference-links-help" class="application-help">一行一個。不要貼內網網址或任何敏感資料。</p>
            </div>
          </div>
        </details>

        <fieldset class="application-consent">
          <legend>送出前確認一下</legend>
          <label>
            <input type="checkbox" name="consent" value="agreed" required aria-describedby="consent-help consent-error" />
            <span>我同意 CabLate 使用以上資料，判斷是否適合合作、回覆這次申請，以及處理後續聯絡。未經我另外同意，內容不會公開成案例。 <strong>必填</strong></span>
          </label>
          <p id="consent-help">資料只用於這次申請與後續聯絡，不會自動加入電子報。詳細處理方式請見<a href="/privacy/">隱私權政策</a>。</p>
          <p id="consent-error" class="application-error"><span aria-hidden="true">!</span>請先勾選並確認資料使用方式。</p>
        </fieldset>

        <div class="application-verification" aria-labelledby="verification-title">
          <div><ShieldCheck size={20} aria-hidden="true" /><strong id="verification-title">送出前會自動完成安全檢查</strong></div>
          <div data-turnstile-container></div>
          <p data-turnstile-status role="status">正在準備安全檢查……</p>
        </div>

        <div id="application-error-summary" class="application-error-summary" role="alert" tabindex="-1" hidden>
          <strong>還有幾個地方需要確認。</strong>
          <p data-error-summary-message>請回到第一個標示錯誤的欄位修改。</p>
        </div>

        <noscript>
          <p class="application-noscript">這份表單需要 JavaScript 才能完成安全驗證。你也可以直接寄信到 <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>，簡單說明想處理的事與目前卡點。</p>
        </noscript>

        <div class="application-submit">
          <button class="btn btn-primary" type="submit"><span data-submit-label>送出申請</span> <Send size={18} aria-hidden="true" /></button>
          <p data-submit-note>送出不會自動扣款或保留時段。我確認適合後，才會回覆付款或訪談安排。</p>
        </div>
      </form>

      <section id="application-ready" class="application-ready" aria-labelledby="application-ready-title" aria-live="polite" hidden>
        <div tabindex="-1" data-ready-focus>
          <p class="section-label">資料已送出</p>
          <h2 id="application-ready-title">接下來我會先看過你的情況。</h2>
          <p data-ready-message>我會用你留下的 Email 回覆陪跑是否適合，以及接下來怎麼進行。</p>
          <p class="application-ready__id">申請編號：<strong data-lead-id></strong></p>
        </div>
        <a class="btn btn-ghost" href="/services/">回到合作方式</a>
      </section>
    </section>

    <aside class="application-shell application-boundary page-paper paper-card" aria-labelledby="application-boundary-title" data-application-boundary>
      <div>
        <p class="section-label">兩條路的差別</p>
        <h2 id="application-boundary-title">免費訪談不是縮短版的付費諮詢。</h2>
      </div>
      <ul>
        <li><Check size={17} aria-hidden="true" /><span><strong>60 分鐘付費諮詢：</strong>帶一個具體問題來，我們會一起找出卡點、比較做法，排出下一步。</span></li>
        <li><Check size={17} aria-hidden="true" /><span><strong>30 分鐘免費陪跑訪談：</strong>先聊你想做的事和目前卡點，確認五週陪跑是否適合；這 30 分鐘不做完整診斷。</span></li>
        <li><Check size={17} aria-hidden="true" /><span>如果選錯也沒關係，我看完後會直接建議比較適合的方式。</span></li>
      </ul>
    </aside>
  </article>
</BaseLayout>

<script>
  declare global {
    interface Window {
      turnstile?: {
        render: (container: HTMLElement, options: Record<string, unknown>) => string;
        reset: (widgetId?: string) => void;
      };
    }
  }

  const loadTurnstile = () => new Promise<void>((resolve, reject) => {
    if (window.turnstile) {
      resolve();
      return;
    }

    const existing = document.querySelector<HTMLScriptElement>('script[data-cablate-turnstile]');
    if (existing) {
      existing.addEventListener('load', () => resolve(), { once: true });
      existing.addEventListener('error', () => reject(new Error('turnstile-load-failed')), { once: true });
      return;
    }

    const script = document.createElement('script');
    script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
    script.async = true;
    script.defer = true;
    script.dataset.cablateTurnstile = 'true';
    script.addEventListener('load', () => resolve(), { once: true });
    script.addEventListener('error', () => reject(new Error('turnstile-load-failed')), { once: true });
    document.head.append(script);
  });

  const initializeServiceApplication = () => {
    const form = document.querySelector<HTMLFormElement>('#service-application-form');
    if (!form || form.dataset.ready === 'true') return;

    const readyPanel = document.querySelector<HTMLElement>('#application-ready');
    const readyFocus = document.querySelector<HTMLElement>('[data-ready-focus]');
    const errorSummary = document.querySelector<HTMLElement>('#application-error-summary');
    const errorSummaryMessage = document.querySelector<HTMLElement>('[data-error-summary-message]');
    const leadIdOutput = document.querySelector<HTMLElement>('[data-lead-id]');
    const readyMessage = document.querySelector<HTMLElement>('[data-ready-message]');
    const responseNote = document.querySelector<HTMLElement>('[data-application-response]');
    const situationLabel = document.querySelector<HTMLElement>('[data-situation-label]');
    const situationHelp = document.querySelector<HTMLElement>('[data-situation-help]');
    const heroLabel = document.querySelector<HTMLElement>('[data-hero-label]');
    const heroTitle = document.querySelector<HTMLElement>('[data-hero-title]');
    const heroDescription = document.querySelector<HTMLElement>('[data-hero-description]');
    const nextTitle = document.querySelector<HTMLElement>('[data-next-title]');
    const nextFirstStep = document.querySelector<HTMLElement>('[data-next-first-step]');
    const formLabel = document.querySelector<HTMLElement>('[data-form-label]');
    const formTitle = document.querySelector<HTMLElement>('[data-form-title]');
    const formDescription = document.querySelector<HTMLElement>('[data-form-description]');
    const submitNote = document.querySelector<HTMLElement>('[data-submit-note]');
    const selectedServicePanel = document.querySelector<HTMLElement>('[data-selected-service]');
    const selectedServiceLabel = document.querySelector<HTMLElement>('[data-selected-service-label]');
    const serviceChoice = document.querySelector<HTMLElement>('[data-service-choice]');
    const changeServiceButton = document.querySelector<HTMLButtonElement>('[data-change-service]');
    const applicationBoundary = document.querySelector<HTMLElement>('[data-application-boundary]');
    const turnstileContainer = document.querySelector<HTMLElement>('[data-turnstile-container]');
    const turnstileStatus = document.querySelector<HTMLElement>('[data-turnstile-status]');
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]');
    const serviceLabels = JSON.parse(form.dataset.serviceLabels ?? '{}') as Record<string, string>;
    type ApplicationCopy = {
      heroLabel: string;
      heroTitle: string;
      heroDescription: string;
      nextTitle: string;
      nextFirstStep: string;
      formLabel: string;
      formTitle: string;
      formDescription: string;
      submitLabel: string;
      submitNote: string;
    };
    const serviceCopy = JSON.parse(form.dataset.serviceCopy ?? '{}') as Record<string, {
      situationLabel: string;
      situationHelp: string;
      responseNote: string;
      applicationCopy: ApplicationCopy | null;
    }>;
    const params = new URLSearchParams(window.location.search);
    const safeAttribution = (value: string | null, fallback = '') => value && /^[A-Za-z0-9._~-]{1,100}$/.test(value) ? value : fallback;
    let turnstileWidgetId = '';
    let turnstileToken = '';
    let turnstileReady = false;
    let currentSubmitLabel = '送出申請';

    const setHiddenValue = (name: string, value: string) => {
      const input = form.elements.namedItem(name);
      if (input instanceof HTMLInputElement) input.value = value;
    };

    setHiddenValue('submission_id', crypto.randomUUID());
    setHiddenValue('source_path', window.location.pathname);
    setHiddenValue('source_key', safeAttribution(params.get('source'), 'direct'));
    for (const key of ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content']) {
      setHiddenValue(key, safeAttribution(params.get(key)));
    }

    const updateService = (serviceId: string, collapseChoice = false) => {
      form.querySelectorAll<HTMLElement>('[data-focus-group]').forEach((group) => {
        const active = group.dataset.focusGroup === serviceId;
        group.hidden = !active;
        group.querySelectorAll<HTMLInputElement>('input[name="focus"]').forEach((input) => {
          input.disabled = !active;
          input.required = active;
          if (!active) {
            input.checked = false;
            input.removeAttribute('aria-invalid');
          }
        });
      });

      const copy = serviceCopy[serviceId];
      if (copy) {
        if (situationLabel) situationLabel.textContent = copy.situationLabel;
        if (situationHelp) situationHelp.textContent = copy.situationHelp;
        if (responseNote) responseNote.textContent = copy.responseNote;
        if (copy.applicationCopy) {
          if (heroLabel) heroLabel.textContent = copy.applicationCopy.heroLabel;
          if (heroTitle) heroTitle.textContent = copy.applicationCopy.heroTitle;
          if (heroDescription) heroDescription.textContent = copy.applicationCopy.heroDescription;
          if (nextTitle) nextTitle.textContent = copy.applicationCopy.nextTitle;
          if (nextFirstStep) nextFirstStep.textContent = copy.applicationCopy.nextFirstStep;
          if (formLabel) formLabel.textContent = copy.applicationCopy.formLabel;
          if (formTitle) formTitle.textContent = copy.applicationCopy.formTitle;
          if (formDescription) formDescription.textContent = copy.applicationCopy.formDescription;
          if (submitNote) submitNote.textContent = copy.applicationCopy.submitNote;
          currentSubmitLabel = copy.applicationCopy.submitLabel;
          if (submitLabel) submitLabel.textContent = currentSubmitLabel;
        }
      }

      if (applicationBoundary) applicationBoundary.hidden = serviceId === 'coaching';

      if (collapseChoice && serviceChoice && selectedServicePanel && selectedServiceLabel) {
        serviceChoice.hidden = true;
        selectedServicePanel.hidden = false;
        selectedServiceLabel.textContent = serviceLabels[serviceId] ?? serviceId;
      }
    };

    const selectedService = safeAttribution(params.get('service'));
    const selectedRadio = form.querySelector<HTMLInputElement>(`input[name="service"][value="${selectedService}"]`);
    if (selectedRadio) {
      selectedRadio.checked = true;
      updateService(selectedService, true);
    }

    form.querySelectorAll<HTMLInputElement>('input[name="service"]').forEach((radio) => {
      radio.addEventListener('change', () => updateService(radio.value));
    });

    changeServiceButton?.addEventListener('click', () => {
      if (serviceChoice) serviceChoice.hidden = false;
      if (selectedServicePanel) selectedServicePanel.hidden = true;
      serviceChoice?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      form.querySelector<HTMLInputElement>('input[name="service"]:checked')?.focus();
    });

    const controls = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input, textarea, select'));
    const syncAriaInvalid = (control: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement) => {
      if (!control.validity.valid) control.setAttribute('aria-invalid', 'true');
      else control.removeAttribute('aria-invalid');
    };

    form.addEventListener('blur', (event) => {
      const control = event.target;
      if (control instanceof HTMLInputElement || control instanceof HTMLTextAreaElement || control instanceof HTMLSelectElement) syncAriaInvalid(control);
    }, true);

    form.addEventListener('input', (event) => {
      const control = event.target;
      if ((control instanceof HTMLInputElement || control instanceof HTMLTextAreaElement || control instanceof HTMLSelectElement) && control.hasAttribute('aria-invalid')) syncAriaInvalid(control);
    });

    form.addEventListener('invalid', (event) => {
      const control = event.target;
      if (control instanceof HTMLInputElement || control instanceof HTMLTextAreaElement || control instanceof HTMLSelectElement) syncAriaInvalid(control);
      if (errorSummary) errorSummary.hidden = false;
    }, true);

    const resetTurnstile = () => {
      turnstileToken = '';
      if (turnstileWidgetId && window.turnstile) window.turnstile.reset(turnstileWidgetId);
    };

    const prepareTurnstile = async () => {
      if (!turnstileContainer || !turnstileStatus) return;
      try {
        const configResponse = await fetch('/api/service-application', { headers: { accept: 'application/json' } });
        const config = await configResponse.json() as { ok?: boolean; turnstileSiteKey?: string; action?: string; message?: string };
        if (!configResponse.ok || !config.turnstileSiteKey) throw new Error(config.message || 'turnstile-config-failed');
        await loadTurnstile();
        if (!window.turnstile) throw new Error('turnstile-unavailable');
        turnstileWidgetId = window.turnstile.render(turnstileContainer, {
          sitekey: config.turnstileSiteKey,
          action: config.action || 'service_application',
          appearance: 'interaction-only',
          theme: 'light',
          callback: (token: string) => {
            turnstileToken = token;
            turnstileReady = true;
            turnstileStatus.textContent = '可以送出了。';
          },
          'expired-callback': () => {
            turnstileToken = '';
            turnstileStatus.textContent = '安全檢查已過期，請再試一次。';
          },
          'error-callback': () => {
            turnstileToken = '';
            turnstileStatus.textContent = '安全檢查暫時無法完成，請重新整理後再試。';
          },
        });
        turnstileReady = true;
        turnstileStatus.textContent = '安全檢查會在送出時自動完成。';
      } catch {
        turnstileReady = false;
        turnstileStatus.innerHTML = `表單驗證暫時無法載入。請稍後再試，或直接寄信到 <a href="mailto:${form.dataset.contactEmail}">${form.dataset.contactEmail}</a>。`;
      }
    };

    void prepareTurnstile();

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        controls.forEach((control) => {
          if (!control.disabled) syncAriaInvalid(control);
        });
        if (errorSummary) {
          errorSummary.hidden = false;
          if (errorSummaryMessage) errorSummaryMessage.textContent = '請回到第一個標示錯誤的欄位修改。';
          errorSummary.focus();
        }
        return;
      }

      if (!turnstileReady || !turnstileToken) {
        if (errorSummary) {
          errorSummary.hidden = false;
          if (errorSummaryMessage) errorSummaryMessage.textContent = '安全檢查尚未完成，請稍等一下再送出。';
          errorSummary.focus();
        }
        return;
      }

      if (errorSummary) errorSummary.hidden = true;
      if (submitButton) submitButton.disabled = true;
      if (submitLabel) submitLabel.textContent = '正在送出……';

      const data = new FormData(form);
      const payload = Object.fromEntries(data.entries()) as Record<string, unknown>;
      payload.consent = data.get('consent') === 'agreed';
      payload.cf_turnstile_response = turnstileToken;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await response.json() as { ok?: boolean; leadId?: string; message?: string; fields?: Record<string, string> };
        if (!response.ok || !result.ok || !result.leadId) {
          throw Object.assign(new Error(result.message || 'submit-failed'), { result });
        }

        if (leadIdOutput) leadIdOutput.textContent = result.leadId;
        if (readyMessage) readyMessage.textContent = result.message || '我會用你留下的 Email 回覆陪跑是否適合，以及接下來怎麼進行。';
        form.hidden = true;
        if (readyPanel) {
          readyPanel.hidden = false;
          readyPanel.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
          readyFocus?.focus({ preventScroll: true });
        }
      } catch (error) {
        resetTurnstile();
        const result = error && typeof error === 'object' && 'result' in error ? (error as { result?: { message?: string; fields?: Record<string, string> } }).result : undefined;
        if (errorSummary) {
          errorSummary.hidden = false;
          if (errorSummaryMessage) errorSummaryMessage.textContent = result?.message || `資料還沒有送出。請稍後再試，或直接寄到 ${form.dataset.contactEmail}。`;
          errorSummary.focus();
        }
      } finally {
        if (submitButton) submitButton.disabled = false;
        if (submitLabel) submitLabel.textContent = currentSubmitLabel;
      }
    });

    form.dataset.ready = 'true';
  };

  initializeServiceApplication();
  document.addEventListener('astro:page-load', initializeServiceApplication);
</script>
