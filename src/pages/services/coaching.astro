---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import { ArrowLeft, ArrowRight, Check, X } from '@lucide/astro';
import { getServiceApplicationHref } from '../../config/serviceApplication';
import '../../styles/service-pages.css';

const coachingApplicationHref = getServiceApplicationHref('coaching', 'coaching_page');

const possibleOutputs = [
  ['工作流程與自動化', '重新安排步驟、工具、資料與檢查方式，或把重複工作做成更省力的流程。'],
  ['Prompt、Skill 與模板', '把反覆需要交代的做法整理成能繼續使用的指令、Skill、檢核表或文件。'],
  ['內容或產品原型', '一起拆需求、做出第一版、看實際回饋，再決定該修、該縮小，還是該停止。'],
  ['選擇工具與做決定的方法', '釐清工具怎麼選、風險怎麼判斷、成果怎麼檢查，避免每次都重新猜。'],
];

const workLoop = [
  ['先把這一期要處理的事說清楚', '第一次會議會盤點現況、目標、優先順序、雙方責任，以及我們要用什麼跡象看進度。'],
  ['每週拿真實工作一起處理', '不照固定課綱走。每次都回到你當下的案例，拆問題、做判斷、看實作，再決定下一步。'],
  ['卡住時直接提問', '合作期間可以隨時把問題留在約定管道；Cab 會在工作日回覆，原則上一個工作天內回應。'],
  ['整理已完成、未完成與下一步', '最後一次會議回顧這一期的變化、留下的工作資產、仍有的限制，以及之後該怎麼繼續。'],
];

const faq = [
  ['一定要先做專案諮詢嗎？', '不一定。如果你已經能說清楚現況、想改善的工作與主要限制，可以直接申請陪跑；若問題仍很模糊，我會建議先做 90 分鐘專案諮詢。'],
  ['每個人都會做出一套 AI 工作流嗎？', '不會。陪跑是高度客製化，成果可能是流程、Skill、Prompt、內容系統、產品原型、文件模板、工具選擇或決策方法，也可能是其中幾項。合作前會先確認這一期最值得處理的目標，但不硬塞同一份交付清單。'],
  ['這跟一對一課有什麼不同？', '課程有共同課綱；陪跑直接處理你的真實工作。過程中會解釋方法，但不以教完多少內容作為進度。'],
  ['陪跑等於代開發或代營運嗎？', '不等於。Cab 會參與約定的判斷、拆解、實作、審查與修正；哪些工作由誰完成，會在開始前寫清楚。'],
  ['可以隨時問問題嗎？', '可以在合作期間隨時留言。Cab 會在工作日回覆，原則上一個工作天內回應；若問題已經是新的大型任務，會排進會議或另外確認範圍。'],
  ['臨時需要改期怎麼辦？', '提前至少 24 小時通知，可免費改期一次。其他改期與取消情況會依合作前提供的條款處理。'],
];

const seoTitle = 'AI 實作陪跑｜五週一對一客製合作｜CabLate';
const seoDescription = '五週一對一 AI 實作陪跑，直接從你的真實工作出發，一起判斷、實作與調整。沒有固定課綱，適合已有專案或流程、希望把 AI 真正用進工作的人。';
const seoImage = '/og/services/coaching.png';
const seoFaq = faq.map(([question, answer]) => ({ question, answer }));
const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'AI 實作陪跑',
  serviceType: '一對一 AI 實作陪跑',
  description: seoDescription,
  url: 'https://cablate.com/services/coaching/',
  image: `https://cablate.com${seoImage}`,
  provider: {
    '@type': 'Person',
    name: 'Cab',
    url: 'https://cablate.com/about/',
  },
  areaServed: {
    '@type': 'Country',
    name: '台灣',
  },
  offers: {
    '@type': 'Offer',
    price: 49800,
    priceCurrency: 'TWD',
    url: 'https://cablate.com/services/coaching/',
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://cablate.com/' },
    { '@type': 'ListItem', position: 2, name: '合作方式', item: 'https://cablate.com/services/' },
    { '@type': 'ListItem', position: 3, name: 'AI 實作陪跑', item: 'https://cablate.com/services/coaching/' },
  ],
};
---

<BaseLayout title="AI 實作陪跑" noSEO={true} analytics="disabled">
  <SEO
    slot="head"
    title={seoTitle}
    description={seoDescription}
    image={seoImage}
    imageAlt="CabLate 五週一對一 AI 實作陪跑"
    imageWidth={1200}
    imageHeight={630}
    faq={seoFaq}
  />
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <article class="service-page paper-page">
    <nav class="service-shell service-back" aria-label="服務導覽"><a href="/services/"><ArrowLeft size={16} aria-hidden="true" />回到合作方式</a></nav>

    <header class="service-shell service-detail-hero page-paper paper-card">
      <div class="service-detail-hero__copy">
        <p class="section-label">1 對 1 客製實作陪跑</p>
        <h1 class="display-heading">把 AI 真正用進你的工作。</h1>
        <p class="service-lead">五週一對一，直接從你的真實工作出發。每週一起判斷、實作與調整，不套固定課綱。</p>
        <div class="service-actions">
          <a class="btn btn-primary" href={coachingApplicationHref}>申請實作陪跑 <ArrowRight size={18} aria-hidden="true" /></a>
          <dl class="service-hero-facts" aria-label="陪跑方案摘要">
            <div><dt>期間</dt><dd>五週</dd></div>
            <div><dt>會議</dt><dd>五次</dd></div>
            <div><dt>費用</dt><dd>NT$49,800</dd></div>
          </dl>
        </div>
      </div>
      <figure class="service-detail-hero__visual service-detail-hero__visual--wide">
        <img src="/images/photos/cablate-speaking-ai-meetup-april.webp" alt="Cab 在 AI 實作聚會中拆解問題" width="1920" height="1080" loading="eager" fetchpriority="high" />
      </figure>
    </header>

    <section class="service-shell service-section service-coaching-bridge page-paper paper-card" aria-labelledby="coaching-bridge-title">
      <header class="service-section__intro">
        <p class="section-label">你缺的可能不是另一堂課</p>
        <h2 id="coaching-bridge-title">知道很多 AI 方法，回到自己的工作還是接不起來。</h2>
        <p>你的資料、工具、客戶、限制與決策方式都跟別人不同。陪跑直接看你的工作畫面與真實案例，當場找問題、做調整。哪些方法有用就留下，哪些不適合就拿掉。</p>
      </header>
      <div class="service-comparison" aria-label="課程、代做與陪跑的差異">
        <article>
          <p>課程</p>
          <h3>跟著共同課綱學</h3>
          <p>適合建立知識與方法，但不會逐一處理你的全部工作細節。</p>
        </article>
        <article>
          <p>代做</p>
          <h3>把明確任務交出去</h3>
          <p>適合規格已經很清楚、只缺執行的工作，但做法與判斷不一定會留在你手上。</p>
        </article>
        <article class="service-comparison__focus">
          <p>實作陪跑</p>
          <h3>拿你的工作一起改</h3>
          <p>你保留情境與最後決定，Cab 參與拆解、判斷、實作與審查，內容會跟著你的需求調整。</p>
        </article>
      </div>
    </section>

    <section class="service-shell service-section page-paper paper-card" aria-labelledby="coaching-offer-title">
      <header class="service-section__intro">
        <p class="section-label">合作內容</p>
        <h2 id="coaching-offer-title">五週一起做，排程需要時可延長到六週。</h2>
        <p>第一次會議先完整盤點，之後每週回到實際進度。合作期間遇到問題可以直接留言，不必等到下一次開會。</p>
      </header>
      <div class="service-offer">
        <div class="service-offer__price">
          <span>標準方案</span>
          <strong>NT$49,800</strong>
          <p>若你在完成 NT$5,000 專案諮詢後 14 天內加入陪跑，諮詢費可全額折抵，剩餘 NT$44,800。</p>
        </div>
        <dl>
          <div><dt>合作期間</dt><dd>標準五週，因排程調整時可在六週內完成。</dd></div>
          <div><dt>五次會議</dt><dd>第一次 90 分鐘，之後每週 60 分鐘，共五次。</dd></div>
          <div><dt>平時提問</dt><dd>合作期間可隨時留言，工作日原則上一個工作天內回覆。</dd></div>
          <div><dt>彈性改期</dt><dd>提前至少 24 小時通知，可免費改期一次。</dd></div>
        </dl>
      </div>
    </section>

    <section class="service-shell service-section page-paper paper-card" aria-labelledby="coaching-result-title">
      <header class="service-section__intro">
        <p class="section-label">每個人留下的東西都可能不同</p>
        <h2 id="coaching-result-title">先解決你的問題，再決定需要做成什麼。</h2>
        <p>下面是常見方向，不是固定交付清單。實際處理什麼，會依你的目標、現況、能力與合作期間共同決定。</p>
      </header>
      <div class="service-deliverables service-deliverables--coaching">
        {possibleOutputs.map(([title, body]) => <article><h3>{title}</h3><p>{body}</p></article>)}
      </div>
    </section>

    <section class="service-shell service-section service-collaboration page-paper paper-card" aria-labelledby="roles-title">
      <header class="service-section__intro service-section__intro--compact">
        <p class="section-label">我們各自負責什麼</p>
        <h2 id="roles-title">你帶真實工作與最後決定，我參與中間最難的判斷與調整。</h2>
      </header>
      <div class="service-role-column">
        <h3>你負責</h3>
        <ul>
          <li>提供必要的工作情境、案例與限制。</li>
          <li>使用自己的工具與環境，完成雙方約定的部分。</li>
          <li>決定業務取捨、可接受風險與最後是否採用。</li>
          <li>遇到問題時及早提出，不等到最後一次會議。</li>
        </ul>
      </div>
      <div class="service-role-column service-role-column--cab">
        <h3>Cab 負責</h3>
        <ul>
          <li>看懂現況，協助排出這一期最值得處理的順序。</li>
          <li>參與約定的拆解、判斷、實作、審查與修正。</li>
          <li>指出不必要的工作、風險與仍缺少的資訊。</li>
          <li>每週依真實進度調整，不拿固定教材硬套。</li>
        </ul>
      </div>
    </section>

    <section class="service-shell service-section service-process page-paper paper-card" aria-labelledby="coaching-loop-title">
      <header class="service-section__intro service-section__intro--compact">
        <p class="section-label">進行方式</p>
        <h2 id="coaching-loop-title">方向先說清楚，內容依你的進度調整。</h2>
      </header>
      <ol>
        {workLoop.map(([title, body], index) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{title}</h3><p>{body}</p></div></li>)}
      </ol>
    </section>

    <section class="service-shell service-section service-fit-grid page-paper paper-card" aria-labelledby="coaching-fit-title">
      <header class="service-section__intro service-section__intro--compact">
        <p class="section-label">先確認是否適合</p>
        <h2 id="coaching-fit-title">適合願意一起做、也願意面對真實限制的人。</h2>
      </header>
      <div class="service-fit-column">
        <h3><Check size={19} aria-hidden="true" />適合你，如果</h3>
        <ul>
          <li>你有真實工作、專案或產品想改善。</li>
          <li>你想要有人一起判斷、實作與修正，不只聽建議。</li>
          <li>你願意提供必要資訊，也能完成自己負責的部分。</li>
          <li>你接受先排優先順序，不可能五週處理所有事情。</li>
        </ul>
      </div>
      <div class="service-fit-column service-fit-column--muted">
        <h3><X size={19} aria-hidden="true" />這可能不適合你，如果</h3>
        <ul>
          <li>你只想聽一套固定課程。</li>
          <li>你要的是 24 小時隨叫隨到或無限修改。</li>
          <li>你想把所有決定與執行責任都交出去。</li>
          <li>你需要保證營收、流量或特定幅度的效率提升。</li>
        </ul>
      </div>
    </section>

    <section class="service-shell service-section service-boundary-table page-paper paper-card" aria-labelledby="boundary-title">
      <header class="service-section__intro service-section__intro--compact">
        <p class="section-label">客製不等於沒有邊界</p>
        <h2 id="boundary-title">開始前，先把這一期怎麼合作寫清楚。</h2>
      </header>
      <dl>
        <div><dt>這一期先處理什麼</dt><dd>依影響與可行性排出優先順序，不同時攤開所有問題。</dd></div>
        <div><dt>誰負責哪一部分</dt><dd>會議、實作、資料提供、最後決定與後續使用，都會先確認責任。</dd></div>
        <div><dt>哪些事不包含</dt><dd>代營運、24 小時維運、無限修改與未確認的開發工作不會自動包含。</dd></div>
        <div><dt>出現新目標怎麼辦</dt><dd>先判斷要取代原優先項目、排到後面，或另開新的合作，不會自動全部加入。</dd></div>
      </dl>
    </section>

    <section class="service-shell service-section service-faq page-paper paper-card" aria-labelledby="coaching-faq-title">
      <header class="service-section__intro service-section__intro--compact">
        <p class="section-label">常見問題</p>
        <h2 id="coaching-faq-title">申請前可以先確認這些事。</h2>
      </header>
      <div>{faq.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div>
    </section>

    <section class="service-shell service-final-cta page-paper paper-card" aria-labelledby="coaching-cta-title">
      <div><p class="section-label">下一步</p><h2 id="coaching-cta-title">先告訴我，你現在最想改善哪一段工作。</h2><p>不用先寫成完整企劃。把目前怎麼做、最常卡在哪裡、希望看到什麼改變寫給我，我會先判斷這種合作是否適合。</p></div>
      <a class="btn btn-primary" href={coachingApplicationHref}>申請實作陪跑 <ArrowRight size={18} aria-hidden="true" /></a>
    </section>
  </article>
</BaseLayout>
