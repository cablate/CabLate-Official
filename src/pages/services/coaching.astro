---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import { ArrowLeft, ArrowRight, Check, X } from '@lucide/astro';
import { getServiceApplicationHref } from '../../config/serviceApplication';
import '../../styles/service-pages.css';

const coachingApplicationHref = getServiceApplicationHref('coaching', 'coaching_page');

const stuckSituations = [
  ['想做的事情太多', '每個方向都想試，最後不知道現在該先做哪一個。'],
  ['課程和工具越收越多', '總覺得還少學一點、漏掉最新做法，真正想做的事反而一直沒有開始。'],
  ['已經有第一版了', '產品、內容或計畫做了一段，卻不知道該繼續修、縮小，還是換方向。'],
  ['手上有一套自己的經驗', '想把它整理成能賣、能教，或能重複使用的東西。'],
];

const faq = [
  ['送出表單後會發生什麼？', '我會親自看內容，再邀請我認為適合陪跑的人免費聊 30 分鐘。沒有收到邀請，不代表你的題目不好，通常只是我判斷這次陪跑不是最適合的處理方式。'],
  ['這 30 分鐘會聊什麼？', '我會先了解你想做什麼、目前卡在哪，也讓你確認我的合作方式適不適合。這不是縮短版諮詢，不會在 30 分鐘內硬做完整診斷。'],
  ['陪跑優惠怎麼拿？', '30 分鐘談完，確認彼此適合，我會寄出正式邀請和這一期的專屬優惠。優惠不會在送出表單時自動取得。'],
  ['一定要做 AI、Agent 或自動化嗎？', '不一定。主軸仍然是 AI 應用，但我不會為了賣 AI，還沒看懂問題就先叫你做 Agent 或自動化。有些題目最後需要的是內容、產品、資料或做法上的調整。'],
  ['合作期間可以臨時問問題嗎？', '可以。五週內都能留言，工作日原則上會在一個工作天內回覆。需要改期可以直接跟我說，我會盡量配合。只希望你能提早告訴我，彼此都把時間留好。'],
];

const seoTitle = 'AI 應用陪跑｜五週一起把想做的事推下去｜CabLate';
const seoDescription = '五週一對一 AI 應用陪跑。先填短表單，Cab 會邀請適合的人免費聊 30 分鐘；確認合作後，再提供正式方案與本期專屬優惠。';
const seoImage = '/og/services/coaching.png';
const seoFaq = faq.map(([question, answer]) => ({ question, answer }));
const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'AI 應用陪跑',
  serviceType: '一對一 AI 應用陪跑',
  description: seoDescription,
  url: 'https://cablate.com/services/coaching/',
  image: `https://cablate.com${seoImage}`,
  provider: {
    '@type': 'Person',
    name: 'Cab',
    url: 'https://cablate.com/about/',
  },
  areaServed: {
    '@type': 'Country',
    name: '台灣',
  },
  offers: {
    '@type': 'Offer',
    price: 39800,
    priceCurrency: 'TWD',
    url: 'https://cablate.com/services/coaching/',
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://cablate.com/' },
    { '@type': 'ListItem', position: 2, name: '合作方式', item: 'https://cablate.com/services/' },
    { '@type': 'ListItem', position: 3, name: 'AI 應用陪跑', item: 'https://cablate.com/services/coaching/' },
  ],
};
---

<BaseLayout title="AI 應用陪跑" noSEO={true}>
  <SEO
    slot="head"
    title={seoTitle}
    description={seoDescription}
    image={seoImage}
    imageAlt="CabLate 五週一對一 AI 應用陪跑"
    imageWidth={1200}
    imageHeight={630}
    faq={seoFaq}
  />
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <article class="service-page service-page--coaching paper-page">
    <nav class="service-shell service-back" aria-label="服務導覽"><a href="/services/"><ArrowLeft size={16} aria-hidden="true" />回到合作方式</a></nav>

    <header class="service-shell service-detail-hero page-paper paper-card">
      <div class="service-detail-hero__copy">
        <p class="section-label">五週一對一陪跑・每期最多三位</p>
        <h1 class="display-heading">有件事想做？<br />我陪你做下去</h1>
        <p class="service-lead">你可以帶工作、內容、產品，或任何正在推進的計畫來。我會跟你一起看問題、試做、調整。AI 用得上就用，用不上也不會硬塞。</p>
        <div class="service-actions">
          <a class="btn btn-primary" href={coachingApplicationHref} data-analytics-placement="coaching_hero">申請 30 分鐘免費聊聊 <ArrowRight size={18} aria-hidden="true" /></a>
          <dl class="service-hero-facts" aria-label="陪跑方案摘要">
            <div><dt>期間</dt><dd>五週</dd></div>
            <div><dt>會議</dt><dd>五次</dd></div>
            <div><dt>費用</dt><dd>NT$39,800</dd></div>
          </dl>
        </div>
        <p class="service-conversation-note">你先填一份短表單，我會親自看過，再邀請適合的人免費聊 30 分鐘。聊完確認彼此適合，我才會正式邀請你加入，並附上這一期的專屬優惠。</p>
      </div>
      <figure class="service-detail-hero__visual service-detail-hero__visual--wide">
        <img src="/images/photos/cablate-speaking-ai-meetup-april.webp" alt="Cab 在 AI 實作聚會中拆解問題" width="1920" height="1080" loading="eager" fetchpriority="high" />
      </figure>
    </header>

    <section class="service-shell service-section service-coaching-story page-paper paper-card" aria-labelledby="coaching-story-title">
      <header class="service-section__intro">
        <p class="section-label">我為什麼做陪跑</p>
        <h2 id="coaching-story-title">很多人缺的，不是另一堂課</h2>
      </header>
      <div class="service-coaching-story__body">
        <p>我教過課，也陪人做過產品和系統。每個人的工作、能力和手上的資源都不一樣。課程可以教共同的方法，卻沒辦法在你卡住的當下，直接告訴你這裡該繼續、該縮小，還是根本走錯方向。</p>
        <p>這就是我做陪跑的原因。你把正在做的東西帶來，我跟你一起判斷、一起做，也一起處理那些很難只靠教學影片解決的細節。</p>
      </div>
    </section>

    <section class="service-shell service-section page-paper paper-card" aria-labelledby="coaching-result-title">
      <header class="service-section__intro">
        <p class="section-label">你可以帶甚麼來</p>
        <h2 id="coaching-result-title">想了很久，卻一直沒有進度</h2>
        <p>工作、內容、產品、系統，或一個放了很久的計畫都可以。</p>
      </header>
      <div class="service-deliverables service-deliverables--coaching">
        {stuckSituations.map(([title, body]) => <article><h3>{title}</h3><p>{body}</p></article>)}
      </div>
    </section>

    <section class="service-shell service-section service-process service-coaching-plan page-paper paper-card" aria-labelledby="coaching-loop-title">
      <header class="service-section__intro">
        <p class="section-label">這五週怎麼陪你</p>
        <h2 id="coaching-loop-title">五週裡，有問題都可以直接問我</h2>
        <p>每週固定安排一次 60 分鐘線上會議，中間有問題也可以直接問。我們會一起做、一起調整，盡可能在五週內，讓你和手上的事情都大幅往前推進。</p>
      </header>
      <div class="service-offer">
        <div class="service-offer__price">
          <span>五週陪跑</span>
          <strong>NT$39,800</strong>
          <p>30 分鐘談完，如果我們都認為適合，我會在陪跑邀請裡附上這一期的專屬優惠。若你曾做過 NT$5,000 專案諮詢，並在 14 天內加入，諮詢費仍可全額折抵。</p>
        </div>
        <dl>
          <div><dt>每週一次一對一會議</dt><dd>每次 60 分鐘，直接看你做到哪裡、接下來怎麼推進。</dd></div>
          <div><dt>會議之外也能提問</dt><dd>五週內遇到問題可以直接留言，工作日原則上會在一個工作天內回覆。</dd></div>
          <div><dt>直接解決你的問題</dt><dd>以你正在做的案例、資料、內容或產品為主，一起處理現在最需要解決的問題。</dd></div>
          <div><dt>一起把進度往前推</dt><dd>我們會邊做邊調整，盡可能在五週內，讓你和手上的事情都大幅往前推進。</dd></div>
          <div><dt>最後幫你整理好</dt><dd>把這一期的所有詢問、會議重點、做出的成果和後續方向整理給你。</dd></div>
        </dl>
      </div>
    </section>

    <section class="service-shell service-section service-fit-grid page-paper paper-card" aria-labelledby="coaching-fit-title">
      <header class="service-section__intro service-section__intro--compact">
        <h2 id="coaching-fit-title">我比較想陪這樣的人</h2>
      </header>
      <div class="service-fit-column">
        <h3><Check size={19} aria-hidden="true" />我們應該會合作得不錯</h3>
        <ul>
          <li>你手上已經有一件想做的事，不只是想多學幾個工具。</li>
          <li>你願意把真實材料拿出來，也願意一起動手做。</li>
          <li>你可以接受我直接說：這裡不用 AI，或這個方向現在不值得做。</li>
        </ul>
      </div>
      <div class="service-fit-column service-fit-column--muted">
        <h3><X size={19} aria-hidden="true" />這幾種需求不適合</h3>
        <ul>
          <li>你要的是一套固定課程。</li>
          <li>你希望有人把全部工作直接代做。</li>
          <li>你需要一個保證營收、流量或效率的答案。</li>
        </ul>
      </div>
      <p class="service-fit-note">開始前，我們會先講好這五週要處理甚麼、各自負責哪一段。中途冒出新的目標，就一起重排，不會假裝五週可以塞進所有事情。</p>
    </section>

    <section class="service-shell service-section service-faq page-paper paper-card" aria-labelledby="coaching-faq-title">
      <header class="service-section__intro service-section__intro--compact">
        <h2 id="coaching-faq-title">申請前，你可能還想問</h2>
      </header>
      <div>{faq.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div>
    </section>

    <section class="service-shell service-final-cta page-paper paper-card" aria-labelledby="coaching-cta-title">
      <div><p class="section-label">下一步</p><h2 id="coaching-cta-title">一個人做得有點累，我幫你少走彎路</h2><p>我會親自看過，再邀請適合的人免費聊 30 分鐘。聊完確認彼此適合，我才會正式邀請你加入，並附上這一期的專屬優惠。</p></div>
      <a class="btn btn-primary" href={coachingApplicationHref} data-analytics-placement="coaching_fit">申請 30 分鐘免費聊聊 <ArrowRight size={18} aria-hidden="true" /></a>
    </section>

    <aside class="service-coaching-sticky" aria-label="AI 應用陪跑下一步">
      <div>
        <strong>五週一對一陪跑</strong>
        <span>每期最多三位｜先申請免費聊聊</span>
      </div>
      <a class="btn btn-primary" href={coachingApplicationHref} data-analytics-placement="coaching_final">申請免費聊聊 <ArrowRight size={17} aria-hidden="true" /></a>
    </aside>
  </article>
</BaseLayout>
