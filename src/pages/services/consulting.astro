---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ArrowLeft, ArrowRight, Check, X } from '@lucide/astro';
import { siteConfig } from '../../config/siteConfig';
import '../../styles/service-pages.css';

const consultingMailto = `mailto:${siteConfig.contactEmail}?subject=${encodeURIComponent('申請 AI 專案卡關諮詢')}&body=${encodeURIComponent(`你的姓名：
你想完成什麼可觀察的結果：
目前已做到哪裡：
已經試過哪些方法或工具：
目前最大的阻礙：
如果不處理，會造成什麼影響：
希望這次先做出哪個判斷：
可先看的畫面、文件或連結（選填，請勿附密碼、Token 或機密原文）：`)}`;

const deliverables = [
  ['核心診斷', '把目前最可能的瓶頸寫成一句能用來做決策的判斷。'],
  ['卡點地圖', '整理目標、現況、資料、工具、狀態與驗收之間的主要斷點。'],
  ['取捨建議', '判斷應該繼續、縮小、換路，或暫時不要做成 Agent。'],
  ['行動卡', '留下優先三步、不做清單、需要補的證據與回顧節點。'],
];

const faq = [
  ['會不會只得到很大的方向？', '不會只留一句抽象建議。若資訊足夠，會留下核心瓶頸、取捨判斷、優先三步與不做清單；資訊不足時，也會把未解事項寫清楚。'],
  ['不是工程師也適合嗎？', '可以。重點是你有一個真實任務與可描述的結果，不是你會不會寫程式。'],
  ['諮詢會直接幫我開發嗎？', '不包含代開發。這一步先決定該不該做、先做哪個切片，以及怎樣算完成。需要共同實作時，再另外確認陪跑範圍。'],
  ['費用與時段怎麼確認？', '我會先看你提交的情境。確認適合後，再一次說明費用、可選時段與合作條款；你確認前不會產生付款義務。'],
];
---

<BaseLayout title="AI 專案卡關諮詢" description="針對一個已經投入時間、卻反覆重做或不知道該先改哪裡的 AI 專案，做出核心診斷、取捨判斷與下一步行動卡。" analytics="disabled">
  <article class="service-page paper-page">
    <nav class="service-shell service-back" aria-label="服務導覽"><a href="/services/"><ArrowLeft size={16} aria-hidden="true" />回到合作方式</a></nav>

    <header class="service-shell service-detail-hero page-paper paper-card">
      <div class="service-detail-hero__copy">
        <p class="section-label">AI 專案卡關諮詢</p>
        <h1 class="display-heading">先把真正卡點判斷清楚，再決定下一步要不要做。</h1>
        <p class="service-lead">這不是泛聊 AI，也不是直接推一套工具。你帶一個真實專案進來，我們一起看目標、現況、資料、工具、狀態與驗收，找出現在最該處理的斷點。</p>
        <div class="service-actions">
          <a class="btn btn-primary" href={consultingMailto}>提交你的卡關情境 <ArrowRight size={18} aria-hidden="true" /></a>
          <span>先判斷適配，再確認費用與 90 分鐘線上時段。</span>
        </div>
      </div>
      <figure class="service-detail-hero__visual">
        <img src="/images/photos/cablate-speaking-workshop-0627.webp" alt="Cab 在工作坊現場回應真實問題" width="1536" height="2048" loading="eager" fetchpriority="high" />
      </figure>
    </header>

    <section class="service-shell service-section page-paper paper-card" aria-labelledby="outcomes-title">
      <header class="service-section__intro">
        <p class="section-label">你會帶走</p>
        <h2 id="outcomes-title">不是多一場會議，而是原本做不出的判斷。</h2>
        <p>每一項產物都要能回到你的真實案例，不用漂亮術語替代還沒確認的事情。</p>
      </header>
      <div class="service-deliverables">
        {deliverables.map(([title, body]) => <article><h3>{title}</h3><p>{body}</p></article>)}
      </div>
    </section>

    <section class="service-shell service-section service-fit-grid page-paper paper-card" aria-labelledby="fit-title">
      <header class="service-section__intro service-section__intro--compact">
        <p class="section-label">先確認是否適合</p>
        <h2 id="fit-title">有真實題目，才有值得做的診斷。</h2>
      </header>
      <div class="service-fit-column">
        <h3><Check size={19} aria-hidden="true" />適合你，如果</h3>
        <ul>
          <li>你正在做一個真實 AI 專案、工作流或產品。</li>
          <li>你已經試過一些方法，卻還不知道真正瓶頸。</li>
          <li>問題已經造成重做、延誤、成本或決策壓力。</li>
          <li>你願意提供必要資料，並親自做最後決定。</li>
        </ul>
      </div>
      <div class="service-fit-column service-fit-column--muted">
        <h3><X size={19} aria-hidden="true" />這可能不適合你，如果</h3>
        <ul>
          <li>你只想拿一個萬用 Prompt。</li>
          <li>你沒有真實題目，只想泛泛了解 AI。</li>
          <li>你期待 Cab 直接代做全部工作。</li>
          <li>你需要 24 小時維運或保證營收。</li>
        </ul>
      </div>
    </section>

    <section class="service-shell service-section service-process page-paper paper-card" aria-labelledby="consulting-process-title">
      <header class="service-section__intro service-section__intro--compact">
        <p class="section-label">進行方式</p>
        <h2 id="consulting-process-title">先看情境，適合才排入諮詢。</h2>
      </header>
      <ol>
        <li><span>01</span><div><h3>提交情境</h3><p>說清楚想完成什麼、目前做到哪、試過什麼與最大阻礙。</p></div></li>
        <li><span>02</span><div><h3>適配判斷</h3><p>先確認這是不是一次診斷能處理的問題；不適合時直接說明。</p></div></li>
        <li><span>03</span><div><h3>確認費用與時段</h3><p>適合時才提供完整條款與可選時段，你確認後才成立合作。</p></div></li>
        <li><span>04</span><div><h3>進行並留下行動卡</h3><p>用真實現況找核心瓶頸，將取捨、行動與未解事項整理成可回顧成果。</p></div></li>
      </ol>
    </section>

    <section class="service-shell service-section service-faq page-paper paper-card" aria-labelledby="consulting-faq-title">
      <header class="service-section__intro service-section__intro--compact">
        <p class="section-label">常見問題</p>
        <h2 id="consulting-faq-title">先把合作邊界說清楚。</h2>
      </header>
      <div>
        {faq.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}
      </div>
    </section>

    <section class="service-shell service-final-cta page-paper paper-card" aria-labelledby="consulting-cta-title">
      <div><p class="section-label">下一步</p><h2 id="consulting-cta-title">不用先整理成完整需求書。</h2><p>把你想完成什麼、目前做到哪裡、試過什麼與最大阻礙寫給我。請勿附上密碼、Token 或機密原文。</p></div>
      <a class="btn btn-primary" href={consultingMailto}>提交你的卡關情境 <ArrowRight size={18} aria-hidden="true" /></a>
    </section>
  </article>
</BaseLayout>
