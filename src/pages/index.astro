---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/sections/Newsletter.astro';
import { ArrowLeft, ArrowRight, Braces, Database, GitBranch } from '@lucide/astro';
import { siteConfig, withCabAiAttribution } from '../config/siteConfig';

const heroMessages = [
  {
    statement: ['我研究 AI、Agent', '與真實工作流程'],
    result: '找到做法也知道怎麼檢查\n用 AI 改善你的工作流程',
  },
  {
    statement: ['我把工程上的拆解與驗證', '帶進 AI 應用'],
    result: '把問題拆開也把判斷留下\n下一次不必再從頭猜',
  },
  {
    statement: ['我熟悉 AI 應用', '也親手把方法做成產品'],
    result: '看得出 AI 卡在哪裡\n把結果修到能驗收也能交接',
  },
];

const diagnosticCases = [
  { code: 'context', icon: Database, term: 'Context', title: '資訊脈絡', question: ['它這次到底', '看到了哪些資料'], symptom: ['講了很多次', 'AI 表現還是很差'], description: '你以為交代過了，下一次它卻像從沒看過。', diagnosis: ['你以為它知道的背景', '不一定真的進到這次任務裡'], next: ['挑一個明顯答錯的地方', '對照它當時實際讀到的資料'] },
  { code: 'skill', icon: Braces, term: 'Skill', title: '可重複方法', question: ['上次做對的關鍵', '有沒有被留下來'], symptom: ['這次明明做出成果', '下次又得重來'], description: '結果留下了，真正有用的做法卻沒有。', diagnosis: ['留下成果不等於留下做法', '關鍵判斷沒保存，下次還是得重講'], next: ['找一個每次都得重講的判斷', '把它整理成下次能直接照做的步驟'] },
  { code: 'harness', icon: GitBranch, term: 'Harness', title: '執行環境', question: ['流程是從哪一步', '開始斷掉的'], symptom: ['只要一步出錯', '整個流程就卡住'], description: '前面明明都成功了，一出錯還是只能從頭開始。', diagnosis: ['流程如果只記得從頭開始', '前面做對再多，出錯也接不回去'], next: ['找到失敗前最後完成的步驟', '讓流程直接從那裡繼續'] },
];

const routes = [
  { order: '01', title: '我想先自己找出問題', description: '適合：你有真實任務，但還不確定問題在資訊、方法還是執行環境。', label: '先做工作流健檢', href: '/expertise/', primary: true },
  { order: '02', title: '我想自己學會怎麼修', description: '適合：問題類型已經比較清楚，願意用課程、手冊或 Skill 自己實作。', label: '查看學習內容', href: '/courses/', primary: false },
  { order: '03', title: '問題已經影響工作，我需要一起判斷', description: '適合：你已投入時間或成本，卻不知道該繼續、縮小還是換路。', label: '查看合作方式', href: '/services/', primary: false },
];
---

<BaseLayout title="CabLate｜AI 應用、Agent 與產品實作" description="CabLate 的個人網站。從全端工程與系統設計出發，持續製作 AI 產品、研究 Agent，也整理文章、課程與工作方法。" image="/og/pages/home.png" imageAlt="CabLate：從工程走進 AI，持續做產品、寫研究與整理工作方法。" imageWidth={1200} imageHeight={630}>
  <div class="home-page" data-content-state="testing">
    <section class="home-hero paper-card" aria-labelledby="home-title" data-hero-copy-rotation data-messages={JSON.stringify(heroMessages)}>
      <header class="home-hero__lede">
        <h1 id="home-title">嗨，我是 CabLate</h1>
        <p class="home-hero__statement" id="home-hero-statement" data-hero-statement aria-live="off">
          {heroMessages[0].statement.map((line) => <span data-hero-statement-line>{line}</span>)}
        </p>
      </header>

      <figure class="home-hero__portraits">
        <div class="hero-photo hero-photo--primary">
          <img
            src="/images/photos/cablate-speaking-ai-meetup-april-refined-v1.webp"
            alt="Cab 在 AI 小聚現場分享 AI 協作與工作流程"
            width="1122"
            height="1402"
            fetchpriority="high"
          />
        </div>
        <div class="hero-photo hero-photo--secondary">
          <img
            src="/images/photos/cablate-speaking-workshop-0627-refined-v1.webp"
            alt="Cab 在工作坊現場與學員拆解實作問題"
            width="1122"
            height="1402"
            fetchpriority="low"
          />
        </div>
        <p class="home-hero__annotation"><span>WORK NOTE</span>做出來之後呢？</p>
      </figure>

      <div class="home-hero__body">
        <p class="home-hero__result" id="home-hero-result" data-hero-result aria-live="off">{heroMessages[0].result}</p>
        <div class="home-hero__rotation-meta">
          <div class="home-hero__rotation-controls" data-hero-rotation-controls role="group" aria-label="切換介紹內容" hidden>
            <button type="button" data-hero-previous aria-label="上一則介紹" aria-controls="home-hero-statement home-hero-result"><ArrowLeft size={15} aria-hidden="true" /></button>
            <span class="rotation-controls__count" aria-hidden="true"><span data-hero-current>01</span> / {String(heroMessages.length).padStart(2, '0')}</span>
            <button type="button" data-hero-next aria-label="下一則介紹" aria-controls="home-hero-statement home-hero-result"><ArrowRight size={15} aria-hidden="true" /></button>
          </div>
          <span class="visually-hidden" data-hero-rotation-status aria-live="polite" aria-atomic="true"></span>
        </div>
        <div class="home-hero__actions">
          <a class="btn btn-primary hero-action" href="/about/#public-output-title">先看我做過的東西 <ArrowRight size={18} aria-hidden="true" /></a>
          <a class="home-hero__secondary-action" href="#diagnostic-title">有個 AI 卡點？從這裡開始 <ArrowRight size={16} aria-hidden="true" /></a>
        </div>
      </div>
    </section>

    <section class="diagnostic-stage" aria-labelledby="diagnostic-title">
      <header class="diagnostic-heading">
        <h2 id="diagnostic-title">你是不是也遇過<br />這幾種情況</h2>
      </header>

      <div class="diagnostic-console">
        <fieldset class="symptom-choices">
          <legend class="visually-hidden">選擇最接近目前情況的症狀</legend>
          {diagnosticCases.map((item, index) => (
            <label class="symptom-choice" for={`home-diagnostic-${item.code}`}>
              <input id={`home-diagnostic-${item.code}`} type="radio" name="home-diagnostic" value={item.code} checked={index === 0} aria-controls={`home-trace-${item.code}`} />
              <span class="symptom-choice__surface"><strong>{item.symptom.map((line) => <span class="symptom-copy-line">{line}</span>)}</strong><span>{item.description}</span></span>
            </label>
          ))}
        </fieldset>

        <div class="trace-panels" aria-live="polite">
          {diagnosticCases.map((item) => (
            <article class="trace-panel" id={`home-trace-${item.code}`} data-trace={item.code}>
              <header class="trace-panel__heading">
                <div class="diagnosis-stamp"><item.icon size={22} aria-hidden="true" /><span>{item.term} / {item.title}</span></div>
                <h3>{item.question.map((line) => <span>{line}</span>)}</h3>
              </header>
              <div class="trace-reading">
                <p class="trace-diagnosis">{item.diagnosis.map((line) => <span>{line}</span>)}</p>
                <p class="trace-next"><span class="trace-next__arrow" aria-hidden="true">→</span><strong>{item.next.map((line) => <span>{line}</span>)}</strong></p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="route-section paper-card" aria-labelledby="route-title">
      <div class="paper-card__inner">
        <header class="route-heading"><p class="section-label">從你的問題開始</p><h2 id="route-title">你可以自己查、自己學，也可以直接找我一起看。</h2></header>
        <div class="route-list">
          {routes.map((route) => (
            <article class:list={['route-item', route.primary && 'route-item--primary']}>
              <span>{route.order}</span>
              <div><h3>{route.title}</h3><p>{route.description}</p></div>
              <a class:list={['btn', route.primary ? 'btn-primary' : 'btn-ghost']} href={route.href}>{route.label} <ArrowRight size={16} aria-hidden="true" /></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* proof-slot: intentionally not rendered until a Claim Registry row is approved. */}

    <section class="identity-section paper-card" aria-labelledby="identity-title">
      <div class="paper-card__inner section-grid">
        <header><p class="section-label">我是 CabLate</p><h2 id="identity-title">執行愈來愈便宜，判斷反而更重要。</h2></header>
        <div><p>我原本做全端工程與系統設計，現在把大部分時間放在 AI 應用、Agent 與真實工作流程。我在意的不是 AI 能不能漂亮地示範一次，而是它進入工作之後能不能持續做對；出了問題，能不能查得到原因。</p><a class="text-action" href="/about/#public-output-title">看作品與經歷 <ArrowRight size={16} aria-hidden="true" /></a></div>
      </div>
    </section>

    <section class="cabai-section paper-card paper-card--clip" aria-labelledby="cabai-title">
      <div class="paper-card__inner section-grid">
        <header><p class="section-label">CabAI 學習與交付平台</p><h2 id="cabai-title">課程、手冊、公開資源與免費試看，都放在同一個地方。</h2></header>
        <div><p>CabLate 幫你看懂問題與選路；CabAI 保存 Library、Skill、課程、已購內容、學習狀態與 Agent API。你可以先看免費內容，再決定是否需要購買。</p><a class="btn btn-primary" href={withCabAiAttribution(siteConfig.cabAi.homeUrl, 'home_cabai_delivery')} target="_blank" rel="noopener">前往 CabAI <ArrowRight size={17} aria-hidden="true" /></a></div>
      </div>
    </section>

    <section class="newsletter-card paper-card" aria-label="更新通知"><div class="paper-card__inner"><Newsletter /></div></section>
  </div>
</BaseLayout>

<script>
  const initializeHeroCopyRotation = () => {
    const heroes = document.querySelectorAll<HTMLElement>('[data-hero-copy-rotation]');

    heroes.forEach((hero) => {
      if (hero.dataset.rotationReady === 'true') return;

      const statement = hero.querySelector<HTMLElement>('[data-hero-statement]');
      const statementLines = Array.from(hero.querySelectorAll<HTMLElement>('[data-hero-statement-line]'));
      const result = hero.querySelector<HTMLElement>('[data-hero-result]');
      const controls = hero.querySelector<HTMLElement>('[data-hero-rotation-controls]');
      const previous = hero.querySelector<HTMLButtonElement>('[data-hero-previous]');
      const next = hero.querySelector<HTMLButtonElement>('[data-hero-next]');
      const currentLabel = hero.querySelector<HTMLElement>('[data-hero-current]');
      const status = hero.querySelector<HTMLElement>('[data-hero-rotation-status]');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      if (!statement || statementLines.length < 2 || !result || !controls || !previous || !next || !currentLabel || !status || !hero.dataset.messages) return;

      const messages = JSON.parse(hero.dataset.messages) as Array<{ statement: string[]; result: string }>;
      if (messages.length < 2) return;

      hero.dataset.rotationReady = 'true';
      let currentIndex = 0;
      let autoplayId = 0;
      let transitionId = 0;
      let isInViewport = true;
      let userInteracted = false;
      let pointerStart: { x: number; y: number } | null = null;

      const stop = () => {
        window.clearTimeout(autoplayId);
        autoplayId = 0;
      };

      const render = (index: number) => {
        currentIndex = index;
        statementLines.forEach((line, lineIndex) => {
          line.textContent = messages[currentIndex].statement[lineIndex] ?? '';
        });
        result.textContent = messages[currentIndex].result;
        currentLabel.textContent = String(currentIndex + 1).padStart(2, '0');
      };

      const announce = () => {
        status.textContent = `第 ${currentIndex + 1} 則介紹：${messages[currentIndex].statement.join(' ')}。${messages[currentIndex].result.replace('\n', ' ')}`;
      };

      const start = () => {
        stop();
        if (document.hidden || reduceMotion.matches || userInteracted || !isInViewport) return;
        autoplayId = window.setTimeout(() => changeTo(currentIndex + 1, 'next', false), 3000);
      };

      const changeTo = (index: number, direction: 'previous' | 'next', shouldAnnounce: boolean) => {
        const nextIndex = (index + messages.length) % messages.length;
        if (nextIndex === currentIndex) return;

        stop();
        const directionClass = direction === 'previous' ? 'is-switching--previous' : 'is-switching--next';
        statement.classList.add('is-switching');
        statement.classList.add(directionClass);
        result.classList.add('is-switching');
        result.classList.add(directionClass);
        window.clearTimeout(transitionId);
        transitionId = window.setTimeout(() => {
          render(nextIndex);
          requestAnimationFrame(() => {
            statement.classList.remove('is-switching');
            statement.classList.remove(directionClass);
            result.classList.remove('is-switching');
            result.classList.remove(directionClass);
          });
          if (shouldAnnounce) announce();
          start();
        }, reduceMotion.matches ? 0 : 220);
      };

      const handleVisibility = () => {
        if (document.hidden) stop();
        else start();
      };

      const handleMotionPreference = () => {
        stop();
        window.clearTimeout(transitionId);
        statement.classList.remove('is-switching');
        statement.classList.remove('is-switching--previous', 'is-switching--next');
        result.classList.remove('is-switching');
        result.classList.remove('is-switching--previous', 'is-switching--next');
        start();
      };

      const navigate = (index: number, direction: 'previous' | 'next') => {
        userInteracted = true;
        changeTo(index, direction, true);
      };

      const handlePrevious = () => navigate(currentIndex - 1, 'previous');
      const handleNext = () => navigate(currentIndex + 1, 'next');

      const handlePointerDown = (event: PointerEvent) => {
        if (event.pointerType === 'mouse' && event.button !== 0) return;
        pointerStart = { x: event.clientX, y: event.clientY };
      };

      const handlePointerUp = (event: PointerEvent) => {
        if (!pointerStart) return;
        const deltaX = event.clientX - pointerStart.x;
        const deltaY = event.clientY - pointerStart.y;
        pointerStart = null;

        if (Math.abs(deltaX) < 48 || Math.abs(deltaX) <= Math.abs(deltaY) * 1.2) return;
        if (deltaX < 0) handleNext();
        else handlePrevious();
      };

      const handlePointerCancel = () => {
        pointerStart = null;
      };

      const observer = 'IntersectionObserver' in window
        ? new IntersectionObserver(([entry]) => {
            isInViewport = entry?.isIntersecting ?? false;
            if (isInViewport) start();
            else stop();
          }, { threshold: 0.24 })
        : null;

      const cleanup = () => {
        stop();
        window.clearTimeout(transitionId);
        previous.removeEventListener('click', handlePrevious);
        next.removeEventListener('click', handleNext);
        hero.removeEventListener('pointerdown', handlePointerDown);
        hero.removeEventListener('pointerup', handlePointerUp);
        hero.removeEventListener('pointercancel', handlePointerCancel);
        document.removeEventListener('visibilitychange', handleVisibility);
        reduceMotion.removeEventListener('change', handleMotionPreference);
        observer?.disconnect();
      };

      controls.hidden = false;
      previous.addEventListener('click', handlePrevious);
      next.addEventListener('click', handleNext);
      hero.addEventListener('pointerdown', handlePointerDown);
      hero.addEventListener('pointerup', handlePointerUp);
      hero.addEventListener('pointercancel', handlePointerCancel);
      document.addEventListener('visibilitychange', handleVisibility);
      reduceMotion.addEventListener('change', handleMotionPreference);
      document.addEventListener('astro:before-swap', cleanup, { once: true });
      observer?.observe(hero);

      start();
    });
  };

  initializeHeroCopyRotation();
  document.addEventListener('astro:page-load', initializeHeroCopyRotation);
</script>

<style>
  .home-page { width: min(calc(100% - 2rem), 86rem); display: grid; gap: 1rem; margin-inline: auto; padding-block: 1rem 2rem; }
  .home-page h1, .home-page h2, .home-page h3 { text-wrap: balance; }
  .home-page p, .home-page li { text-wrap: pretty; }
  .home-hero { position: relative; display: grid; grid-template-areas: 'lede portraits' 'body portraits'; grid-template-columns: minmax(0, 1.06fr) minmax(24rem, .94fr); grid-template-rows: 1fr auto; gap: 1.5rem clamp(2rem, 4vw, 4.5rem); min-height: clamp(38rem, 46vw, 44rem); padding: clamp(3rem, 5.5vw, 5.2rem); overflow: hidden; touch-action: pan-y; }
  .home-hero::after { position: absolute; right: clamp(2rem, 4vw, 4rem); bottom: clamp(1.7rem, 3vw, 2.8rem); width: 4.8rem; height: 1px; content: ''; background: var(--accent); opacity: .42; }
  .home-hero__lede { grid-area: lede; align-self: end; position: relative; z-index: 2; min-width: 0; max-width: 42rem; }
  .home-hero h1 { max-width: none; margin: 0; color: var(--text-primary); font-family: var(--font-serif); font-size: clamp(3.25rem, 4.65vw, 4.65rem); font-weight: 700; letter-spacing: -.055em; line-height: 1.12; white-space: nowrap; }
  .home-hero__statement { display: grid; gap: .08em; min-height: 2.8em; margin: 1.25rem 0 0; color: var(--text-primary); font-family: var(--font-sans); font-size: clamp(1.45rem, 2.15vw, 2.05rem); font-weight: 700; letter-spacing: -.04em; line-height: 1.4; text-align: center; text-wrap: balance; }
  .home-hero__statement span { display: block; }
  .home-hero__body { grid-area: body; position: relative; z-index: 3; align-self: start; min-width: 0; max-width: 36rem; }
  .home-hero__result { min-height: 3.56em; margin: 0; color: var(--text-primary); font-size: 1.02rem; font-weight: 500; line-height: 1.78; text-align: center; white-space: pre-line; text-wrap: pretty; }
  .home-hero__rotation-meta { display: flex; min-height: 2.1rem; align-items: center; justify-content: center; margin-top: .45rem; }
  .home-hero__rotation-controls { display: inline-grid; grid-template-columns: 1.9rem auto 1.9rem; gap: .35rem; align-items: center; }
  .home-hero__rotation-controls[hidden] { display: none; }
  .home-hero__rotation-controls button { display: grid; width: 1.9rem; height: 1.9rem; padding: 0; place-items: center; border: 1px solid var(--border-strong); border-radius: 50%; background: color-mix(in srgb, var(--bg-soft) 88%, transparent); color: var(--text-secondary); cursor: pointer; transition: border-color 160ms ease, background-color 160ms ease, color 160ms ease, transform 120ms ease; }
  .home-hero__rotation-controls button:hover { border-color: var(--accent); background: var(--accent-subtle); color: var(--accent-text); }
  .home-hero__rotation-controls button:active { transform: translateY(1px); }
  .home-hero__rotation-controls button:focus-visible { outline: 3px solid var(--accent); outline-offset: .2rem; }
  .rotation-controls__count { min-width: 3.1rem; color: var(--text-muted); font-family: var(--font-mono); font-size: .62rem; letter-spacing: .035em; text-align: center; }
  .home-hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: .8rem 1.2rem; margin-top: 1rem; }
  .hero-action { white-space: nowrap; }
  .home-hero__secondary-action { display: inline-flex; align-items: center; gap: .4rem; padding-block: .45rem; color: var(--accent-text); font-size: .84rem; font-weight: 700; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .28em; }
  .home-hero__secondary-action:hover { color: var(--accent-hover); }
  .home-hero__secondary-action:focus-visible { outline: 3px solid var(--accent); outline-offset: .3rem; }
  .home-hero__portraits { grid-area: portraits; align-self: stretch; position: relative; z-index: 1; min-height: 31rem; margin: 0; }
  .hero-photo { position: absolute; padding: .48rem; border: 1px solid rgb(66 56 82 / .2); background: #fffdf8; box-shadow: 0 .9rem 1.7rem rgb(58 48 38 / .16); }
  .hero-photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .hero-photo--primary { top: -.6rem; right: -.2rem; z-index: 2; width: 68%; aspect-ratio: 1122 / 1402; transform: rotate(2.1deg); }
  .hero-photo--secondary { bottom: .8rem; left: -.5rem; z-index: 1; width: 52%; aspect-ratio: 1122 / 1402; transform: rotate(-5.2deg); }
  .hero-photo--secondary img { object-position: 51% center; }
  .home-hero__annotation { position: absolute; right: -.1rem; bottom: 3.2rem; z-index: 4; display: grid; gap: .18rem; margin: 0; padding: .72rem .92rem; border: 1px solid rgb(83 62 161 / .35); background: #eee7ff; color: var(--accent-text); font-family: var(--font-sans); font-size: .78rem; font-weight: 800; line-height: 1.35; transform: rotate(-2.5deg); box-shadow: 0 .45rem .9rem rgb(63 51 81 / .14); }
  .home-hero__annotation span { font-family: var(--font-mono); font-size: .55rem; font-weight: 600; letter-spacing: .09em; }
  @media (prefers-reduced-motion: no-preference) {
    .home-hero__statement, .home-hero__result { transition: opacity 220ms ease, transform 220ms ease; }
    .home-hero__statement.is-switching, .home-hero__result.is-switching { opacity: 0; }
    .home-hero__statement.is-switching--next, .home-hero__result.is-switching--next { transform: translateX(-.45rem); }
    .home-hero__statement.is-switching--previous, .home-hero__result.is-switching--previous { transform: translateX(.45rem); }
    .hero-photo--primary { animation: hero-photo-primary-in 620ms cubic-bezier(.2, .72, .2, 1) both; }
    .hero-photo--secondary { animation: hero-photo-secondary-in 680ms 90ms cubic-bezier(.2, .72, .2, 1) both; }
    .home-hero__annotation { animation: hero-note-in 420ms 430ms cubic-bezier(.2, .72, .2, 1) both; }
  }
  @keyframes hero-photo-primary-in { from { opacity: 0; transform: translate3d(1.2rem, -1rem, 0) rotate(4.8deg); } to { opacity: 1; transform: translate3d(0, 0, 0) rotate(2.1deg); } }
  @keyframes hero-photo-secondary-in { from { opacity: 0; transform: translate3d(-1.4rem, 1.2rem, 0) rotate(-7.5deg); } to { opacity: 1; transform: translate3d(0, 0, 0) rotate(-5.2deg); } }
  @keyframes hero-note-in { from { opacity: 0; transform: translate3d(.6rem, .5rem, 0) rotate(1deg); } to { opacity: 1; transform: translate3d(0, 0, 0) rotate(-2.5deg); } }
