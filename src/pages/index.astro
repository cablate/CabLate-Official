---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/sections/Newsletter.astro';
import HeroCarousel from '../components/sections/HeroCarousel.astro';
import { ArrowRight } from '@lucide/astro';
import { authorityProfile, representativeWork } from '../config/authority';

const handbook = representativeWork[0];

const heroSlides = [
  {
    src: '/images/photos/cablate-speaking-ai-meetup-april.webp',
    alt: 'CabLate 在四月 AI 小聚現場以麥克風分享技術內容',
    width: 2000,
    height: 1333,
  },
  {
    src: '/images/photos/cablate-speaking-workshop-0627.webp',
    alt: 'CabLate 在工作坊現場手持麥克風分享 AI 實作經驗',
    width: 1970,
    height: 1970,
  },
];

const diagnosticRows = [
  {
    titleLines: ['每次換個任務，都得重新交代背景。'],
    explanation: 'AI 沒有拿到能延續的正確脈絡。',
  },
  {
    titleLines: ['AI 做了很多，最後還是不敢直接用。'],
    explanation: '完成標準與驗收方式沒有先說清楚。',
  },
  {
    titleLines: ['一出錯就找不到原因，', '只能從頭再來。'],
    explanation: '流程沒有留下檢查點與復原方式。',
  },
];

const visitorRoutes = [
  {
    title: '我想先把 AI 用得更穩',
    description: '已經開始使用 AI，但常遇到忘記前文、產出不穩，或不知道應該從哪裡修正。',
    href: '/articles/',
    label: '從問題指南開始',
  },
  {
    title: '我想把一個想法完整做出來',
    description: '已經有網站、工具或工作流程的題目，希望學會把它推到能使用、能部署，也能繼續維護。',
    href: '/courses/',
    label: '找適合的學習路線',
  },
  {
    title: '我想改善團隊的 AI 流程',
    description: '團隊已經有工作內容、資料與使用者，希望判斷哪些地方該培訓、調整流程，或導入自動化。',
    href: '/services/',
    label: '查看合作方式',
  },
];

const methodChecks = [
  {
    title: '它拿到正確資料了嗎？',
    explanation: 'AI 需要的不是最多資料，而是在需要時取得正確版本與剛好足夠的資訊。',
    method: 'Context Engineering',
  },
  {
    title: '任務、工具與驗收有接起來嗎？',
    explanation: '模型只是其中一部分。工具怎麼使用、錯誤怎麼被發現、失敗後怎麼復原，也會決定成果是否穩定。',
    method: 'Harness Engineering',
  },
  {
    title: '做對一次的方法有留下來嗎？',
    explanation: '如果每次都要重新解釋，經驗就無法累積。Skill 應該留下判斷、順序、限制與完成標準。',
    method: 'Skill 設計',
  },
];
---

<BaseLayout title="CabLate — AI 協作・技術觀點・開發實戰" description={authorityProfile.shortBio}>
  <div class="desk-page">
    <main class="desk-content">
      <section class="hero-grid" aria-labelledby="home-title">
        <div class="identity-card paper-card">
          <div class="paper-card__inner">
            <p class="section-label">AI 協作・工作流程設計</p>
            <h1 id="home-title">讓 AI 做完，也讓成果真的能用。</h1>
            <p class="hero-copy">如果你已經在用 AI，卻還是經常重做、走偏，或不敢直接採用成果，問題通常不只在 Prompt。任務怎麼拆、資料怎麼給、工具怎麼接、做到哪裡算完成，才是成果能不能穩定的關鍵。</p>
            <a class="btn btn-primary home-hero-action" href="#diagnosis">先看看問題卡在哪 <ArrowRight size={17} aria-hidden="true" /></a>
          </div>
        </div>

        <HeroCarousel slides={heroSlides} />
      </section>

      <section class="paper-card" id="diagnosis" aria-labelledby="diagnosis-title">
        <div class="paper-card__inner home-split diagnosis-layout">
          <div class="diagnosis-intro">
            <p class="section-label">先看清楚問題</p>
            <h2 id="diagnosis-title">AI 偶爾做得到，不代表你已經有一套可靠流程。</h2>
            <p>真正需要的，不是每次得到一個漂亮答案，而是換任務、換工具或換人後，成果仍能被重現、檢查和修正。</p>
            <p class="diagnosis-conclusion">好消息是，這些問題都能拆開檢查。你不必一次換掉整套工具，只要先找出最容易失效的那一層。</p>
          </div>
          <div class="home-list diagnostic-list">
            {diagnosticRows.map((row) => (
              <article>
                <h3>
                  {row.titleLines.map((line, index) => (
                    <>{index > 0 && <br class="mobile-heading-break" />}{line}</>
                  ))}
                </h3>
                <p>{row.explanation}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="thesis-card paper-card" aria-labelledby="thesis-title">
        <div class="paper-card__inner home-split thesis-layout">
          <div>
            <p class="section-label">我的核心主張</p>
            <h2 id="thesis-title">判斷力比<br />執行力值錢。</h2>
          </div>
          <div class="thesis-copy">
            <p class="identity-lead">我是 CabLate，一位從全端工程走進 AI 工作流程設計的實作者。</p>
            <p>我關心的不是 AI 能不能生成，而是成果能不能被採用、驗收與重現。遇到問題時，我會先看系統怎麼失效，再判斷該補資料、工具、流程，還是完成標準。</p>
            <a class="text-link" href="/about/">了解這套判斷從哪裡來 <ArrowRight size={16} aria-hidden="true" /></a>
          </div>
        </div>
      </section>

      <section class="paper-card" aria-labelledby="routes-title">
        <div class="paper-card__inner">
          <header class="section-header">
            <p class="section-label">選擇下一步</p>
            <h2 id="routes-title">你現在最想改善<br class="mobile-heading-break" />哪一件事？</h2>
          </header>
          <div class="home-list route-list">
            {visitorRoutes.map((route) => (
              <article class="route-row">
                <h3>{route.title}</h3>
                <p>{route.description}</p>
                <div class="route-action">
                  <a class="text-link" href={route.href}>{route.label} <ArrowRight size={15} aria-hidden="true" /></a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="case-card paper-card paper-card--clip" aria-labelledby="case-title">
        <div class="paper-card__inner home-split">
          <div class="case-story">
            <p class="section-label">一次真實的追查</p>
            <h2 id="case-title">規則愈加愈多，<br class="mobile-heading-break" />為什麼<br class="case-title-desktop-break" /> AI 還是會<br class="mobile-heading-break" />忘記、重做？</h2>
            <div class="case-step">
              <strong>問題</strong>
            <p>為了讓 AI 記得更多背景，我不斷增加規則與設定，成果卻沒有因此變穩。</p>
            </div>
            <div class="case-step">
              <strong>發現</strong>
              <p>追查後才發現，真正缺少的不是更多規則，而是它當下能讀到的資料、可以使用的工具，以及驗收與復原方式沒有接起來。</p>
            </div>
            <div class="case-step">
              <strong>處理</strong>
              <p>我把這半年多反覆遇到的問題，連同 Skill、Memory、Context 等做法，整理成一份能查原因、能修正，也方便交接的工程手冊。</p>
            </div>
            <a class="text-link" href={handbook.href}>看手冊怎麼拆這些問題 <ArrowRight size={16} aria-hidden="true" /></a>
            <p class="case-proof">整理自半年以上的實作與排錯經驗。</p>
          </div>
        </div>
      </section>

      <section class="paper-card" aria-labelledby="methods-title">
        <div class="paper-card__inner">
          <header class="section-header">
            <p class="section-label">失效診斷</p>
            <h2 id="methods-title">AI 卡住時，我通常先檢查這三件事。</h2>
          </header>
          <div class="home-list method-list">
            {methodChecks.map((check) => (
              <article class="method-row">
                <h3>{check.title}</h3>
                <p>{check.explanation}</p>
                <span>{check.method}</span>
              </article>
            ))}
          </div>
          <a class="text-link methods-action" href="/expertise/">深入了解這三類問題 <ArrowRight size={16} aria-hidden="true" /></a>
        </div>
      </section>

      <section class="paper-card" aria-label="更新通知">
        <div class="paper-card__inner"><Newsletter /></div>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  :global(body) {
    background: #eeeae2;
    color: #253047;
  }

  .desk-page {
    --ink: #253047;
    --muted: #697184;
    --purple: #8064ea;
    --purple-soft: #f1edff;
    --line: #d7d1c6;
    min-height: 100dvh;
    background-color: #eeeae2;
    background-image: radial-gradient(rgb(60 50 40 / .045) .7px, transparent .7px);
    background-size: .42rem .42rem;
  }

  .desk-content {
    display: grid;
    width: min(100%, 86rem);
    min-width: 0;
    gap: 1rem;
    margin-inline: auto;
    padding-block: 1rem 1.5rem;
  }

  .desk-content > *,
  .hero-grid > * {
    min-width: 0;
  }

  h1,
  h2,
  h3 {
    text-wrap: balance;
  }

  p,
  li {
    text-wrap: pretty;
  }

  h1,
  h2,
  h3,
  p {
    overflow-wrap: break-word;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(22rem, .82fr) minmax(30rem, 1.18fr);
    align-items: center;
    gap: 1.5rem;
  }

  .identity-card {
    z-index: 2;
    margin-right: -2.5rem;
  }

  .identity-card .paper-card__inner {
    padding: clamp(2.4rem, 4vw, 3.4rem) clamp(2.1rem, 3.5vw, 3rem);
  }

  .identity-card h1 {
    max-width: 10.5em;
    margin: 0;
    font-family: 'Noto Serif TC', serif;
    font-size: clamp(2.35rem, 3.4vw, 3.25rem);
    line-height: 1.18;
    letter-spacing: -.045em;
  }

  .hero-copy {
    max-width: 33rem;
    margin: 1.35rem 0 1.55rem;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.85;
  }

  .home-hero-action {
    border-radius: 0;
  }

  .home-hero-action:hover {
    background: var(--purple);
  }

  .home-split {
    display: grid;
    align-items: start;
  }

  .diagnosis-layout {
    grid-template-columns: minmax(18rem, .78fr) minmax(28rem, 1.22fr);
    gap: clamp(2rem, 5vw, 4rem);
  }

  .diagnosis-intro h2,
  .thesis-card h2,
  .section-header h2,
  .case-story h2 {
    margin: 0;
    font-family: 'Noto Serif TC', serif;
    color: var(--ink);
  }

  .diagnosis-intro h2,
  .section-header h2 {
    font-size: clamp(1.75rem, 3vw, 2.6rem);
    line-height: 1.35;
  }

  .diagnosis-intro > p:not(.section-label) {
    margin: 1rem 0 0;
    color: var(--muted);
    line-height: 1.8;
  }

  .diagnosis-conclusion {
    color: var(--ink) !important;
    font-weight: 700;
  }

  .home-list {
    min-width: 0;
  }

  .diagnostic-list article {
    padding: 1.15rem 0;
    border-top: 1px solid var(--line);
  }

  .diagnostic-list article:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .diagnostic-list h3 {
    margin: 0;
    font-family: 'Noto Serif TC', serif;
    font-size: 1.15rem;
    line-height: 1.5;
  }

  .diagnostic-list p {
    margin: .4rem 0 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .thesis-layout {
    grid-template-columns: minmax(18rem, .82fr) minmax(28rem, 1.18fr);
    gap: clamp(2rem, 6vw, 5rem);
  }

  .thesis-card h2 {
    max-width: 8em;
    font-size: clamp(2.2rem, 4.5vw, 4.4rem);
    line-height: 1.22;
    letter-spacing: -.04em;
  }

  .thesis-copy p {
    margin: 0 0 1rem;
    color: var(--muted);
    line-height: 1.85;
  }

  .thesis-copy .identity-lead {
    color: var(--ink);
    font-family: 'Noto Serif TC', serif;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: 700;
    line-height: 1.6;
  }

  .section-header {
    max-width: 43rem;
    margin-bottom: 1.5rem;
  }

  .route-row {
    display: grid;
    grid-template-columns: minmax(13rem, .8fr) minmax(20rem, 1.35fr) minmax(11rem, .75fr);
    align-items: start;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding: 1.45rem 0;
    border-top: 1px solid var(--line);
  }

  .route-row h3,
  .method-row h3 {
    margin: 0;
    font-family: 'Noto Serif TC', serif;
    font-size: 1.15rem;
    line-height: 1.5;
  }

  .route-row > p,
  .method-row > p {
    margin: 0;
    color: var(--muted);
    line-height: 1.75;
  }

  .route-action {
    display: grid;
    justify-items: start;
    gap: .7rem;
  }

  .case-story {
    max-width: 58rem;
  }

  .case-story h2 {
    max-width: 19em;
    font-size: clamp(1.8rem, 3.4vw, 3.1rem);
    line-height: 1.35;
  }

  .mobile-heading-break {
    display: none;
  }

  .case-step {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .case-step strong {
    color: var(--purple);
    font-size: .78rem;
  }

  .case-step p {
    margin: 0;
    color: var(--muted);
    line-height: 1.75;
  }

  .case-story .text-link {
    margin-top: 1.5rem;
  }

  .case-proof {
    margin: .75rem 0 0;
    color: var(--muted);
    font-size: .78rem;
  }

  .method-row {
    display: grid;
    grid-template-columns: minmax(15rem, 1fr) minmax(24rem, 1.4fr) minmax(10rem, .7fr);
    align-items: start;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding: 1.45rem 0;
    border-top: 1px solid var(--line);
  }

  .method-row > span {
    color: var(--purple);
    font-size: .76rem;
    font-weight: 700;
    line-height: 1.6;
  }

  .methods-action {
    margin-top: 1.2rem;
  }

  @media (max-width: 1100px) {
    .hero-grid {
      grid-template-columns: minmax(20rem, .9fr) minmax(25rem, 1.1fr);
    }

    .identity-card {
      margin-right: -1.5rem;
    }

    .route-row,
    .method-row {
      grid-template-columns: minmax(13rem, .9fr) minmax(20rem, 1.3fr);
    }

    .route-action,
    .method-row > span {
      grid-column: 2;
    }

  }

  @media (max-width: 900px) {
    .desk-content {
      width: 100%;
      max-width: 100%;
      padding-block: .75rem 1rem;
      overflow: clip;
    }

    .hero-grid,
    .diagnosis-layout,
    .thesis-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .identity-card {
      margin-right: 0;
    }

    .identity-card .paper-card__inner {
      padding: 2rem 1.25rem;
    }

    .identity-card h1 {
      max-width: 12em;
      font-size: clamp(2.1rem, 9vw, 3rem);
    }

    .hero-copy {
      font-size: .96rem;
    }

    .diagnosis-layout,
    .thesis-layout {
      gap: 1.75rem;
    }

    .thesis-card h2 {
      max-width: 10em;
      font-size: clamp(2rem, 10vw, 3rem);
    }

    .route-row,
    .method-row {
      grid-template-columns: minmax(0, 1fr);
      gap: .55rem;
      padding: 1.25rem 0;
    }

    .route-action,
    .method-row > span {
      grid-column: auto;
    }

    .route-action {
      margin-top: .25rem;
    }

    .case-step {
      grid-template-columns: minmax(0, 1fr);
      gap: .35rem;
    }

  }

  @media (max-width: 480px) {
    .identity-card h1 {
      font-size: clamp(2rem, 10.5vw, 2.6rem);
    }

    .home-hero-action {
      width: 100%;
      justify-content: center;
    }

    .diagnosis-intro h2,
    .section-header h2 {
      font-size: 1.65rem;
    }

    .case-story h2 {
      font-size: 1.75rem;
    }

    .case-title-desktop-break {
      display: none;
    }

    .mobile-heading-break {
      display: initial;
    }
  }
</style>
