---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import Newsletter from '../components/sections/Newsletter.astro';
import ProofStrip from '../components/common/ProofStrip.astro';
import QuoteBand from '../components/common/QuoteBand.astro';
import WhyDifferent from '../components/common/WhyDifferent.astro';
import { ArrowRight, Braces, Database, GitBranch } from '@lucide/astro';
import { siteConfig, withCabAiAttribution } from '../config/siteConfig';
import { audienceTypes, proofPoints, teachingSessions } from '../config/authority';
import { formatDate } from '../utils/format';

const publishedArticles = (await getCollection('articles'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const [featuredArticle, ...recentArticles] = publishedArticles.slice(0, 3);

const heroMessages = [
  {
    statement: ['我是 Cab，在第一線教 AI 落地，', '從農會推廣人員教到外商工程團隊'],
    result: '我教的是怎麼判斷 AI 該不該用、怎麼用才划算。\n我自己也每天用 Claude Code 工作。',
  },
];

const diagnosticCases = [
  {
    code: 'context',
    icon: Database,
    term: 'Context',
    title: '它看到了什麼',
    question: ['它這次到底', '看到了哪些資料'],
    symptom: ['講了很多次', 'AI 還是做不好'],
    description: '你以為交代過了，下一次它又像沒聽過。',
    diagnosis: ['你以為它知道的背景', '這次可能根本沒傳給它'],
    next: ['挑一個明顯答錯的地方', '對照它當時實際讀到的資料'],
    cta: { label: '60 分鐘專案諮詢：一起找出它漏看了什麼', href: '/services/consulting/' },
  },
  {
    code: 'skill',
    icon: Braces,
    term: 'Skill',
    title: '做法有沒有留下來',
    question: ['上次做對的做法', '有沒有被留下來'],
    symptom: ['這次明明做出來了', '下次又要重來'],
    description: '結果留下了，做對的方法沒留下。',
    diagnosis: ['你存了成品，沒存做法', '做對的判斷下次還是要重講'],
    next: ['找一個每次都要重講的判斷', '寫成下次能直接照做的步驟'],
    cta: { label: '五週陪跑：把做對的那一次變成固定做法', href: '/services/coaching/' },
  },
  {
    code: 'harness',
    icon: GitBranch,
    term: 'Harness',
    title: '流程從哪裡斷掉',
    question: ['流程是從哪一步', '開始斷掉的'],
    symptom: ['只要一步出錯', '整條流程就卡住'],
    description: '前面都做對了，一出錯還是只能從頭來。',
    diagnosis: ['流程只會從頭跑', '前面做對再多，出錯也接不回去'],
    next: ['找到出錯前最後完成的那一步', '讓流程能從那裡接著做'],
    cta: { label: '團隊導入：把流程改成出錯也接得回去', href: '/services/enterprise/' },
  },
];

const routes = [
  { title: '先自己檢查一個任務', description: '拿一件最近做壞的事，照五個問題檢查，看先修哪一層。', price: '免費', label: '開始健檢', href: '/expertise/' },
  { title: '自己學', description: 'AgentSkill 課程和 Claude Code 手冊，每一門都有免費試看。', price: 'NT$1,500 起', label: '看課程與手冊', href: '/courses/' },
  { title: '找我一起看', description: '60 分鐘諮詢或五週陪跑。先填表，我會親自看過再回你。', price: 'NT$5,000 起', label: '看合作方式', href: '/services/' },
];

const speakerRecords = teachingSessions.map((session, index) => ({
  id: session.id,
  time: session.time,
  title: session.title,
  audience: session.audience,
  format: session.format,
  description: session.detail,
  tags: session.tags,
  visual: index % 2 === 0 ? 'meetup' : 'workshop',
}));

const planEntries = [
  { name: '講座', length: '1–2 小時', fit: '先讓全員或主管有共同的說法。', href: '/services/partnerships/', featured: false },
  { name: '實作工作坊', length: '半日或全日', fit: '一個部門拿自己的工作來練，每人帶電腦做。', href: '/services/enterprise/#enterprise-options-title', featured: true },
  { name: '兩日班或導入陪跑', length: '16 小時或分週', fit: '從零做到能用的成果，或挑一段流程試做。', href: '/services/enterprise/#enterprise-options-title', featured: false },
];

const threadsProof = proofPoints.find((point) => point.label.includes('Threads')) ?? proofPoints[0];
---

<BaseLayout title="CabLate｜AI 企業內訓、講座與 Claude Code" description="Cab 在第一線教 AI 落地：從農會推廣人員教到外商工程團隊，自己每天用 Claude Code 工作。提供企業內訓、講座、工作坊，也接 AI 諮詢與陪跑。" image="/og/pages/home.png" imageAlt="CabLate：我在第一線教 AI 落地，自己也每天用它工作。" imageWidth={1200} imageHeight={630}>
  <div class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <header class="home-hero__lede">
        <h1 id="home-title"><span>AI 課上完，</span><span>大家有真的用進工作嗎？</span></h1>
        <p class="home-hero__statement" id="home-hero-statement">
          {heroMessages[0].statement.map((line) => <span>{line}</span>)}
        </p>
      </header>

      <figure class="home-hero__portraits">
        <div class="hero-photo hero-photo--primary">
          <img
            src="/images/photos/cablate-speaking-ai-meetup-april-refined-v1.webp"
            alt="Cab 在 AI 小聚現場分享 AI 協作與工作流程"
            width="1122"
            height="1402"
            fetchpriority="high"
          />
        </div>
        <div class="hero-photo hero-photo--secondary">
          <img
            src="/images/photos/cablate-speaking-workshop-0627-refined-v1.webp"
            alt="Cab 在工作坊現場與學員拆解實作問題"
            width="1122"
            height="1402"
            fetchpriority="low"
          />
        </div>
        <p class="home-hero__annotation"><span>我最常問的一句</span>做出來之後，誰來檢查？</p>
      </figure>

      <div class="home-hero__body">
        <p class="home-hero__result" id="home-hero-result">{heroMessages[0].result}</p>
        <div class="home-hero__actions">
          <a class="btn btn-primary hero-action" href="/services/enterprise/">邀請我上課或內訓 <ArrowRight size={18} aria-hidden="true" /></a>
          <a class="home-hero__secondary-action" href="#identity-title">看我教過誰 <ArrowRight size={16} aria-hidden="true" /></a>
        </div>
        <p class="home-hero__free-note">需求先聊，不收費。</p>
      </div>
    </section>

    <ProofStrip label="目前的數字" />

    <WhyDifferent />

    <section class="identity-section speaker-section" aria-labelledby="identity-title" data-speaker-section data-chapter-transition>
      <span class="identity-section__seam" aria-hidden="true"><span data-chapter-seam></span></span>
      <div class="identity-intro section-grid" data-chapter-lead>
        <header><h2 id="identity-title">這一年，<span class="identity-intro__nowrap">我教過這些人</span></h2></header>
        <div class="identity-intro__copy">
          <p class="identity-intro__lead">有沒寫過程式的推廣人員，也有天天寫程式的工程師。</p>
          <ul class="audience-chips" aria-label="教過的對象">
            {audienceTypes.map((type) => <li>{type}</li>)}
          </ul>
          <a class="text-action" href="/services/enterprise/">看可以上的主題和形式 <ArrowRight size={16} aria-hidden="true" /></a>
        </div>
      </div>
      <div class="speaker-proof">
        <div class="speaker-trace" data-speaker-trace>
          <div class="speaker-trace__rail" aria-hidden="true"><span data-speaker-progress></span></div>
          <ol class="speaker-records">
            {speakerRecords.map((record) => (
              <li class="speaker-record" data-speaker-record={record.id} data-speaker-visual={record.visual}>
                <div class="speaker-record__time"><span>{record.time}</span></div>
                <div class="speaker-record__body">
                  <h3>{record.title}</h3>
                  {'audience' in record && <p class="speaker-record__audience">{record.audience}・{record.format}</p>}
                  <p>{record.description}</p>
                  {'tags' in record && record.tags && (
                    <ul class="speaker-record__tags" aria-label="重點">
                      {record.tags.map((tag: string) => <li>{tag}</li>)}
                    </ul>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>
        <div class="speaker-proof__side">
          <figure class="speaker-media" aria-label="講座與工作坊現場照片">
            <div class="speaker-media__frame" data-speaker-media="meetup">
              <img src="/images/photos/cablate-speaking-ai-meetup-april.webp" alt="Cab 在 AI 小聚現場拿著麥克風分享" width="2000" height="1333" loading="lazy" />
              <figcaption>AI 小聚分享</figcaption>
            </div>
            <div class="speaker-media__frame" data-speaker-media="workshop">
              <img src="/images/photos/cablate-speaking-workshop-0627.webp" alt="Cab 在工作坊現場與學員一起拆解問題" width="1970" height="1970" loading="lazy" />
              <figcaption>工作坊實作</figcaption>
            </div>
          </figure>
          <figure class="threads-proof" id="threads-proof">
            <div class="threads-proof__header">
              <span class="threads-proof__badge">Threads @cab_late</span>
              <div class="threads-proof__stat"><strong>{threadsProof.value}</strong><span>人追蹤</span></div>
            </div>
            <div class="threads-proof__content">
              <p>平常在 Threads 寫 AI 協作、Claude Code 拆解和工作方法。</p>
              <a class="threads-proof__cta" href={siteConfig.threadsUrl} target="_blank" rel="noopener">去 Threads 看看 <ArrowRight size={14} aria-hidden="true" /></a>
            </div>
          </figure>
        </div>
      </div>
    </section>

    <section class="plan-entry" aria-labelledby="plan-entry-title">
      <header>
        <p class="section-label">合作方案</p>
        <h2 id="plan-entry-title">三種方案，<br />看人數和想做到哪裡</h2>
      </header>
      <div class="plan-entry__grid">
        {planEntries.map((plan) => (
          <a class:list={['plan-entry__card', plan.featured && 'is-featured']} href={plan.href}>
            {plan.featured && <small>最多團隊選</small>}
            <strong>{plan.name}</strong>
            <span class="plan-entry__length">{plan.length}</span>
            <p>{plan.fit}</p>
            <span class="plan-entry__more">看細節 <ArrowRight size={15} aria-hidden="true" /></span>
          </a>
        ))}
      </div>
    </section>

    <QuoteBand title="我常講的幾句話" lead="Threads 原文，沒有修過。" pick={[0, 1, 3]} tone="light" />

    <section class="diagnostic-stage" aria-labelledby="diagnostic-title">
      <div class="diagnostic-console">
        <div class="diagnostic-chassis-bar" aria-hidden="true">
          <div class="diagnostic-chassis-status">
            <span class="chassis-led"></span>
            <span class="chassis-label">選一個最像你的</span>
          </div>
          <h2 class="diagnostic-chassis-title" id="diagnostic-title">AI 用到一半卡住，通常是這三種</h2>
          <div class="diagnostic-chassis-coords" aria-hidden="true"></div>
        </div>

        <div class="diagnostic-workbench">
          <fieldset class="symptom-choices">
            <legend class="visually-hidden">選擇最接近目前情況的症狀</legend>
            {diagnosticCases.map((item, index) => (
              <label class="symptom-choice" for={`home-diagnostic-${item.code}`}>
                <input id={`home-diagnostic-${item.code}`} type="radio" name="home-diagnostic" value={item.code} checked={index === 0} aria-controls={`home-trace-${item.code}`} />
                <span class="symptom-choice__surface">
                  <span class="symptom-choice__meta">
                    <span class="symptom-choice__num">0{index + 1}</span>
                    <span class="symptom-choice__term">{item.term}</span>
                  </span>
                  <strong>{item.symptom.map((line) => <span class="symptom-copy-line">{line}</span>)}</strong>
                  <span>{item.description}</span>
                </span>
              </label>
            ))}
          </fieldset>

          <div class="trace-panels" aria-live="polite">
            {diagnosticCases.map((item) => (
              <article class="trace-panel" id={`home-trace-${item.code}`} data-trace={item.code}>
                <header class="trace-panel__heading">
                  <div class="diagnosis-stamp"><item.icon size={18} aria-hidden="true" /><span>{item.term} / {item.title}</span></div>
                  <h3>{item.question.map((line) => <span>{line}</span>)}</h3>
                </header>
                <div class="trace-reading">
                  <div class="trace-diagnosis-card">
                    <span class="trace-subheading">問題多半在這</span>
                    <p class="trace-diagnosis">{item.diagnosis.map((line) => <span>{line}</span>)}</p>
                  </div>
                  <div class="trace-next-card">
                    <span class="trace-subheading trace-subheading--action">先試這一步</span>
                    <p class="trace-next"><span class="trace-next__arrow" aria-hidden="true">→</span><strong>{item.next.map((line) => <span>{line}</span>)}</strong></p>
                  </div>
                  <div class="trace-action-card">
                    <a class="trace-action-btn" href={item.cta.href}>
                      <span class="trace-action-btn__text">{item.cta.label}</span>
                      <span class="trace-action-btn__icon" aria-hidden="true">
                        <ArrowRight size={16} />
                      </span>
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="route-section" aria-labelledby="route-title" data-chapter-transition>
      <header class="route-heading" data-chapter-lead>
        <span class="section-label">下一步</span>
        <h2 id="route-title">個人想把 AI 用好？從這裡開始</h2>
      </header>
      <div class="route-grid">
        {routes.map((route, index) => (
          <article class:list={['route-card', index === routes.length - 1 ? 'route-card--collab' : 'route-card--self']}>
            <div class="route-card__top">
              <span class="route-card__tag">{String(index + 1).padStart(2, '0')}</span>
              <span class="route-card__status">{route.price}</span>
            </div>
            <div class="route-card__main">
              <h3>{route.title}</h3>
              <p class="route-card__desc">{route.description}</p>
            </div>
            <div class="route-card__action-wrap">
              <a class:list={['route-card__btn', index === routes.length - 1 ? 'btn-primary' : 'btn-ghost']} href={route.href}>
                <span>{route.label}</span>
                <ArrowRight size={16} aria-hidden="true" />
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    {featuredArticle && (
      <section class="home-writing" aria-labelledby="home-writing-title">
        <header class="home-writing__header">
          <div>
            <p class="section-label">實作拆解</p>
            <h2 id="home-writing-title">最近卡過的問題與逆向筆記</h2>
          </div>
          <a class="text-link" href="/articles/">看全部 {publishedArticles.length} 篇文章 <ArrowRight size={15} aria-hidden="true" /></a>
        </header>

        <div class="home-writing__grid">
          <a class="home-writing__featured" href={`/articles/${featuredArticle.id}/`}>
            <div class="home-writing__meta">
              <span class="home-writing__category">{featuredArticle.data.category}</span>
              <time datetime={featuredArticle.data.publishDate.toISOString()}>{formatDate(featuredArticle.data.publishDate)}</time>
              {featuredArticle.data.readingTime && <span>{featuredArticle.data.readingTime} 分鐘閱讀</span>}
            </div>
            <h3>{featuredArticle.data.title}</h3>
            <p>{featuredArticle.data.description}</p>
            {featuredArticle.data.ogHighlight && (
              <div class="home-writing__highlight">
                <span>{featuredArticle.data.ogHighlight.label}</span>
                <s>{featuredArticle.data.ogHighlight.before}</s>
                <span aria-hidden="true">→</span>
                <strong>{featuredArticle.data.ogHighlight.after}</strong>
              </div>
            )}
            <span class="home-writing__cta">閱讀完整拆解 <ArrowRight size={15} aria-hidden="true" /></span>
          </a>

          <div class="home-writing__side">
            {recentArticles.map((article) => (
              <a class="home-writing__item" href={`/articles/${article.id}/`}>
                <div class="home-writing__meta">
                  <span class="home-writing__category">{article.data.category}</span>
                  <time datetime={article.data.publishDate.toISOString()}>{formatDate(article.data.publishDate)}</time>
                  {article.data.readingTime && <span>{article.data.readingTime} 分鐘閱讀</span>}
                </div>
                <h3>{article.data.title}</h3>
                {article.data.ogHighlight ? (
                  <div class="home-writing__highlight">
                    <span>{article.data.ogHighlight.label}</span>
                    <s>{article.data.ogHighlight.before}</s>
                    <span aria-hidden="true">→</span>
                    <strong>{article.data.ogHighlight.after}</strong>
                  </div>
                ) : (
                  <p>{article.data.description}</p>
                )}
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="cabai-section" aria-labelledby="cabai-title" data-chapter-transition>
      <div class="cabai-section__header" data-chapter-lead>
        <span class="section-label">CabAI</span>
        <h2 id="cabai-title">課程和文章，<br />都放在 CabAI</h2>
        <p class="cabai-section__lead">公開文章、課程和手冊都在 CabAI，同一個帳號就能看。</p>
      </div>
      <div class="cabai-section__body">
        <div class="cabai-matrix" aria-label="CabAI 內容索引">
          <a class="cabai-matrix-card cabai-matrix-card--library" href={withCabAiAttribution(siteConfig.cabAi.libraryUrl, 'home_cabai_library')} target="_blank" rel="noopener">
            <div class="cabai-matrix-card__head">
              <span class="cabai-matrix-card__badge">免費</span>
              <span class="cabai-matrix-card__icon"><Database size={17} aria-hidden="true" /></span>
            </div>
            <div class="cabai-matrix-card__body">
              <strong>公開文章與筆記</strong>
              <p>Claude Code 拆解、排錯紀錄和工程筆記，不用登入就能看。</p>
            </div>
            <div class="cabai-matrix-card__footer">
              <span>去看文章</span>
              <ArrowRight size={15} aria-hidden="true" />
            </div>
          </a>
          <a class="cabai-matrix-card cabai-matrix-card--courses" href={withCabAiAttribution(siteConfig.cabAi.productsUrl, 'home_cabai_courses')} target="_blank" rel="noopener">
            <div class="cabai-matrix-card__head">
              <span class="cabai-matrix-card__badge cabai-matrix-card__badge--courses">課程</span>
              <span class="cabai-matrix-card__icon"><Braces size={17} aria-hidden="true" /></span>
            </div>
            <div class="cabai-matrix-card__body">
              <strong>課程與手冊</strong>
              <p>AgentSkill 課程、Claude Code 深度工程手冊，每一門都有免費試看。</p>
            </div>
            <div class="cabai-matrix-card__footer">
              <span>看有哪些課</span>
              <ArrowRight size={15} aria-hidden="true" />
            </div>
          </a>
        </div>
      </div>
    </section>

    <section class="two-door" aria-labelledby="two-door-title">
      <h2 id="two-door-title">先從一場講座開始，<br />還是直接談一個部門的工作坊？</h2>
      <div class="two-door__actions">
        <a class="btn btn-ghost" href="/services/partnerships/">邀請演講或講座 <ArrowRight size={17} aria-hidden="true" /></a>
        <a class="btn btn-primary" href="/services/enterprise/">談企業內訓或工作坊 <ArrowRight size={17} aria-hidden="true" /></a>
      </div>
      <p>需求先聊，不收費。填表後我會親自回覆。</p>
    </section>

    <div class="newsletter-card"><Newsletter /></div>
  </div>
</BaseLayout>

<script>
  const initializeSpeakerEvidence = () => {
    const sections = document.querySelectorAll<HTMLElement>('[data-speaker-section]');

    sections.forEach((section) => {
      if (section.dataset.speakerReady === 'true') return;

      const trace = section.querySelector<HTMLElement>('[data-speaker-trace]');
      const records = Array.from(section.querySelectorAll<HTMLElement>('[data-speaker-record]'));
      const progress = section.querySelector<HTMLElement>('[data-speaker-progress]');
      const mediaFrames = Array.from(section.querySelectorAll<HTMLElement>('[data-speaker-media]'));
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const desktop = window.matchMedia('(min-width: 981px)');

      if (!trace || records.length === 0 || !progress || mediaFrames.length === 0) return;

      section.dataset.speakerReady = 'true';
      let activeFrame = mediaFrames.find((frame) => frame.dataset.speakerMedia === records[0]?.dataset.speakerVisual) ?? mediaFrames[0];
      let destroyed = false;

      const setActive = (record: HTMLElement) => {
        records.forEach((item) => item.classList.toggle('is-active', item === record));
        const nextFrame = mediaFrames.find((frame) => frame.dataset.speakerMedia === record.dataset.speakerVisual);
        if (!nextFrame || nextFrame === activeFrame) return;

        const previousFrame = activeFrame;
        activeFrame = nextFrame;
        nextFrame.classList.add('is-active');
        previousFrame.classList.remove('is-active');
      };

      records[0]?.classList.add('is-active');

      let observer: IntersectionObserver | null = null;
      if (!reduceMotion.matches && desktop.matches && 'IntersectionObserver' in window) {
        observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting && entry.target instanceof HTMLElement) {
                setActive(entry.target);
              }
            }
          },
          { rootMargin: '-32% 0px -32% 0px', threshold: 0 }
        );
        records.forEach((record) => observer?.observe(record));
      }

      const cleanup = () => {
        if (destroyed) return;
        destroyed = true;
        observer?.disconnect();
