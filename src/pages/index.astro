    overflow: hidden;
    isolation: isolate;
    animation: trace-btn-ambient-heartbeat 4.2s cubic-bezier(.2, .8, .2, 1) infinite;
    transition: background-color var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast), transform 160ms ease;
  }
  .trace-action-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / .16), transparent);
    transform: skewX(-20deg);
    animation: trace-btn-ambient-shimmer 4.2s ease-in-out infinite;
    pointer-events: none;
  }
  .trace-action-btn__text { position: relative; z-index: 1; line-height: 1.4; }
  .trace-action-btn__icon {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: rgb(255 255 255 / .12);
    border: 1px solid rgb(255 255 255 / .2);
    color: #fff;
    flex-shrink: 0;
    animation: icon-ambient-nudge 4.2s ease-in-out infinite;
    transition: transform 220ms cubic-bezier(.34, 1.56, .64, 1), background-color 200ms ease, color 200ms ease, box-shadow 200ms ease;
  }
  .trace-action-btn:hover {
    animation: btn-wiggle-bounce 450ms cubic-bezier(.2, .8, .2, 1) forwards;
    background: linear-gradient(135deg, #3d2f78 0%, #271e50 100%);
    border-color: var(--accent-bright);
    color: #fff;
    box-shadow: 0 8px 22px rgb(128 100 234 / .38), inset 0 1px 0 rgb(255 255 255 / .28);
  }
  .trace-action-btn:hover::before { animation: none; left: 140%; transition: left 400ms ease; }
  .trace-action-btn:hover .trace-action-btn__icon {
    animation: none;
    background: var(--accent-bright);
    color: #1a1628;
    transform: translateX(6px) scale(1.15) rotate(-8deg);
    box-shadow: 0 0 14px rgb(170 154 246 / .6);
  }
  .trace-action-btn:active {
    animation: none !important;
    transform: translateY(2px) scale(0.97) !important;
    box-shadow: 0 2px 4px rgb(37 48 71 / .4), inset 0 1px 0 rgb(255 255 255 / .1);
  }
  .trace-action-btn:focus-visible { outline: 3px solid var(--accent-bright); outline-offset: .25rem; }

  @keyframes trace-btn-pop-in {
    0% { opacity: 0; transform: translateY(14px) scale(0.92); }
    55% { opacity: 1; transform: translateY(-4px) scale(1.02); }
    75% { transform: translateY(2px) scale(0.99); }
    90% { transform: translateY(-1px) scale(1.005); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes trace-btn-ambient-heartbeat {
    0%, 72%, 100% { transform: translateY(0) rotate(0deg) scale(1); box-shadow: 0 4px 12px rgb(37 48 71 / .22), inset 0 1px 0 rgb(255 255 255 / .18); }
    75% { transform: translateY(-4px) rotate(-1.2deg) scale(1.012); box-shadow: 0 7px 18px rgb(128 100 234 / .32), inset 0 1px 0 rgb(255 255 255 / .25); }
    79% { transform: translateY(1px) rotate(1deg); }
    83% { transform: translateY(-2px) rotate(-0.5deg); box-shadow: 0 5px 14px rgb(128 100 234 / .26), inset 0 1px 0 rgb(255 255 255 / .2); }
    87% { transform: translateY(0.5px) rotate(0.2deg); }
    91% { transform: translateY(0) rotate(0deg); }
  }
  @keyframes trace-btn-ambient-shimmer {
    0%, 70% { left: -100%; opacity: 0; }
    72% { opacity: 1; }
    86%, 100% { left: 140%; opacity: 0; }
  }
  @keyframes btn-wiggle-bounce {
    0% { transform: translateY(0) rotate(0deg); }
    20% { transform: translateY(-5px) rotate(-1.5deg) scale(1.015); }
    40% { transform: translateY(-1px) rotate(1.2deg); }
    60% { transform: translateY(-3.5px) rotate(-0.6deg); }
    80% { transform: translateY(-2px) rotate(0.3deg); }
    100% { transform: translateY(-2.5px) rotate(0deg); }
  }
  @keyframes icon-ambient-nudge {
    0%, 72%, 100% { transform: translateX(0); }
    76% { transform: translateX(5px) scale(1.1); }
    80% { transform: translateX(-2px) scale(0.96); }
    84% { transform: translateX(3px) scale(1.04); }
    88% { transform: translateX(0); }
  }
  @supports selector(:has(*)) {
    .trace-panel { display: none; }
    .diagnostic-workbench:has(#home-diagnostic-context:checked) [data-trace='context'],
    .diagnostic-workbench:has(#home-diagnostic-skill:checked) [data-trace='skill'],
    .diagnostic-workbench:has(#home-diagnostic-harness:checked) [data-trace='harness'] { display: grid; }
  }
  @keyframes trace-panel-in { from { opacity: .65; } to { opacity: 1; } }
  @keyframes stamp-in { from { opacity: 0; transform: translateY(-.5rem) rotate(-4deg); } to { opacity: 1; transform: translateY(0) rotate(-1.25deg); } }
  @keyframes trace-step-in { from { opacity: 0; transform: translateY(.45rem); } to { opacity: 1; transform: translateY(0); } }

  /* 3. ROUTE DECISION BLUEPRINT CARDS */
  .route-section {
    display: grid;
    gap: 1.25rem;
    padding: clamp(2.2rem, 3.8vw, 3.5rem) clamp(1.5rem, 3.5vw, 3.2rem);
    border: 1px solid var(--border-strong);
    background: #fffdf8;
    background-image: var(--paper-white-image);
    border-radius: var(--radius-sm);
  }
  .route-heading { display: grid; gap: .45rem; max-width: 42rem; }
  .route-heading h2 { margin: 0; font-family: var(--font-serif); font-size: clamp(2rem, 3.4vw, 3.1rem); letter-spacing: -.045em; line-height: 1.15; }
  .route-heading p { margin: 0; color: var(--text-secondary); font-size: .95rem; line-height: 1.65; }
  .route-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .route-card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 1.1rem;
    padding: clamp(1.35rem, 2.2vw, 1.85rem);
    border-radius: var(--radius-sm);
    transition: transform 220ms cubic-bezier(.2, .8, .2, 1), box-shadow 220ms ease, border-color 220ms ease;
  }
  .route-card--self {
    background: #fff;
    border: 2px solid var(--border-strong);
    box-shadow: 0 3px 12px rgb(58 48 38 / .05);
  }
  .route-card--self:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgb(58 48 38 / .1);
    border-color: var(--accent);
  }
  .route-card--collab {
    background: linear-gradient(145deg, #253047 0%, #1a2233 100%);
    border: 1px solid rgb(255 255 255 / .15);
    color: #fff;
    box-shadow: 0 6px 20px rgb(37 48 71 / .22);
  }
  .route-card--collab:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgb(37 48 71 / .35);
    border-color: var(--accent-bright);
  }
  .route-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    padding-bottom: .75rem;
    border-bottom: 1px dashed;
    font-family: var(--font-mono);
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .08em;
  }
  .route-card--self .route-card__top { border-color: var(--border); color: var(--accent-text); }
  .route-card--collab .route-card__top { border-color: rgb(255 255 255 / .15); color: var(--accent-bright); }
  .route-card__status { padding: .12rem .42rem; border-radius: var(--radius-sm); font-size: .6rem; }
  .route-card--self .route-card__status { background: rgb(0 0 0 / .04); color: var(--text-muted); }
  .route-card--collab .route-card__status { background: rgb(255 255 255 / .12); color: #fff; }
  .route-card__main h3 { margin: 0; font-family: var(--font-serif); font-size: clamp(1.25rem, 1.8vw, 1.65rem); letter-spacing: -.03em; line-height: 1.3; }
  .route-card--self h3 { color: var(--text-primary); }
  .route-card--collab h3 { color: #fff; }
  .route-card__desc { margin: .55rem 0 0; font-size: .88rem; line-height: 1.65; }
  .route-card--self .route-card__desc { color: var(--text-secondary); }
  .route-card--collab .route-card__desc { color: rgb(255 255 255 / .78); }
  .route-card__action-wrap { margin-top: .35rem; }
  .route-card__btn { width: 100%; text-decoration: none; min-height: 2.75rem; font-size: .86rem; }

  /* 4. SPEAKER & IDENTITY FIELD JOURNAL */
  .identity-section { position: relative; isolation: isolate; padding: clamp(2.5rem, 4.5vw, 4rem) clamp(1.5rem, 3.5vw, 3.2rem); overflow: hidden; background-color: #fffdf8; background-image: var(--paper-white-image); background-repeat: no-repeat; background-position: center; background-size: 115.2% 115.2%; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); }
  .identity-section__seam { position: absolute; inset: 0 0 auto; height: 3px; overflow: hidden; background: color-mix(in srgb, var(--text-primary) 20%, transparent); }
  .identity-section__seam span { display: block; width: 100%; height: 100%; background: var(--text-primary); transform-origin: left center; }
  .section-grid { display: grid; grid-template-columns: minmax(0, .82fr) minmax(20rem, 1.18fr); gap: clamp(2rem, 5vw, 4rem); }
  .identity-intro { grid-template-columns: minmax(0, 1.1fr) minmax(18rem, .9fr); align-items: start; gap: clamp(2rem, 5vw, 4.5rem); }
  .identity-intro h2 { max-width: 18ch; font-family: var(--font-serif); font-size: clamp(1.85rem, 3.5vw, 2.85rem); letter-spacing: -.045em; line-height: 1.15; text-wrap: balance; }
  .identity-intro__nowrap { white-space: nowrap; }
  .identity-intro__copy { display: grid; align-content: start; gap: .65rem; padding-top: .25rem; }
  .identity-intro__copy > p { max-width: 34rem; margin: 0; }
  .identity-intro__lead { color: var(--text-primary); font-size: clamp(1.05rem, 1.7vw, 1.35rem); letter-spacing: -.02em; line-height: 1.5; text-wrap: balance; }
  .identity-intro__copy > p:not(.identity-intro__lead) { color: var(--text-secondary); font-size: .9rem; line-height: 1.75; }
  .text-action { display: inline-flex; align-items: center; gap: .4rem; margin-top: .25rem; color: var(--accent-text); font-size: .86rem; font-weight: 700; text-decoration: underline; text-underline-offset: .24em; }
  .text-action:hover { color: var(--accent-hover); }
  .speaker-proof { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(19rem, .9fr); gap: clamp(1.75rem, 4vw, 3.5rem); margin-top: 1.85rem; padding-top: 1.5rem; border-top: 1px solid var(--border-strong); }
  .speaker-trace { position: relative; min-width: 0; }
  .speaker-trace__rail { position: absolute; inset: .25rem auto .35rem .3rem; width: 1px; background: var(--border-strong); }
  .speaker-trace__rail span { display: block; width: 3px; height: 0; margin-left: -1px; transform-origin: top center; background: var(--accent); }
  .speaker-records { position: relative; display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
  .speaker-record { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: 1.25rem; min-height: 0; padding: .35rem .75rem 1.6rem 1.25rem; border-bottom: 1px solid var(--border); border-radius: var(--radius-sm); transition: opacity 200ms ease, color 200ms ease, background-color 200ms ease; }
  .speaker-record + .speaker-record { padding-top: 1.6rem; }
  .speaker-record::before { position: absolute; left: .02rem; width: .62rem; height: .62rem; margin-top: .45rem; border: 2px solid var(--bg); border-radius: 50%; background: var(--border-strong); content: ''; transition: background-color 200ms ease, border-color 200ms ease, transform 200ms ease, box-shadow 200ms ease; }
  .speaker-record.is-active { background: rgb(255 255 255 / .32); }
  .speaker-record.is-active::before { border-color: #fff; background: var(--accent); transform: scale(1.35); box-shadow: 0 0 0 3px rgb(128 100 234 / .3); }
  .speaker-record:not(.is-active) { color: var(--text-secondary); }
  .speaker-record__time { color: var(--accent-text); font-family: var(--font-mono); font-size: .7rem; font-weight: 700; line-height: 1.55; }
  .speaker-record__body { min-width: 0; }
  .speaker-record__body h3 { max-width: 22ch; margin: 0; color: var(--text-primary); font-size: clamp(1.05rem, 1.7vw, 1.35rem); letter-spacing: -.025em; line-height: 1.4; }
  .speaker-record__body p { max-width: 38rem; margin: .55rem 0 0; color: var(--text-secondary); font-size: .88rem; line-height: 1.7; }
  .speaker-record__tags { display: flex; flex-wrap: wrap; gap: .3rem .45rem; margin: .65rem 0 0; padding: 0; list-style: none; }
  .speaker-record__tags li { padding: .12rem .45rem; border-radius: var(--radius-sm); background: rgb(0 0 0 / .04); border: 1px solid rgb(0 0 0 / .07); color: var(--text-secondary); font-size: .7rem; font-weight: 600; font-family: var(--font-sans); }
  .speaker-record.is-active .speaker-record__tags li { background: rgb(128 100 234 / .08); border-color: rgb(128 100 234 / .2); color: var(--accent-text); }
  .speaker-proof__side { display: grid; align-content: start; gap: 1.25rem; min-width: 0; }
  .speaker-media { position: sticky; top: 3.5rem; display: grid; min-height: 16rem; margin: 0; }
  .speaker-media__frame { position: relative; grid-area: 1 / 1; width: 100%; overflow: hidden; background: var(--bg-soft); border: 1px solid rgb(66 56 82 / .15); box-shadow: 0 .7rem 1.4rem rgb(58 48 38 / .12); opacity: 0; visibility: hidden; transform: translateY(.6rem) rotate(-1.2deg); }
  .speaker-media__frame:first-child { opacity: 1; visibility: visible; transform: none; }
  .speaker-media__frame[data-speaker-media='workshop'] { transform: translateY(.6rem) rotate(1.6deg); }
  .speaker-media__frame.is-active { opacity: 1; visibility: visible; }
  .speaker-media__frame img { display: block; width: 100%; max-height: 20rem; aspect-ratio: 4 / 3; object-fit: cover; }
  .speaker-media__frame[data-speaker-media='workshop'] img { aspect-ratio: 4 / 5; object-position: 58% 38%; }
  .speaker-media__frame figcaption { position: absolute; right: .65rem; bottom: .65rem; margin: 0; padding: .35rem .5rem; background: var(--bg-soft); color: var(--accent-text); font-family: var(--font-mono); font-size: .6rem; font-weight: 700; letter-spacing: .06em; border: 1px solid rgb(66 56 82 / .12); }
  .threads-proof {
    display: grid;
    gap: .75rem;
    padding: 1.15rem 1.25rem;
    border: 1px solid rgb(128 100 234 / .18);
    border-radius: var(--radius-sm);
    background: linear-gradient(128deg, rgb(238 231 255 / .72), rgb(255 253 248 / .45) 72%);
    box-shadow: 0 .4rem 1.2rem rgb(58 48 38 / .06);
  }
  .threads-proof__header { display: flex; align-items: baseline; justify-content: space-between; gap: .5rem; }
  .threads-proof__badge { display: inline-block; color: var(--accent-text); font-family: var(--font-mono); font-size: .62rem; font-weight: 700; letter-spacing: .08em; }
  .threads-proof__stat { display: flex; align-items: baseline; gap: .35rem; }
  .threads-proof__stat strong { color: var(--accent-text); font-family: var(--font-serif); font-size: 1.75rem; letter-spacing: -.05em; line-height: 1; }
  .threads-proof__stat span { color: var(--text-secondary); font-size: .78rem; }
  .threads-proof__content p { margin: 0 0 .55rem; color: var(--text-secondary); font-size: .84rem; line-height: 1.6; }
  .threads-proof__cta { display: inline-flex; min-height: 2.35rem; align-items: center; gap: .45rem; width: fit-content; padding: .35rem .95rem; border-radius: var(--radius-sm); background: var(--text-primary); color: #fff; border: 1px solid color-mix(in srgb, var(--text-primary) 80%, black); font-size: .8rem; font-weight: 700; text-decoration: none; box-shadow: 0 2px 6px rgb(37 48 71 / .18); transition: all 200ms cubic-bezier(.2, .8, .2, 1); }
  .threads-proof__cta:hover { background: var(--accent-text); border-color: var(--accent); color: #fff; transform: translateY(-1px); box-shadow: 0 4px 12px rgb(128 100 234 / .3); }
  .threads-proof__cta svg { animation: icon-ambient-nudge 4.5s ease-in-out infinite; transition: transform 200ms cubic-bezier(.34, 1.56, .64, 1); }
  .threads-proof__cta:hover svg { animation: none; transform: translateX(3px); }
  .threads-proof__cta:active { transform: translateY(1px); }

  /* 5. CABAI DIGITAL LAB SECTION */
  .cabai-section {
    --cabai-handoff: #5fd3b7;
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(20rem, 1.1fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    padding: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 3.5vw, 3.5rem);
    border-top: 3px solid var(--cabai-handoff);
    border-bottom: 1px solid var(--border-strong);
    background: var(--surface-dark);
    color: var(--surface-dark-text);
    background-image: radial-gradient(rgb(95 211 183 / .05) 1px, transparent 1px);
    background-size: 24px 24px;
    border-radius: var(--radius-sm);
  }
  .cabai-section :is(h2, p) { color: inherit; }
  .cabai-section__header h2 { max-width: 15ch; margin: 0; font-family: var(--font-serif); font-size: clamp(1.85rem, 3.5vw, 2.85rem); letter-spacing: -.045em; line-height: 1.15; text-wrap: balance; }
  .cabai-section__lead { max-width: 32rem; margin: .85rem 0 0; color: var(--surface-dark-muted); line-height: 1.75; font-size: .95rem; }
  .cabai-matrix {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.15rem;
  }
  .cabai-matrix-card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: .95rem;
    padding: 1.35rem 1.45rem;
    border-radius: var(--radius-sm);
    background: rgb(255 255 255 / .03);
    border: 1px solid rgb(255 255 255 / .1);
    color: inherit;
    text-decoration: none;
    transition: all 220ms cubic-bezier(.2, .8, .2, 1);
  }
  .cabai-matrix-card:hover {
    background: rgb(255 255 255 / .06);
    transform: translateY(-2px);
  }
  .cabai-matrix-card--library:hover {
    border-color: var(--cabai-handoff);
    box-shadow: 0 8px 20px rgb(95 211 183 / .14);
  }
  .cabai-matrix-card--courses:hover {
    border-color: var(--accent-bright);
    box-shadow: 0 8px 20px rgb(170 154 246 / .16);
  }
  .cabai-matrix-card__head { display: flex; align-items: center; justify-content: space-between; }
  .cabai-matrix-card__badge {
    display: inline-block;
    padding: .12rem .45rem;
    border-radius: var(--radius-sm);
    background: rgb(95 211 183 / .12);
    border: 1px solid rgb(95 211 183 / .3);
    color: var(--cabai-handoff);
    font-family: var(--font-mono);
    font-size: .62rem;
    font-weight: 700;
    letter-spacing: .06em;
  }
  .cabai-matrix-card__badge--courses {
    background: rgb(170 154 246 / .12);
    border-color: rgb(170 154 246 / .3);
    color: var(--accent-bright);
  }
  .cabai-matrix-card__icon {
    display: grid;
    place-items: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 50%;
    background: rgb(255 255 255 / .06);
    color: #fff;
  }
  .cabai-matrix-card__body strong { display: block; color: var(--surface-dark-text); font-size: 1.05rem; margin-bottom: .35rem; }
  .cabai-matrix-card__body p { margin: 0; color: var(--surface-dark-muted); font-size: .84rem; line-height: 1.6; }
  .cabai-matrix-card__footer { display: inline-flex; align-items: center; gap: .45rem; font-size: .84rem; font-weight: 700; }
  .cabai-matrix-card--library .cabai-matrix-card__footer { color: var(--cabai-handoff); }
  .cabai-matrix-card--courses .cabai-matrix-card__footer { color: var(--accent-bright); }
  .cabai-matrix-card__footer svg { transition: transform 200ms ease; }
  .cabai-matrix-card:hover .cabai-matrix-card__footer svg { transform: translateX(3px); }

  /* 6. NEWSLETTER CARD */
  .newsletter-card {
    padding-block: clamp(2rem, 4.5vw, 3.5rem);
    border-bottom: 1px solid var(--border-strong);
  }

  /* RESPONSIVE STYLES */
  @media (max-width: 980px) {
    .home-hero { grid-template-columns: minmax(0, 1fr) minmax(18rem, .82fr); gap: 1.15rem 1.75rem; padding-inline: clamp(1.5rem, 3.5vw, 2.5rem); }
    .home-hero h1 { font-size: clamp(2.45rem, 4.5vw, 3.25rem); }
    .home-hero__statement { font-size: clamp(1.25rem, 2.2vw, 1.55rem); }
    .route-grid { grid-template-columns: 1fr; }
    .cabai-section { grid-template-columns: 1fr; gap: 2rem; }
    .cabai-matrix { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 760px) {
    .home-page { width: min(calc(100% - 1.25rem), 86rem); gap: 1rem; padding-block: .5rem 2rem; }

    /* 1. HERO MOBILE */
    .home-hero {
      grid-template-areas: 'lede' 'portraits' 'body';
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
      gap: .75rem;
      min-height: 0;
      padding: 1.5rem 1rem 1.75rem;
    }
    .home-hero::after { display: none; }
    .home-hero__masthead { margin-bottom: .65rem; gap: .45rem .75rem; }
    .home-hero__lede { align-self: start; }
    .home-hero h1 {
      font-size: clamp(1.85rem, 7.8vw, 2.5rem);
      letter-spacing: -.045em;
      line-height: 1.18;
      white-space: normal;
      text-wrap: balance;
    }
    .home-hero__statement {
      gap: .1em;
      margin-top: .65rem;
      font-size: clamp(1.15rem, 4.8vw, 1.45rem);
      line-height: 1.38;
      text-align: left;
    }
    .home-hero__pillars { gap: .35rem .45rem; margin-top: .75rem; }
    .pillar-tag { font-size: .68rem; padding: .2rem .48rem; }
    .home-hero__portraits {
      position: relative;
      width: 100%;
      max-width: 22rem;
      height: 15.5rem;
      min-height: 0;
      margin: .85rem auto .4rem;
      overflow: visible;
    }
    .hero-photo { padding: .3rem; }
    .hero-photo--primary { top: 0; right: 0; width: 62%; }
    .hero-photo--secondary { bottom: 0; left: 0; width: 48%; }
