---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/sections/Newsletter.astro';
import ProofStrip from '../components/common/ProofStrip.astro';
import QuoteBand from '../components/common/QuoteBand.astro';
import WhyDifferent from '../components/common/WhyDifferent.astro';
import { ArrowRight, Braces, Database, GitBranch } from '@lucide/astro';
import { siteConfig, withCabAiAttribution } from '../config/siteConfig';
import { audienceTypes, proofPoints, teachingSessions } from '../config/authority';

const heroMessages = [
  {
    statement: ['我是 Cab，在第一線教 AI 落地，', '從農會推廣人員教到外商工程團隊'],
    result: '我教的是怎麼判斷 AI 該不該用、怎麼用才划算。\n我自己也每天用 Claude Code 工作。',
  },
];

const diagnosticCases = [
  {
    code: 'context',
    icon: Database,
    term: 'Context',
    title: '它看到了什麼',
    question: ['它這次到底', '看到了哪些資料'],
    symptom: ['講了很多次', 'AI 還是做不好'],
    description: '你以為交代過了，下一次它又像沒聽過。',
    diagnosis: ['你以為它知道的背景', '這次可能根本沒傳給它'],
    next: ['挑一個明顯答錯的地方', '對照它當時實際讀到的資料'],
    cta: { label: '60 分鐘專案諮詢：一起找出它漏看了什麼', href: '/services/consulting/' },
  },
  {
    code: 'skill',
    icon: Braces,
    term: 'Skill',
    title: '做法有沒有留下來',
    question: ['上次做對的做法', '有沒有被留下來'],
    symptom: ['這次明明做出來了', '下次又要重來'],
    description: '結果留下了，做對的方法沒留下。',
    diagnosis: ['你存了成品，沒存做法', '做對的判斷下次還是要重講'],
    next: ['找一個每次都要重講的判斷', '寫成下次能直接照做的步驟'],
    cta: { label: '五週陪跑：把做對的那一次變成固定做法', href: '/services/coaching/' },
  },
  {
    code: 'harness',
    icon: GitBranch,
    term: 'Harness',
    title: '流程從哪裡斷掉',
    question: ['流程是從哪一步', '開始斷掉的'],
    symptom: ['只要一步出錯', '整條流程就卡住'],
    description: '前面都做對了，一出錯還是只能從頭來。',
    diagnosis: ['流程只會從頭跑', '前面做對再多，出錯也接不回去'],
    next: ['找到出錯前最後完成的那一步', '讓流程能從那裡接著做'],
    cta: { label: '團隊導入：把流程改成出錯也接得回去', href: '/services/enterprise/' },
  },
];

const routes = [
  { title: '先自己檢查一個任務', description: '拿一件最近做壞的事，照五個問題檢查，看先修哪一層。', price: '免費', label: '開始健檢', href: '/expertise/' },
  { title: '自己學', description: 'AgentSkill 課程和 Claude Code 手冊，每一門都有免費試看。', price: 'NT$1,500 起', label: '看課程與手冊', href: '/courses/' },
  { title: '找我一起看', description: '60 分鐘諮詢或五週陪跑。先填表，我會親自看過再回你。', price: 'NT$5,000 起', label: '看合作方式', href: '/services/' },
];

const speakerRecords = teachingSessions.map((session, index) => ({
  id: session.id,
  time: session.time,
  title: session.title,
  audience: session.audience,
  format: session.format,
  description: session.detail,
  tags: session.tags,
  visual: index % 2 === 0 ? 'meetup' : 'workshop',
}));

const planEntries = [
  { name: '講座', length: '1–2 小時', fit: '先讓全員或主管有共同的說法。', href: '/services/partnerships/', featured: false },
  { name: '實作工作坊', length: '半日或全日', fit: '一個部門拿自己的工作來練，每人帶電腦做。', href: '/services/enterprise/#enterprise-options-title', featured: true },
  { name: '兩日班或導入陪跑', length: '16 小時或分週', fit: '從零做到能用的成果，或挑一段流程試做。', href: '/services/enterprise/#enterprise-options-title', featured: false },
];

const threadsProof = proofPoints.find((point) => point.label.includes('Threads')) ?? proofPoints[0];
---

<BaseLayout title="CabLate｜AI 企業內訓、講座與 Claude Code" description="Cab 在第一線教 AI 落地：從農會推廣人員教到外商工程團隊，自己每天用 Claude Code 工作。提供企業內訓、講座、工作坊，也接 AI 諮詢與陪跑。" image="/og/pages/home.png" imageAlt="CabLate：我在第一線教 AI 落地，自己也每天用它工作。" imageWidth={1200} imageHeight={630}>
  <div class="home-page">
    <section class="home-hero paper-card" aria-labelledby="home-title">
      <header class="home-hero__lede">
        <h1 id="home-title"><span>AI 課上完，</span><span>大家有真的用進工作嗎？</span></h1>
        <p class="home-hero__statement" id="home-hero-statement">
          {heroMessages[0].statement.map((line) => <span>{line}</span>)}
        </p>
      </header>

      <figure class="home-hero__portraits">
        <div class="hero-photo hero-photo--primary">
          <img
            src="/images/photos/cablate-speaking-ai-meetup-april-refined-v1.webp"
            alt="Cab 在 AI 小聚現場分享 AI 協作與工作流程"
            width="1122"
            height="1402"
            fetchpriority="high"
          />
        </div>
        <div class="hero-photo hero-photo--secondary">
          <img
            src="/images/photos/cablate-speaking-workshop-0627-refined-v1.webp"
            alt="Cab 在工作坊現場與學員拆解實作問題"
            width="1122"
            height="1402"
            fetchpriority="low"
          />
        </div>
        <p class="home-hero__annotation"><span>我最常問的一句</span>做出來之後，誰來檢查？</p>
      </figure>

      <div class="home-hero__body">
        <p class="home-hero__result" id="home-hero-result">{heroMessages[0].result}</p>
        <div class="home-hero__actions">
          <a class="btn btn-primary hero-action" href="/services/enterprise/">邀請我上課或內訓 <ArrowRight size={18} aria-hidden="true" /></a>
          <a class="home-hero__secondary-action" href="#identity-title">看我教過誰 <ArrowRight size={16} aria-hidden="true" /></a>
        </div>
        <p class="home-hero__free-note">需求先聊，不收費。</p>
      </div>
    </section>

    <ProofStrip label="目前的數字" />

    <WhyDifferent />

    <section class="identity-section speaker-section" aria-labelledby="identity-title" data-speaker-section data-chapter-transition>
      <span class="identity-section__seam" aria-hidden="true"><span data-chapter-seam></span></span>
      <div class="identity-intro section-grid" data-chapter-lead>
        <header><h2 id="identity-title">這一年，<span class="identity-intro__nowrap">我教過這些人</span></h2></header>
        <div class="identity-intro__copy">
          <p class="identity-intro__lead">有沒寫過程式的推廣人員，也有天天寫程式的工程師。</p>
          <ul class="audience-chips" aria-label="教過的對象">
            {audienceTypes.map((type) => <li>{type}</li>)}
          </ul>
          <a class="text-action" href="/services/enterprise/">看可以上的主題和形式 <ArrowRight size={16} aria-hidden="true" /></a>
        </div>
      </div>
      <div class="speaker-proof">
        <div class="speaker-trace" data-speaker-trace>
          <div class="speaker-trace__rail" aria-hidden="true"><span data-speaker-progress></span></div>
          <ol class="speaker-records">
            {speakerRecords.map((record) => (
              <li class="speaker-record" data-speaker-record={record.id} data-speaker-visual={record.visual}>
                <div class="speaker-record__time"><span>{record.time}</span></div>
                <div class="speaker-record__body">
                  <h3>{record.title}</h3>
                  {'audience' in record && <p class="speaker-record__audience">{record.audience}・{record.format}</p>}
                  <p>{record.description}</p>
                  {'tags' in record && record.tags && (
                    <ul class="speaker-record__tags" aria-label="重點">
                      {record.tags.map((tag: string) => <li>{tag}</li>)}
                    </ul>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>
        <div class="speaker-proof__side">
          <figure class="speaker-media" aria-label="講座與工作坊現場照片">
            <div class="speaker-media__frame" data-speaker-media="meetup">
              <img src="/images/photos/cablate-speaking-ai-meetup-april.webp" alt="Cab 在 AI 小聚現場拿著麥克風分享" width="2000" height="1333" loading="lazy" />
              <figcaption>AI 小聚分享</figcaption>
            </div>
            <div class="speaker-media__frame" data-speaker-media="workshop">
              <img src="/images/photos/cablate-speaking-workshop-0627.webp" alt="Cab 在工作坊現場與學員一起拆解問題" width="1970" height="1970" loading="lazy" />
              <figcaption>工作坊實作</figcaption>
            </div>
          </figure>
          <figure class="threads-proof" id="threads-proof">
            <div class="threads-proof__header">
              <span class="threads-proof__badge">Threads @cab_late</span>
              <div class="threads-proof__stat"><strong>{threadsProof.value}</strong><span>人追蹤</span></div>
            </div>
            <div class="threads-proof__content">
              <p>平常在 Threads 寫 AI 協作、Claude Code 拆解和工作方法。</p>
              <a class="threads-proof__cta" href={siteConfig.threadsUrl} target="_blank" rel="noopener">去 Threads 看看 <ArrowRight size={14} aria-hidden="true" /></a>
            </div>
          </figure>
        </div>
      </div>
    </section>

    <section class="plan-entry" aria-labelledby="plan-entry-title">
      <header>
        <p class="section-label">合作方案</p>
        <h2 id="plan-entry-title">三種方案，<br />看人數和想做到哪裡</h2>
      </header>
      <div class="plan-entry__grid">
        {planEntries.map((plan) => (
          <a class:list={['plan-entry__card', plan.featured && 'is-featured']} href={plan.href}>
            {plan.featured && <small>最多團隊選</small>}
            <strong>{plan.name}</strong>
            <span class="plan-entry__length">{plan.length}</span>
            <p>{plan.fit}</p>
            <span class="plan-entry__more">看細節 <ArrowRight size={15} aria-hidden="true" /></span>
          </a>
        ))}
      </div>
    </section>

    <QuoteBand title="我常講的幾句話" lead="Threads 原文，沒有修過。" pick={[0, 1, 3]} tone="light" />

    <section class="diagnostic-stage" aria-labelledby="diagnostic-title">
      <div class="diagnostic-console">
        <div class="diagnostic-chassis-bar" aria-hidden="true">
          <div class="diagnostic-chassis-status">
            <span class="chassis-led"></span>
            <span class="chassis-label">選一個最像你的</span>
          </div>
          <h2 class="diagnostic-chassis-title" id="diagnostic-title">AI 用到一半卡住，通常是這三種</h2>
          <div class="diagnostic-chassis-coords" aria-hidden="true"></div>
        </div>

        <div class="diagnostic-workbench">
          <fieldset class="symptom-choices">
            <legend class="visually-hidden">選擇最接近目前情況的症狀</legend>
            {diagnosticCases.map((item, index) => (
              <label class="symptom-choice" for={`home-diagnostic-${item.code}`}>
                <input id={`home-diagnostic-${item.code}`} type="radio" name="home-diagnostic" value={item.code} checked={index === 0} aria-controls={`home-trace-${item.code}`} />
                <span class="symptom-choice__surface">
                  <span class="symptom-choice__meta">
                    <span class="symptom-choice__num">0{index + 1}</span>
                    <span class="symptom-choice__term">{item.term}</span>
                  </span>
                  <strong>{item.symptom.map((line) => <span class="symptom-copy-line">{line}</span>)}</strong>
                  <span>{item.description}</span>
                </span>
              </label>
            ))}
          </fieldset>

          <div class="trace-panels" aria-live="polite">
            {diagnosticCases.map((item) => (
              <article class="trace-panel" id={`home-trace-${item.code}`} data-trace={item.code}>
                <header class="trace-panel__heading">
                  <div class="diagnosis-stamp"><item.icon size={18} aria-hidden="true" /><span>{item.term} / {item.title}</span></div>
                  <h3>{item.question.map((line) => <span>{line}</span>)}</h3>
                </header>
                <div class="trace-reading">
                  <div class="trace-diagnosis-card">
                    <span class="trace-subheading">問題多半在這</span>
                    <p class="trace-diagnosis">{item.diagnosis.map((line) => <span>{line}</span>)}</p>
                  </div>
                  <div class="trace-next-card">
                    <span class="trace-subheading trace-subheading--action">先試這一步</span>
                    <p class="trace-next"><span class="trace-next__arrow" aria-hidden="true">→</span><strong>{item.next.map((line) => <span>{line}</span>)}</strong></p>
                  </div>
                  <div class="trace-action-card">
                    <a class="trace-action-btn" href={item.cta.href}>
                      <span class="trace-action-btn__text">{item.cta.label}</span>
                      <span class="trace-action-btn__icon" aria-hidden="true">
                        <ArrowRight size={16} />
                      </span>
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="route-section" aria-labelledby="route-title" data-chapter-transition>
      <header class="route-heading" data-chapter-lead>
        <span class="section-label">下一步</span>
        <h2 id="route-title">個人想把 AI 用好？從這裡開始</h2>
      </header>
      <div class="route-grid">
        {routes.map((route, index) => (
          <article class:list={['route-card', index === routes.length - 1 ? 'route-card--collab' : 'route-card--self']}>
            <div class="route-card__top">
              <span class="route-card__tag">{String(index + 1).padStart(2, '0')}</span>
              <span class="route-card__status">{route.price}</span>
            </div>
            <div class="route-card__main">
              <h3>{route.title}</h3>
              <p class="route-card__desc">{route.description}</p>
            </div>
            <div class="route-card__action-wrap">
              <a class:list={['route-card__btn', index === routes.length - 1 ? 'btn-primary' : 'btn-ghost']} href={route.href}>
                <span>{route.label}</span>
                <ArrowRight size={16} aria-hidden="true" />
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="cabai-section" aria-labelledby="cabai-title" data-chapter-transition>
      <div class="cabai-section__header" data-chapter-lead>
        <span class="section-label">CabAI</span>
        <h2 id="cabai-title">課程和文章，<br />都放在 CabAI</h2>
        <p class="cabai-section__lead">公開文章、課程和手冊都在 CabAI，同一個帳號就能看。</p>
      </div>
      <div class="cabai-section__body">
        <div class="cabai-matrix" aria-label="CabAI 內容索引">
          <a class="cabai-matrix-card cabai-matrix-card--library" href={withCabAiAttribution(siteConfig.cabAi.libraryUrl, 'home_cabai_library')} target="_blank" rel="noopener">
            <div class="cabai-matrix-card__head">
              <span class="cabai-matrix-card__badge">免費</span>
              <span class="cabai-matrix-card__icon"><Database size={17} aria-hidden="true" /></span>
            </div>
            <div class="cabai-matrix-card__body">
              <strong>公開文章與筆記</strong>
              <p>Claude Code 拆解、排錯紀錄和工程筆記，不用登入就能看。</p>
            </div>
            <div class="cabai-matrix-card__footer">
              <span>去看文章</span>
              <ArrowRight size={15} aria-hidden="true" />
            </div>
          </a>
          <a class="cabai-matrix-card cabai-matrix-card--courses" href={withCabAiAttribution(siteConfig.cabAi.productsUrl, 'home_cabai_courses')} target="_blank" rel="noopener">
            <div class="cabai-matrix-card__head">
              <span class="cabai-matrix-card__badge cabai-matrix-card__badge--courses">課程</span>
              <span class="cabai-matrix-card__icon"><Braces size={17} aria-hidden="true" /></span>
            </div>
            <div class="cabai-matrix-card__body">
              <strong>課程與手冊</strong>
              <p>AgentSkill 課程、Claude Code 深度工程手冊，每一門都有免費試看。</p>
            </div>
            <div class="cabai-matrix-card__footer">
              <span>看有哪些課</span>
              <ArrowRight size={15} aria-hidden="true" />
            </div>
          </a>
        </div>
      </div>
    </section>

    <section class="two-door" aria-labelledby="two-door-title">
      <h2 id="two-door-title">先從一場講座開始，<br />還是直接談一個部門的工作坊？</h2>
      <div class="two-door__actions">
        <a class="btn btn-ghost" href="/services/partnerships/">邀請演講或講座 <ArrowRight size={17} aria-hidden="true" /></a>
        <a class="btn btn-primary" href="/services/enterprise/">談企業內訓或工作坊 <ArrowRight size={17} aria-hidden="true" /></a>
      </div>
      <p>需求先聊，不收費。填表後我會親自回覆。</p>
    </section>

    <div class="newsletter-card"><Newsletter /></div>
  </div>
</BaseLayout>

<script>
  const initializeSpeakerEvidence = () => {
    const sections = document.querySelectorAll<HTMLElement>('[data-speaker-section]');

    sections.forEach((section) => {
      if (section.dataset.speakerReady === 'true') return;

      const trace = section.querySelector<HTMLElement>('[data-speaker-trace]');
      const records = Array.from(section.querySelectorAll<HTMLElement>('[data-speaker-record]'));
      const progress = section.querySelector<HTMLElement>('[data-speaker-progress]');
      const mediaFrames = Array.from(section.querySelectorAll<HTMLElement>('[data-speaker-media]'));
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const desktop = window.matchMedia('(min-width: 981px)');

      if (!trace || records.length === 0 || !progress || mediaFrames.length === 0) return;

      section.dataset.speakerReady = 'true';
      let activeFrame = mediaFrames.find((frame) => frame.dataset.speakerMedia === records[0]?.dataset.speakerVisual) ?? mediaFrames[0];
      let destroyed = false;

      const setActive = (record: HTMLElement) => {
        records.forEach((item) => item.classList.toggle('is-active', item === record));
        const nextFrame = mediaFrames.find((frame) => frame.dataset.speakerMedia === record.dataset.speakerVisual);
        if (!nextFrame || nextFrame === activeFrame) return;

        const previousFrame = activeFrame;
        activeFrame = nextFrame;
        nextFrame.classList.add('is-active');
        previousFrame.classList.remove('is-active');
      };

      records[0]?.classList.add('is-active');

      let observer: IntersectionObserver | null = null;
      if (!reduceMotion.matches && desktop.matches && 'IntersectionObserver' in window) {
        observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting && entry.target instanceof HTMLElement) {
                setActive(entry.target);
              }
            }
          },
          { rootMargin: '-32% 0px -32% 0px', threshold: 0 }
        );
        records.forEach((record) => observer?.observe(record));
      }

      const cleanup = () => {
        if (destroyed) return;
        destroyed = true;
        observer?.disconnect();
        observer = null;
        section.dataset.speakerReady = 'false';
      };

      document.addEventListener('astro:before-swap', cleanup, { once: true });
    });
  };

  initializeSpeakerEvidence();
  document.addEventListener('astro:page-load', initializeSpeakerEvidence);
</script>

<style>
  .home-page { width: min(calc(100% - 1.5rem), 68rem); display: grid; gap: 1rem; margin-inline: auto; padding-block: .5rem 2rem; overflow-x: clip; }
  .home-page h1, .home-page h2, .home-page h3 { text-wrap: balance; }
  .home-page p, .home-page li { text-wrap: pretty; }

  /* 1. HERO SECTION */
  .home-hero { position: relative; display: grid; grid-template-areas: 'lede portraits' 'body portraits'; grid-template-columns: minmax(0, 1.18fr) minmax(16rem, .82fr); grid-template-rows: auto auto; gap: .85rem clamp(1.5rem, 3vw, 2.5rem); min-height: 0; padding: clamp(1.5rem, 3vw, 2.25rem); border: 1px solid var(--border-strong); border-radius: var(--radius-md); background: var(--bg-soft); background-image: none; filter: none; box-shadow: var(--shadow-sm); overflow: hidden; touch-action: pan-y; }
  .home-hero::after { display: none; }
  .home-hero__lede { grid-area: lede; align-self: start; position: relative; z-index: 2; min-width: 0; max-width: 40rem; text-align: left; }
  .home-hero h1 { max-width: none; margin: 0; color: var(--text-primary); font-family: var(--font-sans); font-size: clamp(1.65rem, 2.6vw, 2.15rem); font-weight: 700; letter-spacing: -.02em; line-height: 1.3; text-align: left; }
  .home-hero h1 span { display: block; white-space: nowrap; }
  .home-hero__free-note { margin: .6rem 0 0; color: var(--text-secondary); font-size: .85rem; }
  .home-hero__statement { display: grid; justify-items: start; gap: .08em; min-height: 0; margin: .65rem 0 0; color: var(--accent-text); font-family: var(--font-sans); font-size: clamp(1.05rem, 1.45vw, 1.22rem); font-weight: 700; letter-spacing: -.01em; line-height: 1.45; text-align: left; text-wrap: balance; }
  .home-hero__statement span { display: block; text-align: left; }
  .home-hero__body { grid-area: body; position: relative; z-index: 3; align-self: start; min-width: 0; max-width: 36rem; text-align: left; margin-top: .15rem; }
  .home-hero__result { min-height: 0; margin: 0; color: var(--text-secondary); font-size: .96rem; font-weight: 400; line-height: 1.72; text-align: left; white-space: pre-line; text-wrap: pretty; }
  .home-hero__actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-start; gap: .75rem 1rem; margin-top: 1rem; }
  .hero-action { white-space: nowrap; }
  .home-hero__secondary-action { display: inline-flex; align-items: center; gap: .5rem; min-height: 3rem; padding: .6rem 1.05rem; border-radius: var(--radius-sm); border: 1px solid rgb(128 100 234 / .35); background: rgb(128 100 234 / .08); color: var(--accent-text); font-size: .9rem; font-weight: 700; text-decoration: none; box-shadow: 0 2px 6px rgb(128 100 234 / .08); transition: all 200ms cubic-bezier(.2, .8, .2, 1); }
  .home-hero__secondary-action:hover { background: var(--accent-subtle); border-color: var(--accent); color: var(--accent-hover); transform: translateY(-1px) translateX(2px); box-shadow: 0 4px 12px rgb(128 100 234 / .2); }
  .home-hero__secondary-action svg { animation: icon-ambient-nudge 4.2s ease-in-out infinite; transition: transform 200ms cubic-bezier(.34, 1.56, .64, 1); }
  .home-hero__secondary-action:hover svg { animation: none; transform: translateX(4px); }
  .home-hero__secondary-action:focus-visible { outline: 3px solid var(--accent); outline-offset: .25rem; }
  .home-hero__portraits { grid-area: portraits; align-self: center; position: relative; z-index: 1; min-height: 16.5rem; margin: 0; }
  .hero-photo { position: absolute; padding: .35rem; border: 1px solid rgb(66 56 82 / .2); background: var(--surface-elevated); box-shadow: 0 .55rem 1.15rem rgb(58 48 38 / .12); transition: transform 260ms ease, box-shadow 260ms ease; }
  .hero-photo:hover { box-shadow: 0 .85rem 1.5rem rgb(58 48 38 / .16); }
  .hero-photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .hero-photo--primary { top: -.2rem; right: 0; z-index: 2; width: 64%; aspect-ratio: 1122 / 1402; transform: rotate(1.8deg); }
  .hero-photo--secondary { bottom: .2rem; left: 0; z-index: 1; width: 48%; aspect-ratio: 1122 / 1402; transform: rotate(-4deg); }
  .hero-photo--secondary img { object-position: 51% center; }
  .home-hero__annotation {
    position: absolute;
    right: 0;
    bottom: .8rem;
    z-index: 4;
    display: grid;
    gap: .15rem;
    margin: 0;
    padding: .6rem .85rem .55rem;
    border-radius: 2px;
    background: #fef9c3;
    border: 1px solid rgb(245 158 11 / .25);
    color: #78350f;
    font-family: var(--font-sans);
    font-size: .78rem;
    font-weight: 800;
    line-height: 1.35;
    transform: rotate(-2.5deg);
    box-shadow: 0 8px 16px -3px rgb(58 48 38 / .16), 0 3px 5px -2px rgb(58 48 38 / .08);
    transition: transform 220ms cubic-bezier(.2, .8, .2, 1), box-shadow 220ms ease;
  }
  .home-hero__annotation::before {
    content: '';
    position: absolute;
    top: -.5rem;
    left: 50%;
    transform: translateX(-50%) rotate(1.2deg);
    width: 2.5rem;
    height: 1rem;
    background: rgb(255 255 255 / .65);
    backdrop-filter: blur(2px);
    border: 1px solid rgb(0 0 0 / .06);
    box-shadow: 0 1px 2px rgb(0 0 0 / .08);
  }
  .home-hero__annotation:hover {
    transform: rotate(-1deg) translateY(-2px) scale(1.03);
    box-shadow: 0 14px 28px -4px rgb(58 48 38 / .22), 0 6px 10px -2px rgb(58 48 38 / .12);
  }
  .home-hero__annotation span {
    color: #92400e;
    font-family: var(--font-mono);
    font-size: .56rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-photo--primary { animation: hero-photo-primary-in 500ms cubic-bezier(.2, .72, .2, 1) both; }
    .hero-photo--secondary { animation: hero-photo-secondary-in 550ms 80ms cubic-bezier(.2, .72, .2, 1) both; }
    .home-hero__annotation { animation: hero-note-in 380ms 300ms cubic-bezier(.2, .72, .2, 1) both; }
  }
  @keyframes hero-photo-primary-in { from { opacity: 0; transform: scale(.96) rotate(4deg); } to { opacity: 1; transform: scale(1) rotate(2.1deg); } }
  @keyframes hero-photo-secondary-in { from { opacity: 0; transform: scale(.96) rotate(-7deg); } to { opacity: 1; transform: scale(1) rotate(-5.2deg); } }
  @keyframes hero-note-in { from { opacity: 0; transform: scale(.92) rotate(1deg); } to { opacity: 1; transform: scale(1) rotate(-3.2deg); } }

  /* 2. DIAGNOSTIC WORKBENCH SECTION */
  .diagnostic-stage { position: relative; padding: 0; }
  .diagnostic-console {
    border: 1px solid var(--surface-dark-border);
    background: var(--surface-dark);
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: 0 .75rem 2rem rgb(0 0 0 / .28);
    background-image: radial-gradient(rgb(255 255 255 / .06) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  .diagnostic-chassis-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: .85rem 1.4rem;
    background: rgb(0 0 0 / .28);
    border-bottom: 1px solid rgb(255 255 255 / .1);
    font-family: var(--font-mono);
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .08em;
  }
  .diagnostic-chassis-title {
    margin: 0;
    color: #fff;
    font-family: var(--font-sans);
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    font-weight: 700;
    letter-spacing: -.01em;
  }
  .diagnostic-chassis-status { display: inline-flex; align-items: center; gap: .55rem; color: var(--accent-bright); }
  .chassis-led {
    width: .5rem;
    height: .5rem;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
    animation: led-pulse 2s ease-in-out infinite;
  }
  @keyframes led-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: .4; transform: scale(.85); }
  }
  .diagnostic-chassis-coords { color: var(--surface-dark-muted); }
  .diagnostic-workbench { display: grid; grid-template-columns: minmax(17rem, .72fr) minmax(0, 1.28fr); }
  .symptom-choices { display: grid; align-content: start; margin: 0; padding: 0; border: 0; background: var(--surface-dark); }
  .symptom-choice { position: relative; display: block; cursor: pointer; }
  .symptom-choice + .symptom-choice { border-top: 1px solid var(--surface-dark-border); }
  .symptom-choice input { position: absolute; inline-size: 1px; block-size: 1px; opacity: 0; }
  .symptom-choice__surface { display: grid; gap: .45rem; min-block-size: 7rem; padding: 1.1rem 1.35rem; color: var(--surface-dark-muted); transition: background-color 180ms ease, color 180ms ease, box-shadow 180ms ease; }
  .symptom-choice__meta { display: flex; align-items: center; gap: .55rem; }
  .symptom-choice__num { font-family: var(--font-mono); font-size: .68rem; font-weight: 700; color: var(--accent-bright); opacity: .75; }
  .symptom-choice__term { padding: .1rem .45rem; border-radius: 999px; border: 1px solid rgb(170 154 246 / .25); background: rgb(170 154 246 / .08); font-family: var(--font-mono); font-size: .62rem; font-weight: 700; letter-spacing: .04em; color: var(--accent-bright); }
  .symptom-choice__surface strong { color: var(--surface-dark-text); font-size: .98rem; line-height: 1.45; text-wrap: wrap; }
  .symptom-copy-line { display: inline; }
  .symptom-copy-line + .symptom-copy-line::before { content: ' '; }
  .symptom-choice__surface > span:not(.symptom-choice__meta) { font-size: .78rem; line-height: 1.6; opacity: .88; }
  .symptom-choice:hover .symptom-choice__surface { background: rgb(255 255 255 / .035); }
  .symptom-choice input:checked + .symptom-choice__surface { background: color-mix(in srgb, var(--accent) 14%, var(--surface-dark)); color: var(--surface-dark-text); box-shadow: inset .32rem 0 var(--accent-bright); }
  .symptom-choice input:checked + .symptom-choice__surface .symptom-choice__num { opacity: 1; color: var(--accent-bright); }
  .symptom-choice input:focus-visible + .symptom-choice__surface { outline: 3px solid var(--accent-bright); outline-offset: -4px; }
  .trace-panels { min-width: 0; background: var(--surface-dark); color: var(--text-primary); border-left: 1px solid var(--surface-dark-border); }
  .trace-panel { position: relative; display: grid; min-height: 100%; padding: clamp(1.35rem, 2.5vw, 2rem); overflow: hidden; background-color: transparent; background-image: var(--paper-white-image); background-repeat: no-repeat; background-position: center; background-size: 115.2% 115.2%; color: var(--text-primary); filter: drop-shadow(0 .35rem .45rem rgb(18 21 17 / .14)); animation: trace-panel-in 180ms ease both; }
  .trace-panel::before { position: absolute; inset: 1rem 1rem auto auto; width: 4rem; height: 4rem; border-top: 1px solid var(--accent); border-right: 1px solid var(--accent); content: ''; opacity: .28; }
  .trace-panel__heading { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1rem; align-items: center; padding-bottom: 1.15rem; border-bottom: 1px solid var(--border-strong); }
  .trace-panel__heading h3 { margin: 0; color: var(--text-primary); font-family: var(--font-sans); font-size: clamp(1.15rem, 1.8vw, 1.4rem); line-height: 1.4; }
  .trace-panel__heading h3 span { display: inline; }
  .trace-panel__heading h3 span + span::before { content: ' '; }
  .diagnosis-stamp { display: grid; place-items: center; gap: .35rem; min-width: 6.5rem; padding: .65rem; border: 1px solid var(--accent); background: var(--accent-subtle); color: var(--accent-text); transform: rotate(-1.25deg); box-shadow: 0 .25rem .5rem rgb(63 51 81 / .1); animation: stamp-in 260ms ease both; }
  .diagnosis-stamp span { font-family: var(--font-mono); font-size: .65rem; font-weight: 700; }
  .trace-reading { display: grid; gap: .95rem; padding-top: 1.1rem; animation: trace-step-in 240ms 130ms ease both; }
  .trace-subheading { display: inline-block; margin-bottom: .25rem; color: var(--text-muted); font-family: var(--font-mono); font-size: .65rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .trace-subheading--action { color: var(--accent-text); }
  .trace-diagnosis-card { padding: .75rem 1rem; border-radius: var(--radius-sm); background: rgb(0 0 0 / .03); border: 1px solid rgb(0 0 0 / .05); }
  .trace-diagnosis { max-width: 42rem; margin: 0; color: var(--text-primary); font-size: .92rem; line-height: 1.75; }
  .trace-diagnosis span { display: block; }
  .trace-next-card { padding: .75rem 1rem; border-radius: var(--radius-sm); background: var(--accent-subtle); border: 1px solid rgb(128 100 234 / .22); }
  .trace-next { display: flex; align-items: flex-start; gap: .55rem; margin: 0; color: var(--accent-text); font-size: .88rem; line-height: 1.65; }
  .trace-next__arrow { flex: 0 0 auto; font-family: var(--font-mono); font-weight: 700; font-size: 1.05rem; line-height: 1.4; }
  .trace-next strong { font-weight: 700; }
  .trace-next strong span { display: block; }
  .trace-action-card {
    margin-top: .5rem;
    padding-top: .75rem;
    border-top: 1px dashed var(--border-strong);
    animation: trace-btn-pop-in 420ms 220ms cubic-bezier(.2, .8, .2, 1) both;
  }
  .trace-action-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    min-height: 3.2rem;
    padding: .65rem 1rem .65rem 1.25rem;
    border-radius: var(--radius-sm);
    background: linear-gradient(135deg, #253047 0%, #1a2233 100%);
    border: 1px solid rgb(255 255 255 / .12);
    color: #fff;
    text-decoration: none;
    font-size: .88rem;
    font-weight: 700;
    box-shadow: 0 4px 12px rgb(37 48 71 / .22), inset 0 1px 0 rgb(255 255 255 / .18);
    overflow: hidden;
    isolation: isolate;
    animation: trace-btn-ambient-heartbeat 4.2s cubic-bezier(.2, .8, .2, 1) infinite;
    transition: background-color var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast), transform 160ms ease;
  }
  .trace-action-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / .16), transparent);
    transform: skewX(-20deg);
    animation: trace-btn-ambient-shimmer 4.2s ease-in-out infinite;
    pointer-events: none;
  }
  .trace-action-btn__text { position: relative; z-index: 1; line-height: 1.4; }
  .trace-action-btn__icon {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: rgb(255 255 255 / .12);
    border: 1px solid rgb(255 255 255 / .2);
    color: #fff;
    flex-shrink: 0;
    animation: icon-ambient-nudge 4.2s ease-in-out infinite;
    transition: transform 220ms cubic-bezier(.34, 1.56, .64, 1), background-color 200ms ease, color 200ms ease, box-shadow 200ms ease;
  }
  .trace-action-btn:hover {
    animation: btn-wiggle-bounce 450ms cubic-bezier(.2, .8, .2, 1) forwards;
    background: linear-gradient(135deg, #3d2f78 0%, #271e50 100%);
    border-color: var(--accent-bright);
    color: #fff;
    box-shadow: 0 8px 22px rgb(128 100 234 / .38), inset 0 1px 0 rgb(255 255 255 / .28);
  }
  .trace-action-btn:hover::before { animation: none; left: 140%; transition: left 400ms ease; }
  .trace-action-btn:hover .trace-action-btn__icon {
    animation: none;
    background: var(--accent-bright);
    color: #1a1628;
    transform: translateX(6px) scale(1.15) rotate(-8deg);
    box-shadow: 0 0 14px rgb(170 154 246 / .6);
  }
  .trace-action-btn:active {
    animation: none !important;
    transform: translateY(2px) scale(0.97) !important;
    box-shadow: 0 2px 4px rgb(37 48 71 / .4), inset 0 1px 0 rgb(255 255 255 / .1);
  }
  .trace-action-btn:focus-visible { outline: 3px solid var(--accent-bright); outline-offset: .25rem; }

  @keyframes trace-btn-pop-in {
    0% { opacity: 0; transform: translateY(14px) scale(0.92); }
    55% { opacity: 1; transform: translateY(-4px) scale(1.02); }
    75% { transform: translateY(2px) scale(0.99); }
    90% { transform: translateY(-1px) scale(1.005); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes trace-btn-ambient-heartbeat {
    0%, 72%, 100% { transform: translateY(0) rotate(0deg) scale(1); box-shadow: 0 4px 12px rgb(37 48 71 / .22), inset 0 1px 0 rgb(255 255 255 / .18); }
    75% { transform: translateY(-4px) rotate(-1.2deg) scale(1.012); box-shadow: 0 7px 18px rgb(128 100 234 / .32), inset 0 1px 0 rgb(255 255 255 / .25); }
    79% { transform: translateY(1px) rotate(1deg); }
    83% { transform: translateY(-2px) rotate(-0.5deg); box-shadow: 0 5px 14px rgb(128 100 234 / .26), inset 0 1px 0 rgb(255 255 255 / .2); }
    87% { transform: translateY(0.5px) rotate(0.2deg); }
    91% { transform: translateY(0) rotate(0deg); }
  }
  @keyframes trace-btn-ambient-shimmer {
    0%, 70% { left: -100%; opacity: 0; }
    72% { opacity: 1; }
    86%, 100% { left: 140%; opacity: 0; }
  }
  @keyframes btn-wiggle-bounce {
    0% { transform: translateY(0) rotate(0deg); }
    20% { transform: translateY(-5px) rotate(-1.5deg) scale(1.015); }
    40% { transform: translateY(-1px) rotate(1.2deg); }
    60% { transform: translateY(-3.5px) rotate(-0.6deg); }
    80% { transform: translateY(-2px) rotate(0.3deg); }
    100% { transform: translateY(-2.5px) rotate(0deg); }
  }
  @keyframes icon-ambient-nudge {
    0%, 72%, 100% { transform: translateX(0); }
    76% { transform: translateX(5px) scale(1.1); }
    80% { transform: translateX(-2px) scale(0.96); }
    84% { transform: translateX(3px) scale(1.04); }
    88% { transform: translateX(0); }
  }
  @supports selector(:has(*)) {
    .trace-panel { display: none; }
    .diagnostic-workbench:has(#home-diagnostic-context:checked) [data-trace='context'],
    .diagnostic-workbench:has(#home-diagnostic-skill:checked) [data-trace='skill'],
    .diagnostic-workbench:has(#home-diagnostic-harness:checked) [data-trace='harness'] { display: grid; }
  }
  @keyframes trace-panel-in { from { opacity: .65; } to { opacity: 1; } }
  @keyframes stamp-in { from { opacity: 0; transform: translateY(-.5rem) rotate(-4deg); } to { opacity: 1; transform: translateY(0) rotate(-1.25deg); } }
  @keyframes trace-step-in { from { opacity: 0; transform: translateY(.45rem); } to { opacity: 1; transform: translateY(0); } }

  /* 3. ROUTE DECISION BLUEPRINT CARDS */
  .route-section {
    display: grid;
    gap: 1.25rem;
    padding: clamp(2.2rem, 3.8vw, 3.5rem) clamp(1.5rem, 3.5vw, 3.2rem);
    border: 1px solid var(--border-strong);
    background: var(--bg-soft);
    background-image: var(--paper-white-image);
    border-radius: var(--radius-sm);
  }
  .route-heading { display: grid; gap: .45rem; max-width: 42rem; }
  .route-heading h2 { margin: 0; font-family: var(--font-sans); font-size: clamp(1.3rem, 2vw, 1.6rem); letter-spacing: -.02em; line-height: 1.35; }
  .route-heading p { margin: 0; color: var(--text-secondary); font-size: .95rem; line-height: 1.65; }
  .route-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .route-card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 1.1rem;
    padding: clamp(1.35rem, 2.2vw, 1.85rem);
    border-radius: var(--radius-sm);
    transition: transform 220ms cubic-bezier(.2, .8, .2, 1), box-shadow 220ms ease, border-color 220ms ease;
  }
  .route-card--self {
    background: var(--surface-elevated);
    border: 2px solid var(--border-strong);
    box-shadow: 0 3px 12px rgb(58 48 38 / .05);
  }
  .route-card--self:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgb(58 48 38 / .1);
    border-color: var(--accent);
  }
  .route-card--collab {
    background: linear-gradient(145deg, #253047 0%, #1a2233 100%);
    border: 1px solid rgb(255 255 255 / .15);
    color: #fff;
    box-shadow: 0 6px 20px rgb(37 48 71 / .22);
  }
  .route-card--collab:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgb(37 48 71 / .35);
    border-color: var(--accent-bright);
  }
  .route-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    padding-bottom: .75rem;
    border-bottom: 1px dashed;
    font-family: var(--font-mono);
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .08em;
  }
  .route-card--self .route-card__top { border-color: var(--border); color: var(--accent-text); }
  .route-card--collab .route-card__top { border-color: rgb(255 255 255 / .15); color: var(--accent-bright); }
  .route-card__status { padding: .15rem .5rem; border-radius: var(--radius-sm); font-family: var(--font-sans); font-size: .8rem; letter-spacing: 0; }
  .route-card--self .route-card__status { background: var(--accent-subtle); color: var(--accent-text); }
  .route-card--collab .route-card__status { background: rgb(255 255 255 / .12); color: #fff; }
  .route-card__main h3 { margin: 0; font-family: var(--font-sans); font-size: clamp(1.08rem, 1.5vw, 1.25rem); letter-spacing: -.015em; line-height: 1.4; }
  .route-card--self h3 { color: var(--text-primary); }
  .route-card--collab h3 { color: #fff; }
  .route-card__desc { margin: .55rem 0 0; font-size: .88rem; line-height: 1.65; }
  .route-card--self .route-card__desc { color: var(--text-secondary); }
  .route-card--collab .route-card__desc { color: rgb(255 255 255 / .78); }
  .route-card__action-wrap { margin-top: .35rem; }
  .route-card__btn { width: 100%; text-decoration: none; min-height: 2.75rem; font-size: .86rem; }

  /* 4. SPEAKER & IDENTITY FIELD JOURNAL */
  .identity-section { position: relative; isolation: isolate; padding: clamp(1.35rem, 2.8vw, 2.25rem); overflow: hidden; background: var(--bg-soft); border: 1px solid var(--border-strong); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); }
  .identity-section__seam { position: absolute; inset: 0 0 auto; height: 3px; overflow: hidden; background: color-mix(in srgb, var(--text-primary) 20%, transparent); }
  .identity-section__seam span { display: block; width: 100%; height: 100%; background: var(--text-primary); transform-origin: left center; }
  .section-grid { display: grid; grid-template-columns: minmax(0, .82fr) minmax(20rem, 1.18fr); gap: clamp(2rem, 5vw, 4rem); }
  .identity-intro { grid-template-columns: minmax(0, 1.1fr) minmax(18rem, .9fr); align-items: start; gap: clamp(2rem, 5vw, 4.5rem); }
  .identity-intro h2 { max-width: 14em; font-family: var(--font-sans); font-size: clamp(1.3rem, 2vw, 1.6rem); letter-spacing: -.02em; line-height: 1.35; text-wrap: balance; }
  .identity-intro__nowrap { white-space: nowrap; }
  .threads-proof__stat span { white-space: nowrap; }
  .plan-entry { display: grid; gap: 1.1rem; padding: clamp(1.35rem, 2.8vw, 2.25rem); border: 1px solid var(--border-strong); border-radius: var(--radius-md); background: var(--bg-soft); box-shadow: var(--shadow-sm); }
  .plan-entry header h2 { margin: .35rem 0 0; font-family: var(--font-sans); font-size: clamp(1.3rem, 2vw, 1.6rem); letter-spacing: -.02em; line-height: 1.35; }
  .plan-entry__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .plan-entry__card { display: grid; align-content: start; gap: .45rem; padding: 1.5rem; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); background: var(--surface-elevated); color: inherit; text-decoration: none; transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease; }
