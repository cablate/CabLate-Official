---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/sections/Newsletter.astro';
import HeroCarousel from '../components/sections/HeroCarousel.astro';
import { ArrowRight } from '@lucide/astro';
import { authorityProfile } from '../config/authority';
import { siteConfig, withCabAiAttribution } from '../config/siteConfig';

const heroSlides = [
  {
    src: '/images/photos/cablate-speaking-ai-meetup-april.webp',
    alt: 'CabLate 在四月 AI 小聚現場以麥克風分享技術內容',
    width: 2000,
    height: 1333,
  },
  {
    src: '/images/photos/cablate-speaking-workshop-0627.webp',
    alt: 'CabLate 在工作坊現場手持麥克風分享 AI 實作經驗',
    width: 1970,
    height: 1970,
  },
];

const diagnosticRows = [
  {
    titleLines: ['每次換個任務，都得重新交代背景。'],
    explanation: 'AI 每次拿到的背景不完整，前一次的判斷接不起來。',
    // Articles inbound links paused.
    // href: '/articles/claude-code-token-drain-system-reminder/',
    // label: '看資訊脈絡怎麼失效',
  },
  {
    titleLines: ['AI 做了很多，最後還是不敢直接用。'],
    explanation: '完成標準與驗收方式沒有先說清楚。',
    // Articles inbound links paused.
    // href: '/articles/claude-code-workflow/',
    // label: '看怎麼建立完成標準',
  },
  {
    titleLines: ['一出錯就找不到原因，', '只能從頭再來。'],
    explanation: '流程沒有留下可檢查的節點，也沒有出錯後的復原方式。',
    // Articles inbound links paused.
    // href: '/articles/agent-sdk-system-reminder-diff-fix/',
    // label: '看怎麼留下檢查順序',
  },
];

const visitorRoutes = [
  {
    title: '我想先把 AI 用得更穩',
    description: '已經開始使用 AI，但常遇到忘記前文、產出不穩，或不知道應該從哪裡修正。',
    href: '/expertise/',
    label: '先做問題診斷',
  },
  {
    title: '我想把一個想法完整做出來',
    description: '已經有網站、工具或工作流程的題目，希望學會把它推到能使用、能部署，也能繼續維護。',
    href: '/courses/',
    label: '找適合的學習路線',
  },
  {
    title: '我想改善團隊的 AI 流程',
    description: '團隊已經有工作內容、資料與使用者，希望判斷哪些地方該培訓、調整流程，或導入自動化。',
    href: '/services/',
    label: '查看合作方式',
  },
];

---

<BaseLayout title="CabLate — AI 協作・技術觀點・開發實戰" description={authorityProfile.shortBio}>
  <div class="desk-page">
    <div class="desk-content">
      <section class="hero-grid" aria-labelledby="home-title">
        <div class="identity-card paper-card">
          <div class="paper-card__inner">
            <p class="section-label">AI 協作・工作流程設計</p>
            <h1 class="display-heading" id="home-title"><span class="heading-phrase">讓 AI 把工作</span><span class="heading-phrase">做完，</span><span class="heading-phrase">成果也能</span><span class="heading-phrase">放心交付。</span></h1>
            <p class="hero-copy">你已經在用 AI，卻還是常常重做、卡住，或不敢直接交付。模型和 Prompt 可能沒有問題。只要任務、資料、工具或完成標準少了一塊，AI 一樣會走偏。</p>
            <a class="btn btn-primary home-hero-action" href="#diagnosis">找出問題卡在哪一層 <ArrowRight size={17} aria-hidden="true" /></a>
          </div>
        </div>

        <HeroCarousel slides={heroSlides} />
      </section>

      <section class="paper-card" id="diagnosis" aria-labelledby="diagnosis-title">
        <div class="paper-card__inner">
          <div class="home-split diagnosis-layout">
            <div class="diagnosis-intro">
              <p class="section-label">你可能也遇過這些問題</p>
              <h2 id="diagnosis-title">AI 偶爾做得到，不代表你已經有一套可靠流程。</h2>
              <p>可靠流程要能在換任務、工具或交接對象後，仍讓成果被重現、檢查與修正。</p>
              <p class="diagnosis-conclusion">這三種失效都可以逐層檢查。先找出最容易出錯的一層，不用先換掉整套工具。</p>
            </div>
            <div class="home-list diagnostic-list">
              {diagnosticRows.map((row) => (
                <article>
                  <h3>{row.titleLines.map((line, index) => <>{index > 0 && <br class="mobile-heading-break" />}{line}</>)}</h3>
                  <p>{row.explanation}</p>
                  {/* Articles inbound links paused: 保留診斷內容，不主動導向文章。 */}
                </article>
              ))}
            </div>
          </div>
          <div class="diagnosis-actions">
            <a class="btn btn-primary diagnosis-action" href="/expertise/">查看診斷方法 <ArrowRight size={17} aria-hidden="true" /></a>
            <a class="btn btn-paper diagnosis-action" href="/services/">討論合作 <ArrowRight size={17} aria-hidden="true" /></a>
          </div>
        </div>
      </section>

      <section class="thesis-card paper-card" aria-labelledby="thesis-title">
        <div class="paper-card__inner home-split thesis-layout">
          <div>
            <p class="section-label">我是 CabLate</p>
            <h2 id="thesis-title"><span class="thesis-heading-line">判斷力比</span><span class="thesis-heading-line">執行力值錢。</span></h2>
          </div>
          <div class="thesis-copy">
            <p class="identity-lead">我是 CabLate，從全端工程走進 AI 工作流程設計，現在把這些經驗整理成能用的方法。</p>
            <p>我先確認成果能不能直接使用，再找出系統在哪裡失效。問題可能少了資料、工具，也可能是一開始就沒說清楚怎樣才算完成。</p>
            <a class="btn btn-paper home-trust-action" href="/about/">認識我的經歷與判斷方式 <ArrowRight size={17} aria-hidden="true" /></a>
          </div>
        </div>
      </section>

      <section class="paper-card" aria-labelledby="routes-title">
        <div class="paper-card__inner">
          <header class="section-header">
            <p class="section-label">從最接近你的問題開始</p>
            <h2 id="routes-title">你現在最想改善<br class="mobile-heading-break" />哪一件事？</h2>
            <p class="section-intro">你可以先自己診斷、系統學習，或直接討論合作。選最符合現況的一種就好。</p>
          </header>
          <div class="home-list route-list">
            {visitorRoutes.map((route) => (
              <article class="route-row">
                <h3>{route.title}</h3>
                <p>{route.description}</p>
                <div class="route-action">
                  <a class="btn btn-paper" href={route.href}>{route.label} <ArrowRight size={16} aria-hidden="true" /></a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="case-card paper-card paper-card--clip" aria-labelledby="case-title">
        <div class="paper-card__inner home-split">
          <div class="case-story">
            <p class="section-label">工程手冊案例</p>
            <h2 id="case-title"><span>規則愈加愈多，</span><span>為什麼 AI 還是會</span><span>忘記、重做？</span></h2>
            <div class="case-product-intro">
              <h3>Agent 深度工程手冊</h3>
              <p>我把半年多反覆遇到的問題、排查順序與修正方法整理進這份手冊。遇到類似失效時，可以從症狀開始查，不必再靠猜。</p>
            </div>
            <div class="case-step">
              <strong>問題</strong>
              <p>為了讓 AI 記得更多背景，我不斷增加規則與設定，成果卻沒有因此變穩。</p>
            </div>
            <div class="case-step">
              <strong>發現</strong>
              <p>追查後才發現，規則已經夠多了。AI 當下讀不到需要的資料，也不知道能用哪些工具；出錯後更沒有一套檢查和復原方式。</p>
            </div>
            <div class="case-step">
              <strong>手冊內容</strong>
              <p>手冊把這些失效拆成 Skill、Memory、Context 等層次，並整理檢查、修正與交接的排查順序。</p>
            </div>
            <a class="btn btn-primary case-handbook-action" href={withCabAiAttribution(siteConfig.cabAi.handbookUrl, 'home_case_handbook')} target="_blank" rel="noopener">查看工程手冊 <ArrowRight size={17} aria-hidden="true" /></a>
          </div>
        </div>
      </section>

      <section class="cabai-card paper-card" id="cabai" aria-labelledby="cabai-title">
        <div class="paper-card__inner home-split cabai-layout">
          <div>
            <p class="section-label">CabAI 學習平台</p>
            <h2 id="cabai-title"><span>課程、手冊與免費試看，</span><span>都整理在這裡。</span></h2>
          </div>
          <div class="cabai-copy">
            <p>CabAI 收錄免費試看、系統課程、工程手冊和已購內容。你可以先看目前開放的內容，確定適合，再決定要不要付費。</p>
            <a class="btn btn-primary cabai-primary" href={withCabAiAttribution(siteConfig.cabAi.productsUrl, 'home_learning')} target="_blank" rel="noopener">查看免費試看與學習內容 <ArrowRight size={17} aria-hidden="true" /></a>
          </div>
        </div>
      </section>

      <section class="paper-card" aria-label="更新通知">
        <div class="paper-card__inner"><Newsletter /></div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  :global(body) {
    background: #eeeae2;
    color: #253047;
  }

  .desk-page {
    --ink: #253047;
    --muted: #697184;
    --purple: #8064ea;
    --purple-soft: #f1edff;
    --line: #d7d1c6;
    min-height: 100dvh;
    background-color: #eeeae2;
    background-image: radial-gradient(rgb(60 50 40 / .045) .7px, transparent .7px);
    background-size: .42rem .42rem;
  }

  .desk-content {
    display: grid;
    width: min(100%, 86rem);
    min-width: 0;
    gap: 1rem;
    margin-inline: auto;
    padding-block: 1rem 1.5rem;
  }

  .desk-content > *,
  .hero-grid > * {
    min-width: 0;
  }

  h1,
  h2,
  h3 {
    text-wrap: balance;
  }

  p,
  li {
    text-wrap: pretty;
  }

  h1,
  h2,
  h3,
  p {
    overflow-wrap: break-word;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr);
    align-items: center;
    gap: 1.5rem;
  }

  .identity-card {
    z-index: 2;
    margin-right: -2.5rem;
  }

  .identity-card .paper-card__inner {
    padding: clamp(2.4rem, 4vw, 3.4rem) clamp(2.1rem, 3.5vw, 3rem);
  }

  .identity-card h1 {
    max-width: 10.5em;
    margin: 0;
    font-family: 'Noto Serif TC', serif;
    font-size: clamp(2.35rem, 3.4vw, 3.25rem);
    line-height: 1.18;
    letter-spacing: -.045em;
  }

  .hero-copy {
    max-width: 33rem;
    margin: 1.35rem 0 1.55rem;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.85;
  }

  .home-hero-action {
    border-radius: 0;
  }

  .home-hero-action:hover {
    background: var(--purple);
  }

  .home-split {
    display: grid;
    align-items: start;
  }

  .diagnosis-layout {
    grid-template-columns: minmax(0, .78fr) minmax(0, 1.22fr);
    gap: clamp(2rem, 5vw, 4rem);
  }

  .diagnosis-intro h2,
  .thesis-card h2,
  .section-header h2,
  .case-story h2 {
    margin: 0;
    font-family: 'Noto Serif TC', serif;
    color: var(--ink);
  }

  .diagnosis-intro h2,
  .section-header h2 {
    font-size: clamp(1.75rem, 3vw, 2.6rem);
    line-height: 1.35;
  }

  .diagnosis-intro > p:not(.section-label) {
    margin: 1rem 0 0;
    color: var(--muted);
    line-height: 1.8;
  }

  .diagnosis-conclusion {
    color: var(--ink) !important;
    font-weight: 700;
  }

  .diagnosis-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: .75rem;
    margin-top: 1.6rem;
    padding-top: 1.35rem;
    border-top: 1px solid var(--line);
  }

  .diagnosis-action {
    min-width: 12rem;
    white-space: nowrap;
  }

  .diagnosis-action,
  .btn-paper,
  .case-handbook-action {
    border-radius: 0;
  }

  .btn-paper {
    border-color: rgb(128 100 234 / .62);
    background: rgb(241 237 255 / .78);
    box-shadow: 0 .14rem 0 rgb(128 100 234 / .14);
    color: #6047c7;
  }

  .btn-paper:hover {
    border-color: var(--purple);
    background: var(--purple-soft);
    color: #4f36b8;
    transform: translateY(-1px);
  }

  .home-list {
    min-width: 0;
  }

  .diagnostic-list article {
    padding: 1.15rem 0;
    border-top: 1px solid var(--line);
  }

  .diagnostic-list article:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .diagnostic-list h3 {
    margin: 0;
    font-family: 'Noto Serif TC', serif;
    font-size: 1.15rem;
    line-height: 1.5;
  }

  .diagnostic-list p {
    margin: .4rem 0 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .diagnosis-action {
    margin-top: .65rem;
  }

  .thesis-layout {
    grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr);
    gap: clamp(2rem, 6vw, 5rem);
  }

  .thesis-card h2 {
    max-width: 8em;
    font-size: clamp(2.2rem, 4.5vw, 4.4rem);
    line-height: 1.22;
    letter-spacing: -.04em;
  }

  .thesis-copy p {
    margin: 0 0 1rem;
    color: var(--muted);
    line-height: 1.85;
  }

  .thesis-copy .identity-lead {
    color: var(--ink);
    font-family: 'Noto Serif TC', serif;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: 700;
    line-height: 1.6;
  }

  .home-trust-action {
    margin-top: .25rem;
  }

  .diagnosis-actions .btn svg,
  .home-trust-action svg,
  .route-action .btn svg,
  .case-handbook-action svg {
    flex: none;
    transition: transform var(--transition-fast);
  }

  .diagnosis-actions .btn:hover svg,
  .home-trust-action:hover svg,
  .route-action .btn:hover svg,
  .case-handbook-action:hover svg {
    transform: translateX(.2rem);
  }

  .section-header {
    max-width: 43rem;
    margin-bottom: 1.5rem;
  }

  .section-intro {
    max-width: 40rem;
    margin: .85rem 0 0;
    color: var(--muted);
    line-height: 1.75;
  }

  .route-row {
    display: grid;
    grid-template-columns: minmax(13rem, .8fr) minmax(20rem, 1.35fr) minmax(11rem, .75fr);
    align-items: start;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding: 1.45rem 0;
    border-top: 1px solid var(--line);
  }

  .route-row h3 {
    margin: 0;
    font-family: 'Noto Serif TC', serif;
    font-size: 1.15rem;
    line-height: 1.5;
  }

  .route-row > p {
    margin: 0;
    color: var(--muted);
    line-height: 1.75;
  }

  .route-action {
    display: grid;
    justify-items: start;
    gap: .7rem;
  }

  .route-action .btn {
    min-width: 10.5rem;
    white-space: nowrap;
  }

  .case-story {
    max-width: 58rem;
  }

  .case-story h2 {
    max-width: 19em;
    font-size: clamp(1.8rem, 3.4vw, 3.1rem);
    line-height: 1.35;
  }

  .thesis-card h2 .thesis-heading-line,
  .case-story h2 span {
    display: block;
  }

  .mobile-heading-break {
    display: none;
  }

  .case-step {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .case-step strong {
    color: var(--purple);
    font-size: .78rem;
  }

  .case-step p {
    margin: 0;
    color: var(--muted);
    line-height: 1.75;
  }

  .case-product-intro {
    max-width: 44rem;
    margin: 1.1rem 0 1.5rem;
    padding: .9rem 1rem;
    border-left: .2rem solid var(--purple);
    background: rgb(241 237 255 / .62);
  }

  .case-product-intro h3 {
    margin: 0;
    color: var(--ink);
    font-family: 'Noto Serif TC', serif;
    font-size: clamp(1.12rem, 2vw, 1.35rem);
    font-weight: 700;
    line-height: 1.5;
  }

  .case-product-intro p {
    margin: .45rem 0 0;
    color: var(--muted);
    line-height: 1.75;
  }

  .case-handbook-action {
    margin-top: 1.5rem;
  }

  .cabai-layout {
    grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr);
    gap: clamp(2rem, 6vw, 5rem);
  }

  .cabai-card h2 {
    max-width: 12em;
    margin: 0;
    font-family: 'Noto Serif TC', serif;
    color: var(--ink);
    font-size: clamp(1.9rem, 3.4vw, 3.1rem);
    line-height: 1.3;
  }

  .cabai-card h2 span {
    display: block;
  }

  .cabai-copy > p {
    max-width: 38rem;
    margin: 0 0 1.3rem;
    color: var(--muted);
    line-height: 1.85;
  }

  .cabai-primary {
    border-radius: 0;
    max-width: 100%;
    white-space: nowrap;
  }

  @media (max-width: 1100px) {
    .hero-grid {
      grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    }

    .identity-card {
      margin-right: -1.5rem;
    }

    .route-row {
      grid-template-columns: minmax(13rem, .9fr) minmax(20rem, 1.3fr);
    }

    .route-action {
      grid-column: 2;
    }

  }

  @media (max-width: 900px) {
    .desk-content {
      width: 100%;
      max-width: 100%;
      padding-block: .75rem 1rem;
      overflow: visible;
    }

    .hero-grid,
    .diagnosis-layout,
    .thesis-layout,
    .cabai-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .identity-card {
      margin-right: 0;
    }

    .identity-card .paper-card__inner {
      padding: 2rem 1.25rem;
    }

    .identity-card h1 {
      max-width: 12em;
      font-size: clamp(2.1rem, 9vw, 3rem);
    }

    .hero-copy {
      font-size: .96rem;
    }

    .diagnosis-layout,
    .thesis-layout,
    .cabai-layout {
      gap: 1.75rem;
    }

    .thesis-card h2 {
      max-width: 10em;
      font-size: clamp(2rem, 10vw, 3rem);
    }

    .route-row {
      grid-template-columns: minmax(0, 1fr);
      gap: .55rem;
      padding: 1.25rem 0;
    }

    .route-action {
      grid-column: auto;
    }

    .route-action {
      margin-top: .25rem;
    }

    .diagnosis-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .diagnosis-actions .btn,
    .home-trust-action,
    .route-action .btn,
    .case-handbook-action {
      width: 100%;
      justify-content: space-between;
    }

    .case-step {
      grid-template-columns: minmax(0, 1fr);
      gap: .35rem;
    }

  }

  @media (max-width: 480px) {
    .identity-card h1 {
      font-size: clamp(2rem, 10.5vw, 2.6rem);
    }

    .home-hero-action {
      width: 100%;
      justify-content: center;
    }

    .cabai-primary {
      width: 100%;
      justify-content: center;
    }

    .diagnosis-intro h2,
    .section-header h2 {
      font-size: 1.65rem;
    }

    .case-story h2 {
      font-size: 1.75rem;
    }

    .cabai-card h2 {
      font-size: clamp(1.55rem, 7.6vw, 1.9rem);
    }

    .mobile-heading-break {
      display: initial;
    }
  }
</style>
