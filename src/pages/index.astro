---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/sections/Newsletter.astro';
import { ArrowLeft, ArrowRight, Braces, Database, GitBranch } from '@lucide/astro';
import { siteConfig, withCabAiAttribution } from '../config/siteConfig';

const heroMessages = [
  {
    statement: ['我研究 AI、Agent', '與真實工作流程'],
    result: '找到做法也知道怎麼檢查\n用 AI 改善你的工作流程',
  },
  {
    statement: ['我把工程上的拆解與驗證', '帶進 AI 應用'],
    result: '把問題拆開也把判斷留下\n下一次不必再從頭猜',
  },
  {
    statement: ['我熟悉 AI 應用', '也親手把方法做成產品'],
    result: '看得出 AI 卡在哪裡\n把結果修到能驗收也能交接',
  },
];

const diagnosticCases = [
  { code: 'context', icon: Database, term: 'Context', title: '資訊脈絡', question: ['它這次到底', '看到了哪些資料'], symptom: ['講了很多次', 'AI 表現還是很差'], description: '你以為交代過了，下一次它卻像從沒看過。', diagnosis: ['你以為它知道的背景', '不一定真的進到這次任務裡'], next: ['挑一個明顯答錯的地方', '對照它當時實際讀到的資料'] },
  { code: 'skill', icon: Braces, term: 'Skill', title: '可重複方法', question: ['上次做對的關鍵', '有沒有被留下來'], symptom: ['這次明明做出成果', '下次又得重來'], description: '結果留下了，真正有用的做法卻沒有。', diagnosis: ['留下成果不等於留下做法', '關鍵判斷沒保存，下次還是得重講'], next: ['找一個每次都得重講的判斷', '把它整理成下次能直接照做的步驟'] },
  { code: 'harness', icon: GitBranch, term: 'Harness', title: '執行環境', question: ['流程是從哪一步', '開始斷掉的'], symptom: ['只要一步出錯', '整個流程就卡住'], description: '前面明明都成功了，一出錯還是只能從頭開始。', diagnosis: ['流程如果只記得從頭開始', '前面做對再多，出錯也接不回去'], next: ['找到失敗前最後完成的步驟', '讓流程直接從那裡繼續'] },
];

const routes = [
  { title: '先自己研究看看', description: '從課程和整理好的內容開始', label: '看學習內容', href: '/courses/' },
  { title: '找我一起看', description: '帶著實際情境，一起排出下一步', label: '查看合作方式', href: '/services/' },
];

const speakerRecords = [
  {
    id: 'invited-talk',
    time: '2025.07',
    title: '從第一次受邀講座開始',
    description: '先從研討會與開發者社群分享開始，把 AI 怎麼進入真實工作講給現場的人聽。',
    visual: 'meetup',
  },
  {
    id: 'hosted-talk',
    time: '2025.10',
    title: '接著主辦第一場講座',
    description: '網站資安入門，200 人報名。',
    visual: 'workshop',
  },
  {
    id: 'delivery',
    time: '目前',
    title: '企業內訓與工作坊持續交付',
    description: '依團隊情境做需求與受眾盤點，設計課綱、示範案例和實作題目，課後再留下改善建議與學習方向。',
    visual: 'workshop',
  },
] as const;
---

<BaseLayout title="CabLate｜AI 應用、Agent 與產品實作" description="CabLate 的個人網站。從全端工程與系統設計出發，持續製作 AI 產品、研究 Agent，也整理文章、課程與工作方法。" image="/og/pages/home.png" imageAlt="CabLate：從工程走進 AI，持續做產品、寫研究與整理工作方法。" imageWidth={1200} imageHeight={630}>
  <div class="home-page" data-content-state="testing">
    <section class="home-hero paper-card" aria-labelledby="home-title" data-hero-copy-rotation data-messages={JSON.stringify(heroMessages)}>
      <header class="home-hero__lede">
        <h1 id="home-title">嗨，我是 CabLate</h1>
        <p class="home-hero__statement" id="home-hero-statement" data-hero-statement aria-live="off">
          {heroMessages[0].statement.map((line) => <span data-hero-statement-line>{line}</span>)}
        </p>
      </header>

      <figure class="home-hero__portraits">
        <div class="hero-photo hero-photo--primary">
          <img
            src="/images/photos/cablate-speaking-ai-meetup-april-refined-v1.webp"
            alt="Cab 在 AI 小聚現場分享 AI 協作與工作流程"
            width="1122"
            height="1402"
            fetchpriority="high"
          />
        </div>
        <div class="hero-photo hero-photo--secondary">
          <img
            src="/images/photos/cablate-speaking-workshop-0627-refined-v1.webp"
            alt="Cab 在工作坊現場與學員拆解實作問題"
            width="1122"
            height="1402"
            fetchpriority="low"
          />
        </div>
        <p class="home-hero__annotation"><span>WORK NOTE</span>做出來之後呢？</p>
      </figure>

      <div class="home-hero__body">
        <p class="home-hero__result" id="home-hero-result" data-hero-result aria-live="off">{heroMessages[0].result}</p>
        <div class="home-hero__rotation-meta">
          <div class="home-hero__rotation-controls" data-hero-rotation-controls role="group" aria-label="切換介紹內容" hidden>
            <button type="button" data-hero-previous aria-label="上一則介紹" aria-controls="home-hero-statement home-hero-result"><ArrowLeft size={15} aria-hidden="true" /></button>
            <span class="rotation-controls__count" aria-hidden="true"><span data-hero-current>01</span> / {String(heroMessages.length).padStart(2, '0')}</span>
            <button type="button" data-hero-next aria-label="下一則介紹" aria-controls="home-hero-statement home-hero-result"><ArrowRight size={15} aria-hidden="true" /></button>
          </div>
          <span class="visually-hidden" data-hero-rotation-status aria-live="polite" aria-atomic="true"></span>
        </div>
        <div class="home-hero__actions">
          <a class="btn btn-primary hero-action" href="/about/#public-output-title">先看我做過的東西 <ArrowRight size={18} aria-hidden="true" /></a>
          <a class="home-hero__secondary-action" href="#diagnostic-title">有個 AI 卡點？從這裡開始 <ArrowRight size={16} aria-hidden="true" /></a>
        </div>
      </div>
    </section>

    <section class="diagnostic-stage" aria-labelledby="diagnostic-title">
      <header class="diagnostic-heading">
        <h2 id="diagnostic-title">你是不是也遇過<br />這幾種情況</h2>
      </header>

      <div class="diagnostic-console">
        <fieldset class="symptom-choices">
          <legend class="visually-hidden">選擇最接近目前情況的症狀</legend>
          {diagnosticCases.map((item, index) => (
            <label class="symptom-choice" for={`home-diagnostic-${item.code}`}>
              <input id={`home-diagnostic-${item.code}`} type="radio" name="home-diagnostic" value={item.code} checked={index === 0} aria-controls={`home-trace-${item.code}`} />
              <span class="symptom-choice__surface"><strong>{item.symptom.map((line) => <span class="symptom-copy-line">{line}</span>)}</strong><span>{item.description}</span></span>
            </label>
          ))}
        </fieldset>

        <div class="trace-panels" aria-live="polite">
          {diagnosticCases.map((item) => (
            <article class="trace-panel" id={`home-trace-${item.code}`} data-trace={item.code}>
              <header class="trace-panel__heading">
                <div class="diagnosis-stamp"><item.icon size={22} aria-hidden="true" /><span>{item.term} / {item.title}</span></div>
                <h3>{item.question.map((line) => <span>{line}</span>)}</h3>
              </header>
              <div class="trace-reading">
                <p class="trace-diagnosis">{item.diagnosis.map((line) => <span>{line}</span>)}</p>
                <p class="trace-next"><span class="trace-next__arrow" aria-hidden="true">→</span><strong>{item.next.map((line) => <span>{line}</span>)}</strong></p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="route-section" aria-labelledby="route-title" data-chapter-transition>
      <header class="route-heading" data-chapter-lead><h2 id="route-title">接下來<br />怎麼走？</h2></header>
      <ul class="route-list">
        {routes.map((route, index) => (
          <li class:list={{ 'route-list__primary': index === 0 }}>
            <a class="route-item" href={route.href}>
              {index === 0 && <img class="route-item__annotation" src="/images/decorative/route-decision-annotation.png" alt="" width="2200" height="768" aria-hidden="true" />}
              <h3>{route.title}</h3>
              <span class="visually-hidden">{route.description}</span>
              <span class="route-item__action">{route.label} <ArrowRight size={16} aria-hidden="true" /></span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="identity-section speaker-section" aria-labelledby="identity-title" data-speaker-section data-chapter-transition>
      <span class="identity-section__seam" aria-hidden="true"><span data-chapter-seam></span></span>
      <div class="identity-intro section-grid" data-chapter-lead>
        <header><h2 id="identity-title">這一年，<span class="identity-intro__nowrap">教學成了</span>我工作的一部分</h2></header>
        <div class="identity-intro__copy">
          <p class="identity-intro__lead">從受邀分享，到舉辦講座、工作坊和企業內訓</p>
          <a class="text-action" href="/about/#delivery-experience-title">看完整經歷 <ArrowRight size={16} aria-hidden="true" /></a>
        </div>
      </div>
      <div class="speaker-proof">
        <div class="speaker-trace" data-speaker-trace>
          <div class="speaker-trace__rail" aria-hidden="true"><span data-speaker-progress></span></div>
          <ol class="speaker-records">
            {speakerRecords.map((record) => (
              <li class="speaker-record" data-speaker-record={record.id} data-speaker-visual={record.visual}>
                <div class="speaker-record__time"><span>{record.time}</span></div>
                <div class="speaker-record__body"><h3>{record.title}</h3><p>{record.description}</p></div>
              </li>
            ))}
          </ol>
        </div>
        <div class="speaker-proof__side">
          <figure class="speaker-media" aria-label="講座與工作坊現場照片">
            <div class="speaker-media__frame" data-speaker-media="meetup">
              <img src="/images/photos/cablate-speaking-ai-meetup-april.webp" alt="Cab 在 AI 小聚現場拿著麥克風分享" width="2048" height="1365" loading="lazy" />
              <figcaption>AI 小聚現場</figcaption>
            </div>
            <div class="speaker-media__frame" data-speaker-media="workshop">
              <img src="/images/photos/cablate-speaking-workshop-0627.webp" alt="Cab 在工作坊現場與學員一起拆解問題" width="2048" height="2731" loading="lazy" />
              <figcaption>工作坊現場</figcaption>
            </div>
          </figure>
        </div>
        <figure class="threads-proof" id="threads-proof">
          <figcaption class="threads-proof__copy">
            <h3>我也持續在 Threads 分享</h3>
            <div class="threads-proof__stat"><strong>9,163</strong><span>位追蹤者</span></div>
          </figcaption>
          <a class="threads-proof__image" href={siteConfig.threadsUrl} target="_blank" rel="noopener">
            <img src="/images/proof/threads-cab-late-profile-2026-08-18.png" alt="CabLate Threads 個人檔案，顯示 9,163 位追蹤者" width="657" height="361" loading="lazy" />
          </a>
          <a class="threads-proof__cta" href={siteConfig.threadsUrl} target="_blank" rel="noopener">去 Threads 看最近在寫什麼 <ArrowRight size={14} aria-hidden="true" /></a>
        </figure>
      </div>
    </section>

    <section class="cabai-section" aria-labelledby="cabai-title" data-chapter-transition>
      <div class="cabai-section__header" data-chapter-lead><h2 id="cabai-title">課程和文章，<br />都放在 CabAI</h2></div>
      <div class="cabai-section__body">
        <ul class="cabai-index" aria-label="CabAI 內容索引">
          <li>
            <a class="cabai-index__row" href={withCabAiAttribution(siteConfig.cabAi.libraryUrl, 'home_cabai_library')} target="_blank" rel="noopener">
              <span><strong>公開文章</strong><span class="cabai-index__description">先找一篇現在用得上的內容</span></span>
              <span class="cabai-index__action">前往 Library <ArrowRight size={16} aria-hidden="true" /></span>
            </a>
          </li>
          <li>
            <a class="cabai-index__row" href={withCabAiAttribution(siteConfig.cabAi.productsUrl, 'home_cabai_courses')} target="_blank" rel="noopener">
              <span><strong>課程平台</strong><span class="cabai-index__description">照著一條完整路徑實作</span></span>
              <span class="cabai-index__action">查看課程 <ArrowRight size={16} aria-hidden="true" /></span>
            </a>
          </li>
        </ul>
      </div>
    </section>

    <div class="newsletter-card"><Newsletter /></div>
  </div>
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initializeHeroCopyRotation = () => {
    const heroes = document.querySelectorAll<HTMLElement>('[data-hero-copy-rotation]');

    heroes.forEach((hero) => {
      if (hero.dataset.rotationReady === 'true') return;

      const statement = hero.querySelector<HTMLElement>('[data-hero-statement]');
      const statementLines = Array.from(hero.querySelectorAll<HTMLElement>('[data-hero-statement-line]'));
      const result = hero.querySelector<HTMLElement>('[data-hero-result]');
      const controls = hero.querySelector<HTMLElement>('[data-hero-rotation-controls]');
      const previous = hero.querySelector<HTMLButtonElement>('[data-hero-previous]');
      const next = hero.querySelector<HTMLButtonElement>('[data-hero-next]');
      const currentLabel = hero.querySelector<HTMLElement>('[data-hero-current]');
      const status = hero.querySelector<HTMLElement>('[data-hero-rotation-status]');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      if (!statement || statementLines.length < 2 || !result || !controls || !previous || !next || !currentLabel || !status || !hero.dataset.messages) return;

      const messages = JSON.parse(hero.dataset.messages) as Array<{ statement: string[]; result: string }>;
      if (messages.length < 2) return;

      hero.dataset.rotationReady = 'true';
      let currentIndex = 0;
      let autoplayId = 0;
      let transitionId = 0;
      let isInViewport = true;
      let userInteracted = false;
      let pointerStart: { x: number; y: number } | null = null;

      const stop = () => {
        window.clearTimeout(autoplayId);
        autoplayId = 0;
      };

      const render = (index: number) => {
        currentIndex = index;
        statementLines.forEach((line, lineIndex) => {
          line.textContent = messages[currentIndex].statement[lineIndex] ?? '';
        });
        result.textContent = messages[currentIndex].result;
        currentLabel.textContent = String(currentIndex + 1).padStart(2, '0');
      };

      const announce = () => {
        status.textContent = `第 ${currentIndex + 1} 則介紹：${messages[currentIndex].statement.join(' ')}。${messages[currentIndex].result.replace('\n', ' ')}`;
      };

      const start = () => {
        stop();
        if (document.hidden || reduceMotion.matches || userInteracted || !isInViewport) return;
        autoplayId = window.setTimeout(() => changeTo(currentIndex + 1, 'next', false), 3000);
      };

      const changeTo = (index: number, direction: 'previous' | 'next', shouldAnnounce: boolean) => {
        const nextIndex = (index + messages.length) % messages.length;
        if (nextIndex === currentIndex) return;

        stop();
        const directionClass = direction === 'previous' ? 'is-switching--previous' : 'is-switching--next';
        statement.classList.add('is-switching');
        statement.classList.add(directionClass);
        result.classList.add('is-switching');
        result.classList.add(directionClass);
        window.clearTimeout(transitionId);
        transitionId = window.setTimeout(() => {
          render(nextIndex);
          requestAnimationFrame(() => {
            statement.classList.remove('is-switching');
            statement.classList.remove(directionClass);
            result.classList.remove('is-switching');
            result.classList.remove(directionClass);
          });
          if (shouldAnnounce) announce();
          start();
        }, reduceMotion.matches ? 0 : 220);
      };

      const handleVisibility = () => {
        if (document.hidden) stop();
        else start();
      };

      const handleMotionPreference = () => {
        stop();
        window.clearTimeout(transitionId);
        statement.classList.remove('is-switching');
        statement.classList.remove('is-switching--previous', 'is-switching--next');
        result.classList.remove('is-switching');
        result.classList.remove('is-switching--previous', 'is-switching--next');
        start();
      };

      const navigate = (index: number, direction: 'previous' | 'next') => {
        userInteracted = true;
        changeTo(index, direction, true);
      };

      const handlePrevious = () => navigate(currentIndex - 1, 'previous');
      const handleNext = () => navigate(currentIndex + 1, 'next');

      const handlePointerDown = (event: PointerEvent) => {
        if (event.pointerType === 'mouse' && event.button !== 0) return;
        pointerStart = { x: event.clientX, y: event.clientY };
      };

      const handlePointerUp = (event: PointerEvent) => {
        if (!pointerStart) return;
        const deltaX = event.clientX - pointerStart.x;
        const deltaY = event.clientY - pointerStart.y;
        pointerStart = null;

        if (Math.abs(deltaX) < 48 || Math.abs(deltaX) <= Math.abs(deltaY) * 1.2) return;
        if (deltaX < 0) handleNext();
        else handlePrevious();
      };

      const handlePointerCancel = () => {
        pointerStart = null;
      };

      const observer = 'IntersectionObserver' in window
        ? new IntersectionObserver(([entry]) => {
            isInViewport = entry?.isIntersecting ?? false;
            if (isInViewport) start();
            else stop();
          }, { threshold: 0.24 })
        : null;

      const cleanup = () => {
        stop();
        window.clearTimeout(transitionId);
        previous.removeEventListener('click', handlePrevious);
        next.removeEventListener('click', handleNext);
        hero.removeEventListener('pointerdown', handlePointerDown);
        hero.removeEventListener('pointerup', handlePointerUp);
        hero.removeEventListener('pointercancel', handlePointerCancel);
        document.removeEventListener('visibilitychange', handleVisibility);
        reduceMotion.removeEventListener('change', handleMotionPreference);
        observer?.disconnect();
      };

      controls.hidden = false;
      previous.addEventListener('click', handlePrevious);
      next.addEventListener('click', handleNext);
      hero.addEventListener('pointerdown', handlePointerDown);
      hero.addEventListener('pointerup', handlePointerUp);
      hero.addEventListener('pointercancel', handlePointerCancel);
      document.addEventListener('visibilitychange', handleVisibility);
      reduceMotion.addEventListener('change', handleMotionPreference);
      document.addEventListener('astro:before-swap', cleanup, { once: true });
      observer?.observe(hero);

      start();
    });
  };

  initializeHeroCopyRotation();
  document.addEventListener('astro:page-load', initializeHeroCopyRotation);

  const initializeSpeakerEvidence = () => {
    const sections = document.querySelectorAll<HTMLElement>('[data-speaker-section]');

    sections.forEach((section) => {
      if (section.dataset.speakerReady === 'true') return;

      const trace = section.querySelector<HTMLElement>('[data-speaker-trace]');
      const records = Array.from(section.querySelectorAll<HTMLElement>('[data-speaker-record]'));
      const progress = section.querySelector<HTMLElement>('[data-speaker-progress]');
      const mediaFrames = Array.from(section.querySelectorAll<HTMLElement>('[data-speaker-media]'));
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const desktop = window.matchMedia('(min-width: 981px)');

      if (!trace || records.length === 0 || !progress || mediaFrames.length === 0) return;

      section.dataset.speakerReady = 'true';
      let activeFrame = mediaFrames.find((frame) => frame.dataset.speakerMedia === records[0]?.dataset.speakerVisual) ?? mediaFrames[0];
      let context: gsap.Context | null = null;
      let destroyed = false;

      const setActive = (record: HTMLElement, animate = !reduceMotion.matches) => {
        records.forEach((item) => item.classList.toggle('is-active', item === record));
        const nextFrame = mediaFrames.find((frame) => frame.dataset.speakerMedia === record.dataset.speakerVisual);
        if (!nextFrame || nextFrame === activeFrame) return;

        const previousFrame = activeFrame;
        activeFrame = nextFrame;
        nextFrame.classList.add('is-active');

        if (!animate) {
          previousFrame.classList.remove('is-active');
          return;
        }

        gsap.killTweensOf([previousFrame, nextFrame]);
        gsap.timeline({ defaults: { ease: 'power2.out' } })
          .to(previousFrame, { autoAlpha: 0, y: -10, duration: .24 })
          .fromTo(nextFrame, { autoAlpha: 0, y: 12 }, { autoAlpha: 1, y: 0, duration: .48 }, '<.08')
          .add(() => previousFrame.classList.remove('is-active'));
      };

      records[0]?.classList.add('is-active');
      if (!reduceMotion.matches && desktop.matches) {
        mediaFrames.forEach((frame) => {
          gsap.set(frame, { autoAlpha: frame === activeFrame ? 1 : 0, y: frame === activeFrame ? 0 : 12 });
        });

        context = gsap.context(() => {
          gsap.fromTo(progress, { scaleY: 0 }, {
            scaleY: 1,
            ease: 'none',
            scrollTrigger: {
              trigger: trace,
              start: 'top 72%',
              end: 'bottom 28%',
              scrub: .35,
            },
          });

          records.forEach((record) => {
            ScrollTrigger.create({
              trigger: record,
              start: 'top 68%',
              end: 'bottom 32%',
              onEnter: () => setActive(record),
              onEnterBack: () => setActive(record),
            });
          });
        }, section);
      }

      const cleanup = () => {
        if (destroyed) return;
        destroyed = true;
        context?.revert();
        reduceMotion.removeEventListener('change', handleMotionChange);
        desktop.removeEventListener('change', handleMotionChange);
        section.dataset.speakerReady = 'false';
      };

      const handleMotionChange = () => {
        cleanup();
        requestAnimationFrame(initializeSpeakerEvidence);
      };

      reduceMotion.addEventListener('change', handleMotionChange);
      desktop.addEventListener('change', handleMotionChange);
      document.addEventListener('astro:before-swap', cleanup, { once: true });
    });
  };

  initializeSpeakerEvidence();
  document.addEventListener('astro:page-load', initializeSpeakerEvidence);

  const initializeChapterTransitions = () => {
    const sections = document.querySelectorAll<HTMLElement>('[data-chapter-transition]');

    sections.forEach((section) => {
      if (section.dataset.chapterReady === 'true') return;

      const lead = section.querySelector<HTMLElement>('[data-chapter-lead]');
      const seam = section.querySelector<HTMLElement>('[data-chapter-seam]');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const desktop = window.matchMedia('(min-width: 761px)');

      if (!lead && !seam) return;

      section.dataset.chapterReady = 'true';
      let context: gsap.Context | null = null;
      let destroyed = false;

      if (!reduceMotion.matches && desktop.matches) {
        context = gsap.context(() => {
          if (lead) {
            gsap.fromTo(lead, { y: 22 }, {
              y: 0,
              ease: 'none',
              scrollTrigger: {
                trigger: section,
                start: 'top 86%',
                end: 'top 62%',
                scrub: .45,
              },
            });
          }

          if (seam) {
            gsap.fromTo(seam, { scaleX: .08 }, {
              scaleX: 1,
              ease: 'none',
              scrollTrigger: {
                trigger: section,
                start: 'top 92%',
                end: 'top 66%',
                scrub: .4,
              },
            });
          }
        }, section);
      }

      const cleanup = () => {
        if (destroyed) return;
        destroyed = true;
        context?.revert();
        reduceMotion.removeEventListener('change', handleMotionChange);
        desktop.removeEventListener('change', handleMotionChange);
        section.dataset.chapterReady = 'false';
      };

      const handleMotionChange = () => {
        cleanup();
        requestAnimationFrame(initializeChapterTransitions);
      };

      reduceMotion.addEventListener('change', handleMotionChange);
      desktop.addEventListener('change', handleMotionChange);
      document.addEventListener('astro:before-swap', cleanup, { once: true });
    });
  };

  initializeChapterTransitions();
  document.addEventListener('astro:page-load', initializeChapterTransitions);
</script>

