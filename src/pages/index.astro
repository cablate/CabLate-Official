---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/sections/Newsletter.astro';
import HeroCarousel from '../components/sections/HeroCarousel.astro';
import { ArrowRight, Braces, Database, GitBranch } from '@lucide/astro';
import { siteConfig, withCabAiAttribution } from '../config/siteConfig';

const heroSlides = [
  {
    src: '/images/photos/cablate-speaking-ai-meetup-april.webp',
    alt: 'CabLate 在 AI 小聚現場分享 AI 協作與技術實作',
    width: 2000,
    height: 1333,
  },
  {
    src: '/images/photos/cablate-speaking-workshop-0627.webp',
    alt: 'CabLate 在工作坊現場帶領學員進行 AI 實作',
    width: 1970,
    height: 1970,
  },
];

const symptoms = [
  ['背景講過很多次，它還是接不起來。', 'AI 當下拿到的資訊不完整，或讀到了過期、互相衝突的內容。'],
  ['它做了很多，最後還是得自己重做。', '任務看似完成，但沒有清楚的完成條件，也缺少能直接檢查結果的方法。'],
  ['只要一步出錯，整個流程就得重來。', '過程沒有留下可追查的節點，失敗後也不知道該從哪裡繼續。'],
];

const methods = [
  { icon: Database, term: 'Context', title: '資訊脈絡', body: 'AI 現在看到的資料對不對、版本對不對、是否剛好足夠。' },
  { icon: Braces, term: 'Skill', title: '可重複方法', body: '上次做對的判斷、順序、限制與例外，有沒有被留下來。' },
  { icon: GitBranch, term: 'Harness', title: '執行環境', body: '任務、工具、權限、驗收與失敗恢復，能不能真的接成一條流程。' },
];

const routes = [
  { order: '01', title: '我想先自己找出問題', description: '適合：你有真實任務，但還不確定問題在資訊、方法還是執行環境。', label: '先做工作流健檢', href: '/expertise/', primary: true },
  { order: '02', title: '我想自己學會怎麼修', description: '適合：問題類型已經比較清楚，願意用課程、手冊或 Skill 自己實作。', label: '查看學習內容', href: '/courses/', primary: false },
  { order: '03', title: '問題已經影響工作，我需要一起判斷', description: '適合：你已投入時間或成本，卻不知道該繼續、縮小還是換路。', label: '查看合作方式', href: '/services/', primary: false },
];
---

<BaseLayout title="CabLate｜AI 協作、Agent 工作流程與開發實戰" description="先找出 AI 工作流程真正失效的一層，再決定要自己修、系統學會，或找人一起處理。" image="/og/pages/home.png" imageAlt="CabLate：AI 已經做得很快了，難的是把事情真的做完。" imageWidth={1200} imageHeight={630}>
  <div class="home-page" data-content-state="testing">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero__copy paper-card">
        <div class="paper-card__inner">
          <p class="section-label">AI 協作・工作流程設計</p>
          <h1 id="home-title"><span>AI 已經做得很快了，</span><span>難的是把事情真的做完。</span></h1>
          <p>你可能已經用 AI 做了不少事，但背景常接不上、結果還要自己重修，出錯時又不知道從哪裡查。這些問題不一定靠改 Prompt 能解決。我通常會把工作拆開，看問題到底出在資料、工具、流程還是驗收。</p>
          <a class="btn btn-primary hero-action" href="/expertise/" aria-label="開始 AI 工作流健檢">先做 AI 工作流健檢 <ArrowRight size={18} aria-hidden="true" /></a>
        </div>
      </div>
      <HeroCarousel slides={heroSlides} label="CabLate 分享與工作坊現場" />
    </section>

    <section class="symptom-section paper-card" aria-labelledby="symptom-title">
      <div class="paper-card__inner section-grid">
        <header>
          <p class="section-label">你可能也遇過</p>
          <h2 id="symptom-title">AI 偶爾成功，不等於能拿來工作。</h2>
          <p>如果每次都要重新交代、重新檢查，甚至自己重做，那就不是「這次有沒有成功」的問題，而是這套做法還不能穩定工作。</p>
          <a class="text-action" href="/expertise/#workflow-check">從症狀開始檢查 <ArrowRight size={16} aria-hidden="true" /></a>
        </header>
        <ol class="symptom-list">
          {symptoms.map(([title, body], index) => (
            <li><span>0{index + 1}</span><div><h3>{title}</h3><p>{body}</p></div></li>
          ))}
        </ol>
      </div>
    </section>

    <section class="method-section" aria-labelledby="method-title">
      <header class="method-heading">
        <p class="section-label">先別急著堆更多規則</p>
        <h2 id="method-title">我通常先查三件事。</h2>
      </header>
      <div class="method-path">
        {methods.map((method, index) => (
          <article>
            <div class="method-path__marker"><span>0{index + 1}</span><method.icon size={21} aria-hidden="true" /></div>
            <div><p>{method.term}</p><h3>{method.title}</h3><p>{method.body}</p></div>
          </article>
        ))}
      </div>
      <p class="method-note">我不會一開始就猜是哪一層。拿你手上的工作案例跑一次，通常比繼續猜有效。</p>
    </section>

    <section class="fit-section paper-card" aria-label="適合與不適合的使用情境" data-content-state="testing">
      <div class="paper-card__inner fit-grid">
        <div class="fit-column fit-column--yes">
          <h2>如果你手上已經有一件真的工作，而且同一個問題一直重來，可以先從這裡開始。</h2>
          <ul>
            <li>你已經用 AI 處理真實工作，但同一件事仍常常要重做</li>
            <li>你想先找出問題在題目、資料、工具、狀態還是驗收</li>
            <li>你願意拿一個真實任務檢查，而不是只找新的工具名稱</li>
          </ul>
        </div>
        <div class="fit-column fit-column--no">
          <h2>這裡可能不適合你，如果</h2>
          <ul>
            <li>你只想拿一個保證有效的萬用 Prompt</li>
            <li>你目前沒有任何真實任務可以測試</li>
            <li>你期待 AI 自動完成所有判斷，也不需要人驗收結果</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="route-section paper-card" aria-labelledby="route-title">
      <div class="paper-card__inner">
        <header class="route-heading"><p class="section-label">從你的問題開始</p><h2 id="route-title">你可以自己查、自己學，也可以直接找我一起看。</h2></header>
        <div class="route-list">
          {routes.map((route) => (
            <article class:list={['route-item', route.primary && 'route-item--primary']}>
              <span>{route.order}</span>
              <div><h3>{route.title}</h3><p>{route.description}</p></div>
              <a class:list={['btn', route.primary ? 'btn-primary' : 'btn-ghost']} href={route.href}>{route.label} <ArrowRight size={16} aria-hidden="true" /></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* proof-slot: intentionally not rendered until a Claim Registry row is approved. */}

    <section class="identity-section paper-card" aria-labelledby="identity-title">
      <div class="paper-card__inner section-grid">
        <header><p class="section-label">我是 CabLate</p><h2 id="identity-title">執行愈來愈便宜，判斷反而更重要。</h2></header>
        <div><p>我原本做全端工程與系統設計，現在把大部分時間放在 AI 應用、Agent 與真實工作流程。我在意的不是 AI 能不能漂亮地示範一次，而是它進入工作之後能不能持續做對；出了問題，能不能查得到原因。</p><a class="text-action" href="/about/">看我的公開作品與工作方式 <ArrowRight size={16} aria-hidden="true" /></a></div>
      </div>
    </section>

    <section class="cabai-section paper-card paper-card--clip" aria-labelledby="cabai-title">
      <div class="paper-card__inner section-grid">
        <header><p class="section-label">CabAI 學習與交付平台</p><h2 id="cabai-title">課程、手冊、公開資源與免費試看，都放在同一個地方。</h2></header>
        <div><p>CabLate 幫你看懂問題與選路；CabAI 保存 Library、Skill、課程、已購內容、學習狀態與 Agent API。你可以先看免費內容，再決定是否需要購買。</p><a class="btn btn-primary" href={withCabAiAttribution(siteConfig.cabAi.homeUrl, 'home_cabai_delivery')} target="_blank" rel="noopener">前往 CabAI <ArrowRight size={17} aria-hidden="true" /></a></div>
      </div>
    </section>

    <section class="newsletter-card paper-card" aria-label="更新通知"><div class="paper-card__inner"><Newsletter /></div></section>
  </div>
</BaseLayout>

<style>
  .home-page { width: min(calc(100% - 2rem), 86rem); display: grid; gap: 1rem; margin-inline: auto; padding-block: 1rem 2rem; }
  .home-page h1, .home-page h2, .home-page h3 { text-wrap: balance; }
  .home-page p, .home-page li { text-wrap: pretty; }
  .home-hero { display: grid; grid-template-columns: minmax(0, .84fr) minmax(0, 1.16fr); align-items: center; gap: 1.35rem; }
  .home-hero__copy { position: relative; z-index: 2; margin-right: -2.5rem; }
  .home-hero__copy .paper-card__inner { padding: clamp(2.2rem, 4vw, 3.5rem); }
  .home-hero h1 { max-width: none; margin: 0; font-family: var(--font-serif); font-size: clamp(2.1rem, 3.2vw, 3.3rem); letter-spacing: -.055em; line-height: 1.16; }
  .home-hero h1 span { display: block; white-space: nowrap; }
  .home-hero__copy p:not(.section-label) { max-width: 37rem; margin: 1.35rem 0 0; color: var(--text-secondary); line-height: 1.85; }
  .hero-action { margin-top: 1.6rem; white-space: nowrap; }
  .section-grid { display: grid; grid-template-columns: minmax(0, .82fr) minmax(20rem, 1.18fr); gap: clamp(2rem, 6vw, 5rem); }
  .section-grid h2, .method-heading h2, .route-heading h2, .fit-column h2 { margin: 0; font-family: var(--font-serif); font-size: clamp(1.75rem, 3.2vw, 2.75rem); letter-spacing: -.035em; line-height: 1.35; }
  .section-grid header > p:not(.section-label), .section-grid > div > p { color: var(--text-secondary); line-height: 1.82; }
  .text-action { display: inline-flex; align-items: center; gap: .4rem; margin-top: 1rem; color: var(--accent-text); font-size: .88rem; font-weight: 700; text-decoration: underline; text-underline-offset: .24em; }
  .text-action:hover { color: var(--accent-hover); }
  .symptom-list { margin: 0; padding: 0; list-style: none; }
  .symptom-list li { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: 1rem; padding: 1.15rem 0; border-top: 1px solid var(--border); }
  .symptom-list li:first-child { padding-top: 0; border-top: 0; }
  .symptom-list > li > span { color: var(--accent); font-family: var(--font-mono); font-size: .72rem; }
  .symptom-list h3 { margin: 0; font-size: 1.08rem; }
  .symptom-list p { margin: .35rem 0 0; color: var(--text-secondary); font-size: .87rem; line-height: 1.7; }
  .method-section { padding: clamp(2.5rem, 6vw, 5rem); border: 1px solid var(--surface-dark-border); background: var(--surface-dark); color: var(--surface-dark-text); }
  .method-section :is(h2, h3) { color: var(--surface-dark-text); }
  .method-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; }
  .method-heading .section-label { color: var(--accent-bright); }
  .method-path { display: grid; margin-top: 2.5rem; border-top: 1px solid var(--surface-dark-border); }
  .method-path article { display: grid; grid-template-columns: 5rem minmax(0, 1fr); gap: 1.5rem; padding: 1.5rem 0; border-bottom: 1px solid var(--surface-dark-border); }
  .method-path__marker { display: flex; align-items: center; justify-content: space-between; color: var(--accent-bright); font-family: var(--font-mono); }
  .method-path article > div:last-child { display: grid; grid-template-columns: minmax(6rem, .45fr) minmax(8rem, .65fr) minmax(0, 1.5fr); gap: 1rem 2rem; align-items: baseline; }
  .method-path p { margin: 0; color: var(--surface-dark-muted); }
  .method-path h3 { margin: 0; font-size: 1.1rem; }
  .method-note { margin: 1.25rem 0 0; color: var(--surface-dark-text); font-weight: 700; }
  .fit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; padding: 0 !important; }
  .fit-column { padding: clamp(2rem, 5vw, 4rem); }
  .fit-column + .fit-column { border-left: 1px solid var(--border); background: rgb(241 237 255 / .44); }
  .fit-column h2 { font-size: clamp(1.35rem, 2.4vw, 2rem); }
  .fit-column ul { display: grid; gap: .85rem; margin: 1.5rem 0 0; padding: 0; list-style: none; }
  .fit-column li { position: relative; padding-left: 1.35rem; color: var(--text-secondary); }
  .fit-column li::before { position: absolute; left: 0; content: '・'; color: var(--accent); font-weight: 700; }
  .route-heading { max-width: 46rem; margin-bottom: 1.75rem; }
  .route-list { border-top: 1px solid var(--border-strong); }
  .route-item { display: grid; grid-template-columns: 3rem minmax(12rem, .8fr) minmax(16rem, 1.15fr) auto; gap: 1.25rem; align-items: center; padding: 1.35rem 0; border-bottom: 1px solid var(--border); }
  .route-item > span { color: var(--accent); font-family: var(--font-mono); font-size: .72rem; }
  .route-item h3, .route-item p { margin: 0; }
  .route-item p { color: var(--text-secondary); font-size: .85rem; line-height: 1.7; }
  .route-item .btn { min-width: 11rem; }
  .route-item--primary { margin-inline: -.75rem; padding-inline: .75rem; background: var(--accent-subtle); box-shadow: inset .22rem 0 var(--accent); }
  .identity-section h2 { max-width: 15ch; }
  .cabai-section { transform: rotate(-.15deg); }
  .cabai-section h2 { max-width: 17ch; }
  .cabai-section .btn { margin-top: 1rem; }
  @media (max-width: 980px) {
    .home-hero { grid-template-columns: 1fr 1fr; }
    .home-hero__copy { margin-right: -1rem; }
    .route-item { grid-template-columns: 2.5rem minmax(0, 1fr) auto; }
    .route-item > p { grid-column: 2 / 3; }
  }
  @media (max-width: 760px) {
    .home-page { gap: .75rem; padding-block: 0; }
    .home-hero, .section-grid, .fit-grid { grid-template-columns: 1fr; }
    .home-hero__copy { margin-right: 0; }
    .home-hero h1 { font-size: clamp(1.72rem, 8.4vw, 3rem); }
    .home-hero h1 span { white-space: normal; }
    .hero-action { width: 100%; white-space: normal; }
    .method-path article > div:last-child { grid-template-columns: 1fr; gap: .3rem; }
    .fit-column + .fit-column { border-top: 1px solid var(--border); border-left: 0; }
    .route-item { grid-template-columns: 2rem minmax(0, 1fr); }
    .route-item > p, .route-item .btn { grid-column: 2 / -1; }
    .route-item .btn { width: 100%; }
    .cabai-section { transform: none; }
  }
  @media (max-width: 390px) {
    .home-hero__copy .paper-card__inner, .method-section { padding: 1.5rem 1.2rem; }
    .method-path article { grid-template-columns: 3.5rem minmax(0, 1fr); gap: .75rem; }
    .method-path__marker { align-items: flex-start; }
  }
</style>
