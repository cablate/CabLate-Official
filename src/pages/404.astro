---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="找不到頁面" description="你要找的頁面不存在或已被移除。" noSEO={true}>
    <title slot="head">找不到頁面 | CabLate</title>
    <meta slot="head" name="robots" content="noindex, nofollow" />
    <section class="not-found">
        <div class="not-found-container">
            <h1>404</h1>
            <p class="not-found-message">你要找的頁面不存在，或已經被移除了。</p>
            <div class="not-found-links">
                <a href="/" class="not-found-btn">回首頁</a>
                <a href="/articles/" class="not-found-btn secondary">看文章</a>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .not-found {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 60vh;
        text-align: center;
        padding: 2rem;
    }

    .not-found-container {
        max-width: 480px;
    }

    .not-found h1 {
        font-family: 'Noto Serif TC', serif;
        font-size: 6rem;
        font-weight: 700;
        color: var(--accent, #8b5cf6);
        line-height: 1;
        margin-bottom: 1rem;
    }

    .not-found-message {
        font-size: 1.15rem;
        color: var(--text-secondary, #475569);
        margin-bottom: 2rem;
        line-height: 1.6;
    }

    .not-found-links {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .not-found-btn {
        display: inline-block;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 500;
        text-decoration: none;
        transition: opacity 0.2s;
        background: var(--accent, #8b5cf6);
        color: #ffffff;
    }

    .not-found-btn.secondary {
        background: transparent;
        border: 1px solid var(--border, #e2e8f0);
        color: var(--text-primary, #1e293b);
    }

    .not-found-btn:hover {
        opacity: 0.85;
    }
</style>
