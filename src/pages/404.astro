---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/siteConfig';

const reportHref = `mailto:${siteConfig.contactEmail}?subject=${encodeURIComponent('CabLate 失效連結')}`;
---

<BaseLayout title="找不到頁面" description="這個頁面目前不存在。" noSEO={true}>
  <title slot="head">找不到頁面 | CabLate</title>
  <meta slot="head" name="robots" content="noindex, follow" />
  <div class="not-found-page">
    <section class="not-found-card paper-card paper-card--clip" aria-labelledby="not-found-title">
      <div class="not-found-code" aria-hidden="true">404</div>
      <div class="paper-card__inner">
        <p class="section-label">找不到頁面</p>
        <h1 id="not-found-title">這一頁不見了</h1>
        <p>如果你是從舊的課程、商品或文章連結進來，內容可能搬家了或暫時下架。可以先回首頁看看，或告訴我是哪個連結壞了。</p>
        <a class="btn btn-primary" href="/">回首頁</a>
        <nav aria-label="其他選擇">
          <span>其他選擇：</span>
          <a href="/expertise/">免費 AI 健檢</a>
          <span aria-hidden="true">｜</span>
          <a href="/courses/">課程與手冊</a>
          <span aria-hidden="true">｜</span>
          <a href="/services/enterprise/">企業內訓</a>
          <span aria-hidden="true">｜</span>
          <a href={reportHref} data-broken-link-report>回報失效連結</a>
        </nav>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const initializeBrokenLinkReport = () => {
    const subject = encodeURIComponent('CabLate 失效連結');
    const body = encodeURIComponent(window.location.pathname);
    document.querySelectorAll<HTMLAnchorElement>('[data-broken-link-report]').forEach((link) => {
      const email = link.href.split('?')[0];
      link.href = `${email}?subject=${subject}&body=${body}`;
    });
  };
  initializeBrokenLinkReport();
  document.addEventListener('astro:page-load', initializeBrokenLinkReport);
</script>

<style>
  .not-found-page { width: min(100%, 70rem); margin-inline: auto; padding-block: 1rem 2rem; }
  .not-found-card { display: grid; grid-template-columns: minmax(8rem, .35fr) minmax(0, 1fr); }
  .not-found-code { display: grid; place-items: center; border-right: 1px solid var(--border); color: var(--accent-text); font-family: var(--font-mono); font-size: clamp(1.6rem, 3.5vw, 2.4rem); font-weight: 700; writing-mode: vertical-rl; letter-spacing: .2em; }
  .not-found-card .paper-card__inner { display: grid; align-content: center; justify-items: start; padding: clamp(1.75rem, 4vw, 3rem); }
  .not-found-card h1 { max-width: 12em; margin: 0; font-family: var(--font-serif); font-size: clamp(1.85rem, 3vw, 2.45rem); letter-spacing: -0.025em; line-height: 1.25; }
  .not-found-card p:not(.section-label) { max-width: 42rem; margin: 1rem 0; color: var(--text-secondary); font-size: 0.95rem; line-height: 1.75; }
  .not-found-card nav { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: 1.25rem; color: var(--text-muted); font-size: .88rem; }
  .not-found-card nav a { color: var(--accent-text); text-decoration: underline; text-underline-offset: .2em; }
  @media (max-width: 600px) {
    .not-found-page { padding-block: 0; }
    .not-found-card { grid-template-columns: 3rem minmax(0, 1fr); }
    .not-found-code { font-size: 1.2rem; }
    .not-found-card .paper-card__inner { padding: 1.75rem 1.15rem 2rem; }
    .not-found-card .btn { width: 100%; }
  }
</style>
