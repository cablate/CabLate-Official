---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="找不到頁面" description="你要找的頁面不存在或已被移除。" noSEO={true}>
    <title slot="head">找不到頁面 | CabLate</title>
    <meta slot="head" name="robots" content="noindex, nofollow" />
    <div class="not-found paper-page">
        <section class="not-found-container page-paper paper-card paper-card--clip">
            <p class="section-label">OPEN DESK / 404</p>
            <h1>404</h1>
            <p class="not-found-message">你要找的頁面不存在，或已經被移除了。</p>
            <div class="not-found-links">
                <a href="/" class="not-found-btn">回到首頁</a>
                {/* Articles inbound links paused. */}
            </div>
        </section>
    </div>
</BaseLayout>

<style>
    .not-found {
        width: min(100% - 2rem, 86rem);
        margin-inline: auto;
        padding-block: 1rem 1.5rem;
    }

    .not-found-container {
        display: grid;
        justify-items: center;
        min-height: min(60vh, 34rem);
        align-content: center;
        text-align: center;
    }

    .not-found h1 {
        font-family: 'Noto Serif TC', serif;
        font-size: clamp(4.5rem, 12vw, 8rem);
        font-weight: 700;
        color: var(--accent);
        line-height: 1;
        margin: 0 0 1rem;
    }

    .not-found-message {
        font-size: 1.15rem;
        max-width: 30rem;
        color: var(--text-secondary);
        margin: 0 0 2rem;
        line-height: 1.6;
    }

    .not-found-links {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .not-found-btn {
        display: inline-block;
        padding: 0.75rem 1.5rem;
        border-radius: 0;
        font-weight: 500;
        text-decoration: none;
        transition: opacity 0.2s;
        background: var(--text-primary);
        color: var(--bg);
    }

    .not-found-btn.secondary {
        background: transparent;
        border: 1px solid var(--border, #e2e8f0);
        color: var(--text-primary, #1e293b);
    }

    .not-found-btn:hover {
        background: var(--accent);
        opacity: 1;
    }
</style>
