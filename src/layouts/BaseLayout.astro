---
interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  noSEO?: boolean;
  noindex?: boolean;
  shell?: 'desk' | 'bare';
  analytics?: 'default' | 'disabled';
}

import { ClientRouter } from 'astro:transitions';
import SEO from '../components/SEO.astro';
import ArchiveNavigation from '../components/ArchiveNavigation.astro';
import AnalyticsHead from '../components/analytics/AnalyticsHead.astro';
import AnalyticsConsent from '../components/analytics/AnalyticsConsent.astro';
import { siteConfig, withCabAiAttribution } from '../config/siteConfig';

const {
  title,
  description = '關於 AI 工作流程、產品實作與交付判斷的研究與紀錄。',
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  noSEO = false,
  noindex = false,
  shell = 'desk',
  analytics = 'default',
} = Astro.props;
const seoTitle = title.includes('CabLate') ? title : `${title} | CabLate`;
const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script is:inline>
      (function () {
        function syncThemeOverride() {
          try {
            var saved = localStorage.getItem('cablate_theme');
            if (saved === 'dark' || saved === 'light') {
              document.documentElement.dataset.theme = saved;
              return;
            }
          } catch (_) {}
          delete document.documentElement.dataset.theme;
        }
        syncThemeOverride();
        document.addEventListener('astro:after-swap', syncThemeOverride);
      })();
    </script>
    {!noSEO && (
      <SEO
        title={seoTitle}
        description={description}
        image={image}
        imageAlt={imageAlt}
        imageWidth={imageWidth}
        imageHeight={imageHeight}
        noindex={noindex}
      />
    )}
    {/* noSEO 模式：title 由子 layout 透過 slot="head" 的 SEO 元件提供 */}
    <slot name="head" />
    <ClientRouter />
    <link rel="icon" type="image/webp" href="/favicon.webp">
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32">
    <link rel="alternate" type="application/rss+xml" title="CabLate 文章" href="/rss.xml">

    <!-- Google Search Console 驗證 -->
    <meta name="google-site-verification" content={siteConfig.gscVerification} />

    {analytics === 'default' && <AnalyticsHead ga4Id={siteConfig.ga4Id} />}
    {analytics === 'default' && (
      <script is:inline>
      (function() {
        // 只在文章頁面初始化
        if (!document.querySelector('.article-content')) {
          return;
        }

        const scrollThresholds = [25, 50, 75, 100];
        const trackedDepths = new Set();
        const articleElement = document.querySelector('.article-content');

        if (!articleElement) return;

        // 計算文章內容的實際高度（考慮文章開始位置）
        function getArticleScrollDepth() {
          const rect = articleElement.getBoundingClientRect();
          const scrollTop = window.scrollY || document.documentElement.scrollTop;
          const articleTop = rect.top + scrollTop;
          const articleBottom = articleTop + articleElement.offsetHeight;
          const viewportHeight = window.innerHeight;

          // 如果文章還沒進入視窗，深度為 0
          if (articleBottom < scrollTop) {
            return 0;
          }

          // 計算用戶在文章中的相對位置
          const userPosition = scrollTop + viewportHeight;
          const relativeScroll = userPosition - articleTop;
          const depth = Math.max(0, Math.min(100, (relativeScroll / articleElement.offsetHeight) * 100));

          return Math.floor(depth);
        }

        function handleScroll() {
          const currentDepth = getArticleScrollDepth();

          // 檢查是否達到任何未追蹤的里程碑
          scrollThresholds.forEach((threshold) => {
            if (currentDepth >= threshold && !trackedDepths.has(threshold)) {
              trackedDepths.add(threshold);
              window.cablateAnalytics?.track('article_scroll', { percent: threshold });
            }
          });
        }

        // 監聽滾動事件（使用節流以提高效能）
        let throttleTimer;
        window.addEventListener('scroll', () => {
          if (!throttleTimer) {
            throttleTimer = setTimeout(() => {
              handleScroll();
              throttleTimer = null;
            }, 100);
          }
        }, { passive: true });
      })();
      </script>
    )}

</head>
<body class:list={[`site-shell-${shell}`]}>
    <a href="#main-content" class="skip-link">跳到主要內容</a>

    {shell === 'desk' && <ArchiveNavigation />}

    <!-- Main Content -->
    <main id="main-content" tabindex="-1">
        <slot />
    </main>

    {shell === 'desk' && <footer class="footer" role="contentinfo">
        <div class="footer-inner">
          <div class="footer-statement">
            <a href="/" class="footer-brand">CabLate</a>
            <p>我是 Cab，工程師出身，現在研究 AI、寫課、做開源工具。AI 用到卡住、一直重做的時候，可以來找我一起看。</p>
          </div>
          <div class="footer-links">
            <nav aria-label="內容與服務">
              <strong>探索</strong>
              <a href="/expertise/">免費健檢</a><a href="/courses/">課程與手冊</a><a href="/articles/">文章</a><a href="/services/">合作方式</a><a href="/newsletter/">電子報</a><a href="/about/#public-output-title">作品與經歷</a><a href="/about/">關於</a>
            </nav>
            <nav aria-label="外部連結">
              <strong>連結</strong>
              <a href={withCabAiAttribution(siteConfig.cabAi.homeUrl, 'site_navigation')} target="_blank" rel="noopener">CabAI 學習平台</a><a href={`mailto:${siteConfig.contactEmail}`}>Email</a><a href={siteConfig.threadsUrl} target="_blank" rel="noopener">Threads</a><a href={siteConfig.githubUrl} target="_blank" rel="noopener">GitHub</a><a href="/rss.xml">RSS</a>
            </nav>
          </div>
          <div class="footer-meta"><p>&copy; {currentYear} CabLate</p><a href="/privacy/">隱私權政策</a>{analytics === 'default' && <button type="button" data-analytics-settings>分析設定</button>}</div>
        </div>
    </footer>}

    {analytics === 'default' && <AnalyticsConsent />}

    {analytics === 'default' && (
      <script is:inline>
        document.addEventListener('click', (event) => {
          const button = event.target.closest?.('[data-analytics-settings]');
          if (button) window.cablateAnalytics?.openPreferences();
        });
      </script>
    )}
</body>
</html>

<style is:global>
    /* Phase 1: 模組化 CSS 載入順序 */
    @import '../styles/base.css';       /* CSS Variables + Reset + Typography */
    @import '../styles/utilities.css';  /* Layout + Section + Reveal */
    @import '../styles/global.css';     /* 元件樣式（待 Phase 2 遷移） */

    /* Accessibility: Skip Link */
    .skip-link {
      position: absolute;
      top: -100%;
      left: 0;
      z-index: 9999;
      padding: 0.75rem 1.5rem;
      background: var(--accent);
      color: #fff;
      font-size: 0.9rem;
      text-decoration: none;
      border-radius: 0 0 var(--radius-sm) 0;
    }
    .skip-link:focus-visible {
       top: 0;
     }

    .footer-meta button {
      padding: 0;
      border: 0;
      background: transparent;
      color: inherit;
      font: inherit;
      text-decoration: underline;
      text-underline-offset: .18em;
      cursor: pointer;
    }

    /* Accessibility: Focus Visible */
    :focus-visible {
      outline: 2px solid var(--accent, #6d28d9);
      outline-offset: 2px;
    }
</style>
