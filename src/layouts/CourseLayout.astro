---
/**
 * Course Layout - 課程佈局
 */

import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import SEO from '../components/SEO.astro';

interface Props {
  entry: CollectionEntry<'courses'>;
  headings: MarkdownHeading[];
}

const { entry, headings } = Astro.props;
const { Content } = await entry.render();

// 格式化價格
const formatPrice = (price: number) => {
  if (price === 0) return '免費';
  return `NT$ ${price.toLocaleString()}`;
};

// 狀態對應
const statusMap = {
  'pre-sale': '预售中',
  'active': '開放報名',
  'archived': '已結束'
};
---

<BaseLayout title={entry.data.title} noSEO={true}>
  <SEO
    title={`${entry.data.title} | 課程 | CabLate`}
    description={entry.data.description}
    image={entry.data.ogImage}
    type="article"
    publishDate={entry.data.publishDate}
    tags={entry.data.tags}
  />

  <article class="course-container section section-light">
    <div class="container">
      <!-- 課程標頭 -->
      <header class="course-header reveal">
        <div class="course-badges">
          <span class="course-badge level-badge">{entry.data.level}</span>
          {entry.data.status !== 'draft' && (
            <span class={`course-badge status-badge status-${entry.data.status}`}>
              {statusMap[entry.data.status]}
            </span>
          )}
        </div>

        <h1 class="course-title">{entry.data.title}</h1>

        <p class="course-description">{entry.data.description}</p>

        <div class="course-meta">
          <div class="meta-item">
            <span class="meta-label">價格</span>
            <span class="meta-value price">{formatPrice(entry.data.price)}</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">時長</span>
            <span class="meta-value">{entry.data.duration}</span>
          </div>
          {entry.data.tags.length > 0 && (
            <div class="meta-item tags">
              {entry.data.tags.map(tag => (
                <span class="tag">#{tag}</span>
              ))}
            </div>
          )}
        </div>
      </header>

      <!-- 課程內容 -->
      <div class="course-content reveal">
        <Content />
      </div>

      <!-- CTA -->
      {entry.data.status === 'active' && (
        <div class="course-cta reveal">
          <a href="#contact" class="btn btn-primary btn-large">
            立即報名 →
          </a>
        </div>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .course-container {
    padding: 2rem 0 4rem;
    color: var(--text-primary);
  }

  .course-header {
    max-width: 800px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .course-badges {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .course-badge {
    padding: 0.4rem 1rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .level-badge {
    background: var(--accent-subtle);
    border: 1px solid var(--accent-border);
    color: var(--accent);
  }

  .status-badge {
    background: #fffbeb;
    border: 1px solid #fde68a;
    color: #d97706;
  }

  .status-active {
    background: #f0fdf4;
    border-color: #bbf7d0;
    color: #16a34a;
  }

  .course-title {
    font-family: 'Noto Serif TC', serif;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .course-description {
    font-size: 1.2rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .course-meta {
    display: flex;
    justify-content: center;
    gap: 2rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .meta-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .meta-value {
    font-size: 1.1rem;
    color: var(--text-primary);
    font-weight: 600;
  }

  .meta-value.price {
    color: var(--accent);
    font-size: 1.5rem;
  }

  .meta-item.tags {
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
  }

  .tag {
    padding: 0.25rem 0.75rem;
    background: var(--accent-subtle);
    border: 1px solid var(--accent-border);
    border-radius: 20px;
    font-size: 0.8rem;
    color: var(--accent);
  }

  .course-content {
    max-width: 720px;
    margin: 0 auto 3rem;
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--text-primary);
  }

  .course-content :global(p) {
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    color: var(--text-secondary);
  }

  /* 連續段落增加額外間距 */
  .course-content :global(p + p) {
    margin-top: 1.5rem;
  }

  .course-content :global(h2) {
    font-family: 'Noto Serif TC', serif;
    font-size: 1.8rem;
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .course-content :global(h3) {
    font-size: 1.4rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .course-content :global(ul),
  .course-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 2rem;
    color: var(--text-secondary);
  }

  .course-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .course-content :global(code) {
    padding: 0.2rem 0.4rem;
    background: var(--accent-subtle);
    border-radius: 4px;
    font-family: 'Consolas', monospace;
    font-size: 0.9em;
    color: var(--accent);
  }

  .course-content :global(pre) {
    padding: 1.5rem;
    background: var(--bg-muted) !important;
    border-radius: 8px;
    overflow-x: auto;
    margin-bottom: 1.5rem;
    border: 1px solid var(--border);
  }

  .course-content :global(pre code) {
    background: transparent;
    padding: 0;
    color: var(--text-primary);
  }

  .course-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
  }

  .course-content :global(a:hover) {
    color: var(--accent-light);
  }

  .course-cta {
    text-align: center;
    padding: 2rem 0;
  }

  .btn-large {
    padding: 1rem 2.5rem;
    font-size: 1.1rem;
  }

  @media (max-width: 768px) {
    .course-container {
      padding: 2rem 0;
    }

    .course-header,
    .course-content {
      padding: 0 1rem;
    }

    .course-meta {
      flex-direction: column;
      gap: 1rem;
    }

    .meta-item.tags {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }
</style>
