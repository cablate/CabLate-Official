---
/**
 * Course Layout - 課程銷售頁佈局
 *
 * 結構（上到下）：
 * 1. Header（badge + title + description + meta）
 * 2. CTA（checkoutUrl → shop 站 / pre-sale → Threads）
 * 3. Features（課程包含什麼）
 * 4. Target Audience（適合誰 / 不適合誰）
 * 5. Markdown Content（.md body）
 * 6. Testimonials（學員見證）
 * 7. FAQ（結構化 FAQ）
 * 8. 底部 CTA（重複頂部，長頁面需要）
 */

import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import SEO from '../components/SEO.astro';
import {
  type CourseStatus,
  getStatusLabel,
  getStatusBadgeClass,
  getCourseCtaConfig,
  formatPrice,
} from '../config/courseDisplay';

interface Props {
  entry: CollectionEntry<'courses'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { data } = entry;

// Centralized display logic
const status = data.status as CourseStatus;
const cta = getCourseCtaConfig(status, data.checkoutUrl);

// 區塊顯示判斷
const hasFeatures = data.features && data.features.length > 0;
const hasTargetAudience = data.targetAudience && data.targetAudience.length > 0;
const hasNotFor = data.notFor && data.notFor.length > 0;
const hasTestimonials = data.testimonials && data.testimonials.length > 0;
const hasFaq = data.faq && data.faq.length > 0;
---

<BaseLayout title={data.title} noSEO={true}>
  <SEO
    title={`${data.title} | 課程 | CabLate`}
    description={data.description}
    image={data.ogImage}
    type="course"
    publishDate={data.publishDate}
    tags={data.tags}
    coursePrice={data.price}
    courseDuration={data.duration}
    courseStatus={status}
    checkoutUrl={data.checkoutUrl}
    faq={data.faq}
  />

  <article class="course-container section section-light">
    <div class="container">

      <!-- 1. 課程標頭 -->
      <header class="course-header reveal">
        <div class="course-badges">
          <span class="badge badge-accent">{data.level}</span>
          {status !== 'draft' && (
            <span class={`badge ${getStatusBadgeClass(status)}`}>
              {getStatusLabel(status)}
            </span>
          )}
        </div>

        <h1 class="course-title">{data.title}</h1>
        <p class="course-description">{data.description}</p>

        <div class="course-meta">
          <div class="meta-item">
            <span class="meta-label">價格</span>
            <span class="meta-value price">{formatPrice(data.price)}</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">時長</span>
            <span class="meta-value">{data.duration}</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">難度</span>
            <span class="meta-value">{data.level}</span>
          </div>
        </div>
      </header>

      <!-- 2. 頂部 CTA -->
      {cta.show && (
        <div class="course-cta reveal">
          <a
            href={cta.href}
            class="btn btn-primary btn-large"
            {...(cta.isExternal ? { target: '_blank', rel: 'noopener' } : {})}
          >
            {cta.text} &rarr;
          </a>
          {cta.hint && (
            <p class="cta-hint">{cta.hint}</p>
          )}
        </div>
      )}

      <!-- 3. Features（課程包含什麼）-->
      {hasFeatures && (
        <section class="course-section reveal">
          <h2 class="section-heading">這堂課包含什麼</h2>
          <ul class="feature-list">
            {data.features.map((feature: string) => (
              <li class="feature-item">
                <span class="feature-check" aria-hidden="true">&#10003;</span>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- 4. Target Audience（適合誰 / 不適合誰）-->
      {(hasTargetAudience || hasNotFor) && (
        <section class="course-section reveal">
          <h2 class="section-heading">這堂課適合你嗎</h2>
          <div class="audience-grid">
            {hasTargetAudience && (
              <div class="audience-card audience-yes">
                <h3 class="audience-label">適合你，如果你是...</h3>
                <ul class="audience-list">
                  {data.targetAudience.map((item: string) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            )}
            {hasNotFor && (
              <div class="audience-card audience-no">
                <h3 class="audience-label">可能不適合，如果你...</h3>
                <ul class="audience-list">
                  {data.notFor.map((item: string) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </section>
      )}

      <!-- 5. Markdown Content -->
      <div class="course-content reveal">
        <Content />
      </div>

      <!-- 6. Testimonials（學員見證）-->
      {hasTestimonials && (
        <section class="course-section reveal">
          <h2 class="section-heading">學員怎麼說</h2>
          <div class="testimonials-grid">
            {data.testimonials?.map((t: { name: string; role: string; quote: string }) => (
              <blockquote class="testimonial-card">
                <p class="testimonial-quote">&ldquo;{t.quote}&rdquo;</p>
                <footer class="testimonial-author">
                  <span class="testimonial-name">{t.name}</span>
                  <span class="testimonial-role">{t.role}</span>
                </footer>
              </blockquote>
            ))}
          </div>
        </section>
      )}

      <!-- 7. FAQ -->
      {hasFaq && (
        <section class="course-section reveal">
          <h2 class="section-heading">常見問題</h2>
          <div class="faq-list">
            {data.faq?.map((item: { question: string; answer: string }) => (
              <details class="faq-item">
                <summary class="faq-question">{item.question}</summary>
                <p class="faq-answer">{item.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <!-- 8. 底部 CTA -->
      {cta.show && (
        <div class="course-cta course-cta-bottom reveal">
          <p class="cta-closing">準備好了嗎？</p>
          <a
            href={cta.href}
            class="btn btn-primary btn-large"
            {...(cta.isExternal ? { target: '_blank', rel: 'noopener' } : {})}
          >
            {cta.text} &rarr;
          </a>
        </div>
      )}

    </div>
  </article>
</BaseLayout>

<style>
  /* ═══════════════════════════════════════════════════════════
     LAYOUT
     ═══════════════════════════════════════════════════════════ */

  .course-container {
    padding: 2rem 0 4rem;
    color: var(--text-primary);
  }

  /* ═══════════════════════════════════════════════════════════
     HEADER
     ═══════════════════════════════════════════════════════════ */

  .course-header {
    max-width: 800px;
    margin: 0 auto 2rem;
    text-align: center;
  }

  .course-badges {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .course-title {
    font-family: 'Noto Serif TC', serif;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .course-description {
    font-size: 1.2rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 65ch;
    margin-left: auto;
    margin-right: auto;
  }

  .course-meta {
    display: flex;
    justify-content: center;
    gap: 2rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .meta-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .meta-value {
    font-size: 1.1rem;
    color: var(--text-primary);
    font-weight: 600;
  }

  .meta-value.price {
    color: var(--accent);
    font-size: 1.5rem;
  }

  /* ═══════════════════════════════════════════════════════════
     CTA
     ═══════════════════════════════════════════════════════════ */

  .course-cta {
    text-align: center;
    padding: 2rem 0;
  }

  .course-cta-bottom {
    margin-top: 2rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border);
  }

  .cta-hint {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .cta-closing {
    font-family: 'Noto Serif TC', serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
  }

  .btn-large {
    padding: 1rem 2.5rem;
    font-size: 1.1rem;
  }

  /* ═══════════════════════════════════════════════════════════
     SECTIONS（共用）
     ═══════════════════════════════════════════════════════════ */

  .course-section {
    max-width: 800px;
    margin: 0 auto 3rem;
  }

  .section-heading {
    font-family: 'Noto Serif TC', serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    text-align: center;
  }

  /* ═══════════════════════════════════════════════════════════
     FEATURES
     ═══════════════════════════════════════════════════════════ */

  .feature-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .feature-check {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--status-success-bg);
    border: 1px solid var(--status-success-border);
    border-radius: 50%;
    font-size: 0.65rem;
    color: var(--status-success);
    font-weight: 700;
    margin-top: 0.1rem;
  }

  /* ═══════════════════════════════════════════════════════════
     AUDIENCE
     ═══════════════════════════════════════════════════════════ */

  .audience-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .audience-card {
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid var(--border);
  }

  .audience-yes {
    background: var(--status-success-bg);
    border-color: var(--status-success-border);
  }

  .audience-no {
    background: var(--status-error-bg);
    border-color: var(--status-error-border);
  }

  .audience-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .audience-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .audience-list li {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
    padding-left: 1.25rem;
    position: relative;
  }

  .audience-yes .audience-list li::before {
    content: '\2713';
    position: absolute;
    left: 0;
    color: var(--status-success);
    font-weight: 700;
  }

  .audience-no .audience-list li::before {
    content: '\2717';
    position: absolute;
    left: 0;
    color: var(--status-error);
    font-weight: 700;
  }

  /* ═══════════════════════════════════════════════════════════
     MARKDOWN CONTENT
     ═══════════════════════════════════════════════════════════ */

  .course-content {
    max-width: 720px;
    margin: 0 auto 3rem;
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--text-primary);
  }

  .course-content :global(p) {
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    color: var(--text-secondary);
  }

  .course-content :global(p + p) {
    margin-top: 1.5rem;
  }

  .course-content :global(h2) {
    font-family: 'Noto Serif TC', serif;
    font-size: 1.8rem;
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .course-content :global(h3) {
    font-size: 1.4rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .course-content :global(ul),
  .course-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 2rem;
    color: var(--text-secondary);
  }

  .course-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .course-content :global(code) {
    padding: 0.2rem 0.4rem;
    background: var(--accent-subtle);
    border-radius: 4px;
    font-family: 'Consolas', monospace;
    font-size: 0.9em;
    color: var(--accent);
  }

  .course-content :global(pre) {
    padding: 1.5rem;
    background: var(--bg-muted) !important;
    border-radius: 8px;
    overflow-x: auto;
    margin-bottom: 1.5rem;
    border: 1px solid var(--border);
  }

  .course-content :global(pre code) {
    background: transparent;
    padding: 0;
    color: var(--text-primary);
  }

  .course-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
  }

  .course-content :global(a:hover) {
    color: var(--accent-light);
  }

  /* ═══════════════════════════════════════════════════════════
     TESTIMONIALS
     ═══════════════════════════════════════════════════════════ */

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .testimonial-card {
    padding: 1.5rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    margin: 0;
  }

  .testimonial-quote {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1rem;
    font-style: italic;
  }

  .testimonial-author {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .testimonial-name {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .testimonial-role {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  /* ═══════════════════════════════════════════════════════════
     FAQ
     ═══════════════════════════════════════════════════════════ */

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .faq-item {
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .faq-item[open] {
    border-color: var(--accent-border);
  }

  .faq-question {
    padding: 1.25rem 1.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::after {
    content: '+';
    font-size: 1.25rem;
    font-weight: 300;
    color: var(--text-muted);
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .faq-item[open] .faq-question::after {
    transform: rotate(45deg);
  }

  .faq-answer {
    padding: 0 1.5rem 1.25rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* ═══════════════════════════════════════════════════════════
     MOBILE
     MOBILE
     ═══════════════════════════════════════════════════════════ */

  @media (max-width: 768px) {
    .course-container {
      padding: 2rem 0;
    }

    .course-header,
    .course-content,
    .course-section {
      padding: 0 1rem;
    }

    .course-meta {
      flex-direction: column;
      gap: 1rem;
    }

    .audience-grid {
      grid-template-columns: 1fr;
    }

    .feature-list {
      grid-template-columns: 1fr;
    }

    .testimonials-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
