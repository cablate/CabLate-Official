---
/**
 * Article Layout - 文章佈局
 */

import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import SEO from '../components/SEO.astro';
import ArticleNav from '../components/ArticleNav.astro';
import ArticleEnd from '../components/ArticleEnd.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { formatDate } from '../utils/format';

interface Props {
  entry: CollectionEntry<'articles'>;
  headings: MarkdownHeading[];
}

const { entry, headings } = Astro.props;
const { Content } = await entry.render();

// BreadcrumbList 結構化資料
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://cablate.com/' },
    { '@type': 'ListItem', position: 2, name: '文章', item: 'https://cablate.com/articles/' },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: `https://cablate.com/articles/${entry.slug}/` }
  ]
};
---

<BaseLayout title={entry.data.title} noSEO={true}>
  <SEO
    slot="head"
    title={`${entry.data.title} | CabLate`}
    description={entry.data.description}
    image={`/og/${entry.slug}.png`}
    imageAlt={entry.data.title}
    imageWidth={1200}
    imageHeight={630}
    type="article"
    publishDate={entry.data.publishDate}
    modifiedDate={entry.data.updatedDate}
    tags={entry.data.tags}
  />
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />

  <nav class="breadcrumb" aria-label="麵包屑導覽">
    <ol>
      <li><a href="/">首頁</a></li>
      <li><a href="/articles/">文章</a></li>
      <li aria-current="page">{entry.data.title}</li>
    </ol>
  </nav>

  <article class="article-container section section-light">
    <div class="container">
      <!-- 文章標頭 -->
      <header class="article-header">
        <div class="article-meta">
          <span class="article-category">{entry.data.category}</span>
          <time class="article-date" datetime={entry.data.publishDate.toISOString()}>
            {formatDate(entry.data.publishDate)}
          </time>
          {entry.data.updatedDate && (
            <span class="article-updated">
              更新於 {formatDate(entry.data.updatedDate)}
            </span>
          )}
          {entry.data.readingTime && (
            <span class="article-reading-time">{entry.data.readingTime} 分鐘閱讀</span>
          )}
        </div>

        <h1 class="article-title">{entry.data.title}</h1>

        {entry.data.excerpt && (
          <p class="article-excerpt">{entry.data.excerpt}</p>
        )}
      </header>

      <!-- 封面圖 -->
      {entry.data.ogImage && (
        <figure class="article-banner">
          <img src={entry.data.ogImage} alt="" width="1200" height="630" loading="eager" fetchpriority="high" />
        </figure>
      )}

      <!-- 文章內容 + TOC sidebar -->
      <div class="article-body-layout">
        <div class="article-body-main">
          <div class="article-content">
            <Content />
          </div>

          <ArticleEnd />
          <ArticleNav currentSlug={entry.slug} />
        </div>

        <aside class="article-toc-sidebar">
          <TableOfContents headings={headings} />
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  :global(html) {
    scroll-padding-top: 6rem;
  }

  .breadcrumb {
    max-width: 900px;
    margin: 0 auto;
    padding: 1rem 1rem 0;
  }

  .breadcrumb ol {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .breadcrumb li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: var(--border);
  }

  .breadcrumb li:last-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: min(300px, 60vw);
  }

  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--text-secondary);
  }

  .article-container {
    padding: 1rem 0;
    color: var(--text-primary, #1a1a2e);
  }

  .article-container > .container {
    width: min(100%, 82rem);
    margin-inline: auto;
    padding: clamp(1.5rem, 4vw, 3.5rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: rgb(255 253 248 / .96);
    box-shadow: var(--shadow-sm);
  }

  .article-header {
    max-width: 900px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: .35rem 1rem;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    color: var(--text-muted, #94a3b8);
  }

  .article-category {
    color: var(--accent, #6d28d9);
    font-weight: 600;
  }

  .article-updated {
    font-size: 0.85rem;
    color: var(--text-muted, #94a3b8);
  }

  .article-reading-time {
    font-size: 0.9rem;
    color: var(--text-muted, #94a3b8);
  }

  .article-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 1.5rem;
    color: var(--text-primary, #1a1a2e);
  }

  .article-excerpt {
    font-size: 1.2rem;
    color: var(--text-secondary, #64748b);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  .article-banner {
    max-width: 900px;
    margin: 0 auto 3rem;
    padding: 0 1rem;
  }

  .article-banner img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--border, #e2e8f0);
  }

  /* TOC sidebar layout */
  .article-body-layout {
    --article-measure: 42rem;
    display: grid;
    grid-template-columns: 1fr 220px;
    gap: 2rem;
    max-width: 1100px;
    margin: 0 auto;
    align-items: start;
  }

  .article-body-main {
    min-width: 0; /* prevent grid blowout */
    max-width: var(--article-measure);
    margin-inline: auto;
  }

  .article-toc-sidebar {
    display: block;
  }

  @media (max-width: 1024px) {
    .article-body-layout {
      grid-template-columns: 1fr;
    }

    .article-toc-sidebar {
      display: none;
    }
  }

  .article-content {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--text-primary);
  }

  .article-content :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    color: var(--text-primary, #1a1a2e);
  }

  .article-content :global(h3) {
    font-size: 1.4rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--text-primary, #1a1a2e);
  }

  .article-content :global(p) {
    margin: 0 0 1.5rem;
  }

  .article-content :global(strong) {
    color: var(--text-primary, #1a1a2e);
    font-weight: 600;
  }

  .article-content :global(code) {
    padding: 0.2rem 0.4rem;
    background: var(--accent-subtle, #f5f3ff);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--accent, #6d28d9);
  }

  .article-content :global(pre) {
    padding: 1.5rem;
    background: var(--bg-muted, #f1f5f9) !important;
    border-radius: var(--radius-sm);
    overflow-x: auto;
    max-width: 100%;
    margin-bottom: 1.5rem;
    border: 1px solid var(--border, #e2e8f0);
  }

  .article-content :global(pre code) {
    background: transparent;
    padding: 0;
    color: var(--text-primary, #1a1a2e);
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .article-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .article-content :global(a) {
    color: var(--accent, #6d28d9);
    text-decoration: underline;
  }

  .article-content :global(a:hover) {
    color: var(--accent-light, #8b5cf6);
  }

  .article-content :global(table) {
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-collapse: collapse;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .article-content :global(th) {
    background: var(--bg-muted, #f1f5f9);
    padding: 0.75rem 1rem;
    text-align: left;
    font-weight: 600;
    color: var(--text-primary, #1a1a2e);
    border-bottom: 2px solid var(--border, #e2e8f0);
  }

  .article-content :global(td) {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border, #e2e8f0);
    color: var(--text-secondary, #64748b);
  }

  .article-content :global(hr) {
    border: none;
    height: 1px;
    background: var(--border, #e2e8f0);
    margin: 3rem 0;
  }

  .article-content :global(blockquote) {
    border-left: 3px solid var(--accent, #6d28d9);
    padding-left: 1.5rem;
    margin: 1.5rem 0;
    color: var(--text-secondary);
  }

  .article-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    margin: 2rem auto;
    display: block;
  }

  .article-content :global(figure) {
    margin: 2rem 0;
    text-align: center;
  }

  .article-content :global(figure img) {
    margin: 0 auto 0.75rem;
  }

  .article-content :global(figcaption) {
    font-size: 0.85rem;
    color: var(--text-muted, #94a3b8);
    line-height: 1.5;
  }
  @media (max-width: 768px) {
    .breadcrumb {
      padding: .25rem .75rem 0;
    }

    .article-container {
      padding: .75rem 0;
    }

    .article-container .container {
      padding: 1.25rem;
    }

    .article-header {
      padding: 0;
      margin-bottom: 2rem;
    }

    .article-meta {
      justify-content: flex-start;
      gap: .25rem .9rem;
      margin-bottom: 1rem;
    }

    .article-title {
      font-size: clamp(1.5rem, 6vw, 2rem);
      text-align: left;
    }

    .article-excerpt {
      font-size: 1rem;
      text-align: left;
    }
    .article-banner {
      margin-bottom: 2rem;
      padding: 0;
    }

    .article-content {
      font-size: 1.0625rem;
    }

    .article-content :global(h2) {
      font-size: 1.4rem;
      margin-top: 2.5rem;
      margin-bottom: 1rem;
    }

    .article-content :global(h3) {
      font-size: 1.15rem;
      margin-top: 1.5rem;
    }

    .article-content :global(p) {
      margin-bottom: 1.25rem;
    }

    .article-content :global(pre) {
      padding: 1rem;
      font-size: 0.8rem;
      margin-left: -0.75rem;
      margin-right: -0.75rem;
      border-radius: 0;
      border-left: none;
      border-right: none;
    }

    .article-content :global(table) {
      font-size: 0.85rem;
    }

    .article-content :global(th),
    .article-content :global(td) {
      padding: 0.5rem 0.75rem;
    }

    .article-content :global(code) {
      font-size: 0.85em;
      word-break: break-all;
    }

    .article-content :global(pre code) {
      word-break: normal;
    }

    .article-content :global(hr) {
      margin: 2rem 0;
    }

    .article-content :global(img) {
      margin: 1.5rem auto;
      border-radius: 6px;
    }
  }
</style>
