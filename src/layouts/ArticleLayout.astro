---
/**
 * Article Layout - 文章佈局
 */

import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import SEO from '../components/SEO.astro';
import ArticleNav from '../components/ArticleNav.astro';
import ArticleEnd from '../components/ArticleEnd.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { formatDate } from '../utils/format';

interface Props {
  entry: CollectionEntry<'articles'>;
  headings: MarkdownHeading[];
}

const { entry, headings } = Astro.props;
const { Content } = await entry.render();
const h2Headings = headings.filter((h) => h.depth === 2);

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://cablate.com/' },
    { '@type': 'ListItem', position: 2, name: '文章', item: 'https://cablate.com/articles/' },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: `https://cablate.com/articles/${entry.slug}/` }
  ]
};
---

<BaseLayout title={entry.data.title} noSEO={true}>
  <SEO
    slot="head"
    title={`${entry.data.title} | CabLate`}
    description={entry.data.description}
    image={`/og/${entry.slug}.png`}
    imageAlt={entry.data.title}
    imageWidth={1200}
    imageHeight={630}
    type="article"
    publishDate={entry.data.publishDate}
    modifiedDate={entry.data.updatedDate}
    tags={entry.data.tags}
  />
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />

  <div class="article-page paper-page">
    <article class="article-container page-paper">
      <div class="article-shell">
        <nav class="breadcrumb" aria-label="麵包屑導覽">
          <ol>
            <li><a href="/">首頁</a></li>
            <li><a href="/articles/">文章</a></li>
            <li aria-current="page">{entry.data.title}</li>
          </ol>
        </nav>

        <header class="article-header">
          <div class="article-meta">
            <span class="article-category">{entry.data.category}</span>
            <time class="article-date" datetime={entry.data.publishDate.toISOString()}>
              {formatDate(entry.data.publishDate)}
            </time>
            {entry.data.updatedDate && (
              <span class="article-updated">
                更新於 {formatDate(entry.data.updatedDate)}
              </span>
            )}
            {entry.data.readingTime && (
              <span class="article-reading-time">{entry.data.readingTime} 分鐘閱讀</span>
            )}
          </div>

          <h1 class="article-title">{entry.data.title}</h1>

          {entry.data.excerpt && (
            <p class="article-excerpt">{entry.data.excerpt}</p>
          )}
        </header>

        {entry.data.ogImage && (
          <figure class="article-banner">
            <img src={entry.data.ogImage} alt="" width="1200" height="630" loading="eager" fetchpriority="high" />
          </figure>
        )}

        <div class="article-body-layout">
          <div class="article-body-main">
            {h2Headings.length >= 2 && (
              <details class="article-toc-mobile">
                <summary>這篇的段落（{h2Headings.length}）</summary>
                <ol>
                  {h2Headings.map((h) => (
                    <li><a href={`#${h.slug}`}>{h.text}</a></li>
                  ))}
                </ol>
              </details>
            )}

            <div class="article-content">
              <Content />
            </div>

            <ArticleEnd />
            <ArticleNav currentSlug={entry.slug} />
          </div>

          <aside class="article-toc-sidebar">
            <TableOfContents headings={headings} />
          </aside>
        </div>
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  :global(html) {
    scroll-padding-top: 3rem;
  }

  .article-page > .article-container {
    background-color: var(--bg-soft) !important;
    background-image: none !important;
    border: 1px solid var(--border-strong) !important;
    border-radius: var(--radius-sm) !important;
    box-shadow: var(--shadow-sm) !important;
  }

  .article-shell {
    max-width: 66rem;
    margin-inline: auto;
  }

  .breadcrumb {
    padding-bottom: 1.15rem;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
    border-bottom: 1px solid var(--border);
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .breadcrumb li + li::before {
    content: '/';
    margin-right: 0.45rem;
    color: var(--border-strong);
  }

  .breadcrumb li:last-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: min(26rem, 65vw);
  }

  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--text-primary);
  }

  .article-header {
    max-width: 48rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin-bottom: 1rem;
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .article-category {
    color: var(--accent-text);
    font-weight: 700;
  }

  .article-updated,
  .article-reading-time {
    font-size: 0.86rem;
    color: var(--text-muted);
  }

  .article-title {
    font-family: var(--font-serif);
    font-size: clamp(1.85rem, 4.2vw, 2.75rem);
    font-weight: 700;
    line-height: 1.32;
    margin: 0 0 1.25rem;
    color: var(--text-primary);
    text-wrap: pretty;
  }

  .article-excerpt {
    font-size: 1.12rem;
    color: var(--text-secondary);
    line-height: 1.75;
    margin: 0;
    padding-left: 1rem;
    border-left: 2px solid var(--border-strong);
  }

  .article-banner {
    margin: 0 0 clamp(2.25rem, 4vw, 3.25rem);
  }

  .article-banner img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
  }

  .article-body-layout {
    --article-measure: 42rem;
    display: grid;
    grid-template-columns: minmax(0, var(--article-measure)) 13.5rem;
    justify-content: space-between;
    gap: 2.5rem;
    align-items: start;
  }

  .article-body-main {
    min-width: 0;
    max-width: var(--article-measure);
  }

  .article-toc-sidebar {
    display: block;
  }

  .article-toc-mobile {
    display: none;
    margin: 0 0 2rem;
    padding: 0.9rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: rgb(255 253 248 / 0.7);
  }

  .article-toc-mobile summary {
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .article-toc-mobile ol {
    margin: 0.75rem 0 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.4rem;
    font-size: 0.88rem;
  }

  .article-toc-mobile a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .article-toc-mobile a:hover {
    color: var(--accent-text);
  }

  @media (max-width: 1024px) {
    .article-body-layout {
      grid-template-columns: 1fr;
    }

    .article-toc-sidebar {
      display: none;
    }

    .article-toc-mobile {
      display: block;
    }
  }

  .article-content {
    font-size: 1.1rem;
    line-height: 1.85;
    color: var(--text-primary);
  }

  .article-content :global(h2) {
    font-family: var(--font-serif);
    font-size: clamp(1.45rem, 2.6vw, 1.75rem);
    line-height: 1.38;
    margin-top: 3rem;
    margin-bottom: 1.15rem;
    color: var(--text-primary);
  }

  .article-content :global(hr + h2) {
    margin-top: 0;
  }

  .article-content :global(h3) {
    font-size: clamp(1.18rem, 2vw, 1.35rem);
    line-height: 1.45;
    margin-top: 2.25rem;
    margin-bottom: 0.85rem;
    color: var(--text-primary);
  }

  .article-content :global(p) {
    margin: 0 0 1.45rem;
  }

  .article-content :global(strong) {
    color: var(--text-primary);
    font-weight: 700;
  }

  .article-content :global(code) {
    padding: 0.15rem 0.4rem;
    background: var(--accent-subtle);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.88em;
    color: var(--accent-text);
    overflow-wrap: break-word;
  }

  .article-content :global(pre) {
    padding: 1.25rem 1.4rem;
    background: #f5f2ea !important;
    border-radius: var(--radius-sm);
    overflow-x: auto;
    max-width: 100%;
    margin: 0 0 1.65rem;
    border: 1px solid var(--border);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .article-content :global(pre code) {
    background: transparent;
    padding: 0;
    color: var(--text-primary);
    font-size: inherit;
    overflow-wrap: normal;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 0 0 1.5rem;
    padding-left: 1.4rem;
  }

  .article-content :global(li) {
    margin-bottom: 0.45rem;
  }

  .article-content :global(a) {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .article-content :global(a:hover) {
    color: var(--accent-hover);
  }

  .article-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.75rem 0;
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .article-content :global(th) {
    background: #f5f2ea;
    padding: 0.7rem 0.9rem;
    text-align: left;
    font-weight: 700;
    color: var(--text-primary);
    border-bottom: 2px solid var(--border-strong);
  }

  .article-content :global(td) {
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-primary);
    vertical-align: top;
  }

  .article-content :global(th:first-child),
  .article-content :global(td:first-child) {
    min-width: 5.5rem;
  }

  .article-content :global(hr) {
    border: none;
    height: 1px;
    background: var(--border);
    margin: 2.75rem 0;
  }

  .article-content :global(blockquote) {
    border-left: 3px solid var(--accent-text);
    padding: 0.25rem 0 0.25rem 1.25rem;
    margin: 1.65rem 0;
    color: var(--text-secondary);
  }

  .article-content :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .article-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    margin: 2rem auto;
    display: block;
  }

  .article-content :global(figure) {
    margin: 2rem 0;
    text-align: center;
  }

  .article-content :global(figure img) {
    margin: 0 auto 0.75rem;
  }

  .article-content :global(figcaption) {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .article-title {
      font-size: clamp(1.55rem, 6vw, 2.05rem);
    }

    .article-excerpt {
      font-size: 1rem;
    }

    .article-content {
      font-size: 1.0625rem;
    }

    .article-content :global(h2) {
      font-size: 1.35rem;
      margin-top: 2.25rem;
      margin-bottom: 0.9rem;
    }

    .article-content :global(h3) {
      font-size: 1.15rem;
      margin-top: 1.75rem;
    }

    .article-content :global(p) {
      margin-bottom: 1.25rem;
    }

    .article-content :global(pre) {
      padding: 1rem;
      font-size: 0.82rem;
    }

    .article-content :global(table) {
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      font-size: 0.86rem;
    }

    .article-content :global(th),
    .article-content :global(td) {
      padding: 0.55rem 0.75rem;
      min-width: 7rem;
    }

    .article-content :global(img) {
      margin: 1.5rem auto;
    }
  }
</style>
