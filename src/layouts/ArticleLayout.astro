---
/**
 * Article Layout - 文章閱讀版面（支援手機、平板直/橫向、桌機多斷點 RWD）
 */

import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import SEO from '../components/SEO.astro';
import ArticleNav from '../components/ArticleNav.astro';
import ArticleEnd from '../components/ArticleEnd.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { formatDate } from '../utils/format';

interface Props {
  entry: CollectionEntry<'articles'>;
  headings: MarkdownHeading[];
}

const { entry, headings } = Astro.props;
const { Content } = await entry.render();
const h2Headings = headings.filter((h) => h.depth === 2);

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://cablate.com/' },
    { '@type': 'ListItem', position: 2, name: '文章', item: 'https://cablate.com/articles/' },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: `https://cablate.com/articles/${entry.slug}/` }
  ]
};
---

<BaseLayout title={entry.data.title} noSEO={true}>
  <SEO
    slot="head"
    title={`${entry.data.title} | CabLate`}
    description={entry.data.description}
    image={`/og/${entry.slug}.png`}
    imageAlt={entry.data.title}
    imageWidth={1200}
    imageHeight={630}
    type="article"
    publishDate={entry.data.publishDate}
    modifiedDate={entry.data.updatedDate}
    tags={entry.data.tags}
  />
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />

  <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>

  <div class="article-page paper-page">
    <article class="article-container page-paper">
      <div class="article-shell">
        <div class="article-topline">
          <nav class="breadcrumb" aria-label="麵包屑導覽">
            <ol>
              <li><a href="/">首頁</a></li>
              <li><a href="/articles/">文章</a></li>
              <li aria-current="page">{entry.data.title}</li>
            </ol>
          </nav>
          <div class="article-meta">
            <span class="article-category">{entry.data.category}</span>
            <time class="article-date" datetime={entry.data.publishDate.toISOString()}>
              {formatDate(entry.data.publishDate)}
            </time>
            {entry.data.updatedDate && (
              <span class="article-updated">
                更新於 {formatDate(entry.data.updatedDate)}
              </span>
            )}
            {entry.data.readingTime && (
              <span class="article-reading-time">{entry.data.readingTime} 分鐘閱讀</span>
            )}
          </div>
        </div>

        <div class="article-body-layout">
          <div class="article-body-main">
            <header class="article-header">
              <h1 class="article-title">{entry.data.title}</h1>

              {entry.data.excerpt && (
                <p class="article-excerpt">{entry.data.excerpt}</p>
              )}
            </header>

            {h2Headings.length >= 2 && (
              <details class="article-toc-mobile">
                <summary>這篇的段落（{h2Headings.length}）</summary>
                <ol>
                  {h2Headings.map((h) => (
                    <li><a href={`#${h.slug}`}>{h.text}</a></li>
                  ))}
                </ol>
              </details>
            )}

            <div class="article-content">
              <Content />
            </div>

            <ArticleEnd />
            <ArticleNav currentSlug={entry.slug} />
          </div>

          <aside class="article-toc-sidebar">
            <TableOfContents headings={headings} />
          </aside>
        </div>
      </div>
    </article>
  </div>

  <dialog class="article-lightbox" data-lightbox aria-label="圖片放大檢視">
    <img alt="" decoding="async" />
    <button type="button" data-lightbox-close>關閉</button>
  </dialog>

  <script is:inline>
    (function () {
      var progressBound = false;

      function bindProgressOnce() {
        if (progressBound) return;
        progressBound = true;
        var ticking = false;
        var update = function () {
          ticking = false;
          var bar = document.querySelector('[data-reading-progress]');
          var content = document.querySelector('.article-content');
          if (!bar || !content) return;
          var rect = content.getBoundingClientRect();
          var total = rect.height - window.innerHeight;
          var done = total <= 40 ? 1 : Math.min(1, Math.max(0, -rect.top / total));
          bar.style.transform = 'scaleX(' + done + ')';
        };
        var request = function () { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
        window.addEventListener('scroll', request, { passive: true });
        window.addEventListener('resize', request, { passive: true });
        request();
      }

      function initArticleEnhancements() {
        var root = document.querySelector('.article-page');
        if (!root) return;
        bindProgressOnce();
        var progressNow = document.querySelector('[data-reading-progress]');
        if (progressNow) progressNow.style.transform = 'scaleX(0)';

        root.querySelectorAll('.article-code__copy').forEach(function (btn) {
          if (btn.dataset.ready) return;
          btn.dataset.ready = '1';
          btn.addEventListener('click', function () {
            var pre = btn.closest('.article-code') && btn.closest('.article-code').querySelector('pre');
            if (!pre) return;
            var original = btn.textContent;
            navigator.clipboard.writeText(pre.innerText).then(function () {
              btn.textContent = '已複製 ✓';
              btn.classList.add('is-copied');
            }).catch(function () {
              btn.textContent = '複製失敗';
            });
            setTimeout(function () { btn.textContent = original; btn.classList.remove('is-copied'); }, 2000);
          });
        });

        var lightbox = root.querySelector('[data-lightbox]');
        var lightboxImg = lightbox && lightbox.querySelector('img');
        root.querySelectorAll('.article-figure > img').forEach(function (img) {
          if (img.dataset.ready) return;
          img.dataset.ready = '1';
          img.addEventListener('click', function () {
            if (!lightbox || typeof lightbox.showModal !== 'function') return;
            lightboxImg.src = img.currentSrc || img.src;
            lightboxImg.alt = img.alt || '';
            lightbox.showModal();
          });
        });
        if (lightbox && !lightbox.dataset.ready) {
          lightbox.dataset.ready = '1';
          lightbox.addEventListener('click', function (event) {
            if (event.target === lightbox || event.target.hasAttribute('data-lightbox-close')) lightbox.close();
          });
        }

        var tocDetails = root.querySelector('.article-toc-mobile');
        if (tocDetails) {
          tocDetails.querySelectorAll('a[href^="#"]').forEach(function (link) {
            if (link.dataset.ready) return;
            link.dataset.ready = '1';
            link.addEventListener('click', function () { tocDetails.removeAttribute('open'); });
          });
        }

        root.querySelectorAll('.article-content h2[id], .article-content h3[id]').forEach(function (heading) {
          if (heading.querySelector('.anchor-link')) return;
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'anchor-link';
          btn.setAttribute('aria-label', '複製這個段落的連結');
          btn.textContent = '#';
          btn.addEventListener('click', function () {
            var url = location.origin + location.pathname + '#' + heading.id;
            navigator.clipboard.writeText(url).then(function () {
              btn.classList.add('is-copied');
              setTimeout(function () { btn.classList.remove('is-copied'); }, 1500);
            }).catch(function () {});
          });
          heading.appendChild(btn);
        });

        root.querySelectorAll('[data-diagram]').forEach(function (diagram) {
          var buttons = diagram.querySelectorAll('[data-mode]');
          var apply = function (mode) {
            buttons.forEach(function (b) { b.classList.toggle('is-active', b.getAttribute('data-mode') === mode); });
            diagram.querySelectorAll('[data-pane]').forEach(function (pane) {
              pane.style.display = pane.getAttribute('data-pane') === mode ? '' : 'none';
            });
          };
          buttons.forEach(function (btn) {
            if (btn.dataset.ready) return;
            btn.dataset.ready = '1';
            btn.addEventListener('click', function () { apply(btn.getAttribute('data-mode')); });
          });
          var active = diagram.querySelector('[data-mode].is-active');
          if (active) apply(active.getAttribute('data-mode'));
        });
      }

      initArticleEnhancements();
      document.addEventListener('astro:page-load', initArticleEnhancements);
    })();
  </script>
</BaseLayout>

<style>
  :global(html) {
    scroll-padding-top: 2.5rem;
  }

  .article-page > .article-container {
    background-color: var(--bg-soft) !important;
    background-image: none !important;
    border: 1px solid var(--border-strong) !important;
    border-radius: var(--radius-md) !important;
    box-shadow: var(--shadow-sm) !important;
    padding: clamp(1.5rem, 3.2vw, 2.5rem) clamp(1.25rem, 4vw, 3rem) !important;
  }

  .article-shell {
    max-width: 60rem;
    margin-inline: auto;
  }

  .article-topline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem 1.25rem;
    padding-bottom: 0.9rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.84rem;
    color: var(--text-muted);
  }

  .breadcrumb li + li::before {
    content: '/';
    margin-right: 0.4rem;
    color: var(--border-strong);
  }

  .breadcrumb li:last-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: min(20rem, 55vw);
  }

  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--text-primary);
  }

  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    font-size: 0.84rem;
    color: var(--text-muted);
  }

  .article-category {
    padding: 0.12rem 0.55rem;
    border-radius: 4px;
    background: var(--accent-subtle);
    color: var(--accent-text);
    font-weight: 700;
    font-size: 0.8rem;
  }

  .article-updated,
  .article-reading-time {
    font-size: 0.84rem;
    color: var(--text-muted);
  }

  .article-body-layout {
    --article-measure: 41rem;
    display: grid;
    grid-template-columns: minmax(0, var(--article-measure)) 13rem;
    justify-content: space-between;
    gap: 2.5rem;
    align-items: start;
  }

  .article-body-main {
    min-width: 0;
    max-width: var(--article-measure);
  }

  .article-header {
    margin-bottom: 1.5rem;
  }

  .article-title {
    font-family: var(--font-sans);
    font-size: clamp(1.5rem, 2.6vw, 1.95rem);
    font-weight: 700;
    line-height: 1.36;
    letter-spacing: -0.015em;
    margin: 0 0 1rem;
    color: var(--text-primary);
    text-wrap: pretty;
  }

  .article-excerpt {
    font-size: 0.98rem;
    color: var(--text-primary);
    line-height: 1.72;
    margin: 0;
    padding: 0.85rem 1.1rem;
    background: #f6f3eb;
    border-left: 3px solid var(--accent-text);
    border-radius: 0 6px 6px 0;
  }

  .article-toc-sidebar {
    display: block;
    position: sticky;
    top: 1.5rem;
  }

  .article-toc-mobile {
    display: none;
    margin: 0 0 1.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: #faf7f0;
  }

  .article-toc-mobile summary {
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .article-toc-mobile ol {
    margin: 0.65rem 0 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.4rem;
    font-size: 0.88rem;
  }

  .article-toc-mobile a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .article-toc-mobile a:hover {
    color: var(--accent-text);
  }

  /* Below 1180px the left desktop rail + article + right TOC would crowd; collapse TOC into the inline details drawer */
  @media (max-width: 1180px) {
    .article-shell {
      max-width: 43rem;
    }

    .article-body-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .article-toc-sidebar {
      display: none;
    }

    .article-toc-mobile {
      display: block;
    }
  }

  .article-content {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--text-primary);
  }

  .article-content :global(h2) {
    font-family: var(--font-sans);
    font-size: clamp(1.25rem, 2vw, 1.42rem);
    font-weight: 700;
    line-height: 1.4;
    margin-top: 2.5rem;
    margin-bottom: 0.9rem;
    padding-left: 0.75rem;
    border-left: 3px solid var(--accent);
    color: var(--text-primary);
  }

  .article-content :global(h2:first-child) {
    margin-top: 0;
  }

  .article-content :global(hr + h2) {
    margin-top: 0;
  }

  .article-content :global(h3) {
    font-family: var(--font-sans);
    font-size: clamp(1.08rem, 1.6vw, 1.18rem);
    font-weight: 700;
    line-height: 1.45;
    margin-top: 1.85rem;
    margin-bottom: 0.65rem;
    color: var(--text-primary);
  }

  .article-content :global(p) {
    margin: 0 0 1.25rem;
  }

  .article-content :global(strong) {
    color: var(--text-primary);
    font-weight: 700;
  }

  .article-content :global(code) {
    padding: 0.14rem 0.38rem;
    background: #f2eee6;
    border: 1px solid #e4decb;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.86em;
    color: #3d2c8d;
    overflow-wrap: break-word;
  }

  .article-content :global(pre) {
    padding: 1rem 1.2rem;
    background: #f5f2ea !important;
    border-radius: 6px;
    overflow-x: auto;
    max-width: 100%;
    margin: 0 0 1.4rem;
    border: 1px solid var(--border);
    font-size: 0.875rem;
    line-height: 1.65;
  }

  .article-content :global(pre code) {
    background: transparent;
    border: 0;
    padding: 0;
    color: var(--text-primary);
    font-size: inherit;
    overflow-wrap: normal;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 0 0 1.35rem;
    padding-left: 1.35rem;
  }

  .article-content :global(li) {
    margin-bottom: 0.4rem;
  }

  .article-content :global(li::marker) {
    color: var(--accent-text);
  }

  .article-content :global(a) {
    color: var(--accent-text);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .article-content :global(a:hover) {
    color: var(--accent-hover);
  }

  .article-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.92rem;
    line-height: 1.6;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
  }

  .article-content :global(th) {
    background: #f3efe5;
    padding: 0.65rem 0.85rem;
    text-align: left;
    font-weight: 700;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-strong);
  }

  .article-content :global(td) {
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-primary);
    vertical-align: top;
  }

  .article-content :global(tr:last-child td) {
    border-bottom: 0;
  }

  .article-content :global(th:first-child),
  .article-content :global(td:first-child) {
    min-width: 5.5rem;
  }

  .article-content :global(hr) {
    border: none;
    height: 1px;
    background: var(--border);
    margin: 2rem 0;
  }

  /* Reading progress bar */
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 1200;
    pointer-events: none;
  }

  .reading-progress span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--accent-text));
    transform: scaleX(0);
    transform-origin: 0 50%;
    will-change: transform;
  }

  /* Semantic callouts ([!NOTE] / [!TIP] / [!WARNING]) */
  .article-content :global(.article-callout) {
    margin: 1.35rem 0;
    padding: 0.8rem 1.05rem;
    border-left: 3px solid var(--border-strong);
    border-radius: 0 6px 6px 0;
  }

  .article-content :global(.article-callout__title) {
    margin: 0 0 0.3rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .article-content :global(.article-callout p:last-child) {
    margin-bottom: 0;
  }

  .article-content :global(.article-callout--note) {
    border-left-color: var(--accent-text);
    background: #f1edff;
  }

  .article-content :global(.article-callout--note .article-callout__title) {
    color: var(--accent-text);
  }

  .article-content :global(.article-callout--tip) {
    border-left-color: #26734f;
    background: #eef7f1;
  }

  .article-content :global(.article-callout--tip .article-callout__title) {
    color: #26734f;
  }

  .article-content :global(.article-callout--warning) {
    border-left-color: #9b6017;
    background: #fff7e8;
  }

  .article-content :global(.article-callout--warning .article-callout__title) {
    color: #9b6017;
  }

  /* Figures with captions + lightbox */
  .article-content :global(.article-figure) {
    margin: 1.6rem 0;
  }

  .article-content :global(.article-figure img) {
    cursor: zoom-in;
  }

  .article-content :global(.article-figure__caption) {
    margin-top: 0.55rem;
    font-size: 0.86rem;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }

  .article-lightbox {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .article-lightbox::backdrop {
    background: rgb(23 24 22 / 0.84);
  }

  .article-lightbox img {
    display: block;
    max-width: 92vw;
    max-height: 84vh;
    margin: 8vh auto 0;
    border-radius: 6px;
  }

  .article-lightbox button {
    position: fixed;
    top: 1.5rem;
    right: 1.5rem;
    min-height: 2.6rem;
    padding: 0.5rem 1.1rem;
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.12);
    color: #fff;
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
  }

  /* Code block chrome (language label + copy button) */
  .article-content :global(.article-code) {
    margin: 0 0 1.4rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    background: #f5f2ea;
  }

  .article-content :global(.article-code__head) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.4rem 0.55rem 0.4rem 0.95rem;
    border-bottom: 1px solid var(--border);
    background: #ece7d9;
  }

  .article-content :global(.article-code__lang) {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  .article-content :global(.article-code__copy) {
    display: inline-flex;
    align-items: center;
    min-height: 1.9rem;
    padding: 0.2rem 0.7rem;
    border: 1px solid var(--border-strong);
    border-radius: 5px;
    background: var(--bg-soft);
    color: var(--text-secondary);
    font-size: 0.76rem;
    font-weight: 700;
    cursor: pointer;
    transition: border-color var(--transition-fast), color var(--transition-fast), background-color var(--transition-fast);
  }

  .article-content :global(.article-code__copy:hover) {
    border-color: var(--accent-text);
    color: var(--accent-text);
  }

  .article-content :global(.article-code__copy.is-copied) {
    border-color: #26734f;
    background: #eef7f1;
    color: #26734f;
  }

  .article-content :global(.article-code pre) {
    margin: 0;
    border: 0;
    border-radius: 0;
  }

  /* Scrollable table region */
  .article-content :global(.article-table-wrap) {
    margin: 1.5rem 0;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 6px;
    -webkit-overflow-scrolling: touch;
  }

  .article-content :global(.article-table-wrap table) {
    margin: 0;
    border: 0;
  }

  .article-content :global(.article-table-wrap th),
  .article-content :global(.article-table-wrap td) {
    font-variant-numeric: tabular-nums;
  }

  .article-content :global(.article-table-wrap:focus-visible) {
    outline: 3px solid var(--accent-text);
    outline-offset: 2px;
  }

  /* Heading anchor copy buttons */
  .article-content :global(h2[id]),
  .article-content :global(h3[id]) {
    position: relative;
  }

  .article-content :global(.anchor-link) {
    margin-left: 0.4rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--border-strong);
    font-family: var(--font-mono);
    font-size: 0.82em;
    font-weight: 700;
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--transition-fast), color var(--transition-fast);
  }

  .article-content :global(h2:hover .anchor-link),
  .article-content :global(h3:hover .anchor-link),
  .article-content :global(.anchor-link:focus-visible),
  .article-content :global(.anchor-link.is-copied) {
    opacity: 1;
  }

  .article-content :global(.anchor-link.is-copied) {
    color: #26734f;
  }

  /* Interactive / animated SVG diagram container */
  .article-content :global(.article-diagram) {
    margin: 1.6rem 0;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    overflow: hidden;
    background: #fffdf8;
  }

  .article-content :global(.article-diagram__head) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
