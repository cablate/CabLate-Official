    "astro": "^7.2.8",
    "markdown-it": "^14.3.3",
    "sanitize-html": "^2.18.0",
    "satori": "^0.26.0",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/markdown-it": "^14.1.2",
    "@types/sanitize-html": "^2.16.1",
    "typescript": "^5.9.3"
