{
  "name": "cablate",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build.js",
    "check": "astro check",
    "lint:copy": "node scripts/lint-copy.mjs",
    "validate:content": "node scripts/validate-content.js",
    "validate:svg": "node scripts/validate-svg-diagrams.mjs",
    "validate:service-application": "node scripts/validate-service-application.js && node scripts/test-service-application-function.js",
    "validate:analytics": "node scripts/validate-analytics.mjs",
    "preview": "astro preview",
    "astro": "astro",
